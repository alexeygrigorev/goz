rn tool_calls\n\n    async def simple_chat(\n        self,\n        message: str,\n        system_prompt: str | None = None,\n    ) -> str:\n        \"\"\"Simple chat without streaming or tool calling.\n\n","exit_code":0,"status":"completed"}}
