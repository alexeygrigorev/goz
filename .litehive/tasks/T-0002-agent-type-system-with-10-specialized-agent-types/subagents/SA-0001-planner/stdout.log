onManager | None = None\n./goz/agent/tui/app.py:100:        self._session_dir: Path | None = None\n./goz/agent/tui/app.py:102:    def _get_session_dir(self) -> Path:\n./goz/agent/tui/app.py:103:        \"\"\"Get the session directory for saving/loading sessions.\n./goz/agent/tui/app.py:106:            Path to the session directory\n./goz/agent/tui/app.py:108:        if self._session_dir is None:\n./goz/agent/tui/app.py:109:            self._session_dir = Path.home() / \".goz\" / \"sessions\"\n./goz/agent/tui/app.py:110:            self._session_dir.mkdir(parents=True, exist_ok=True)\n./goz/agent/tui/app.py:111:        return self._session_dir\n./goz/agent/tui/app.py:125:    async def load_session(self, session_id: str) -> None:\n./goz/agent/tui/app.py:126:        \"\"\"Load a saved session.\n./goz/agent/tui/app.py:129:            session_id: The session identifier to load\n./goz/agent/tui/app.py:132:            FileNotFoundError: If session doesn't exist\n./goz/agent/tui/app.py:134:        # Initialize session manager if needed\n./goz/agent/tui/app.py:135:        if self.session_manager is None:\n./goz/agent/tui/app.py:136:            self.session_manager = SessionManager(session_dir=self._get_session_dir())\n./goz/agent/tui/app.py:138:        # Load session from file\n./goz/agent/tui/app.py:139:        session = await self.session_manager.load(session_id)\n./goz/agent/tui/app.py:142:        self.agent.history = ChatHistory(messages=session.messages)\n./goz/agent/tui/app.py:144:        # Restore session metadata\n./goz/agent/tui/app.py:145:        self.session_id = session.id\n./goz/agent/tui/app.py:146:        self.current_agent_type = session.agent_type\n./goz/agent/tui/app.py:148:        # Note: working_directory could be restored with os.chdir(session.working_directory)\n./goz/agent/tui/app.py:151:    async def save_session(self, session_id: str) -> None:\n./goz/agent/tui/app.py:152:        \"\"\"Save the current session.\n./goz/agent/tui/app.py:155:            