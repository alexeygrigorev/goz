{"type": "tool_use", "part": {"id": "call_0b18e1d6805a41abab21399d", "name": "view_file", "input": {"file_path": "goz/agent/usage.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/usage.py (193 lines)\n============================================================\n\n  1\u2192 \"\"\"Usage tracking for Z.AI token consumption and cost.\n  2\u2192 \n  3\u2192 This module provides data structures and utilities for tracking token usage\n  4\u2192 across streaming API responses, computing costs, and accumulating per-session\n  5\u2192 statistics.\n  6\u2192 \n  7\u2192 Acceptance Criteria (T-0008):\n  8\u2192 - Per-turn token counts extracted from message_start/message_delta events\n  9\u2192 - Accumulated in session state\n 10\u2192 - step_finish JSONL event includes tokens and cost\n 11\u2192 \"\"\"\n 12\u2192 \n 13\u2192 from __future__ import annotations\n 14\u2192 \n 15\u2192 import math\n 16\u2192 from dataclasses import dataclass, field\n 17\u2192 \n 18\u2192 \n 19\u2192 # Approximate per-Mtoken pricing (USD) for common models.\n 20\u2192 # These are best-effort estimates; actual billing comes from the API.\n 21\u2192 _MODEL_PRICING: dict[str, dict[str, float]] = {\n 22\u2192     \"glm-5-turbo\": {\"input\": 2.0, \"output\": 8.0, \"cache_read\": 0.5, \"cache_creation\": 2.5},\n 23\u2192     \"glm-4.6v\": {\"input\": 2.0, \"output\": 8.0, \"cache_read\": 0.5, \"cache_creation\": 2.5},\n 24\u2192     \"claude-sonnet-4-20250514\": {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75},\n 25\u2192     \"claude-3-5-sonnet-20241022\": {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75},\n 26\u2192 }\n 27\u2192 \n 28\u2192 _DEFAULT_PRICING = {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75}\n 29\u2192 \n 30\u2192 \n 31\u2192 def _get_pricing(model: str) -> dict[str, float]:\n 32\u2192     \"\"\"Return pricing dict for *model*, falling back to defaults.\"\"\"\n 33\u2192     for key, pricing in _MODEL_PRICING.items():\n 34\u2192         if key in model:\n 35\u2192             return pricing\n 36\u2192     return _DEFAULT_PRICING\n 37\u2192 \n 38\u2192 \n 39\u2192 @dataclass\n 40\u2192 class UsageSnapshot:\n 41\u2192     \"\"\"Token counts from a single API response (one streaming turn).\n 42\u2192 \n 43\u2192     Attributes:\n 44\u2192         input_tokens: Total input tokens for the request.\n 45\u2192         output_tokens: Total output tokens generated.\n 46\u2192         cache_read_input_tokens: Tokens served from prompt cache (read).\n 47\u2192         cache_creation_input_tokens: Tokens stored into prompt cache (write).\n 48\u2192     \"\"\"\n 49\u2192 \n 50\u2192     input_tokens: int = 0\n 51\u2192     output_tokens: int = 0\n 52\u2192     cache_read_input_tokens: int = 0\n 53\u2192     cache_creation_input_tokens: int = 0\n 54\u2192 \n 55\u2192     def cost_usd(self, model: str = \"\") -> float:\n 56\u2192         \"\"\"Compute approximate USD cost for this snapshot.\"\"\"\n 57\u2192         pricing = _get_pricing(model)\n 58\u2192         return (\n 59\u2192             self.input_tokens * pricing[\"input\"]\n 60\u2192             + self.output_tokens * pricing[\"output\"]\n 61\u2192             + self.cache_read_input_tokens * pricing[\"cache_read\"]\n 62\u2192             + self.cache_creation_input_tokens * pricing[\"cache_creation\"]\n 63\u2192         ) / 1_000_000.0\n 64\u2192 \n 65\u2192     def total_tokens(self) -> int:\n 66\u2192         \"\"\"Return the sum of all token counts.\"\"\"\n 67\u2192         return (\n 68\u2192             self.input_tokens\n 69\u2192             + self.output_tokens\n 70\u2192             + self.cache_read_input_tokens\n 71\u2192             + self.cache_creation_input_tokens\n 72\u2192         )\n 73\u2192 \n 74\u2192     def to_dict(self) -> dict:\n 75\u2192         \"\"\"Serialise to a plain dict (for JSONL emission).\"\"\"\n 76\u2192         return {\n 77\u2192             \"input\": self.input_tokens,\n 78\u2192             \"output\": self.output_tokens,\n 79\u2192             \"cache_read\": self.cache_read_input_tokens,\n 80\u2192             \"cache_creation\": self.cache_creation_input_tokens,\n 81\u2192         }\n 82\u2192 \n 83\u2192 \n 84\u2192 @dataclass\n 85\u2192 class UsageAccumulator:\n 86\u2192     \"\"\"Accumulates usage across multiple turns in a session.\n 87\u2192 \n 88\u2192     Usage is captured in two phases per streaming response:\n 89\u2192     1. ``message_start`` carries initial input / cache tokens.\n 90\u2192     2. ``message_delta`` carries the final output token count.\n 91\u2192 \n 92\u2192     The accumulator merges these into a :class:`UsageSnapshot` per turn\n 93\u2192     and maintains running totals.\n 94\u2192     \"\"\"\n 95\u2192 \n 96\u2192     # Running totals across all turns\n 97\u2192     total_input_tokens: int = 0\n 98\u2192     total_output_tokens: int = 0\n 99\u2192     total_cache_read_tokens: int = 0\n100\u2192     total_cache_creation_tokens: int = 0\n101\u2192     turn_count: int = 0\n102\u2192 \n103\u2192     # Per-turn snapshots (append-only)\n104\u2192     turns: list[UsageSnapshot] = field(default_factory=list)\n105\u2192 \n106\u2192     # --- Streaming helpers ---------------------------------------------------\n107\u2192 \n108\u2192     def begin_turn(self) -> None:\n109\u2192         \"\"\"Prepare for a new streaming turn.\"\"\"\n110\u2192         self.turns.append(UsageSnapshot())\n111\u2192 \n112\u2192     def apply_message_start(self, usage: object) -> None:\n113\u2192         \"\"\"Merge ``message_start`` usage data into the current turn.\n114\u2192 \n115\u2192         Args:\n116\u2192             usage: An object with ``input_tokens``, optionally\n117\u2192                 ``cache_read_input_tokens`` and ``cache_creation_input_tokens``.\n118\u2192         \"\"\"\n119\u2192         if not self.turns:\n120\u2192             self.begin_turn()\n121\u2192         snap = self.turns[-1]\n122\u2192         snap.input_tokens = getattr(usage, \"input_tokens\", 0) or 0\n123\u2192         snap.cache_read_input_tokens = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n124\u2192         snap.cache_creation_input_tokens = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n125\u2192 \n126\u2192     def apply_message_delta(self, usage: object) -> None:\n127\u2192         \"\"\"Merge ``message_delta`` usage data into the current turn.\n128\u2192 \n129\u2192         Args:\n130\u2192             usage: An object with ``output_tokens``, optionally cumulative\n131\u2192                 ``input_tokens``, ``cache_read_input_tokens``, etc.\n132\u2192         \"\"\"\n133\u2192         if not self.turns:\n134\u2192             self.begin_turn()\n135\u2192         snap = self.turns[-1]\n136\u2192         # message_delta carries cumulative output_tokens\n137\u2192         snap.output_tokens = getattr(usage, \"output_tokens\", 0) or 0\n138\u2192         # Update input/cache if provided (some APIs send cumulative totals here)\n139\u2192         if hasattr(usage, \"input_tokens\") and usage.input_tokens is not None:\n140\u2192             snap.input_tokens = usage.input_tokens\n141\u2192         if hasattr(usage, \"cache_read_input_tokens\") and usage.cache_read_input_tokens is not None:\n142\u2192             snap.cache_read_input_tokens = usage.cache_read_input_tokens\n143\u2192         if hasattr(usage, \"cache_creation_input_tokens\") and usage.cache_creation_input_tokens is not None:\n144\u2192             snap.cache_creation_input_tokens = usage.cache_creation_input_tokens\n145\u2192 \n146\u2192     def finalise_turn(self) -> UsageSnapshot:\n147\u2192         \"\"\"Close the current turn, roll into running totals, and return it.\"\"\"\n148\u2192         if not self.turns:\n149\u2192             return UsageSnapshot()\n150\u2192         snap = self.turns[-1]\n151\u2192         self.total_input_tokens += snap.input_tokens\n152\u2192         self.total_output_tokens += snap.output_tokens\n153\u2192         self.total_cache_read_tokens += snap.cache_read_input_tokens\n154\u2192         self.total_cache_creation_tokens += snap.cache_creation_input_tokens\n155\u2192         self.turn_count += 1\n156\u2192         return snap\n157\u2192 \n158\u2192     def current_turn_snapshot(self) -> UsageSnapshot:\n159\u2192         \"\"\"Return the in-progress snapshot for the current turn.\"\"\"\n160\u2192         if not self.turns:\n161\u2192             return UsageSnapshot()\n162\u2192         return self.turns[-1]\n163\u2192 \n164\u2192     # --- Aggregation ---------------------------------------------------------\n165\u2192 \n166\u2192     def total_tokens(self) -> int:\n167\u2192         return (\n168\u2192             self.total_input_tokens\n169\u2192             + self.total_output_tokens\n170\u2192             + self.total_cache_read_tokens\n171\u2192             + self.total_cache_creation_tokens\n172\u2192         )\n173\u2192 \n174\u2192     def total_cost_usd(self, model: str = \"\") -> float:\n175\u2192         pricing = _get_pricing(model)\n176\u2192         return (\n177\u2192             self.total_input_tokens * pricing[\"input\"]\n178\u2192             + self.total_output_tokens * pricing[\"output\"]\n179\u2192             + self.total_cache_read_tokens * pricing[\"cache_read\"]\n180\u2192             + self.total_cache_creation_tokens * pricing[\"cache_creation\"]\n181\u2192         ) / 1_000_000.0\n182\u2192 \n183\u2192     def to_dict(self) -> dict:\n184\u2192         \"\"\"Serialise full accumulator state.\"\"\"\n185\u2192         return {\n186\u2192             \"turn_count\": self.turn_count,\n187\u2192             \"total_input\": self.total_input_tokens,\n188\u2192             \"total_output\": self.total_output_tokens,\n189\u2192             \"total_cache_read\": self.total_cache_read_tokens,\n190\u2192             \"total_cache_creation\": self.total_cache_creation_tokens,\n191\u2192             \"total_tokens\": self.total_tokens(),\n192\u2192             \"turns\": [t.to_dict() for t in self.turns],\n193\u2192         }", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_ef4edd5cdd414cb698c66950", "name": "view_file", "input": {"file_path": "goz/cli/usage.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/cli/usage.py (137 lines)\n============================================================\n\n  1\u2192 \"\"\"`goz usage` CLI command for displaying usage statistics and quota.\"\"\"\n  2\u2192 \n  3\u2192 from __future__ import annotations\n  4\u2192 \n  5\u2192 import sys\n  6\u2192 \n  7\u2192 from goz.config import load_config\n  8\u2192 \n  9\u2192 \n 10\u2192 def _fmt_tokens(n: int) -> str:\n 11\u2192     if n >= 1_000_000:\n 12\u2192         return f\"{n / 1_000_000:.2f}M\"\n 13\u2192     if n >= 1_000:\n 14\u2192         return f\"{n / 1_000:.1f}k\"\n 15\u2192     return str(n)\n 16\u2192 \n 17\u2192 \n 18\u2192 def _fmt_cost(cost: float) -> str:\n 19\u2192     if cost < 0.01:\n 20\u2192         return f\"${cost:.4f}\"\n 21\u2192     return f\"${cost:.2f}\"\n 22\u2192 \n 23\u2192 \n 24\u2192 async def cmd_usage(args: list[str]) -> None:\n 25\u2192     if args and args[0] in (\"--help\", \"-h\", \"help\"):\n 26\u2192         print(\"\"\"Usage command:\n 27\u2192 \n 28\u2192   goz usage            Show quota remaining and usage aggregates\n 29\u2192   goz usage --json     Raw JSON output\n 30\u2192   goz usage --days N   Model usage window (default: 7)\n 31\u2192 \n 32\u2192 Endpoints:\n 33\u2192   api.z.ai/api/monitor/usage/quota/limit   - 5-hour quota\n 34\u2192   api.z.ai/api/monitor/usage/model-usage   - Model aggregates\n 35\u2192 \"\"\")\n 36\u2192         return\n 37\u2192 \n 38\u2192     use_json = \"--json\" in args\n 39\u2192     days = 7\n 40\u2192     for i, a in enumerate(args):\n 41\u2192         if a == \"--days\" and i + 1 < len(args):\n 42\u2192             try:\n 43\u2192                 days = int(args[i + 1])\n 44\u2192             except ValueError:\n 45\u2192                 pass\n 46\u2192 \n 47\u2192     from goz.api.monitor import MonitorClient\n 48\u2192 \n 49\u2192     config = load_config()\n 50\u2192     client = MonitorClient(config=config)\n 51\u2192 \n 52\u2192     try:\n 53\u2192         quota = await client.fetch_quota_limit()\n 54\u2192     except Exception as exc:\n 55\u2192         print(f\"Failed to fetch quota: {exc}\", file=sys.stderr)\n 56\u2192         quota = None\n 57\u2192 \n 58\u2192     try:\n 59\u2192         usage_7 = await client.fetch_model_usage(days=days)\n 60\u2192     except Exception as exc:\n 61\u2192         print(f\"Failed to fetch {days}-day usage: {exc}\", file=sys.stderr)\n 62\u2192         usage_7 = None\n 63\u2192 \n 64\u2192     try:\n 65\u2192         usage_30 = await client.fetch_model_usage(days=30)\n 66\u2192     except Exception as exc:\n 67\u2192         print(f\"Failed to fetch 30-day usage: {exc}\", file=sys.stderr)\n 68\u2192         usage_30 = None\n 69\u2192 \n 70\u2192     if use_json:\n 71\u2192         import json\n 72\u2192 \n 73\u2192         out: dict = {}\n 74\u2192         if quota:\n 75\u2192             out[\"quota\"] = {\n 76\u2192                 \"limit\": quota.limit,\n 77\u2192                 \"remaining\": quota.remaining,\n 78\u2192                 \"used\": quota.used,\n 79\u2192                 \"window\": quota.window_label,\n 80\u2192             }\n 81\u2192         if usage_7:\n 82\u2192             out[f\"{usage_7.period_days}_day\"] = [\n 83\u2192                 {\n 84\u2192                     \"model\": e.model,\n 85\u2192                     \"input_tokens\": e.input_tokens,\n 86\u2192                     \"output_tokens\": e.output_tokens,\n 87\u2192                     \"total_tokens\": e.total_tokens,\n 88\u2192                     \"cost\": e.cost,\n 89\u2192                     \"requests\": e.requests,\n 90\u2192                 }\n 91\u2192                 for e in usage_7.entries\n 92\u2192             ]\n 93\u2192         if usage_30:\n 94\u2192             out[\"30_day\"] = [\n 95\u2192                 {\n 96\u2192                     \"model\": e.model,\n 97\u2192                     \"input_tokens\": e.input_tokens,\n 98\u2192                     \"output_tokens\": e.output_tokens,\n 99\u2192                     \"total_tokens\": e.total_tokens,\n100\u2192                     \"cost\": e.cost,\n101\u2192                     \"requests\": e.requests,\n102\u2192                 }\n103\u2192                 for e in usage_30.entries\n104\u2192             ]\n105\u2192         print(json.dumps(out, indent=2, ensure_ascii=True))\n106\u2192         return\n107\u2192 \n108\u2192     if quota:\n109\u2192         pct = (quota.used / quota.limit * 100) if quota.limit else 0\n110\u2192         print(f\"Quota ({quota.window_label}):\")\n111\u2192         print(f\"  Limit:     {_fmt_tokens(quota.limit)} tokens\")\n112\u2192         print(f\"  Used:      {_fmt_tokens(quota.used)} tokens ({pct:.1f}%)\")\n113\u2192         print(f\"  Remaining: {_fmt_tokens(quota.remaining)} tokens\")\n114\u2192         print()\n115\u2192 \n116\u2192     if usage_7:\n117\u2192         print(f\"Model usage ({usage_7.period_days}-day):\")\n118\u2192         if not usage_7.entries:\n119\u2192             print(\"  (no data)\")\n120\u2192         for e in usage_7.entries:\n121\u2192             print(f\"  {e.model}\")\n122\u2192             print(\n123\u2192                 f\"    Input:  {_fmt_tokens(e.input_tokens)}  Output: {_fmt_tokens(e.output_tokens)}  Total: {_fmt_tokens(e.total_tokens)}\"\n124\u2192             )\n125\u2192             print(f\"    Cost:   {_fmt_cost(e.cost)}  Requests: {e.requests}\")\n126\u2192         print()\n127\u2192 \n128\u2192     if usage_30:\n129\u2192         print(\"Model usage (30-day):\")\n130\u2192         if not usage_30.entries:\n131\u2192             print(\"  (no data)\")\n132\u2192         for e in usage_30.entries:\n133\u2192             print(f\"  {e.model}\")\n134\u2192             print(\n135\u2192                 f\"    Input:  {_fmt_tokens(e.input_tokens)}  Output: {_fmt_tokens(e.output_tokens)}  Total: {_fmt_tokens(e.total_tokens)}\"\n136\u2192             )\n137\u2192             print(f\"    Cost:   {_fmt_cost(e.cost)}  Requests: {e.requests}\")", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_5994e2ee964e46479666884f", "name": "view_file", "input": {"file_path": "goz/api/monitor.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/monitor.py (130 lines)\n============================================================\n\n  1\u2192 \"\"\"Z.AI Monitor API client for usage statistics and quota tracking.\n  2\u2192 \n  3\u2192 Provides access to:\n  4\u2192 - /api/monitor/usage/quota/limit \u2014 5-hour quota remaining\n  5\u2192 - /api/monitor/usage/model-usage \u2014 7-day and 30-day aggregates\n  6\u2192 \"\"\"\n  7\u2192 \n  8\u2192 from __future__ import annotations\n  9\u2192 \n 10\u2192 import logging\n 11\u2192 from dataclasses import dataclass, field\n 12\u2192 from typing import Any\n 13\u2192 \n 14\u2192 import httpx\n 15\u2192 \n 16\u2192 from goz.config import Config\n 17\u2192 \n 18\u2192 logger = logging.getLogger(__name__)\n 19\u2192 \n 20\u2192 \n 21\u2192 @dataclass\n 22\u2192 class QuotaInfo:\n 23\u2192     limit: int\n 24\u2192     remaining: int\n 25\u2192     used: int\n 26\u2192     window_label: str\n 27\u2192     raw: dict[str, Any] = field(default_factory=dict)\n 28\u2192 \n 29\u2192 \n 30\u2192 @dataclass\n 31\u2192 class ModelUsageEntry:\n 32\u2192     model: str\n 33\u2192     input_tokens: int\n 34\u2192     output_tokens: int\n 35\u2192     total_tokens: int\n 36\u2192     cost: float\n 37\u2192     requests: int\n 38\u2192     raw: dict[str, Any] = field(default_factory=dict)\n 39\u2192 \n 40\u2192 \n 41\u2192 @dataclass\n 42\u2192 class ModelUsageReport:\n 43\u2192     period_days: int\n 44\u2192     entries: list[ModelUsageEntry] = field(default_factory=list)\n 45\u2192     raw: dict[str, Any] = field(default_factory=dict)\n 46\u2192 \n 47\u2192 \n 48\u2192 class MonitorClient:\n 49\u2192     def __init__(self, config: Config | None = None) -> None:\n 50\u2192         if config is None:\n 51\u2192             from goz.config import load_config\n 52\u2192 \n 53\u2192             config = load_config()\n 54\u2192         self.config = config\n 55\u2192 \n 56\u2192     def _base(self) -> str:\n 57\u2192         url = self.config.zai_base_url\n 58\u2192         if \"/api/anthropic\" in url:\n 59\u2192             url = url.replace(\"/api/anthropic\", \"\")\n 60\u2192         return url.rstrip(\"/\")\n 61\u2192 \n 62\u2192     def _headers(self) -> dict[str, str]:\n 63\u2192         return {\n 64\u2192             \"Authorization\": f\"Bearer {self.config.zai_token}\",\n 65\u2192             \"Content-Type\": \"application/json\",\n 66\u2192         }\n 67\u2192 \n 68\u2192     async def fetch_quota_limit(self) -> QuotaInfo:\n 69\u2192         base = self._base()\n 70\u2192         url = f\"{base}/api/monitor/usage/quota/limit\"\n 71\u2192         async with httpx.AsyncClient(timeout=self.config.timeout) as client:\n 72\u2192             resp = await client.get(url, headers=self._headers())\n 73\u2192             resp.raise_for_status()\n 74\u2192             data = resp.json()\n 75\u2192 \n 76\u2192         if isinstance(data, dict) and \"data\" in data:\n 77\u2192             inner = data[\"data\"]\n 78\u2192         elif isinstance(data, dict):\n 79\u2192             inner = data\n 80\u2192         else:\n 81\u2192             inner = {}\n 82\u2192 \n 83\u2192         limit = inner.get(\"limit\", inner.get(\"total\", 0))\n 84\u2192         used = inner.get(\"used\", inner.get(\"consumed\", 0))\n 85\u2192         remaining = inner.get(\"remaining\", max(0, limit - used))\n 86\u2192         window = inner.get(\"window\", inner.get(\"period\", \"5h\"))\n 87\u2192 \n 88\u2192         return QuotaInfo(\n 89\u2192             limit=limit,\n 90\u2192             remaining=remaining,\n 91\u2192             used=used,\n 92\u2192             window_label=str(window),\n 93\u2192             raw=data,\n 94\u2192         )\n 95\u2192 \n 96\u2192     async def fetch_model_usage(self, days: int = 7) -> ModelUsageReport:\n 97\u2192         base = self._base()\n 98\u2192         url = f\"{base}/api/monitor/usage/model-usage\"\n 99\u2192         params: dict[str, Any] = {\"days\": days}\n100\u2192 \n101\u2192         async with httpx.AsyncClient(timeout=self.config.timeout) as client:\n102\u2192             resp = await client.get(url, headers=self._headers(), params=params)\n103\u2192             resp.raise_for_status()\n104\u2192             data = resp.json()\n105\u2192 \n106\u2192         entries: list[ModelUsageEntry] = []\n107\u2192         items: list[dict[str, Any]] = []\n108\u2192         if isinstance(data, dict) and \"data\" in data:\n109\u2192             items = data[\"data\"] if isinstance(data[\"data\"], list) else []\n110\u2192         elif isinstance(data, list):\n111\u2192             items = data\n112\u2192 \n113\u2192         for item in items:\n114\u2192             entries.append(\n115\u2192                 ModelUsageEntry(\n116\u2192                     model=item.get(\"model\", \"unknown\"),\n117\u2192                     input_tokens=item.get(\"input_tokens\", 0),\n118\u2192                     output_tokens=item.get(\"output_tokens\", 0),\n119\u2192                     total_tokens=item.get(\n120\u2192                         \"total_tokens\", item.get(\"input_tokens\", 0) + item.get(\"output_tokens\", 0)\n121\u2192                     ),\n122\u2192                     cost=item.get(\"cost\", 0.0),\n123\u2192                     requests=item.get(\"requests\", item.get(\"request_count\", 0)),\n124\u2192                     raw=item,\n125\u2192                 )\n126\u2192             )\n127\u2192 \n128\u2192         return ModelUsageReport(\n129\u2192             period_days=days, entries=entries, raw=data if isinstance(data, dict) else {}\n130\u2192         )", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_338db649c55e45a6890c8c13", "name": "view_file", "input": {"file_path": "goz/agent/quota.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/quota.py (158 lines)\n============================================================\n\n  1\u2192 \"\"\"Z.AI quota and usage monitor API client.\n  2\u2192 \n  3\u2192 Calls the Z.AI monitor endpoints to retrieve quota limits and historical\n  4\u2192 usage aggregates for display in the ``goz usage`` CLI command.\n  5\u2192 \n  6\u2192 Endpoints:\n  7\u2192 - ``api.z.ai/api/monitor/usage/quota/limit`` \u2192 5-hour quota remaining\n  8\u2192 - ``api.z.ai/api/monitor/usage/model-usage`` \u2192 7-day and 30-day aggregates\n  9\u2192 \"\"\"\n 10\u2192 \n 11\u2192 from __future__ import annotations\n 12\u2192 \n 13\u2192 import logging\n 14\u2192 from dataclasses import dataclass\n 15\u2192 from typing import Any\n 16\u2192 \n 17\u2192 import httpx\n 18\u2192 \n 19\u2192 from goz.config import Config, DEFAULT_ZAI_BASE_URL\n 20\u2192 \n 21\u2192 logger = logging.getLogger(__name__)\n 22\u2192 \n 23\u2192 # The monitor API uses a different base than the Anthropic-compatible one.\n 24\u2192 _MONITOR_BASE = \"https://api.z.ai/api/monitor\"\n 25\u2192 \n 26\u2192 \n 27\u2192 @dataclass\n 28\u2192 class QuotaLimitInfo:\n 29\u2192     \"\"\"Parsed response from the quota/limit endpoint.\"\"\"\n 30\u2192 \n 31\u2192     quota_limit: int = 0\n 32\u2192     quota_remaining: int = 0\n 33\u2192     quota_used: int = 0\n 34\u2192     reset_at: str | None = None\n 35\u2192 \n 36\u2192     def usage_percent(self) -> float:\n 37\u2192         if self.quota_limit <= 0:\n 38\u2192             return 0.0\n 39\u2192         return (self.quota_used / self.quota_limit) * 100.0\n 40\u2192 \n 41\u2192 \n 42\u2192 @dataclass\n 43\u2192 class ModelUsageAggregate:\n 44\u2192     \"\"\"Parsed response from the model-usage endpoint.\"\"\"\n 45\u2192 \n 46\u2192     model: str = \"\"\n 47\u2192     input_tokens: int = 0\n 48\u2192     output_tokens: int = 0\n 49\u2192     total_tokens: int = 0\n 50\u2192     period: str = \"\"  # e.g. \"7d\", \"30d\"\n 51\u2192 \n 52\u2192 \n 53\u2192 @dataclass\n 54\u2192 class QuotaDashboard:\n 55\u2192     \"\"\"Combined quota and usage data for the ``goz usage`` display.\"\"\"\n 56\u2192 \n 57\u2192     quota: QuotaLimitInfo | None = None\n 58\u2192     aggregates_7d: list[ModelUsageAggregate] | None = None\n 59\u2192     aggregates_30d: list[ModelUsageAggregate] | None = None\n 60\u2192     error: str | None = None\n 61\u2192 \n 62\u2192 \n 63\u2192 class QuotaClient:\n 64\u2192     \"\"\"Client for the Z.AI monitor/usage API.\"\"\"\n 65\u2192 \n 66\u2192     def __init__(self, config: Config | None = None) -> None:\n 67\u2192         if config is None:\n 68\u2192             from goz.config import load_config\n 69\u2192             config = load_config()\n 70\u2192         self.config = config\n 71\u2192         self._headers = {\n 72\u2192             \"Authorization\": f\"Bearer {config.zai_token}\",\n 73\u2192             \"Accept\": \"application/json\",\n 74\u2192         }\n 75\u2192 \n 76\u2192     async def _get(self, path: str) -> dict[str, Any]:\n 77\u2192         \"\"\"Make an authenticated GET request to the monitor API.\"\"\"\n 78\u2192         url = f\"{_MONITOR_BASE}/{path.lstrip('/')}\"\n 79\u2192         async with httpx.AsyncClient(timeout=15.0) as client:\n 80\u2192             resp = await client.get(url, headers=self._headers)\n 81\u2192             resp.raise_for_status()\n 82\u2192             return resp.json()\n 83\u2192 \n 84\u2192     async def get_quota_limit(self) -> QuotaLimitInfo:\n 85\u2192         \"\"\"Fetch 5-hour quota limit and remaining tokens.\n 86\u2192 \n 87\u2192         Calls ``api.z.ai/api/monitor/usage/quota/limit``.\n 88\u2192         \"\"\"\n 89\u2192         try:\n 90\u2192             data = await self._get(\"usage/quota/limit\")\n 91\u2192             # The response shape may vary; handle common patterns.\n 92\u2192             if isinstance(data, dict):\n 93\u2192                 return QuotaLimitInfo(\n 94\u2192                     quota_limit=data.get(\"quota_limit\", data.get(\"limit\", 0)),\n 95\u2192                     quota_remaining=data.get(\"quota_remaining\", data.get(\"remaining\", 0)),\n 96\u2192                     quota_used=data.get(\"quota_used\", data.get(\"used\", 0)),\n 97\u2192                     reset_at=data.get(\"reset_at\", data.get(\"resets_at\")),\n 98\u2192                 )\n 99\u2192         except httpx.HTTPStatusError as exc:\n100\u2192             logger.warning(\"Quota limit request failed: %s\", exc)\n101\u2192         except Exception as exc:\n102\u2192             logger.warning(\"Quota limit request error: %s\", exc)\n103\u2192         return QuotaLimitInfo()\n104\u2192 \n105\u2192     async def get_model_usage(self) -> dict[str, list[ModelUsageAggregate]]:\n106\u2192         \"\"\"Fetch model usage aggregates.\n107\u2192 \n108\u2192         Calls ``api.z.ai/api/monitor/usage/model-usage``.\n109\u2192 \n110\u2192         Returns:\n111\u2192             A dict with ``\"7d\"`` and ``\"30d\"`` keys mapping to lists of\n112\u2192             :class:`ModelUsageAggregate`.\n113\u2192         \"\"\"\n114\u2192         result: dict[str, list[ModelUsageAggregate]] = {\"7d\": [], \"30d\": []}\n115\u2192         try:\n116\u2192             data = await self._get(\"usage/model-usage\")\n117\u2192             if isinstance(data, list):\n118\u2192                 for entry in data:\n119\u2192                     agg = ModelUsageAggregate(\n120\u2192                         model=entry.get(\"model\", entry.get(\"model_id\", \"\")),\n121\u2192                         input_tokens=entry.get(\"input_tokens\", 0),\n122\u2192                         output_tokens=entry.get(\"output_tokens\", 0),\n123\u2192                         total_tokens=entry.get(\"total_tokens\", entry.get(\"input_tokens\", 0) + entry.get(\"output_tokens\", 0)),\n124\u2192                         period=entry.get(\"period\", \"\"),\n125\u2192                     )\n126\u2192                     period = agg.period.lower() if agg.period else \"\"\n127\u2192                     if \"30\" in period:\n128\u2192                         result[\"30d\"].append(agg)\n129\u2192                     else:\n130\u2192                         result[\"7d\"].append(agg)\n131\u2192             elif isinstance(data, dict):\n132\u2192                 for period_key, entries in data.items():\n133\u2192                     key = \"30d\" if \"30\" in str(period_key).lower() else \"7d\"\n134\u2192                     if isinstance(entries, list):\n135\u2192                         for entry in entries:\n136\u2192                             agg = ModelUsageAggregate(\n137\u2192                                 model=entry.get(\"model\", entry.get(\"model_id\", \"\")),\n138\u2192                                 input_tokens=entry.get(\"input_tokens\", 0),\n139\u2192                                 output_tokens=entry.get(\"output_tokens\", 0),\n140\u2192                                 total_tokens=entry.get(\"total_tokens\", entry.get(\"input_tokens\", 0) + entry.get(\"output_tokens\", 0)),\n141\u2192                                 period=str(period_key),\n142\u2192                             )\n143\u2192                             result[key].append(agg)\n144\u2192         except httpx.HTTPStatusError as exc:\n145\u2192             logger.warning(\"Model usage request failed: %s\", exc)\n146\u2192         except Exception as exc:\n147\u2192             logger.warning(\"Model usage request error: %s\", exc)\n148\u2192         return result\n149\u2192 \n150\u2192     async def get_dashboard(self) -> QuotaDashboard:\n151\u2192         \"\"\"Fetch all quota/usage data for the usage command display.\"\"\"\n152\u2192         quota = await self.get_quota_limit()\n153\u2192         usage = await self.get_model_usage()\n154\u2192         return QuotaDashboard(\n155\u2192             quota=quota,\n156\u2192             aggregates_7d=usage.get(\"7d\"),\n157\u2192             aggregates_30d=usage.get(\"30d\"),\n158\u2192         )", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_fee04b7ecf2a49c08f5f8e57", "name": "view_file", "input": {"file_path": "goz/api/errors.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/errors.py (220 lines)\n============================================================\n\n  1\u2192 \"\"\"Error types for Z.AI API client.\n  2\u2192 \n  3\u2192 These error types are used throughout the API client for consistent error handling.\n  4\u2192 \"\"\"\n  5\u2192 \n  6\u2192 from __future__ import annotations\n  7\u2192 \n  8\u2192 \n  9\u2192 \n 10\u2192 class ZaiError(Exception):\n 11\u2192     \"\"\"Base error class for all Z.AI API errors.\n 12\u2192 \n 13\u2192     Attributes:\n 14\u2192         message: Human-readable error message\n 15\u2192         code: Error code for programmatic handling\n 16\u2192         statusCode: HTTP status code (optional)\n 17\u2192         help: Helpful hint for resolving the error (optional)\n 18\u2192     \"\"\"\n 19\u2192 \n 20\u2192     def __init__(\n 21\u2192         self,\n 22\u2192         message: str,\n 23\u2192         code: str = \"ZAI_ERROR\",\n 24\u2192         statusCode: int | None = None,\n 25\u2192         help: str | None = None,\n 26\u2192     ) -> None:\n 27\u2192         \"\"\"Initialize ZaiError.\n 28\u2192 \n 29\u2192         Args:\n 30\u2192             message: Human-readable error message\n 31\u2192             code: Error code for programmatic handling\n 32\u2192             statusCode: HTTP status code (optional)\n 33\u2192             help: Helpful hint for resolving the error (optional)\n 34\u2192         \"\"\"\n 35\u2192         self.message = message\n 36\u2192         self.code = code\n 37\u2192         self.statusCode = statusCode\n 38\u2192         self.help = help\n 39\u2192         super().__init__(self.message)\n 40\u2192 \n 41\u2192     def __str__(self) -> str:\n 42\u2192         \"\"\"Return string representation showing error code and message.\"\"\"\n 43\u2192         return f\"[{self.code}] {self.message}\"\n 44\u2192 \n 45\u2192     def __repr__(self) -> str:\n 46\u2192         \"\"\"Return detailed string representation.\"\"\"\n 47\u2192         return (\n 48\u2192             f\"{self.__class__.__name__}(message={self.message!r}, code={self.code!r}, \"\n 49\u2192             f\"statusCode={self.statusCode!r}, help={self.help!r})\"\n 50\u2192         )\n 51\u2192 \n 52\u2192 \n 53\u2192 class AuthError(ZaiError):\n 54\u2192     \"\"\"Authentication/authorization error (401, 403).\n 55\u2192 \n 56\u2192     This error is raised when the API token is invalid, expired, or missing.\n 57\u2192     \"\"\"\n 58\u2192 \n 59\u2192     def __init__(self, message: str, statusCode: int = 401) -> None:\n 60\u2192         \"\"\"Initialize AuthError.\n 61\u2192 \n 62\u2192         Args:\n 63\u2192             message: Human-readable error message\n 64\u2192             statusCode: HTTP status code (default: 401)\n 65\u2192         \"\"\"\n 66\u2192         super().__init__(\n 67\u2192             message=message,\n 68\u2192             code=\"AUTH_ERROR\",\n 69\u2192             statusCode=statusCode,\n 70\u2192             help=\"Authentication failed. Check your API key in ~/.config/goz/config.json. \"\n 71\u2192             \"Run 'goz config set zai_token <your-token>' to update.\",\n 72\u2192         )\n 73\u2192 \n 74\u2192 \n 75\u2192 class ApiError(ZaiError):\n 76\u2192     \"\"\"General API error (4xx, 5xx responses).\n 77\u2192 \n 78\u2192     This error is raised for API errors that are not authentication-related.\n 79\u2192     \"\"\"\n 80\u2192 \n 81\u2192     def __init__(self, message: str, statusCode: int = 500) -> None:\n 82\u2192         \"\"\"Initialize ApiError.\n 83\u2192 \n 84\u2192         Args:\n 85\u2192             message: Human-readable error message\n 86\u2192             statusCode: HTTP status code (default: 500)\n 87\u2192         \"\"\"\n 88\u2192         super().__init__(\n 89\u2192             message=message,\n 90\u2192             code=\"API_ERROR\",\n 91\u2192             statusCode=statusCode,\n 92\u2192             help=self._default_help(statusCode),\n 93\u2192         )\n 94\u2192 \n 95\u2192     @staticmethod\n 96\u2192     def _default_help(status_code: int) -> str:\n 97\u2192         \"\"\"Return actionable guidance based on HTTP status code.\"\"\"\n 98\u2192         if status_code == 429:\n 99\u2192             return \"Rate limit hit. Wait a moment before retrying, or reduce request volume.\"\n100\u2192         if status_code >= 500:\n101\u2192             return \"The service is having problems. Retry shortly; if it persists, try again later.\"\n102\u2192         return \"Check the request input and try again.\"\n103\u2192 \n104\u2192 \n105\u2192 class NetworkError(ZaiError):\n106\u2192     \"\"\"Network connection error.\n107\u2192 \n108\u2192     This error is raised when the client cannot connect to the API server.\n109\u2192     \"\"\"\n110\u2192 \n111\u2192     def __init__(self, message: str) -> None:\n112\u2192         \"\"\"Initialize NetworkError.\n113\u2192 \n114\u2192         Args:\n115\u2192             message: Human-readable error message\n116\u2192         \"\"\"\n117\u2192         super().__init__(\n118\u2192             message=message,\n119\u2192             code=\"NETWORK_ERROR\",\n120\u2192             help=\"Network connection failed. Check your internet connection and try again.\",\n121\u2192         )\n122\u2192 \n123\u2192 \n124\u2192 class TimeoutError(ZaiError):\n125\u2192     \"\"\"Request timeout error.\n126\u2192 \n127\u2192     This error is raised when the API request takes too long to complete.\n128\u2192     \"\"\"\n129\u2192 \n130\u2192     def __init__(self, timeoutMs: int) -> None:\n131\u2192         \"\"\"Initialize TimeoutError.\n132\u2192 \n133\u2192         Args:\n134\u2192             timeoutMs: Timeout value in milliseconds\n135\u2192         \"\"\"\n136\u2192         super().__init__(\n137\u2192             message=f\"Request timed out after {timeoutMs}ms\",\n138\u2192             code=\"TIMEOUT_ERROR\",\n139\u2192             help=\"Try again or increase timeout with Z_AI_TIMEOUT env var\",\n140\u2192         )\n141\u2192 \n142\u2192 \n143\u2192 class ValidationError(ZaiError):\n144\u2192     \"\"\"Validation error for invalid input parameters.\n145\u2192 \n146\u2192     This error is raised when input validation fails, such as invalid URLs,\n147\u2192     invalid format values, or other parameter validation issues.\n148\u2192     \"\"\"\n149\u2192 \n150\u2192     def __init__(self, message: str) -> None:\n151\u2192         \"\"\"Initialize ValidationError.\n152\u2192 \n153\u2192         Args:\n154\u2192             message: Human-readable error message describing the validation failure\n155\u2192         \"\"\"\n156\u2192         super().__init__(\n157\u2192             message=message,\n158\u2192             code=\"VALIDATION_ERROR\",\n159\u2192             help=\"Check your input parameters and try again.\",\n160\u2192         )\n161\u2192 \n162\u2192 \n163\u2192 # Z.AI quota/rate-limit error codes\n164\u2192 QUOTA_ERROR_CODES = {\n165\u2192     1302: \"QuotaExceededError\",\n166\u2192     1305: \"RateLimitError\",\n167\u2192     1308: \"TokenBudgetExceededError\",\n168\u2192     1310: \"ConcurrentRequestLimitError\",\n169\u2192 }\n170\u2192 \n171\u2192 QUOTA_ERROR_DESCRIPTIONS = {\n172\u2192     1302: \"API quota exceeded. Your usage has reached the plan limit.\",\n173\u2192     1305: \"Rate limit hit. Too many requests in a short time window.\",\n174\u2192     1308: \"Token budget exceeded for this billing period.\",\n175\u2192     1310: \"Concurrent request limit reached. Wait for in-flight requests to finish.\",\n176\u2192 }\n177\u2192 \n178\u2192 QUOTA_ERROR_HELP = {\n179\u2192     1302: \"Check your usage with 'goz usage' and consider upgrading your plan.\",\n180\u2192     1305: \"Wait a moment before retrying, or reduce request volume.\",\n181\u2192     1308: \"Reduce token usage or wait for the next billing period to reset.\",\n182\u2192     1310: \"Wait for current requests to finish before sending new ones.\",\n183\u2192 }\n184\u2192 \n185\u2192 \n186\u2192 class QuotaError(ZaiError):\n187\u2192     \"\"\"Quota or rate-limit error from Z.AI (error codes 1302/1305/1308/1310).\n188\u2192 \n189\u2192     This error is raised when the Z.AI API returns a quota-related error code,\n190\u2192     indicating that usage limits have been exceeded.\n191\u2192     \"\"\"\n192\u2192 \n193\u2192     def __init__(self, message: str, zai_code: int = 1302, statusCode: int = 429) -> None:\n194\u2192         \"\"\"Initialize QuotaError.\n195\u2192 \n196\u2192         Args:\n197\u2192             message: Human-readable error message from the API\n198\u2192             zai_code: Z.AI-specific error code (1302, 1305, 1308, or 1310)\n199\u2192             statusCode: HTTP status code (typically 429)\n200\u2192         \"\"\"\n201\u2192         code_name = QUOTA_ERROR_CODES.get(zai_code, \"QUOTA_ERROR\")\n202\u2192         help_text = QUOTA_ERROR_HELP.get(zai_code, \"Check your usage with 'goz usage'.\")\n203\u2192         super().__init__(\n204\u2192             message=message,\n205\u2192             code=code_name,\n206\u2192             statusCode=statusCode,\n207\u2192             help=help_text,\n208\u2192         )\n209\u2192         self.zai_code = zai_code\n210\u2192 \n211\u2192 \n212\u2192 def is_quota_error(error: ZaiError) -> bool:\n213\u2192     \"\"\"Check if an error is a quota-related error (codes 1302/1305/1308/1310).\"\"\"\n214\u2192     if isinstance(error, QuotaError):\n215\u2192         return True\n216\u2192     # Also check if a generic error carries a quota code in its message\n217\u2192     for code in QUOTA_ERROR_CODES:\n218\u2192         if f\"[{code}]\" in str(error) or f\"code {code}\" in str(error).lower():\n219\u2192             return True\n220\u2192     return False", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_b6c18a828f4d4716a2c095a0", "name": "view_file", "input": {"file_path": "tests/test_usage_tracking.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/tests/test_usage_tracking.py (443 lines)\n============================================================\n\n  1\u2192 \"\"\"Tests for T-0008: Usage statistics and quota tracking.\n  2\u2192 \n  3\u2192 Acceptance criteria tested:\n  4\u2192 - chat_client.py extracts usage.input_tokens and usage.output_tokens from streaming events\n  5\u2192 - Per-turn token counts accumulated in session state via UsageAccumulator\n  6\u2192 - step_finish JSONL event includes tokens and cost\n  7\u2192 - goz usage command calls monitor endpoints\n  8\u2192 - Quota/rate limit errors are detected and reported clearly\n  9\u2192 \"\"\"\n 10\u2192 \n 11\u2192 from __future__ import annotations\n 12\u2192 \n 13\u2192 import io\n 14\u2192 import json\n 15\u2192 from unittest.mock import AsyncMock, MagicMock, patch\n 16\u2192 \n 17\u2192 import pytest\n 18\u2192 \n 19\u2192 from goz.agent.chat_client import (\n 20\u2192     ChatClient,\n 21\u2192     ContentBlockDelta,\n 22\u2192     ContentBlockStart,\n 23\u2192     ContentBlockStop,\n 24\u2192     MessageStart,\n 25\u2192     MessageStop,\n 26\u2192     UsageDelta,\n 27\u2192 )\n 28\u2192 from goz.agent.usage import UsageAccumulator, UsageSnapshot\n 29\u2192 from goz.api.errors import QuotaError, is_quota_error\n 30\u2192 from goz.cli.run import emit_step_finish_event, run_prompt_jsonl\n 31\u2192 from goz.config import Config\n 32\u2192 \n 33\u2192 \n 34\u2192 @pytest.fixture\n 35\u2192 def config() -> Config:\n 36\u2192     return Config(\n 37\u2192         zai_token=\"test-token\",\n 38\u2192         zai_base_url=\"https://api.test.com\",\n 39\u2192         chat_model=\"test-model\",\n 40\u2192         timeout=60,\n 41\u2192     )\n 42\u2192 \n 43\u2192 \n 44\u2192 class TestMessageStartUsageExtraction:\n 45\u2192     def test_message_start_carries_usage_fields(self):\n 46\u2192         ms = MessageStart(\n 47\u2192             id=\"msg_1\",\n 48\u2192             model=\"glm-5-turbo\",\n 49\u2192             usage_input_tokens=1500,\n 50\u2192             usage_cache_read=800,\n 51\u2192             usage_cache_creation=200,\n 52\u2192         )\n 53\u2192         assert ms.usage_input_tokens == 1500\n 54\u2192         assert ms.usage_cache_read == 800\n 55\u2192         assert ms.usage_cache_creation == 200\n 56\u2192 \n 57\u2192     def test_message_start_defaults_to_zero(self):\n 58\u2192         ms = MessageStart(id=\"msg_1\", model=\"test\")\n 59\u2192         assert ms.usage_input_tokens == 0\n 60\u2192         assert ms.usage_cache_read == 0\n 61\u2192         assert ms.usage_cache_creation == 0\n 62\u2192 \n 63\u2192     def test_convert_message_start_extracts_usage(self, config):\n 64\u2192         client = ChatClient(config)\n 65\u2192 \n 66\u2192         usage = MagicMock()\n 67\u2192         usage.input_tokens = 2000\n 68\u2192         usage.cache_read_input_tokens = 500\n 69\u2192         usage.cache_creation_input_tokens = 100\n 70\u2192 \n 71\u2192         msg = MagicMock()\n 72\u2192         msg.id = \"msg_abc\"\n 73\u2192         msg.model = \"glm-5-turbo\"\n 74\u2192         msg.usage = usage\n 75\u2192 \n 76\u2192         event = MagicMock()\n 77\u2192         event.type = \"message_start\"\n 78\u2192         event.message = msg\n 79\u2192 \n 80\u2192         chunk = client._convert_sse_event_to_chunk(event)\n 81\u2192         assert isinstance(chunk, MessageStart)\n 82\u2192         assert chunk.usage_input_tokens == 2000\n 83\u2192         assert chunk.usage_cache_read == 500\n 84\u2192         assert chunk.usage_cache_creation == 100\n 85\u2192 \n 86\u2192     def test_convert_message_start_handles_missing_usage(self, config):\n 87\u2192         client = ChatClient(config)\n 88\u2192 \n 89\u2192         msg = MagicMock()\n 90\u2192         msg.id = \"msg_abc\"\n 91\u2192         msg.model = \"glm-5-turbo\"\n 92\u2192         msg.usage = None\n 93\u2192 \n 94\u2192         event = MagicMock()\n 95\u2192         event.type = \"message_start\"\n 96\u2192         event.message = msg\n 97\u2192 \n 98\u2192         chunk = client._convert_sse_event_to_chunk(event)\n 99\u2192         assert isinstance(chunk, MessageStart)\n100\u2192         assert chunk.usage_input_tokens == 0\n101\u2192         assert chunk.usage_cache_read == 0\n102\u2192 \n103\u2192 \n104\u2192 class TestUsageDeltaChunk:\n105\u2192     def test_usage_delta_has_output_tokens(self):\n106\u2192         ud = UsageDelta(output_tokens=42)\n107\u2192         assert ud.output_tokens == 42\n108\u2192 \n109\u2192     def test_usage_delta_defaults_to_zero(self):\n110\u2192         ud = UsageDelta()\n111\u2192         assert ud.output_tokens == 0\n112\u2192 \n113\u2192     def test_convert_message_delta_extracts_output_tokens(self, config):\n114\u2192         client = ChatClient(config)\n115\u2192 \n116\u2192         event = MagicMock()\n117\u2192         event.type = \"message_delta\"\n118\u2192         event.usage = MagicMock()\n119\u2192         event.usage.output_tokens = 350\n120\u2192 \n121\u2192         chunk = client._convert_sse_event_to_chunk(event)\n122\u2192         assert isinstance(chunk, UsageDelta)\n123\u2192         assert chunk.output_tokens == 350\n124\u2192 \n125\u2192     def test_convert_message_delta_handles_missing_usage(self, config):\n126\u2192         client = ChatClient(config)\n127\u2192 \n128\u2192         event = MagicMock()\n129\u2192         event.type = \"message_delta\"\n130\u2192         event.usage = None\n131\u2192 \n132\u2192         chunk = client._convert_sse_event_to_chunk(event)\n133\u2192         assert isinstance(chunk, UsageDelta)\n134\u2192         assert chunk.output_tokens == 0\n135\u2192 \n136\u2192     def test_message_stop_carries_usage(self):\n137\u2192         ms = MessageStop(stop_reason=\"end_turn\", usage_output_tokens=500)\n138\u2192         assert ms.usage_output_tokens == 500\n139\u2192 \n140\u2192     def test_message_stop_defaults_to_zero(self):\n141\u2192         ms = MessageStop(stop_reason=\"end_turn\")\n142\u2192         assert ms.usage_output_tokens == 0\n143\u2192 \n144\u2192 \n145\u2192 class TestUsageAccumulator:\n146\u2192     def test_full_turn_accumulation(self):\n147\u2192         acc = UsageAccumulator()\n148\u2192         acc.begin_turn()\n149\u2192 \n150\u2192         class UsageStart:\n151\u2192             input_tokens = 1000\n152\u2192             cache_read_input_tokens = 200\n153\u2192             cache_creation_input_tokens = 50\n154\u2192 \n155\u2192         acc.apply_message_start(UsageStart())\n156\u2192 \n157\u2192         class UsageEnd:\n158\u2192             output_tokens = 500\n159\u2192 \n160\u2192         acc.apply_message_delta(UsageEnd())\n161\u2192 \n162\u2192         snap = acc.finalise_turn()\n163\u2192         assert snap.input_tokens == 1000\n164\u2192         assert snap.output_tokens == 500\n165\u2192         assert snap.cache_read_input_tokens == 200\n166\u2192         assert snap.cache_creation_input_tokens == 50\n167\u2192 \n168\u2192         assert acc.total_input_tokens == 1000\n169\u2192         assert acc.total_output_tokens == 500\n170\u2192         assert acc.turn_count == 1\n171\u2192 \n172\u2192     def test_multi_turn_accumulation(self):\n173\u2192         acc = UsageAccumulator()\n174\u2192 \n175\u2192         for i in range(3):\n176\u2192             acc.begin_turn()\n177\u2192 \n178\u2192             class UStart:\n179\u2192                 input_tokens = 100\n180\u2192                 cache_read_input_tokens = 0\n181\u2192                 cache_creation_input_tokens = 0\n182\u2192 \n183\u2192             acc.apply_message_start(UStart())\n184\u2192 \n185\u2192             class UDelta:\n186\u2192                 output_tokens = 50\n187\u2192 \n188\u2192             acc.apply_message_delta(UDelta())\n189\u2192             acc.finalise_turn()\n190\u2192 \n191\u2192         assert acc.turn_count == 3\n192\u2192         assert acc.total_input_tokens == 300\n193\u2192         assert acc.total_output_tokens == 150\n194\u2192 \n195\u2192     def test_snapshot_to_dict(self):\n196\u2192         snap = UsageSnapshot(\n197\u2192             input_tokens=100,\n198\u2192             output_tokens=50,\n199\u2192             cache_read_input_tokens=20,\n200\u2192             cache_creation_input_tokens=10,\n201\u2192         )\n202\u2192         d = snap.to_dict()\n203\u2192         assert d == {\"input\": 100, \"output\": 50, \"cache_read\": 20, \"cache_creation\": 10}\n204\u2192 \n205\u2192     def test_snapshot_cost_usd(self):\n206\u2192         snap = UsageSnapshot(input_tokens=1_000_000, output_tokens=1_000_000)\n207\u2192         cost = snap.cost_usd(model=\"claude-sonnet-4-20250514\")\n208\u2192         assert cost > 0\n209\u2192         assert abs(cost - 18.0) < 0.01\n210\u2192 \n211\u2192     def test_finalise_turn_empty(self):\n212\u2192         acc = UsageAccumulator()\n213\u2192         snap = acc.finalise_turn()\n214\u2192         assert snap.total_tokens() == 0\n215\u2192 \n216\u2192 \n217\u2192 class TestStepFinishWithUsage:\n218\u2192     def test_emit_step_finish_with_tokens_and_cost(self):\n219\u2192         stdout = io.StringIO()\n220\u2192         tokens = {\"input\": 1000, \"output\": 500, \"cache_creation\": 50, \"cache_read\": 200}\n221\u2192         emit_step_finish_event(stdout, \"session-1\", tokens=tokens, cost=0.015)\n222\u2192         event = json.loads(stdout.getvalue().strip())\n223\u2192         assert event[\"type\"] == \"step_finish\"\n224\u2192         assert event[\"part\"][\"tokens\"] == tokens\n225\u2192         assert event[\"part\"][\"cost\"] == 0.015\n226\u2192         assert event[\"part\"][\"session_id\"] == \"session-1\"\n227\u2192 \n228\u2192     def test_emit_step_finish_defaults(self):\n229\u2192         stdout = io.StringIO()\n230\u2192         emit_step_finish_event(stdout, \"session-2\")\n231\u2192         event = json.loads(stdout.getvalue().strip())\n232\u2192         assert event[\"part\"][\"tokens\"] == {\n233\u2192             \"input\": 0,\n234\u2192             \"output\": 0,\n235\u2192             \"cache_creation\": 0,\n236\u2192             \"cache_read\": 0,\n237\u2192         }\n238\u2192         assert event[\"part\"][\"cost\"] == 0.0\n239\u2192 \n240\u2192 \n241\u2192 class TestRunPromptJsonlWithUsage:\n242\u2192     @pytest.mark.asyncio\n243\u2192     async def test_step_finish_includes_real_usage(self, config, tmp_path):\n244\u2192         stream = [\n245\u2192             MessageStart(\n246\u2192                 id=\"msg_1\",\n247\u2192                 model=\"glm-5-turbo\",\n248\u2192                 usage_input_tokens=800,\n249\u2192                 usage_cache_read=100,\n250\u2192                 usage_cache_creation=50,\n251\u2192             ),\n252\u2192             ContentBlockStart(type=\"text\", index=0),\n253\u2192             ContentBlockDelta(type=\"text_delta\", index=0, text=\"Done\"),\n254\u2192             ContentBlockStop(index=0),\n255\u2192             UsageDelta(output_tokens=200),\n256\u2192             MessageStop(stop_reason=\"end_turn\"),\n257\u2192         ]\n258\u2192 \n259\u2192         class FakeClient:\n260\u2192             def __init__(self, *, config):\n261\u2192                 self.config = config\n262\u2192 \n263\u2192             def chat_completion(self, **kwargs):\n264\u2192                 async def gen():\n265\u2192                     for chunk in stream:\n266\u2192                         yield chunk\n267\u2192 \n268\u2192                 return gen()\n269\u2192 \n270\u2192         stdout = io.StringIO()\n271\u2192         exit_code = await run_prompt_jsonl(\n272\u2192             \"test prompt\",\n273\u2192             config=config,\n274\u2192             working_dir=str(tmp_path),\n275\u2192             stdout=stdout,\n276\u2192             chat_client=FakeClient(config=config),\n277\u2192         )\n278\u2192         assert exit_code == 0\n279\u2192         events = [json.loads(line) for line in stdout.getvalue().splitlines()]\n280\u2192         finish = events[-1]\n281\u2192         assert finish[\"type\"] == \"step_finish\"\n282\u2192         assert finish[\"part\"][\"tokens\"][\"input\"] == 800\n283\u2192         assert finish[\"part\"][\"tokens\"][\"output\"] == 200\n284\u2192         assert finish[\"part\"][\"tokens\"][\"cache_read\"] == 100\n285\u2192         assert finish[\"part\"][\"tokens\"][\"cache_creation\"] == 50\n286\u2192         assert finish[\"part\"][\"cost\"] > 0\n287\u2192 \n288\u2192 \n289\u2192 class TestQuotaErrorDetection:\n290\u2192     def test_quota_error_is_detected(self):\n291\u2192         err = QuotaError(\"exceeded\", zai_code=1302)\n292\u2192         assert is_quota_error(err)\n293\u2192         assert err.zai_code == 1302\n294\u2192 \n295\u2192     def test_all_quota_codes_detected(self):\n296\u2192         for code in (1302, 1305, 1308, 1310):\n297\u2192             err = QuotaError(\"test\", zai_code=code)\n298\u2192             assert is_quota_error(err)\n299\u2192 \n300\u2192     def test_non_quota_error_not_detected(self):\n301\u2192         from goz.api.errors import ApiError\n302\u2192 \n303\u2192         err = ApiError(\"regular error\")\n304\u2192         assert not is_quota_error(err)\n305\u2192 \n306\u2192     @pytest.mark.asyncio\n307\u2192     async def test_chat_client_raises_quota_error_for_zai_code(self, config):\n308\u2192         import anthropic\n309\u2192 \n310\u2192         client = ChatClient(config)\n311\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n312\u2192 \n313\u2192         mock_response = MagicMock()\n314\u2192         mock_response.status_code = 429\n315\u2192         mock_response.text = '{\"error\":{\"code\":1302,\"message\":\"Quota exceeded\"}}'\n316\u2192 \n317\u2192         with patch.object(client._client, \"messages\") as mock_messages:\n318\u2192 \n319\u2192             class ErrorCtx:\n320\u2192                 async def __aenter__(self):\n321\u2192                     raise anthropic.APIStatusError(\n322\u2192                         message=\"Quota exceeded\",\n323\u2192                         response=mock_response,\n324\u2192                         body={\"error\": {\"code\": 1302, \"message\": \"Quota exceeded\"}},\n325\u2192                     )\n326\u2192 \n327\u2192                 async def __aexit__(self, *a):\n328\u2192                     pass\n329\u2192 \n330\u2192             mock_messages.stream.side_effect = [ErrorCtx()]\n331\u2192             with pytest.raises(QuotaError) as exc_info:\n332\u2192                 async for _ in client.chat_completion(messages):\n333\u2192                     pass\n334\u2192             assert exc_info.value.zai_code == 1302\n335\u2192 \n336\u2192 \n337\u2192 class TestMonitorClient:\n338\u2192     @pytest.mark.asyncio\n339\u2192     async def test_fetch_quota_limit(self, config):\n340\u2192         from goz.api.monitor import MonitorClient\n341\u2192 \n342\u2192         client = MonitorClient(config=config)\n343\u2192         mock_resp = MagicMock()\n344\u2192         mock_resp.json.return_value = {\n345\u2192             \"data\": {\n346\u2192                 \"limit\": 500000,\n347\u2192                 \"used\": 200000,\n348\u2192                 \"remaining\": 300000,\n349\u2192                 \"window\": \"5h\",\n350\u2192             }\n351\u2192         }\n352\u2192         mock_resp.raise_for_status = MagicMock()\n353\u2192 \n354\u2192         with patch(\"goz.api.monitor.httpx.AsyncClient\") as mock_client_cls:\n355\u2192             mock_client = AsyncMock()\n356\u2192             mock_client.get = AsyncMock(return_value=mock_resp)\n357\u2192             mock_client.__aenter__ = AsyncMock(return_value=mock_client)\n358\u2192             mock_client.__aexit__ = AsyncMock()\n359\u2192             mock_client_cls.return_value = mock_client\n360\u2192 \n361\u2192             quota = await client.fetch_quota_limit()\n362\u2192 \n363\u2192         assert quota.limit == 500000\n364\u2192         assert quota.remaining == 300000\n365\u2192         assert quota.used == 200000\n366\u2192         assert quota.window_label == \"5h\"\n367\u2192 \n368\u2192     @pytest.mark.asyncio\n369\u2192     async def test_fetch_model_usage(self, config):\n370\u2192         from goz.api.monitor import MonitorClient\n371\u2192 \n372\u2192         client = MonitorClient(config=config)\n373\u2192         mock_resp = MagicMock()\n374\u2192         mock_resp.json.return_value = {\n375\u2192             \"data\": [\n376\u2192                 {\n377\u2192                     \"model\": \"glm-5-turbo\",\n378\u2192                     \"input_tokens\": 100000,\n379\u2192                     \"output_tokens\": 50000,\n380\u2192                     \"total_tokens\": 150000,\n381\u2192                     \"cost\": 1.25,\n382\u2192                     \"requests\": 42,\n383\u2192                 }\n384\u2192             ]\n385\u2192         }\n386\u2192         mock_resp.raise_for_status = MagicMock()\n387\u2192 \n388\u2192         with patch(\"goz.api.monitor.httpx.AsyncClient\") as mock_client_cls:\n389\u2192             mock_client = AsyncMock()\n390\u2192             mock_client.get = AsyncMock(return_value=mock_resp)\n391\u2192             mock_client.__aenter__ = AsyncMock(return_value=mock_client)\n392\u2192             mock_client.__aexit__ = AsyncMock()\n393\u2192             mock_client_cls.return_value = mock_client\n394\u2192 \n395\u2192             report = await client.fetch_model_usage(days=7)\n396\u2192 \n397\u2192         assert report.period_days == 7\n398\u2192         assert len(report.entries) == 1\n399\u2192         assert report.entries[0].model == \"glm-5-turbo\"\n400\u2192         assert report.entries[0].input_tokens == 100000\n401\u2192         assert report.entries[0].output_tokens == 50000\n402\u2192         assert report.entries[0].cost == 1.25\n403\u2192         assert report.entries[0].requests == 42\n404\u2192 \n405\u2192 \n406\u2192 class TestUsageCommand:\n407\u2192     @pytest.mark.asyncio\n408\u2192     async def test_cmd_usage_json_output(self, config, capsys):\n409\u2192         from goz.api.monitor import QuotaInfo, ModelUsageReport, ModelUsageEntry\n410\u2192         from goz.cli.usage import cmd_usage\n411\u2192 \n412\u2192         mock_monitor = MagicMock()\n413\u2192         mock_monitor.fetch_quota_limit = AsyncMock(\n414\u2192             return_value=QuotaInfo(limit=500000, remaining=300000, used=200000, window_label=\"5h\")\n415\u2192         )\n416\u2192         mock_monitor.fetch_model_usage = AsyncMock(\n417\u2192             side_effect=lambda days=7: ModelUsageReport(\n418\u2192                 period_days=days,\n419\u2192                 entries=[\n420\u2192                     ModelUsageEntry(\n421\u2192                         model=\"glm-5-turbo\",\n422\u2192                         input_tokens=100000,\n423\u2192                         output_tokens=50000,\n424\u2192                         total_tokens=150000,\n425\u2192                         cost=1.25,\n426\u2192                         requests=42,\n427\u2192                     )\n428\u2192                 ],\n429\u2192             )\n430\u2192         )\n431\u2192 \n432\u2192         with (\n433\u2192             patch(\"goz.cli.usage.load_config\", return_value=config),\n434\u2192             patch(\"goz.api.monitor.MonitorClient\", return_value=mock_monitor),\n435\u2192         ):\n436\u2192             await cmd_usage([\"--json\"])\n437\u2192 \n438\u2192         captured = capsys.readouterr()\n439\u2192         data = json.loads(captured.out)\n440\u2192         assert \"quota\" in data\n441\u2192         assert data[\"quota\"][\"remaining\"] == 300000\n442\u2192         assert \"7_day\" in data\n443\u2192         assert data[\"7_day\"][0][\"model\"] == \"glm-5-turbo\"", "is_error": false}}
