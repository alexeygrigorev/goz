{"type": "tool_use", "part": {"id": "call_dba170988053410ebb7ddd6c", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/chat_client.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/chat_client.py (530 lines)\n============================================================\n\n  1\u2192 \"\"\"Chat API Client for Z.AI (Issue 17).\n  2\u2192 \n  3\u2192 This module provides the ChatClient class for interacting with the Z.AI\n  4\u2192 chat API using the Anthropic SDK with tool calling support.\n  5\u2192 \n  6\u2192 Acceptance Criteria:\n  7\u2192 1. ChatClient class exists in goz/agent/chat_client.py\n  8\u2192 2. Uses existing Anthropic SDK (same as Vision API)\n  9\u2192 3. Uses config.zai_token and config.zai_base_url\n 10\u2192 4. chat_completion() method sends messages and returns async iterator\n 11\u2192 5. Supports tools parameter for function calling\n 12\u2192 6. Supports tool_choice parameter (\"auto\", \"any\")\n 13\u2192 7. Supports stream parameter (True/False)\n 14\u2192 8. Response chunks yield text deltas\n 15\u2192 9. Tool calls are properly formatted in stream\n 16\u2192 10. Errors raised as appropriate exceptions (AuthError, ApiError, etc.)\n 17\u2192 11. Timeout configurable via config\n 18\u2192 \n 19\u2192 T-0008 additions:\n 20\u2192 - MessageStart carries usage from message_start event\n 21\u2192 - UsageDelta chunk type carries usage from message_delta event\n 22\u2192 - QuotaError detection for Z.AI codes 1302/1305/1308/1310\n 23\u2192 \"\"\"\n 24\u2192 \n 25\u2192 import asyncio\n 26\u2192 import json\n 27\u2192 from dataclasses import dataclass\n 28\u2192 from typing import Any, AsyncIterator, Literal\n 29\u2192 \n 30\u2192 import anthropic\n 31\u2192 from anthropic import AsyncAnthropic\n 32\u2192 \n 33\u2192 from goz.api.errors import AuthError, ApiError, NetworkError, TimeoutError, ZaiError, QuotaError\n 34\u2192 from goz.config import Config\n 35\u2192 \n 36\u2192 \n 37\u2192 # Chunk types for streaming responses (from spec)\n 38\u2192 @dataclass\n 39\u2192 class ContentBlockStart:\n 40\u2192     \"\"\"Start of a content block in the stream.\n 41\u2192 \n 42\u2192     Attributes:\n 43\u2192         type: The type of content block (\"text\" or \"tool_use\")\n 44\u2192         index: The index of this content block\n 45\u2192         id: Tool call ID (only for tool_use type)\n 46\u2192         name: Tool name (only for tool_use type)\n 47\u2192     \"\"\"\n 48\u2192 \n 49\u2192     type: Literal[\"text\", \"tool_use\"]\n 50\u2192     index: int\n 51\u2192     id: str | None = None\n 52\u2192     name: str | None = None\n 53\u2192 \n 54\u2192 \n 55\u2192 @dataclass\n 56\u2192 class ContentBlockDelta:\n 57\u2192     \"\"\"Delta for a content block in the stream.\n 58\u2192 \n 59\u2192     Attributes:\n 60\u2192         type: The type of delta (\"text_delta\" or \"input_json_delta\")\n 61\u2192         index: The index of this content block\n 62\u2192         text: Text content (only for text_delta type)\n 63\u2192         partial_json: Partial JSON string (only for input_json_delta type)\n 64\u2192     \"\"\"\n 65\u2192 \n 66\u2192     type: Literal[\"text_delta\", \"input_json_delta\"]\n 67\u2192     index: int\n 68\u2192     text: str | None = None\n 69\u2192     partial_json: str | None = None\n 70\u2192 \n 71\u2192 \n 72\u2192 @dataclass\n 73\u2192 class ContentBlockStop:\n 74\u2192     \"\"\"End of a content block in the stream.\n 75\u2192 \n 76\u2192     Attributes:\n 77\u2192         index: The index of this content block\n 78\u2192     \"\"\"\n 79\u2192 \n 80\u2192     index: int\n 81\u2192 \n 82\u2192 \n 83\u2192 @dataclass\n 84\u2192 class MessageStart:\n 85\u2192     \"\"\"Start of the message.\n 86\u2192 \n 87\u2192     Attributes:\n 88\u2192         id: Message ID\n 89\u2192         model: Model name\n 90\u2192         usage_input_tokens: Input tokens from message_start.usage\n 91\u2192         usage_cache_read: Cache read tokens from message_start.usage\n 92\u2192         usage_cache_creation: Cache creation tokens from message_start.usage\n 93\u2192     \"\"\"\n 94\u2192 \n 95\u2192     id: str\n 96\u2192     model: str\n 97\u2192     usage_input_tokens: int = 0\n 98\u2192     usage_cache_read: int = 0\n 99\u2192     usage_cache_creation: int = 0\n100\u2192 \n101\u2192 \n102\u2192 @dataclass\n103\u2192 class MessageStop:\n104\u2192     \"\"\"End of the message.\n105\u2192 \n106\u2192     Attributes:\n107\u2192         stop_reason: Reason for stopping (\"end_turn\", \"max_tokens\", \"tool_use\")\n108\u2192         usage_output_tokens: Output tokens from message_delta.usage\n109\u2192     \"\"\"\n110\u2192 \n111\u2192     stop_reason: Literal[\"end_turn\", \"max_tokens\", \"tool_use\"]\n112\u2192     usage_output_tokens: int = 0\n113\u2192 \n114\u2192 \n115\u2192 @dataclass\n116\u2192 class UsageDelta:\n117\u2192     \"\"\"Usage data from message_delta event.\n118\u2192 \n119\u2192     Attributes:\n120\u2192         output_tokens: Output tokens generated so far\n121\u2192     \"\"\"\n122\u2192 \n123\u2192     output_tokens: int = 0\n124\u2192 \n125\u2192 \n126\u2192 # Union type for all chunk types\n127\u2192 Chunk = (\n128\u2192     ContentBlockStart\n129\u2192     | ContentBlockDelta\n130\u2192     | ContentBlockStop\n131\u2192     | MessageStart\n132\u2192     | MessageStop\n133\u2192     | UsageDelta\n134\u2192 )\n135\u2192 \n136\u2192 \n137\u2192 class ChatClient:\n138\u2192     \"\"\"Client for Z.AI Chat API with tool calling support.\n139\u2192 \n140\u2192     This client uses the Anthropic SDK to interact with the Z.AI chat API,\n141\u2192     supporting streaming responses, tool calling, and various generation\n142\u2192     parameters.\n143\u2192 \n144\u2192     Attributes:\n145\u2192         config: Configuration object containing API credentials and settings\n146\u2192         _client: Internal AsyncAnthropic client instance\n147\u2192     \"\"\"\n148\u2192 \n149\u2192     def __init__(self, config: Config | None = None) -> None:\n150\u2192         \"\"\"Initialize ChatClient.\n151\u2192 \n152\u2192         Args:\n153\u2192             config: Optional config object. If not provided, loads from default location.\n154\u2192 \n155\u2192         Acceptance Criteria:\n156\u2192         - Uses config.zai_token and config.zai_base_url (AC 3)\n157\u2192         - Uses AsyncAnthropic from existing SDK (AC 2)\n158\u2192         - Timeout is configurable via config (AC 11)\n159\u2192         \"\"\"\n160\u2192         if config is None:\n161\u2192             from goz.config import load_config\n162\u2192 \n163\u2192             config = load_config()\n164\u2192 \n165\u2192         self.config = config\n166\u2192 \n167\u2192         # Initialize async Anthropic client (same pattern as VisionClient)\n168\u2192         self._client = AsyncAnthropic(\n169\u2192             api_key=self.config.zai_token,\n170\u2192             base_url=self.config.zai_base_url,\n171\u2192             timeout=self.config.timeout,\n172\u2192         )\n173\u2192         self.max_retries = 2\n174\u2192         self.base_retry_delay = 1.0\n175\u2192 \n176\u2192     async def chat_completion(\n177\u2192         self,\n178\u2192         messages: list[dict],\n179\u2192         tools: list[dict] | None = None,\n180\u2192         tool_choice: Literal[\"auto\", \"any\", \"none\"] | dict = \"auto\",\n181\u2192         stream: bool = True,\n182\u2192         temperature: float | None = None,\n183\u2192         max_tokens: int | None = None,\n184\u2192     ) -> AsyncIterator[Chunk]:\n185\u2192         \"\"\"Stream chat completion with tool calling support.\n186\u2192 \n187\u2192         Args:\n188\u2192             messages: Chat history in Anthropic format\n189\u2192             tools: Tool definitions in Anthropic format (optional)\n190\u2192             tool_choice: How to select tools (\"auto\", \"any\", \"none\", or specific tool dict)\n191\u2192             stream: Whether to stream response (True) or wait for complete response (False)\n192\u2192             temperature: Generation temperature (uses config default if None)\n193\u2192             max_tokens: Max tokens in response (uses config default if None)\n194\u2192 \n195\u2192         Yields:\n196\u2192             Chunk objects from the API response\n197\u2192 \n198\u2192         Raises:\n199\u2192             AuthError: For 401/403 authentication failures\n200\u2192             ApiError: For other API errors (4xx, 5xx)\n201\u2192             NetworkError: For connection failures\n202\u2192             TimeoutError: For request timeouts\n203\u2192 \n204\u2192         Acceptance Criteria:\n205\u2192         - Returns async iterator (AC 4)\n206\u2192         - Supports tools parameter (AC 5)\n207\u2192         - Supports tool_choice parameter (AC 6)\n208\u2192         - Supports stream parameter (AC 7)\n209\u2192         - Response chunks yield text deltas (AC 8)\n210\u2192         - Tool calls properly formatted in stream (AC 9)\n211\u2192         - Errors raised as appropriate exceptions (AC 10)\n212\u2192         \"\"\"\n213\u2192         # Build request parameters\n214\u2192         params: dict = {\n215\u2192             \"model\": self.config.chat_model,\n216\u2192             \"messages\": messages,\n217\u2192         }\n218\u2192 \n219\u2192         # Add optional parameters\n220\u2192         if tools is not None:\n221\u2192             params[\"tools\"] = tools\n222\u2192 \n223\u2192         if tool_choice != \"auto\":\n224\u2192             params[\"tool_choice\"] = tool_choice\n225\u2192 \n226\u2192         if temperature is not None:\n227\u2192             params[\"temperature\"] = temperature\n228\u2192         else:\n229\u2192             params[\"temperature\"] = self.config.temperature\n230\u2192 \n231\u2192         if max_tokens is not None:\n232\u2192             params[\"max_tokens\"] = max_tokens\n233\u2192         else:\n234\u2192             params[\"max_tokens\"] = self.config.max_tokens\n235\u2192 \n236\u2192         timeout_ms = int(self.config.timeout * 1000)\n237\u2192 \n238\u2192         for attempt in range(self.max_retries + 1):\n239\u2192             try:\n240\u2192                 if stream:\n241\u2192                     async with self._client.messages.stream(**params) as response_stream:\n242\u2192                         async for event in response_stream:\n243\u2192                             chunk = self._convert_sse_event_to_chunk(event)\n244\u2192                             if chunk is not None:\n245\u2192                                 yield chunk\n246\u2192                 else:\n247\u2192                     response = await self._client.messages.create(**params)\n248\u2192                     async for chunk in self._response_to_chunks(response):\n249\u2192                         yield chunk\n250\u2192                 return\n251\u2192             except anthropic.AuthenticationError as e:\n252\u2192                 status_code = getattr(getattr(e, \"response\", None), \"status_code\", 401)\n253\u2192                 raise AuthError(\n254\u2192                     \"Authentication failed. Check your API token and try again.\",\n255\u2192                     statusCode=status_code,\n256\u2192                 ) from e\n257\u2192             except anthropic.APITimeoutError as e:\n258\u2192                 timeout_error = TimeoutError(timeoutMs=timeout_ms)\n259\u2192                 if attempt >= self.max_retries:\n260\u2192                     raise timeout_error from e\n261\u2192                 await self._sleep_before_retry(attempt)\n262\u2192             except anthropic.APIConnectionError as e:\n263\u2192                 network_error = NetworkError(\n264\u2192                     \"Connection failed while contacting the API. Check your network and retry.\"\n265\u2192                 )\n266\u2192                 if attempt >= self.max_retries:\n267\u2192                     raise network_error from e\n268\u2192                 await self._sleep_before_retry(attempt)\n269\u2192             except anthropic.APIStatusError as e:\n270\u2192                 status_code = getattr(e, \"status_code\", None) or getattr(\n271\u2192                     getattr(e, \"response\", None), \"status_code\", 500\n272\u2192                 )\n273\u2192                 if status_code in (401, 403):\n274\u2192                     raise AuthError(\n275\u2192                         \"Authentication failed. Check your API token and try again.\",\n276\u2192                         statusCode=status_code,\n277\u2192                     ) from e\n278\u2192 \n279\u2192                 zai_code = self._extract_zai_error_code(e)\n280\u2192                 if zai_code in (1302, 1305, 1308, 1310):\n281\u2192                     raise QuotaError(str(e), zai_code=zai_code, statusCode=status_code) from e\n282\u2192 \n283\u2192                 if status_code == 429:\n284\u2192                     api_error = ApiError(\n285\u2192                         \"Rate limit exceeded. Wait a moment and retry, or reduce request volume.\",\n286\u2192                         statusCode=status_code,\n287\u2192                     )\n288\u2192                 elif status_code >= 500:\n289\u2192                     api_error = ApiError(\n290\u2192                         \"Server error from the API. Retry shortly; the service may be degraded.\",\n291\u2192                         statusCode=status_code,\n292\u2192                     )\n293\u2192                 else:\n294\u2192                     api_error = ApiError(str(e), statusCode=status_code)\n295\u2192 \n296\u2192                 if attempt >= self.max_retries or status_code < 500 and status_code != 429:\n297\u2192                     raise api_error from e\n298\u2192                 await self._sleep_before_retry(attempt)\n299\u2192             except Exception as e:\n300\u2192                 raise ZaiError(f\"Unexpected error: {e}\") from e\n301\u2192 \n302\u2192     def _convert_sse_event_to_chunk(\n303\u2192         self, event: anthropic.types.RawMessageStreamEvent\n304\u2192     ) -> Chunk | None:\n305\u2192         \"\"\"Convert Anthropic SSE event to our Chunk type.\n306\u2192 \n307\u2192         Args:\n308\u2192             event: Raw SSE event from Anthropic SDK\n309\u2192 \n310\u2192         Returns:\n311\u2192             Chunk object or None if event type not handled\n312\u2192         \"\"\"\n313\u2192         event_type = event.type\n314\u2192 \n315\u2192         if event_type == \"message_start\":\n316\u2192             usage = getattr(event.message, \"usage\", None)\n317\u2192             input_tokens = getattr(usage, \"input_tokens\", 0) or 0\n318\u2192             cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n319\u2192             cache_creation = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n320\u2192             return MessageStart(\n321\u2192                 id=event.message.id,\n322\u2192                 model=event.message.model,\n323\u2192                 usage_input_tokens=input_tokens,\n324\u2192                 usage_cache_read=cache_read,\n325\u2192                 usage_cache_creation=cache_creation,\n326\u2192             )\n327\u2192 \n328\u2192         elif event_type == \"content_block_start\":\n329\u2192             content_block = event.content_block\n330\u2192             if content_block.type == \"text\":\n331\u2192                 return ContentBlockStart(\n332\u2192                     type=\"text\",\n333\u2192                     index=event.index,\n334\u2192                 )\n335\u2192             elif content_block.type == \"tool_use\":\n336\u2192                 return ContentBlockStart(\n337\u2192                     type=\"tool_use\",\n338\u2192                     index=event.index,\n339\u2192                     id=content_block.id,\n340\u2192                     name=content_block.name,\n341\u2192                 )\n342\u2192 \n343\u2192         elif event_type == \"content_block_delta\":\n344\u2192             delta = event.delta\n345\u2192             if delta.type == \"text_delta\":\n346\u2192                 return ContentBlockDelta(\n347\u2192                     type=\"text_delta\",\n348\u2192                     index=event.index,\n349\u2192                     text=delta.text,\n350\u2192                 )\n351\u2192             elif delta.type == \"input_json_delta\":\n352\u2192                 return ContentBlockDelta(\n353\u2192                     type=\"input_json_delta\",\n354\u2192                     index=event.index,\n355\u2192                     partial_json=delta.partial_json,\n356\u2192                 )\n357\u2192 \n358\u2192         elif event_type == \"content_block_stop\":\n359\u2192             return ContentBlockStop(index=event.index)\n360\u2192 \n361\u2192         elif event_type == \"message_delta\":\n362\u2192             usage = getattr(event, \"usage\", None)\n363\u2192             output_tokens = getattr(usage, \"output_tokens\", 0) or 0\n364\u2192             return UsageDelta(output_tokens=output_tokens)\n365\u2192 \n366\u2192         elif event_type == \"message_stop\":\n367\u2192             return MessageStop(stop_reason=event.message.stop_reason)\n368\u2192 \n369\u2192         # Return None for unhandled event types\n370\u2192         return None\n371\u2192 \n372\u2192     async def _response_to_chunks(self, response: anthropic.types.Message) -> AsyncIterator[Chunk]:\n373\u2192         \"\"\"Convert non-streaming response to chunk stream.\n374\u2192 \n375\u2192         Args:\n376\u2192             response: Complete response from messages.create()\n377\u2192 \n378\u2192         Yields:\n379\u2192             Chunk objects representing the response\n380\u2192         \"\"\"\n381\u2192         # Yield message start\n382\u2192         yield MessageStart(id=response.id, model=response.model)\n383\u2192 \n384\u2192         # Yield content blocks\n385\u2192         for index, block in enumerate(response.content):\n386\u2192             if block.type == \"text\":\n387\u2192                 yield ContentBlockStart(type=\"text\", index=index)\n388\u2192                 yield ContentBlockDelta(type=\"text_delta\", index=index, text=block.text)\n389\u2192                 yield ContentBlockStop(index=index)\n390\u2192 \n391\u2192             elif block.type == \"tool_use\":\n392\u2192                 yield ContentBlockStart(\n393\u2192                     type=\"tool_use\",\n394\u2192                     index=index,\n395\u2192                     id=block.id,\n396\u2192                     name=block.name,\n397\u2192                 )\n398\u2192                 # Yield the input JSON as a single delta\n399\u2192                 input_json = json.dumps(block.input)\n400\u2192                 yield ContentBlockDelta(\n401\u2192                     type=\"input_json_delta\",\n402\u2192                     index=index,\n403\u2192                     partial_json=input_json,\n404\u2192                 )\n405\u2192                 yield ContentBlockStop(index=index)\n406\u2192 \n407\u2192         # Yield message stop\n408\u2192         yield MessageStop(stop_reason=response.stop_reason)\n409\u2192 \n410\u2192     async def _sleep_before_retry(self, attempt: int) -> None:\n411\u2192         \"\"\"Sleep using exponential backoff before retrying.\"\"\"\n412\u2192         await asyncio.sleep(self.base_retry_delay * (2**attempt))\n413\u2192 \n414\u2192     @staticmethod\n415\u2192     def _extract_zai_error_code(exc: anthropic.APIStatusError) -> int | None:\n416\u2192         \"\"\"Try to extract a Z.AI numeric error code from an APIStatusError.\"\"\"\n417\u2192         try:\n418\u2192             body = getattr(exc, \"body\", None)\n419\u2192             if isinstance(body, dict):\n420\u2192                 code = body.get(\"error\", body).get(\"code\")\n421\u2192                 if isinstance(code, int):\n422\u2192                     return code\n423\u2192             resp = getattr(exc, \"response\", None)\n424\u2192             if resp is not None:\n425\u2192                 raw = getattr(resp, \"text\", \"\")\n426\u2192                 if raw:\n427\u2192                     data = json.loads(raw)\n428\u2192                     code = data.get(\"error\", data).get(\"code\")\n429\u2192                     if isinstance(code, int):\n430\u2192                         return code\n431\u2192         except (json.JSONDecodeError, AttributeError, TypeError):\n432\u2192             pass\n433\u2192         return None\n434\u2192 \n435\u2192     async def extract_tool_calls(\n436\u2192         self,\n437\u2192         chunks: list[Chunk],\n438\u2192     ) -> list[dict]:\n439\u2192         \"\"\"Extract tool calls from accumulated stream chunks.\n440\u2192 \n441\u2192         This method processes a list of chunks and extracts complete\n442\u2192         tool_call objects by accumulating partial_json deltas.\n443\u2192 \n444\u2192         Args:\n445\u2192             chunks: List of chunks from a stream\n446\u2192 \n447\u2192         Returns:\n448\u2192             List of tool_call dicts with id, name, and input keys\n449\u2192 \n450\u2192         Example:\n451\u2192             >>> chunks = []\n452\u2192             >>> async for chunk in client.chat_completion(messages, tools=tools):\n453\u2192             ...     chunks.append(chunk)\n454\u2192             >>> tool_calls = await client.extract_tool_calls(chunks)\n455\u2192         \"\"\"\n456\u2192         tool_calls: list[dict] = []\n457\u2192         current_tool: dict[str, Any] | None = None\n458\u2192         accumulated_json: list[str] = []\n459\u2192 \n460\u2192         for chunk in chunks:\n461\u2192             if isinstance(chunk, ContentBlockStart) and chunk.type == \"tool_use\":\n462\u2192                 # Start of a new tool call\n463\u2192                 current_tool = {\n464\u2192                     \"id\": chunk.id,\n465\u2192                     \"name\": chunk.name,\n466\u2192                     \"input\": {},\n467\u2192                 }\n468\u2192                 accumulated_json = []\n469\u2192 \n470\u2192             elif isinstance(chunk, ContentBlockDelta) and chunk.type == \"input_json_delta\":\n471\u2192                 # Accumulate partial JSON\n472\u2192                 if chunk.partial_json:\n473\u2192                     accumulated_json.append(chunk.partial_json)\n474\u2192 \n475\u2192             elif isinstance(chunk, ContentBlockStop) and current_tool is not None:\n476\u2192                 # End of current tool call - parse accumulated JSON\n477\u2192                 if accumulated_json:\n478\u2192                     try:\n479\u2192                         json_str = \"\".join(accumulated_json)\n480\u2192                         current_tool[\"input\"] = json.loads(json_str)\n481\u2192                     except json.JSONDecodeError:\n482\u2192                         # If JSON is incomplete, keep as string\n483\u2192                         current_tool[\"input\"] = {\"raw\": \"\".join(accumulated_json)}\n484\u2192 \n485\u2192                 tool_calls.append(current_tool)\n486\u2192                 current_tool = None\n487\u2192                 accumulated_json = []\n488\u2192 \n489\u2192         return tool_calls\n490\u2192 \n491\u2192     async def simple_chat(\n492\u2192         self,\n493\u2192         message: str,\n494\u2192         system_prompt: str | None = None,\n495\u2192     ) -> str:\n496\u2192         \"\"\"Simple chat without streaming or tool calling.\n497\u2192 \n498\u2192         This is a convenience method for basic chat interactions.\n499\u2192 \n500\u2192         Args:\n501\u2192             message: User message\n502\u2192             system_prompt: Optional system prompt\n503\u2192 \n504\u2192         Returns:\n505\u2192             Complete response text\n506\u2192         \"\"\"\n507\u2192         messages: list[dict] = [{\"role\": \"user\", \"content\": message}]\n508\u2192 \n509\u2192         params: dict = {\n510\u2192             \"model\": self.config.chat_model,\n511\u2192             \"messages\": messages,\n512\u2192             \"max_tokens\": self.config.max_tokens,\n513\u2192         }\n514\u2192 \n515\u2192         if system_prompt:\n516\u2192             params[\"system\"] = system_prompt\n517\u2192 \n518\u2192         try:\n519\u2192             response = await self._client.messages.create(**params)\n520\u2192             return response.content[0].text\n521\u2192         except anthropic.AuthenticationError as e:\n522\u2192             raise AuthError(str(e))\n523\u2192         except anthropic.APITimeoutError as e:\n524\u2192             raise TimeoutError(timeoutMs=int(self.config.timeout * 1000))\n525\u2192         except anthropic.APIConnectionError as e:\n526\u2192             raise NetworkError(str(e))\n527\u2192         except anthropic.APIStatusError as e:\n528\u2192             raise ApiError(str(e), statusCode=e.status_code)\n529\u2192         except Exception as e:\n530\u2192             raise ZaiError(f\"Unexpected error: {e}\")", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_68b4005b8238496faf038bcd", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/cli/run.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/cli/run.py (438 lines)\n============================================================\n\n  1\u2192 \"\"\"JSONL CLI runner for litehive-compatible one-shot agent execution.\"\"\"\n  2\u2192 \n  3\u2192 from __future__ import annotations\n  4\u2192 \n  5\u2192 import argparse\n  6\u2192 import asyncio\n  7\u2192 import json\n  8\u2192 import signal\n  9\u2192 import sys\n 10\u2192 import uuid\n 11\u2192 from dataclasses import dataclass\n 12\u2192 from datetime import datetime\n 13\u2192 from pathlib import Path\n 14\u2192 from typing import Any, TextIO\n 15\u2192 \n 16\u2192 from goz.agent.chat_client import (\n 17\u2192     ChatClient,\n 18\u2192     Chunk,\n 19\u2192     ContentBlockDelta,\n 20\u2192     ContentBlockStart,\n 21\u2192     ContentBlockStop,\n 22\u2192     MessageStart,\n 23\u2192     MessageStop,\n 24\u2192     UsageDelta,\n 25\u2192 )\n 26\u2192 from goz.agent.history import ChatHistory, ChatMessage, ToolCall\n 27\u2192 from goz.agent.sessions import Session, SessionManager\n 28\u2192 from goz.agent.usage import UsageAccumulator\n 29\u2192 from goz.agent.tools import (\n 30\u2192     BashTool,\n 31\u2192     CreateFileTool,\n 32\u2192     GlobTool,\n 33\u2192     GrepTool,\n 34\u2192     ReadTool,\n 35\u2192     RepoReadTool,\n 36\u2192     RepoSearchTool,\n 37\u2192     RepoTreeTool,\n 38\u2192     SearchTool,\n 39\u2192     StrReplaceEditorTool,\n 40\u2192     ToolRegistry,\n 41\u2192     ViewFileTool,\n 42\u2192 )\n 43\u2192 from goz.config import Config, load_config\n 44\u2192 \n 45\u2192 \n 46\u2192 MAX_ITERATIONS = 10\n 47\u2192 DEFAULT_AGENT_TYPE = \"engine\"\n 48\u2192 STAGE_RESULT_INSTRUCTION = \"\"\"\n 49\u2192 \n 50\u2192 End your final answer with:\n 51\u2192 STAGE_RESULT:\n 52\u2192 {\"verdict\":\"pass\",\"summary\":\"one-line summary\",\"files_changed\":[\"path/to/file\"],\"tests\":{\"added\":0,\"passing\":0},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\n 53\u2192 \n 54\u2192 Return valid JSON after STAGE_RESULT:. Include a verdict.\n 55\u2192 \"\"\".strip()\n 56\u2192 \n 57\u2192 \n 58\u2192 def _emit_event(event: dict[str, Any], stdout: TextIO) -> None:\n 59\u2192     stdout.write(json.dumps(event, ensure_ascii=True) + \"\\n\")\n 60\u2192     stdout.flush()\n 61\u2192 \n 62\u2192 \n 63\u2192 def emit_text_event(text: str, stdout: TextIO) -> None:\n 64\u2192     _emit_event({\"type\": \"text\", \"part\": {\"text\": text}}, stdout)\n 65\u2192 \n 66\u2192 \n 67\u2192 def emit_tool_use_event(\n 68\u2192     tool_call: dict[str, Any],\n 69\u2192     result: str,\n 70\u2192     stdout: TextIO,\n 71\u2192     *,\n 72\u2192     is_error: bool = False,\n 73\u2192 ) -> None:\n 74\u2192     _emit_event(\n 75\u2192         {\n 76\u2192             \"type\": \"tool_use\",\n 77\u2192             \"part\": {\n 78\u2192                 \"id\": tool_call[\"id\"],\n 79\u2192                 \"name\": tool_call[\"name\"],\n 80\u2192                 \"input\": tool_call[\"input\"],\n 81\u2192                 \"output\": result,\n 82\u2192                 \"is_error\": is_error,\n 83\u2192             },\n 84\u2192         },\n 85\u2192         stdout,\n 86\u2192     )\n 87\u2192 \n 88\u2192 \n 89\u2192 def emit_error_event(name: str, message: str, stdout: TextIO) -> None:\n 90\u2192     _emit_event(\n 91\u2192         {\n 92\u2192             \"type\": \"error\",\n 93\u2192             \"error\": {\n 94\u2192                 \"name\": name,\n 95\u2192                 \"data\": {\"message\": message},\n 96\u2192             },\n 97\u2192         },\n 98\u2192         stdout,\n 99\u2192     )\n100\u2192 \n101\u2192 \n102\u2192 def emit_step_finish_event(\n103\u2192     stdout: TextIO,\n104\u2192     session_id: str,\n105\u2192     *,\n106\u2192     tokens: dict[str, int] | None = None,\n107\u2192     cost: float = 0.0,\n108\u2192 ) -> None:\n109\u2192     _emit_event(\n110\u2192         {\n111\u2192             \"type\": \"step_finish\",\n112\u2192             \"part\": {\n113\u2192                 \"tokens\": tokens or {\"input\": 0, \"output\": 0, \"cache_creation\": 0, \"cache_read\": 0},\n114\u2192                 \"cost\": cost,\n115\u2192                 \"session_id\": session_id,\n116\u2192                 \"continuation\": {\"resume_session_id\": session_id},\n117\u2192             },\n118\u2192         },\n119\u2192         stdout,\n120\u2192     )\n121\u2192 \n122\u2192 \n123\u2192 @dataclass\n124\u2192 class RunSessionState:\n125\u2192     session_id: str\n126\u2192     created_at: datetime\n127\u2192     history: ChatHistory\n128\u2192     working_dir: str\n129\u2192     agent_type: str\n130\u2192     config: Config\n131\u2192     session_manager: SessionManager\n132\u2192     tool_registry: ToolRegistry\n133\u2192 \n134\u2192     async def save(self) -> Path:\n135\u2192         session = Session(\n136\u2192             id=self.session_id,\n137\u2192             created_at=self.created_at,\n138\u2192             updated_at=datetime.now(),\n139\u2192             working_directory=self.working_dir,\n140\u2192             messages=list(self.history.messages),\n141\u2192             model=self.config.chat_model,\n142\u2192             agent_type=self.agent_type,\n143\u2192             config_snapshot=self.config.model_dump() if hasattr(self.config, \"model_dump\") else {},\n144\u2192             tool_state=_serialize_tool_state(self.tool_registry, self.working_dir),\n145\u2192         )\n146\u2192         return await self.session_manager.save(session)\n147\u2192 \n148\u2192 \n149\u2192 def _serialize_tool_state(tool_registry: ToolRegistry, working_dir: str) -> dict[str, Any]:\n150\u2192     return {\n151\u2192         \"working_directory\": working_dir,\n152\u2192         \"tools\": {\n153\u2192             tool.name: {\n154\u2192                 \"working_dir\": getattr(tool, \"working_dir\", None),\n155\u2192             }\n156\u2192             for tool in tool_registry.list_all()\n157\u2192         },\n158\u2192     }\n159\u2192 \n160\u2192 \n161\u2192 def build_default_tool_registry(config: Config, working_dir: str) -> ToolRegistry:\n162\u2192     \"\"\"Create the default tool set for one-shot CLI runs.\"\"\"\n163\u2192     registry = ToolRegistry()\n164\u2192     registry.register(BashTool(working_dir=working_dir))\n165\u2192     registry.register(ViewFileTool(working_dir=working_dir))\n166\u2192     registry.register(CreateFileTool(working_dir=working_dir))\n167\u2192     registry.register(StrReplaceEditorTool(working_dir=working_dir))\n168\u2192     registry.register(GlobTool(working_dir=working_dir))\n169\u2192     registry.register(GrepTool(working_dir=working_dir))\n170\u2192     registry.register(SearchTool(config))\n171\u2192     registry.register(ReadTool(config))\n172\u2192     registry.register(RepoSearchTool(config))\n173\u2192     registry.register(RepoTreeTool(config))\n174\u2192     registry.register(RepoReadTool(config))\n175\u2192     return registry\n176\u2192 \n177\u2192 \n178\u2192 def _build_prompt(user_prompt: str) -> str:\n179\u2192     return f\"{user_prompt.rstrip()}\\n\\n{STAGE_RESULT_INSTRUCTION}\"\n180\u2192 \n181\u2192 \n182\u2192 def _parse_tool_calls(chunks: list[Chunk]) -> list[dict[str, Any]]:\n183\u2192     tool_calls: list[dict[str, Any]] = []\n184\u2192     tool_calls_by_index: dict[int, dict[str, Any]] = {}\n185\u2192 \n186\u2192     for chunk in chunks:\n187\u2192         if isinstance(chunk, ContentBlockStart) and chunk.type == \"tool_use\":\n188\u2192             tool_calls_by_index[chunk.index] = {\n189\u2192                 \"id\": chunk.id or \"\",\n190\u2192                 \"name\": chunk.name or \"\",\n191\u2192                 \"input_json\": [],\n192\u2192             }\n193\u2192         elif isinstance(chunk, ContentBlockDelta) and chunk.type == \"input_json_delta\":\n194\u2192             block = tool_calls_by_index.get(chunk.index)\n195\u2192             if block is not None and chunk.partial_json:\n196\u2192                 block[\"input_json\"].append(chunk.partial_json)\n197\u2192         elif isinstance(chunk, ContentBlockStop):\n198\u2192             block = tool_calls_by_index.get(chunk.index)\n199\u2192             if block is None:\n200\u2192                 continue\n201\u2192             input_text = \"\".join(block.pop(\"input_json\"))\n202\u2192             try:\n203\u2192                 parsed_input = json.loads(input_text) if input_text else {}\n204\u2192             except json.JSONDecodeError:\n205\u2192                 parsed_input = {\"raw\": input_text}\n206\u2192             tool_calls.append(\n207\u2192                 {\n208\u2192                     \"id\": block[\"id\"],\n209\u2192                     \"name\": block[\"name\"],\n210\u2192                     \"input\": parsed_input,\n211\u2192                 }\n212\u2192             )\n213\u2192 \n214\u2192     return tool_calls\n215\u2192 \n216\u2192 \n217\u2192 async def _execute_tool_call(\n218\u2192     tool_registry: ToolRegistry, tool_call: dict[str, Any]\n219\u2192 ) -> tuple[str, bool]:\n220\u2192     tool = tool_registry.get(tool_call[\"name\"])\n221\u2192     if tool is None:\n222\u2192         return f\"Tool not found: {tool_call['name']}\", True\n223\u2192 \n224\u2192     try:\n225\u2192         result = await asyncio.wait_for(tool.execute(**tool_call[\"input\"]), timeout=300)\n226\u2192     except asyncio.TimeoutError:\n227\u2192         return f\"Tool {tool_call['name']} timed out after 300 seconds\", True\n228\u2192     except Exception as exc:\n229\u2192         return f\"Tool {tool_call['name']} failed: {exc}\", True\n230\u2192 \n231\u2192     return str(result), False\n232\u2192 \n233\u2192 \n234\u2192 async def run_prompt_jsonl(\n235\u2192     prompt: str,\n236\u2192     *,\n237\u2192     config: Config,\n238\u2192     working_dir: str,\n239\u2192     stdout: TextIO | None = None,\n240\u2192     tool_registry: ToolRegistry | None = None,\n241\u2192     chat_client: ChatClient | None = None,\n242\u2192     resume_session_id: str | None = None,\n243\u2192     session_dir: Path | None = None,\n244\u2192 ) -> int:\n245\u2192     \"\"\"Execute one agent prompt and emit JSONL events.\"\"\"\n246\u2192     stdout = stdout or sys.stdout\n247\u2192     session_manager = SessionManager(session_dir=session_dir)\n248\u2192     session: Session | None = None\n249\u2192     if resume_session_id is not None:\n250\u2192         session = await session_manager.load(resume_session_id)\n251\u2192         working_dir = session.working_directory\n252\u2192 \n253\u2192     history = ChatHistory(messages=list(session.messages) if session else None)\n254\u2192     registry = tool_registry or build_default_tool_registry(config, working_dir)\n255\u2192     client = chat_client or ChatClient(config=config)\n256\u2192     state = RunSessionState(\n257\u2192         session_id=resume_session_id or uuid.uuid4().hex,\n258\u2192         created_at=session.created_at if session else datetime.now(),\n259\u2192         history=history,\n260\u2192         working_dir=working_dir,\n261\u2192         agent_type=session.agent_type if session else DEFAULT_AGENT_TYPE,\n262\u2192         config=config,\n263\u2192         session_manager=session_manager,\n264\u2192         tool_registry=registry,\n265\u2192     )\n266\u2192 \n267\u2192     if prompt:\n268\u2192         history.add(ChatMessage(role=\"user\", content=_build_prompt(prompt)))\n269\u2192 \n270\u2192     loop = asyncio.get_running_loop()\n271\u2192     interrupted_by: dict[str, str | None] = {\"signal\": None}\n272\u2192     current_task = asyncio.current_task()\n273\u2192 \n274\u2192     async def _handle_interrupt(signame: str) -> None:\n275\u2192         interrupted_by[\"signal\"] = signame\n276\u2192         await state.save()\n277\u2192         if current_task is not None:\n278\u2192             current_task.cancel()\n279\u2192 \n280\u2192     for signum in (signal.SIGTERM, signal.SIGINT):\n281\u2192         try:\n282\u2192             loop.add_signal_handler(\n283\u2192                 signum,\n284\u2192                 lambda current_signum=signum: asyncio.create_task(\n285\u2192                     _handle_interrupt(signal.Signals(current_signum).name)\n286\u2192                 ),\n287\u2192             )\n288\u2192         except (NotImplementedError, RuntimeError):\n289\u2192             continue\n290\u2192 \n291\u2192     try:\n292\u2192         usage_acc = UsageAccumulator()\n293\u2192         for _ in range(MAX_ITERATIONS):\n294\u2192             chunks: list[Chunk] = []\n295\u2192             assistant_chunks: list[str] = []\n296\u2192             usage_acc.begin_turn()\n297\u2192 \n298\u2192             stream = client.chat_completion(\n299\u2192                 messages=history.to_api_format(),\n300\u2192                 tools=registry.to_openai_schema(),\n301\u2192                 tool_choice=\"auto\",\n302\u2192             )\n303\u2192 \n304\u2192             async for chunk in stream:\n305\u2192                 chunks.append(chunk)\n306\u2192                 if (\n307\u2192                     isinstance(chunk, ContentBlockDelta)\n308\u2192                     and chunk.type == \"text_delta\"\n309\u2192                     and chunk.text\n310\u2192                 ):\n311\u2192                     assistant_chunks.append(chunk.text)\n312\u2192                     emit_text_event(chunk.text, stdout)\n313\u2192                 elif isinstance(chunk, MessageStart):\n314\u2192                     usage_obj = type(\n315\u2192                         \"U\",\n316\u2192                         (),\n317\u2192                         {\n318\u2192                             \"input_tokens\": chunk.usage_input_tokens,\n319\u2192                             \"cache_read_input_tokens\": chunk.usage_cache_read,\n320\u2192                             \"cache_creation_input_tokens\": chunk.usage_cache_creation,\n321\u2192                         },\n322\u2192                     )()\n323\u2192                     usage_acc.apply_message_start(usage_obj)\n324\u2192                 elif isinstance(chunk, UsageDelta):\n325\u2192                     usage_obj = type(\"U\", (), {\"output_tokens\": chunk.output_tokens})()\n326\u2192                     usage_acc.apply_message_delta(usage_obj)\n327\u2192 \n328\u2192             snap = usage_acc.finalise_turn()\n329\u2192 \n330\u2192             tool_calls = _parse_tool_calls(chunks)\n331\u2192             if not tool_calls:\n332\u2192                 history.add(ChatMessage(role=\"assistant\", content=\"\".join(assistant_chunks)))\n333\u2192                 emit_step_finish_event(\n334\u2192                     stdout,\n335\u2192                     state.session_id,\n336\u2192                     tokens=snap.to_dict(),\n337\u2192                     cost=snap.cost_usd(model=config.chat_model),\n338\u2192                 )\n339\u2192                 return 0\n340\u2192 \n341\u2192             history.add(\n342\u2192                 ChatMessage(\n343\u2192                     role=\"assistant\",\n344\u2192                     content=\"\".join(assistant_chunks),\n345\u2192                     tool_calls=[\n346\u2192                         ToolCall(\n347\u2192                             id=tool_call[\"id\"],\n348\u2192                             name=tool_call[\"name\"],\n349\u2192                             input=tool_call[\"input\"],\n350\u2192                         )\n351\u2192                         for tool_call in tool_calls\n352\u2192                     ],\n353\u2192                 )\n354\u2192             )\n355\u2192 \n356\u2192             for tool_call in tool_calls:\n357\u2192                 result, is_error = await _execute_tool_call(registry, tool_call)\n358\u2192                 emit_tool_use_event(tool_call, result, stdout, is_error=is_error)\n359\u2192                 history.add(\n360\u2192                     ChatMessage(\n361\u2192                         role=\"tool\",\n362\u2192                         content=result,\n363\u2192                         tool_result_id=tool_call[\"id\"],\n364\u2192                     )\n365\u2192                 )\n366\u2192     except asyncio.CancelledError:\n367\u2192         emit_error_event(\n368\u2192             \"Interrupted\", f\"Run interrupted by {interrupted_by['signal'] or 'signal'}\", stdout\n369\u2192         )\n370\u2192         return 1\n371\u2192     finally:\n372\u2192         for signum in (signal.SIGTERM, signal.SIGINT):\n373\u2192             try:\n374\u2192                 loop.remove_signal_handler(signum)\n375\u2192             except (NotImplementedError, RuntimeError):\n376\u2192                 continue\n377\u2192         await state.save()\n378\u2192 \n379\u2192     emit_error_event(\"MaxIterationsExceeded\", f\"Exceeded {MAX_ITERATIONS} agent iterations\", stdout)\n380\u2192     return 1\n381\u2192 \n382\u2192 \n383\u2192 async def cmd_run(args: list[str]) -> None:\n384\u2192     \"\"\"Handle the `goz run` command.\"\"\"\n385\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n386\u2192         print(\"\"\"Run command usage:\n387\u2192 \n388\u2192   goz run [options] <prompt>\n389\u2192 \n390\u2192 Options:\n391\u2192   --format, -f json   Output ExternalCLIAdapter-compatible JSONL (default: json)\n392\u2192   --dir DIR           Working directory for file and shell tools\n393\u2192   --model MODEL       Override chat model for this invocation\n394\u2192   --resume-session ID Resume a previously saved engine session\n395\u2192 \n396\u2192 Examples:\n397\u2192   goz run --format json \"Summarize this repo and report STAGE_RESULT.\"\n398\u2192   goz run --dir /tmp/project --model glm-5 \"Run pytest and explain failures.\"\n399\u2192   goz run --resume-session abc123 \"Continue with the next step.\"\n400\u2192 \"\"\")\n401\u2192         return\n402\u2192 \n403\u2192     parser = argparse.ArgumentParser(prog=\"goz run\", add_help=False)\n404\u2192     parser.add_argument(\"--format\", \"-f\", choices=[\"json\"], default=\"json\", help=\"Output format\")\n405\u2192     parser.add_argument(\"--dir\", dest=\"working_dir\", help=\"Working directory for the run\")\n406\u2192     parser.add_argument(\"--model\", help=\"Override chat model\")\n407\u2192     parser.add_argument(\n408\u2192         \"--resume-session\", dest=\"resume_session_id\", help=\"Resume a saved session by ID\"\n409\u2192     )\n410\u2192     parser.add_argument(\"prompt\", nargs=\"*\", help=\"Prompt to execute\")\n411\u2192     parsed = parser.parse_args(args)\n412\u2192 \n413\u2192     if not parsed.prompt and not parsed.resume_session_id:\n414\u2192         raise SystemExit(\"goz run requires a prompt unless --resume-session is provided\")\n415\u2192 \n416\u2192     try:\n417\u2192         config = load_config()\n418\u2192         if parsed.model:\n419\u2192             config = config.model_copy(update={\"chat_model\": parsed.model})\n420\u2192 \n421\u2192         working_dir = str(Path(parsed.working_dir or \".\").resolve())\n422\u2192         if parsed.working_dir and not Path(working_dir).exists():\n423\u2192             raise FileNotFoundError(f\"Working directory does not exist: {working_dir}\")\n424\u2192         if parsed.working_dir and not Path(working_dir).is_dir():\n425\u2192             raise NotADirectoryError(f\"Working directory is not a directory: {working_dir}\")\n426\u2192 \n427\u2192         exit_code = await run_prompt_jsonl(\n428\u2192             \" \".join(parsed.prompt),\n429\u2192             config=config,\n430\u2192             working_dir=working_dir,\n431\u2192             resume_session_id=parsed.resume_session_id,\n432\u2192         )\n433\u2192     except Exception as exc:\n434\u2192         emit_error_event(type(exc).__name__, str(exc), sys.stdout)\n435\u2192         sys.exit(1)\n436\u2192 \n437\u2192     if exit_code != 0:\n438\u2192         sys.exit(exit_code)", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_9cbcc178322d4f50aef68e1f", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/__main__.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/__main__.py (1031 lines)\n============================================================\n\n   1\u2192 \"\"\"Main entry point for the goz CLI.\"\"\"\n   2\u2192 \n   3\u2192 import asyncio\n   4\u2192 import json\n   5\u2192 import itertools\n   6\u2192 import sys\n   7\u2192 import threading\n   8\u2192 import time\n   9\u2192 from pathlib import Path\n  10\u2192 \n  11\u2192 from goz import __version__\n  12\u2192 \n  13\u2192 \n  14\u2192 def _show_thinking_animation(stop_event: threading.Event) -> None:\n  15\u2192     \"\"\"Show a \"thinking\" animation in a separate thread.\n  16\u2192 \n  17\u2192     Args:\n  18\u2192         stop_event: Threading event to stop the animation\n  19\u2192     \"\"\"\n  20\u2192     animation = [\"|\", \"/\", \"-\", \"\\\\\"]\n  21\u2192     try:\n  22\u2192         for frame in itertools.cycle(animation):\n  23\u2192             if stop_event.is_set():\n  24\u2192                 break\n  25\u2192             # Print the animation frame with carriage return to overwrite\n  26\u2192             print(f\"\\r{frame} Thinking...\", end=\"\", flush=True)\n  27\u2192             time.sleep(0.1)\n  28\u2192     finally:\n  29\u2192         # Clear the animation line when done\n  30\u2192         print(\"\\r\" + \" \" * 20 + \"\\r\", end=\"\", flush=True)\n  31\u2192 \n  32\u2192 \n  33\u2192 def _print_json(data: object) -> None:\n  34\u2192     \"\"\"Print JSON with stable formatting.\"\"\"\n  35\u2192     print(json.dumps(data, indent=2, ensure_ascii=True))\n  36\u2192 \n  37\u2192 \n  38\u2192 def _load_json_value(raw_value: str) -> object:\n  39\u2192     \"\"\"Load JSON from an inline value or @file reference.\"\"\"\n  40\u2192     source = raw_value\n  41\u2192     if raw_value.startswith(\"@\"):\n  42\u2192         source = Path(raw_value[1:]).read_text()\n  43\u2192 \n  44\u2192     try:\n  45\u2192         return json.loads(source)\n  46\u2192     except json.JSONDecodeError as e:\n  47\u2192         raise ValueError(f\"Invalid JSON: {e}\") from e\n  48\u2192 \n  49\u2192 \n  50\u2192 def _load_call_arguments(json_arg: str | None, use_stdin: bool) -> dict:\n  51\u2192     \"\"\"Resolve call arguments from --json or --stdin.\"\"\"\n  52\u2192     if json_arg is not None and use_stdin:\n  53\u2192         raise ValueError(\"Use either --json or --stdin, not both\")\n  54\u2192 \n  55\u2192     if json_arg is None and not use_stdin:\n  56\u2192         return {}\n  57\u2192 \n  58\u2192     payload = _load_json_value(sys.stdin.read() if use_stdin else json_arg or \"{}\")\n  59\u2192     if not isinstance(payload, dict):\n  60\u2192         raise ValueError(\"Tool arguments must be a JSON object\")\n  61\u2192     return payload\n  62\u2192 \n  63\u2192 \n  64\u2192 async def cmd_vision(args: list[str]) -> None:\n  65\u2192     \"\"\"Handle the `goz vision` command.\n  66\u2192 \n  67\u2192     Usage:\n  68\u2192         goz vision <image> [prompt]           - Analyze image (default)\n  69\u2192         goz vision analyze <image> [prompt]   - General analysis\n  70\u2192         goz vision ui-to-code <image>         - Convert UI to code\n  71\u2192         goz vision extract-text <image>       - OCR text extraction\n  72\u2192         goz vision diagnose-error <image>     - Diagnose error screenshot\n  73\u2192         goz vision diagram <image>            - Explain diagram\n  74\u2192         goz vision chart <image>              - Analyze chart\n  75\u2192         goz vision diff <expected> <actual>   - Compare images\n  76\u2192         goz vision video <video> [prompt]     - Analyze video\n  77\u2192 \n  78\u2192     Options:\n  79\u2192         --no-stream     - Disable streaming (wait for full response)\n  80\u2192         --output <type> - Output type for ui-to-code (code, prompt, spec, description)\n  81\u2192         --language <lang> - Programming language for extract-text\n  82\u2192         --context <ctx> - Error context for diagnose-error\n  83\u2192         --type <type>   - Diagram type\n  84\u2192         --focus <focus> - Chart focus (trends, anomalies, comparisons, insights)\n  85\u2192 \n  86\u2192     Args:\n  87\u2192         args: Command arguments\n  88\u2192     \"\"\"\n  89\u2192 \n  90\u2192     # Check for help flag\n  91\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n  92\u2192         print(\"\"\"Vision command usage:\n  93\u2192 \n  94\u2192   goz vision <image> [prompt]           - Analyze image (default)\n  95\u2192   goz vision analyze <image> [prompt]   - General image analysis\n  96\u2192   goz vision ui-to-code <image>         - Convert UI to code\n  97\u2192   goz vision extract-text <image>       - Extract text (OCR)\n  98\u2192   goz vision diagnose-error <image>     - Diagnose error screenshot\n  99\u2192   goz vision diagram <image>            - Explain technical diagram\n 100\u2192   goz vision chart <image>              - Analyze data visualization\n 101\u2192   goz vision diff <expected> <actual>   - Compare two screenshots\n 102\u2192   goz vision video <video> [prompt]     - Analyze video content\n 103\u2192 \n 104\u2192 Options:\n 105\u2192   --no-stream           - Disable streaming output\n 106\u2192   --output <type>       - ui-to-code output (code, prompt, spec, description)\n 107\u2192   --language <lang>     - Programming language for extract-text\n 108\u2192   --context <ctx>       - Error context for diagnose-error\n 109\u2192   --type <type>         - Diagram type (flowchart, sequence, architecture, etc.)\n 110\u2192   --focus <focus>       - Chart focus (trends, anomalies, comparisons, insights)\n 111\u2192 \n 112\u2192 File constraints:\n 113\u2192   Images: 5MB max (JPG, PNG, JPEG)\n 114\u2192   Videos: 8MB max (MP4, MOV, M4V)\n 115\u2192 \"\"\")\n 116\u2192         return\n 117\u2192 \n 118\u2192     from goz.api.vision import VisionClient\n 119\u2192     from goz.config import load_config\n 120\u2192 \n 121\u2192     config = load_config()\n 122\u2192     client = VisionClient(config=config)\n 123\u2192 \n 124\u2192     # Parse flags and positional args\n 125\u2192     flags = {}\n 126\u2192     positional = []\n 127\u2192 \n 128\u2192     i = 0\n 129\u2192     while i < len(args):\n 130\u2192         arg = args[i]\n 131\u2192         if arg.startswith(\"--\"):\n 132\u2192             key = arg[2:]\n 133\u2192             # Check if next arg is a value (not a flag)\n 134\u2192             if i + 1 < len(args) and not args[i + 1].startswith(\"-\"):\n 135\u2192                 flags[key] = args[i + 1]\n 136\u2192                 i += 2\n 137\u2192             else:\n 138\u2192                 flags[key] = True\n 139\u2192                 i += 1\n 140\u2192         elif arg.startswith(\"-\") and len(arg) == 2:\n 141\u2192             key = arg[1:]\n 142\u2192             if i + 1 < len(args) and not args[i + 1].startswith(\"-\"):\n 143\u2192                 flags[key] = args[i + 1]\n 144\u2192                 i += 2\n 145\u2192             else:\n 146\u2192                 flags[key] = True\n 147\u2192                 i += 1\n 148\u2192         else:\n 149\u2192             positional.append(arg)\n 150\u2192             i += 1\n 151\u2192 \n 152\u2192     # Determine mode and source\n 153\u2192     mode = \"analyze\"  # Default mode\n 154\u2192     source1 = None\n 155\u2192     source2 = None\n 156\u2192     prompt = None\n 157\u2192 \n 158\u2192     # Check if first positional arg is a known subcommand\n 159\u2192     known_modes = {\n 160\u2192         \"analyze\",\n 161\u2192         \"ui-to-code\",\n 162\u2192         \"extract-text\",\n 163\u2192         \"diagnose-error\",\n 164\u2192         \"diagram\",\n 165\u2192         \"chart\",\n 166\u2192         \"diff\",\n 167\u2192         \"video\",\n 168\u2192     }\n 169\u2192 \n 170\u2192     if positional[0] in known_modes:\n 171\u2192         mode = positional[0]\n 172\u2192         source1 = positional[1] if len(positional) > 1 else None\n 173\u2192 \n 174\u2192         if mode == \"diff\":\n 175\u2192             source2 = positional[2] if len(positional) > 2 else None\n 176\u2192             prompt = positional[3] if len(positional) > 3 else None\n 177\u2192         else:\n 178\u2192             prompt = positional[2] if len(positional) > 2 else None\n 179\u2192     else:\n 180\u2192         # Old behavior: first arg is source\n 181\u2192         source1 = positional[0]\n 182\u2192         prompt = positional[1] if len(positional) > 1 else None\n 183\u2192 \n 184\u2192     # Validate we have a source\n 185\u2192     if not source1:\n 186\u2192         print(\"Error: Missing image/video source\", file=sys.stderr)\n 187\u2192         print(\"Run 'goz vision --help' for usage\", file=sys.stderr)\n 188\u2192         sys.exit(1)\n 189\u2192 \n 190\u2192     if mode == \"diff\" and not source2:\n 191\u2192         print(\"Error: diff mode requires two sources: <expected> <actual>\", file=sys.stderr)\n 192\u2192         sys.exit(1)\n 193\u2192 \n 194\u2192     # Build prompt based on mode\n 195\u2192     default_prompts = {\n 196\u2192         \"analyze\": \"Describe this image in detail.\",\n 197\u2192         \"ui-to-code\": \"Convert this UI to production-ready code.\",\n 198\u2192         \"extract-text\": \"Extract all text from this image.\",\n 199\u2192         \"diagnose-error\": \"Diagnose this error and suggest fixes.\",\n 200\u2192         \"diagram\": \"Explain this technical diagram.\",\n 201\u2192         \"chart\": \"Analyze this data visualization.\",\n 202\u2192         \"video\": \"Analyze this video content.\",\n 203\u2192     }\n 204\u2192 \n 205\u2192     effective_prompt = prompt or default_prompts.get(mode, \"Describe this image.\")\n 206\u2192 \n 207\u2192     # Enhance prompt with mode-specific options\n 208\u2192     output_type = flags.get(\"output\", \"code\")\n 209\u2192 \n 210\u2192     if mode == \"ui-to-code\" and output_type != \"code\":\n 211\u2192         if output_type == \"prompt\":\n 212\u2192             effective_prompt = (\n 213\u2192                 f\"{effective_prompt}\\n\\n\"\n 214\u2192                 f\"Provide a detailed prompt that would generate this UI, \"\n 215\u2192                 f\"including layout, components, styling, and functionality.\"\n 216\u2192             )\n 217\u2192         elif output_type == \"spec\":\n 218\u2192             effective_prompt = (\n 219\u2192                 f\"{effective_prompt}\\n\\n\"\n 220\u2192                 f\"Provide a technical specification including components, \"\n 221\u2192                 f\"props, state management, and styling approach.\"\n 222\u2192             )\n 223\u2192         elif output_type == \"description\":\n 224\u2192             effective_prompt = (\n 225\u2192                 f\"{effective_prompt}\\n\\n\"\n 226\u2192                 f\"Provide a detailed description of the UI layout, \"\n 227\u2192                 f\"components, colors, and interactions without generating code.\"\n 228\u2192             )\n 229\u2192 \n 230\u2192     if mode == \"extract-text\" and flags.get(\"language\"):\n 231\u2192         effective_prompt = (\n 232\u2192             f\"{effective_prompt}\\n\\n\"\n 233\u2192             f\"The content is in {flags['language']}. Preserve code syntax and formatting.\"\n 234\u2192         )\n 235\u2192 \n 236\u2192     if mode == \"diagnose-error\" and flags.get(\"context\"):\n 237\u2192         effective_prompt = (\n 238\u2192             f\"{effective_prompt}\\n\\n\"\n 239\u2192             f\"Context: {flags['context']}\\n\\n\"\n 240\u2192             f\"Consider this context when diagnosing the error.\"\n 241\u2192         )\n 242\u2192 \n 243\u2192     if mode == \"diagram\" and flags.get(\"type\"):\n 244\u2192         effective_prompt = (\n 245\u2192             f\"{effective_prompt}\\n\\nThis is a {flags['type']} diagram. Use appropriate terminology.\"\n 246\u2192         )\n 247\u2192 \n 248\u2192     if mode == \"chart\" and flags.get(\"focus\"):\n 249\u2192         focus_prompts = {\n 250\u2192             \"trends\": \"Focus on identifying trends and patterns over time.\",\n 251\u2192             \"anomalies\": \"Focus on identifying anomalies, outliers, and unusual data points.\",\n 252\u2192             \"comparisons\": \"Focus on comparing different data series and values.\",\n 253\u2192             \"insights\": \"Focus on extracting key insights and actionable conclusions.\",\n 254\u2192         }\n 255\u2192         focus_prompt = focus_prompts.get(flags[\"focus\"], \"\")\n 256\u2192         if focus_prompt:\n 257\u2192             effective_prompt = f\"{effective_prompt}\\n\\n{focus_prompt}\"\n 258\u2192 \n 259\u2192     # Determine if streaming\n 260\u2192     no_stream = flags.get(\"no-stream\", False)\n 261\u2192 \n 262\u2192     try:\n 263\u2192         if mode == \"diff\":\n 264\u2192             # For diff, analyze both images and compare\n 265\u2192             if no_stream:\n 266\u2192                 result1 = await client.analyze(source1, \"Describe this image in detail.\")\n 267\u2192                 result2 = await client.analyze(source2, \"Describe this image in detail.\")\n 268\u2192                 print(f\"Expected Image:\\n{result1}\\n\\n\")\n 269\u2192                 print(f\"Actual Image:\\n{result2}\\n\\n\")\n 270\u2192                 print(\"Note: Use the vision diff command for precise visual comparison.\")\n 271\u2192             else:\n 272\u2192                 print(\"Analyzing expected image...\", file=sys.stderr)\n 273\u2192                 async for chunk in client.analyze_stream(source1, \"Describe this image in detail.\"):\n 274\u2192                     print(chunk, end=\"\", flush=True)\n 275\u2192                 print(\"\\n\\nAnalyzing actual image...\", file=sys.stderr)\n 276\u2192                 async for chunk in client.analyze_stream(source2, \"Describe this image in detail.\"):\n 277\u2192                     print(chunk, end=\"\", flush=True)\n 278\u2192                 print(\"\\n\\nNote: Use the vision diff command for precise visual comparison.\")\n 279\u2192         else:\n 280\u2192             if no_stream:\n 281\u2192                 result = await client.analyze(source1, effective_prompt)\n 282\u2192                 print(result)\n 283\u2192             else:\n 284\u2192                 # Show \"thinking\" animation while waiting for first chunk\n 285\u2192                 import threading\n 286\u2192 \n 287\u2192                 stop_animation = threading.Event()\n 288\u2192                 animation_thread = threading.Thread(\n 289\u2192                     target=_show_thinking_animation, args=(stop_animation,), daemon=True\n 290\u2192                 )\n 291\u2192                 animation_thread.start()\n 292\u2192 \n 293\u2192                 # Stream response\n 294\u2192                 first_chunk = True\n 295\u2192                 async for chunk in client.analyze_stream(source1, effective_prompt):\n 296\u2192                     if first_chunk:\n 297\u2192                         # Stop animation on first chunk\n 298\u2192                         stop_animation.set()\n 299\u2192                         animation_thread.join(timeout=0.2)\n 300\u2192                         first_chunk = False\n 301\u2192                     print(chunk, end=\"\", flush=True)\n 302\u2192                 print()  # New line after streaming completes\n 303\u2192                 if first_chunk:\n 304\u2192                     # In case no chunks were received\n 305\u2192                     stop_animation.set()\n 306\u2192                     animation_thread.join(timeout=0.2)\n 307\u2192     except Exception as e:\n 308\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 309\u2192         sys.exit(1)\n 310\u2192 \n 311\u2192 \n 312\u2192 async def cmd_search(args: list[str]) -> None:\n 313\u2192     \"\"\"Handle the `goz search` command.\n 314\u2192 \n 315\u2192     Usage:\n 316\u2192         goz search <query> [options]\n 317\u2192 \n 318\u2192     Options:\n 319\u2192         --count, -c N       - Number of results (default: 10)\n 320\u2192         --domain, -d DOMAIN - Filter to domain\n 321\u2192         --recency, -r R     - Time filter (oneDay, oneWeek, oneMonth, oneYear, noLimit)\n 322\u2192 \n 323\u2192     Args:\n 324\u2192         args: Command arguments\n 325\u2192     \"\"\"\n 326\u2192     import argparse\n 327\u2192 \n 328\u2192     # Check for help\n 329\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 330\u2192         print(\"\"\"Search command usage:\n 331\u2192 \n 332\u2192   goz search <query> [options]\n 333\u2192 \n 334\u2192 Options:\n 335\u2192   --count, -c N         Number of results to return (default: 10)\n 336\u2192   --domain, -d DOMAIN   Filter results to specific domain\n 337\u2192   --recency, -r R       Time filter:\n 338\u2192                         - oneDay: Results from last 24 hours\n 339\u2192                         - oneWeek: Results from last week\n 340\u2192                         - oneMonth: Results from last month\n 341\u2192                         - oneYear: Results from last year\n 342\u2192                         - noLimit: No time restriction\n 343\u2192 \n 344\u2192 Examples:\n 345\u2192   goz search \"python async await\"\n 346\u2192   goz search \"climate change\" --count 5\n 347\u2192   goz search \"AI news\" --domain news.ycombinator.com --recency oneWeek\n 348\u2192 \"\"\")\n 349\u2192         return\n 350\u2192 \n 351\u2192     parser = argparse.ArgumentParser(prog=\"goz search\", add_help=False)\n 352\u2192     parser.add_argument(\"query\", help=\"Search query\")\n 353\u2192     parser.add_argument(\"--count\", \"-c\", type=int, help=\"Number of results\")\n 354\u2192     parser.add_argument(\"--domain\", \"-d\", help=\"Filter to domain\")\n 355\u2192     parser.add_argument(\n 356\u2192         \"--recency\",\n 357\u2192         \"-r\",\n 358\u2192         choices=[\"oneDay\", \"oneWeek\", \"oneMonth\", \"oneYear\", \"noLimit\"],\n 359\u2192         help=\"Time filter\",\n 360\u2192     )\n 361\u2192 \n 362\u2192     parsed = parser.parse_args(args)\n 363\u2192 \n 364\u2192     from goz.api.search import SearchClient\n 365\u2192     from goz.config import load_config\n 366\u2192 \n 367\u2192     config = load_config()\n 368\u2192     client = SearchClient(config=config)\n 369\u2192 \n 370\u2192     try:\n 371\u2192         results = await client.search(\n 372\u2192             query=parsed.query,\n 373\u2192             count=parsed.count,\n 374\u2192             domain_filter=parsed.domain,\n 375\u2192             recency_filter=parsed.recency,\n 376\u2192         )\n 377\u2192         for r in results:\n 378\u2192             print(f\"{r.rank}. {r.title}\")\n 379\u2192             print(f\"   {r.url}\")\n 380\u2192             if r.summary:\n 381\u2192                 print(f\"   {r.summary[:100]}...\")\n 382\u2192             print()\n 383\u2192     except Exception as e:\n 384\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 385\u2192         sys.exit(1)\n 386\u2192 \n 387\u2192 \n 388\u2192 async def cmd_read(args: list[str]) -> None:\n 389\u2192     \"\"\"Handle the `goz read` command.\n 390\u2192 \n 391\u2192     Usage:\n 392\u2192         goz read <url> [options]\n 393\u2192 \n 394\u2192     Options:\n 395\u2192         --format, -f FMT  - Output format (markdown, text)\n 396\u2192         --timeout, -t N   - Timeout in seconds (default: 20)\n 397\u2192 \n 398\u2192     Args:\n 399\u2192         args: Command arguments\n 400\u2192     \"\"\"\n 401\u2192     import argparse\n 402\u2192 \n 403\u2192     # Check for help\n 404\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 405\u2192         print(\"\"\"Read command usage:\n 406\u2192 \n 407\u2192   goz read <url> [options]\n 408\u2192 \n 409\u2192 Options:\n 410\u2192   --format, -f FMT    Output format:\n 411\u2192                       - markdown: GitHub Flavored Markdown (default)\n 412\u2192                       - text: Plain text\n 413\u2192   --timeout, -t N     Request timeout in seconds (default: 20)\n 414\u2192 \n 415\u2192 Examples:\n 416\u2192   goz read https://example.com\n 417\u2192   goz read https://example.com --format text\n 418\u2192   goz read https://example.com --timeout 30\n 419\u2192 \"\"\")\n 420\u2192         return\n 421\u2192 \n 422\u2192     parser = argparse.ArgumentParser(prog=\"goz read\", add_help=False)\n 423\u2192     parser.add_argument(\"url\", help=\"URL to read\")\n 424\u2192     parser.add_argument(\n 425\u2192         \"--format\", \"-f\", choices=[\"markdown\", \"text\"], default=\"markdown\", help=\"Output format\"\n 426\u2192     )\n 427\u2192     parser.add_argument(\"--timeout\", \"-t\", type=int, help=\"Timeout in seconds\")\n 428\u2192 \n 429\u2192     parsed = parser.parse_args(args)\n 430\u2192 \n 431\u2192     from goz.api.reader import ReaderClient\n 432\u2192     from goz.config import load_config\n 433\u2192 \n 434\u2192     config = load_config()\n 435\u2192     client = ReaderClient(config=config)\n 436\u2192 \n 437\u2192     try:\n 438\u2192         result = await client.read(\n 439\u2192             url=parsed.url,\n 440\u2192             format=parsed.format,\n 441\u2192             timeout=parsed.timeout,\n 442\u2192         )\n 443\u2192         print(result.content)\n 444\u2192     except Exception as e:\n 445\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 446\u2192         sys.exit(1)\n 447\u2192 \n 448\u2192 \n 449\u2192 async def cmd_repo(args: list[str]) -> None:\n 450\u2192     \"\"\"Handle the `goz repo` command.\n 451\u2192 \n 452\u2192     Usage:\n 453\u2192         goz repo search <owner/repo> <query>\n 454\u2192         goz repo tree <owner/repo>\n 455\u2192         goz repo read <owner/repo> <file_path>\n 456\u2192 \n 457\u2192     Args:\n 458\u2192         args: Command arguments\n 459\u2192     \"\"\"\n 460\u2192     # Check for help or no args\n 461\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 462\u2192         print(\"\"\"Repo command usage:\n 463\u2192 \n 464\u2192   goz repo search <owner/repo> <query>   Search docs and code in repository\n 465\u2192   goz repo tree <owner/repo>             Get repository directory structure\n 466\u2192   goz repo read <owner/repo> <path>      Read a file from repository\n 467\u2192 \n 468\u2192 Search Options:\n 469\u2192   --language <lang>   Result language: en (default) or zh\n 470\u2192 \n 471\u2192 Tree Options:\n 472\u2192   --path <path>       Directory path to inspect (default: repo root)\n 473\u2192   --depth <n>         Expand subdirectory trees (default: 1)\n 474\u2192 \n 475\u2192 Examples:\n 476\u2192   goz repo search facebook/react \"server components\"\n 477\u2192   goz repo search vercel/next.js \"app router\" --language en\n 478\u2192   goz repo tree vercel/next.js\n 479\u2192   goz repo tree vercel/next.js --path packages --depth 2\n 480\u2192   goz repo read anthropics/anthropic-sdk-python README.md\n 481\u2192 \n 482\u2192 Notes:\n 483\u2192   - Repository must be public\n 484\u2192   - Use \"owner/repo\" format (e.g., \"facebook/react\")\n 485\u2192   - Paths are relative to repository root\n 486\u2192 \"\"\")\n 487\u2192         return\n 488\u2192 \n 489\u2192     subcommand = args[0]\n 490\u2192 \n 491\u2192     if subcommand == \"search\":\n 492\u2192         # goz repo search <owner/repo> <query> [--language <lang>]\n 493\u2192         if len(args) < 3:\n 494\u2192             print(\"Error: repo search requires <owner/repo> and <query>\", file=sys.stderr)\n 495\u2192             print(\n 496\u2192                 \"Usage: goz repo search <owner/repo> <query> [--language <lang>]\", file=sys.stderr\n 497\u2192             )\n 498\u2192             sys.exit(1)\n 499\u2192 \n 500\u2192         repo = args[1]\n 501\u2192         query = args[2]\n 502\u2192         language = None\n 503\u2192 \n 504\u2192         # Parse optional args\n 505\u2192         i = 3\n 506\u2192         while i < len(args):\n 507\u2192             if args[i] == \"--language\" and i + 1 < len(args):\n 508\u2192                 language = args[i + 1]\n 509\u2192                 i += 2\n 510\u2192             else:\n 511\u2192                 i += 1\n 512\u2192 \n 513\u2192         from goz.api.repo import RepoClient\n 514\u2192         from goz.config import load_config\n 515\u2192 \n 516\u2192         config = load_config()\n 517\u2192         client = RepoClient(config=config)\n 518\u2192 \n 519\u2192         try:\n 520\u2192             results = await client.search(repo, query, language)\n 521\u2192             for r in results:\n 522\u2192                 if r.title:\n 523\u2192                     print(f\"# {r.title}\")\n 524\u2192                 print(r.content)\n 525\u2192                 if r.url:\n 526\u2192                     print(f\"URL: {r.url}\")\n 527\u2192                 print()\n 528\u2192         except Exception as e:\n 529\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 530\u2192             sys.exit(1)\n 531\u2192 \n 532\u2192     elif subcommand == \"tree\":\n 533\u2192         # goz repo tree <owner/repo> [--path <path>] [--depth <n>]\n 534\u2192         if len(args) < 2:\n 535\u2192             print(\"Error: repo tree requires <owner/repo>\", file=sys.stderr)\n 536\u2192             print(\n 537\u2192                 \"Usage: goz repo tree <owner/repo> [--path <path>] [--depth <n>]\", file=sys.stderr\n 538\u2192             )\n 539\u2192             sys.exit(1)\n 540\u2192 \n 541\u2192         repo = args[1]\n 542\u2192         path = None\n 543\u2192         depth = 1\n 544\u2192 \n 545\u2192         # Parse optional args\n 546\u2192         i = 2\n 547\u2192         while i < len(args):\n 548\u2192             if args[i] == \"--path\" and i + 1 < len(args):\n 549\u2192                 path = args[i + 1]\n 550\u2192                 i += 2\n 551\u2192             elif args[i] == \"--depth\" and i + 1 < len(args):\n 552\u2192                 try:\n 553\u2192                     depth = int(args[i + 1])\n 554\u2192                 except ValueError:\n 555\u2192                     print(f\"Error: depth must be an integer, got '{args[i + 1]}'\", file=sys.stderr)\n 556\u2192                     sys.exit(1)\n 557\u2192                 i += 2\n 558\u2192             else:\n 559\u2192                 i += 1\n 560\u2192 \n 561\u2192         from goz.api.repo import RepoClient\n 562\u2192         from goz.config import load_config\n 563\u2192 \n 564\u2192         config = load_config()\n 565\u2192         client = RepoClient(config=config)\n 566\u2192 \n 567\u2192         try:\n 568\u2192             result = await client.tree(repo, path, depth)\n 569\u2192             print(result)\n 570\u2192         except Exception as e:\n 571\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 572\u2192             sys.exit(1)\n 573\u2192 \n 574\u2192     elif subcommand == \"read\":\n 575\u2192         # goz repo read <owner/repo> <file_path>\n 576\u2192         if len(args) < 3:\n 577\u2192             print(\"Error: repo read requires <owner/repo> and <file_path>\", file=sys.stderr)\n 578\u2192             print(\"Usage: goz repo read <owner/repo> <file_path>\", file=sys.stderr)\n 579\u2192             sys.exit(1)\n 580\u2192 \n 581\u2192         repo = args[1]\n 582\u2192         file_path = args[2]\n 583\u2192 \n 584\u2192         from goz.api.repo import RepoClient\n 585\u2192         from goz.config import load_config\n 586\u2192 \n 587\u2192         config = load_config()\n 588\u2192         client = RepoClient(config=config)\n 589\u2192 \n 590\u2192         try:\n 591\u2192             result = await client.read(repo, file_path)\n 592\u2192             print(result)\n 593\u2192         except Exception as e:\n 594\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 595\u2192             sys.exit(1)\n 596\u2192 \n 597\u2192     else:\n 598\u2192         print(f\"Error: Unknown repo subcommand '{subcommand}'\", file=sys.stderr)\n 599\u2192         print(\"Run 'goz repo --help' for usage\", file=sys.stderr)\n 600\u2192         sys.exit(1)\n 601\u2192 \n 602\u2192 \n 603\u2192 async def cmd_tools(args: list[str]) -> None:\n 604\u2192     \"\"\"Handle the `goz tools` command.\"\"\"\n 605\u2192     import argparse\n 606\u2192 \n 607\u2192     if args and args[0] in (\"--help\", \"-h\", \"help\"):\n 608\u2192         print(\"\"\"Tools command usage:\n 609\u2192 \n 610\u2192   goz tools [options]\n 611\u2192 \n 612\u2192 Options:\n 613\u2192   --filter TEXT   Filter tool names by substring\n 614\u2192   --full          Show full tool schemas as JSON\n 615\u2192 \"\"\")\n 616\u2192         return\n 617\u2192 \n 618\u2192     parser = argparse.ArgumentParser(prog=\"goz tools\", add_help=False)\n 619\u2192     parser.add_argument(\"--filter\", dest=\"name_filter\", help=\"Filter tool names by substring\")\n 620\u2192     parser.add_argument(\"--full\", action=\"store_true\", help=\"Show full tool schemas\")\n 621\u2192     parsed = parser.parse_args(args)\n 622\u2192 \n 623\u2192     from goz.api.mcp import McpClient\n 624\u2192 \n 625\u2192     client = McpClient()\n 626\u2192     try:\n 627\u2192         tools = await client.list_tools()\n 628\u2192     except Exception as e:\n 629\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 630\u2192         sys.exit(1)\n 631\u2192 \n 632\u2192     if parsed.name_filter:\n 633\u2192         query = parsed.name_filter.lower()\n 634\u2192         tools = [tool for tool in tools if query in str(tool.get(\"name\", \"\")).lower()]\n 635\u2192 \n 636\u2192     if parsed.full:\n 637\u2192         _print_json(tools)\n 638\u2192         return\n 639\u2192 \n 640\u2192     for tool in tools:\n 641\u2192         name = tool.get(\"name\")\n 642\u2192         if name:\n 643\u2192             print(name)\n 644\u2192 \n 645\u2192 \n 646\u2192 async def cmd_tool(args: list[str]) -> None:\n 647\u2192     \"\"\"Handle the `goz tool <name>` command.\"\"\"\n 648\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 649\u2192         print(\"\"\"Tool command usage:\n 650\u2192 \n 651\u2192   goz tool <name>\n 652\u2192 \"\"\")\n 653\u2192         return\n 654\u2192 \n 655\u2192     from goz.api.mcp import McpClient\n 656\u2192 \n 657\u2192     client = McpClient()\n 658\u2192     try:\n 659\u2192         tool = await client.get_tool(args[0])\n 660\u2192     except Exception as e:\n 661\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 662\u2192         sys.exit(1)\n 663\u2192 \n 664\u2192     if tool is None:\n 665\u2192         print(f\"Error: Unknown tool '{args[0]}'\", file=sys.stderr)\n 666\u2192         sys.exit(1)\n 667\u2192 \n 668\u2192     _print_json(tool)\n 669\u2192 \n 670\u2192 \n 671\u2192 async def cmd_call(args: list[str]) -> None:\n 672\u2192     \"\"\"Handle the `goz call <tool>` command.\"\"\"\n 673\u2192     import argparse\n 674\u2192 \n 675\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 676\u2192         print(\"\"\"Call command usage:\n 677\u2192 \n 678\u2192   goz call <tool> [--json JSON|@file.json] [--stdin] [--dry-run]\n 679\u2192 \n 680\u2192 Options:\n 681\u2192   --json VALUE    Inline JSON object or @path/to/file.json\n 682\u2192   --stdin         Read JSON object from stdin\n 683\u2192   --dry-run       Print resolved request payload without calling the tool\n 684\u2192 \"\"\")\n 685\u2192         return\n 686\u2192 \n 687\u2192     parser = argparse.ArgumentParser(prog=\"goz call\", add_help=False)\n 688\u2192     parser.add_argument(\"tool\", help=\"Tool name to call\")\n 689\u2192     parser.add_argument(\"--json\", dest=\"json_payload\", help=\"Inline JSON or @file reference\")\n 690\u2192     parser.add_argument(\"--stdin\", action=\"store_true\", help=\"Read JSON from stdin\")\n 691\u2192     parser.add_argument(\n 692\u2192         \"--dry-run\", action=\"store_true\", help=\"Preview the request without calling\"\n 693\u2192     )\n 694\u2192     parsed = parser.parse_args(args)\n 695\u2192 \n 696\u2192     try:\n 697\u2192         arguments = _load_call_arguments(parsed.json_payload, parsed.stdin)\n 698\u2192     except (OSError, ValueError) as e:\n 699\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 700\u2192         sys.exit(1)\n 701\u2192 \n 702\u2192     request_payload = {\n 703\u2192         \"name\": parsed.tool,\n 704\u2192         \"arguments\": arguments,\n 705\u2192     }\n 706\u2192     if parsed.dry_run:\n 707\u2192         _print_json(request_payload)\n 708\u2192         return\n 709\u2192 \n 710\u2192     from goz.api.mcp import McpClient\n 711\u2192 \n 712\u2192     client = McpClient()\n 713\u2192     try:\n 714\u2192         result = await client.call_tool(parsed.tool, arguments)\n 715\u2192     except Exception as e:\n 716\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 717\u2192         sys.exit(1)\n 718\u2192 \n 719\u2192     _print_json(result)\n 720\u2192 \n 721\u2192 \n 722\u2192 async def cmd_run(args: list[str]) -> None:\n 723\u2192     \"\"\"Handle the `goz run` command.\"\"\"\n 724\u2192     from goz.cli.run import cmd_run as run_cmd\n 725\u2192 \n 726\u2192     await run_cmd(args)\n 727\u2192 \n 728\u2192 \n 729\u2192 def cmd_config(args: list[str]) -> None:\n 730\u2192     \"\"\"Handle the `goz config` command.\n 731\u2192 \n 732\u2192     Usage:\n 733\u2192         goz config                - Show current config\n 734\u2192         goz config get <key>      - Get a single value\n 735\u2192         goz config set <key> <val> - Set a value\n 736\u2192         goz config list           - List all keys\n 737\u2192         goz config edit           - Open in editor\n 738\u2192 \n 739\u2192     Args:\n 740\u2192         args: Remaining arguments after 'config'\n 741\u2192     \"\"\"\n 742\u2192     from goz.config import ConfigManager\n 743\u2192 \n 744\u2192     manager = ConfigManager()\n 745\u2192 \n 746\u2192     # No subcommand = show current config\n 747\u2192     if not args:\n 748\u2192         manager.show_config()\n 749\u2192         return\n 750\u2192 \n 751\u2192     subcommand = args[0]\n 752\u2192 \n 753\u2192     if subcommand == \"get\" and len(args) >= 2:\n 754\u2192         key = args[1]\n 755\u2192         try:\n 756\u2192             manager.get_config(key)\n 757\u2192         except ValueError as e:\n 758\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 759\u2192             sys.exit(1)\n 760\u2192 \n 761\u2192     elif subcommand == \"set\" and len(args) >= 2:\n 762\u2192         key = args[1]\n 763\u2192         value = args[2] if len(args) > 2 else \"\"\n 764\u2192         try:\n 765\u2192             manager.set_config(key, value)\n 766\u2192         except ValueError as e:\n 767\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 768\u2192             sys.exit(1)\n 769\u2192 \n 770\u2192     elif subcommand == \"list\":\n 771\u2192         manager.list_keys()\n 772\u2192 \n 773\u2192     elif subcommand == \"edit\":\n 774\u2192         try:\n 775\u2192             manager.edit_config()\n 776\u2192         except Exception as e:\n 777\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 778\u2192             sys.exit(1)\n 779\u2192 \n 780\u2192     elif subcommand in (\"--help\", \"-h\", \"help\"):\n 781\u2192         print(\"\"\"Config command usage:\n 782\u2192 \n 783\u2192   goz config                Show current configuration\n 784\u2192   goz config get <key>      Get a single configuration value\n 785\u2192   goz config set <key> <val> Set a configuration value\n 786\u2192   goz config list           List all available keys with descriptions\n 787\u2192   goz config edit           Open config file in $EDITOR\n 788\u2192 \n 789\u2192 Keys:\n 790\u2192   zai_token     - Z.AI API authentication token (required)\n 791\u2192   zai_base_url  - Base URL for Z.AI API\n 792\u2192   timeout       - Request timeout in seconds\n 793\u2192   vision_model  - Model for image/video analysis\n 794\u2192   chat_model    - Model for chat requests\n 795\u2192   temperature   - Generation temperature\n 796\u2192   top_p         - Generation top_p sampling\n 797\u2192   max_tokens    - Maximum response tokens\n 798\u2192 \"\"\")\n 799\u2192 \n 800\u2192     else:\n 801\u2192         # Treat as show current config (for backwards compatibility)\n 802\u2192         manager.show_config()\n 803\u2192 \n 804\u2192 \n 805\u2192 def cmd_doctor(args: list[str]) -> None:\n 806\u2192     \"\"\"Handle the `goz doctor` command.\n 807\u2192 \n 808\u2192     Usage:\n 809\u2192         goz doctor\n 810\u2192 \n 811\u2192     Runs environment and connectivity checks.\n 812\u2192 \n 813\u2192     Args:\n 814\u2192         args: Remaining arguments\n 815\u2192     \"\"\"\n 816\u2192     import asyncio\n 817\u2192 \n 818\u2192     # Check for help\n 819\u2192     if args and args[0] in (\"--help\", \"-h\", \"help\"):\n 820\u2192         print(\"\"\"Doctor command usage:\n 821\u2192 \n 822\u2192   goz doctor\n 823\u2192 \n 824\u2192 Runs diagnostic checks:\n 825\u2192   - Config file exists\n 826\u2192   - API token is set\n 827\u2192   - API endpoint is reachable\n 828\u2192 \"\"\")\n 829\u2192         return\n 830\u2192 \n 831\u2192     async def run_doctor() -> None:\n 832\u2192         from goz.config import load_config, DEFAULT_CONFIG_FILE\n 833\u2192 \n 834\u2192         checks_passed = 0\n 835\u2192         checks_failed = 0\n 836\u2192 \n 837\u2192         # Check 1: Config file\n 838\u2192         print(\"Checking configuration...\")\n 839\u2192         if DEFAULT_CONFIG_FILE.exists():\n 840\u2192             print(f\"  [PASS] Config file found at {DEFAULT_CONFIG_FILE}\")\n 841\u2192             checks_passed += 1\n 842\u2192         else:\n 843\u2192             print(f\"  [FAIL] Config file not found at {DEFAULT_CONFIG_FILE}\")\n 844\u2192             print(\"         Run 'goz config' to set up.\")\n 845\u2192             checks_failed += 1\n 846\u2192 \n 847\u2192         # Check 2: Load config and validate token\n 848\u2192         try:\n 849\u2192             config = load_config()\n 850\u2192             if config.zai_token:\n 851\u2192                 masked = f\"****{config.zai_token[-4:]}\" if len(config.zai_token) > 4 else \"****\"\n 852\u2192                 print(f\"  [PASS] API token present ({masked})\")\n 853\u2192                 checks_passed += 1\n 854\u2192             else:\n 855\u2192                 print(\"  [FAIL] API token not set\")\n 856\u2192                 checks_failed += 1\n 857\u2192         except Exception as e:\n 858\u2192             print(f\"  [FAIL] Error loading config: {e}\")\n 859\u2192             checks_failed += 1\n 860\u2192             return\n 861\u2192 \n 862\u2192         # Check 3: API connectivity\n 863\u2192         try:\n 864\u2192             import httpx\n 865\u2192 \n 866\u2192             async with httpx.AsyncClient(timeout=5.0) as client:\n 867\u2192                 await client.get(config.zai_base_url)\n 868\u2192                 print(f\"  [PASS] Base URL reachable ({config.zai_base_url})\")\n 869\u2192                 checks_passed += 1\n 870\u2192         except (httpx.ConnectError, httpx.NetworkError) as e:\n 871\u2192             print(f\"  [FAIL] Cannot connect to API: {e}\")\n 872\u2192             checks_failed += 1\n 873\u2192         except Exception as e:\n 874\u2192             print(f\"  [WARN] Could not test connectivity: {e}\")\n 875\u2192 \n 876\u2192         # Summary\n 877\u2192         print()\n 878\u2192         if checks_failed == 0:\n 879\u2192             print(f\"All checks passed! ({checks_passed}/{checks_passed})\")\n 880\u2192         else:\n 881\u2192             print(f\"Some checks failed: {checks_failed} failed, {checks_passed} passed\")\n 882\u2192 \n 883\u2192     asyncio.run(run_doctor())\n 884\u2192 \n 885\u2192 \n 886\u2192 def cmd_tui(args: list[str]) -> None:\n 887\u2192     \"\"\"Launch the TUI.\n 888\u2192 \n 889\u2192     Args:\n 890\u2192         args: Remaining arguments (ignored)\n 891\u2192     \"\"\"\n 892\u2192     from goz.tui import run_tui\n 893\u2192 \n 894\u2192     run_tui()\n 895\u2192 \n 896\u2192 \n 897\u2192 def main() -> None:\n 898\u2192     \"\"\"Run the goz CLI.\n 899\u2192 \n 900\u2192     This is the entry point for the `goz` command.\n 901\u2192     \"\"\"\n 902\u2192     import argparse\n 903\u2192 \n 904\u2192     # Check for --help before argparse to handle it properly\n 905\u2192     if \"--help\" in sys.argv or \"-h\" in sys.argv:\n 906\u2192         print(f\"\"\"goz v{__version__} - Z.AI Tools\n 907\u2192 \n 908\u2192 Usage: goz <command> [args] [options]\n 909\u2192 \n 910\u2192 Commands:\n 911\u2192   run       One-shot agent run with JSONL output\n 912\u2192   vision    Image and video analysis\n 913\u2192   search    Real-time web search\n 914\u2192   read      Fetch and parse web pages\n 915\u2192   repo      GitHub repository exploration\n 916\u2192   tools     List MCP tools\n 917\u2192   tool      Show one MCP tool schema\n 918\u2192   call      Call an MCP tool directly\n 919\u2192   config    Manage configuration\n 920\u2192   doctor    Environment + connectivity checks\n 921\u2192   usage     Show token usage and quota\n 922\u2192   tui       Launch interactive terminal UI\n 923\u2192 \n 924\u2192 Global Options:\n 925\u2192   --help, -h     Show this help message\n 926\u2192   --version, -v  Show version number\n 927\u2192 \n 928\u2192 For command-specific help:\n 929\u2192   goz vision --help\n 930\u2192   goz run --help\n 931\u2192   goz search --help\n 932\u2192   goz read --help\n 933\u2192   goz repo --help\n 934\u2192   goz tools --help\n 935\u2192   goz tool --help\n 936\u2192   goz call --help\n 937\u2192   goz config --help\n 938\u2192   goz doctor --help\n 939\u2192   goz usage --help\n 940\u2192 \n 941\u2192 Examples:\n 942\u2192   goz vision analyze https://example.com/image.png\n 943\u2192   goz run --format json \"Inspect this repo and report STAGE_RESULT.\"\n 944\u2192   goz vision ui-to-code screenshot.png\n 945\u2192   goz search \"python async await\"\n 946\u2192   goz read https://example.com/article\n 947\u2192   goz repo tree vercel/next.js\n 948\u2192   goz repo search facebook/react \"hooks\"\n 949\u2192   goz tools --filter vision\n 950\u2192   goz tool zai.vision.analyze_image\n 951\u2192   goz call zai.search.webSearchPrime --json '{{\"search_query\":\"test\"}}'\n 952\u2192   goz config get zai_token\n 953\u2192 \n 954\u2192 With no command, launches the interactive TUI.\n 955\u2192 \"\"\")\n 956\u2192         return\n 957\u2192 \n 958\u2192     parser = argparse.ArgumentParser(\n 959\u2192         prog=\"goz\",\n 960\u2192         description=\"goz - Z.AI Tools: vision, search, web reader, and more\",\n 961\u2192         add_help=False,  # We handle help manually\n 962\u2192     )\n 963\u2192     parser.add_argument(\n 964\u2192         \"--version\",\n 965\u2192         action=\"version\",\n 966\u2192         version=f\"%(prog)s {__version__}\",\n 967\u2192     )\n 968\u2192     # Agent mode flags (for use with no command)\n 969\u2192     parser.add_argument(\n 970\u2192         \"--load\",\n 971\u2192         help=\"Load session on startup (for agent mode)\",\n 972\u2192     )\n 973\u2192     parser.add_argument(\n 974\u2192         \"--agent\",\n 975\u2192         help=\"Start with specific agent type (for agent mode)\",\n 976\u2192     )\n 977\u2192     parser.add_argument(\n 978\u2192         \"command\",\n 979\u2192         nargs=\"?\",\n 980\u2192         help=\"Command to run (run, config, vision, search, read, repo, tools, tool, call, doctor, tui)\",\n 981\u2192     )\n 982\u2192     parser.add_argument(\n 983\u2192         \"args\",\n 984\u2192         nargs=argparse.REMAINDER,\n 985\u2192         help=\"Arguments for the command\",\n 986\u2192     )\n 987\u2192 \n 988\u2192     args = parser.parse_args()\n 989\u2192 \n 990\u2192     if args.command is None:\n 991\u2192         # No command = launch AGENT MODE (interactive coding agent)\n 992\u2192         from goz.agent.tui import run_agent_app\n 993\u2192 \n 994\u2192         run_agent_app(session_id=args.load, agent_type=args.agent)\n 995\u2192         return\n 996\u2192 \n 997\u2192     # Dispatch to command handlers\n 998\u2192     if args.command == \"config\":\n 999\u2192         cmd_config(args.args)\n1000\u2192     elif args.command == \"vision\":\n1001\u2192         asyncio.run(cmd_vision(args.args))\n1002\u2192     elif args.command == \"run\":\n1003\u2192         asyncio.run(cmd_run(args.args))\n1004\u2192     elif args.command == \"search\":\n1005\u2192         asyncio.run(cmd_search(args.args))\n1006\u2192     elif args.command == \"read\":\n1007\u2192         asyncio.run(cmd_read(args.args))\n1008\u2192     elif args.command == \"repo\":\n1009\u2192         asyncio.run(cmd_repo(args.args))\n1010\u2192     elif args.command == \"tools\":\n1011\u2192         asyncio.run(cmd_tools(args.args))\n1012\u2192     elif args.command == \"tool\":\n1013\u2192         asyncio.run(cmd_tool(args.args))\n1014\u2192     elif args.command == \"call\":\n1015\u2192         asyncio.run(cmd_call(args.args))\n1016\u2192     elif args.command == \"doctor\":\n1017\u2192         cmd_doctor(args.args)\n1018\u2192     elif args.command == \"usage\":\n1019\u2192         from goz.cli.usage import cmd_usage as _cmd_usage\n1020\u2192 \n1021\u2192         asyncio.run(_cmd_usage(args.args))\n1022\u2192     elif args.command in (\"tui\", \"ui\"):\n1023\u2192         cmd_tui(args.args)\n1024\u2192     else:\n1025\u2192         print(f\"Error: Unknown command '{args.command}'\", file=sys.stderr)\n1026\u2192         print(\"Run 'goz --help' for usage\", file=sys.stderr)\n1027\u2192         sys.exit(1)\n1028\u2192 \n1029\u2192 \n1030\u2192 if __name__ == \"__main__\":\n1031\u2192     main()", "is_error": false}}
