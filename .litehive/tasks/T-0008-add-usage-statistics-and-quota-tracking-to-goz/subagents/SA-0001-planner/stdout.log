positional[0]\n 166\u2192         source1 = positional[1] if len(positional) > 1 else None\n 167\u2192 \n 168\u2192         if mode == \"diff\":\n 169\u2192             source2 = positional[2] if len(positional) > 2 else None\n 170\u2192             prompt = positional[3] if len(positional) > 3 else None\n 171\u2192         else:\n 172\u2192             prompt = positional[2] if len(positional) > 2 else None\n 173\u2192     else:\n 174\u2192         # Old behavior: first arg is source\n 175\u2192         source1 = positional[0]\n 176\u2192         prompt = positional[1] if len(positional) > 1 else None\n 177\u2192 \n 178\u2192     # Validate we have a source\n 179\u2192     if not source1:\n 180\u2192         print(\"Error: Missing image/video source\", file=sys.stderr)\n 181\u2192         print(\"Run 'goz vision --help' for usage\", file=sys.stderr)\n 182\u2192         sys.exit(1)\n 183\u2192 \n 184\u2192     if mode == \"diff\" and not source2:\n 185\u2192         print(\"Error: diff mode requires two sources: <expected> <actual>\", file=sys.stderr)\n 186\u2192         sys.exit(1)\n 187\u2192 \n 188\u2192     # Build prompt based on mode\n 189\u2192     default_prompts = {\n 190\u2192         \"analyze\": \"Describe this image in detail.\",\n 191\u2192         \"ui-to-code\": \"Convert this UI to production-ready code.\",\n 192\u2192         \"extract-text\": \"Extract all text from this image.\",\n 193\u2192         \"diagnose-error\": \"Diagnose this error and suggest fixes.\",\n 194\u2192         \"diagram\": \"Explain this technical diagram.\",\n 195\u2192         \"chart\": \"Analyze this data visualization.\",\n 196\u2192         \"video\": \"Analyze this video content.\",\n 197\u2192     }\n 198\u2192 \n 199\u2192     effective_prompt = prompt or default_prompts.get(mode, \"Describe this image.\")\n 200\u2192 \n 201\u2192     # Enhance prompt with mode-specific options\n 202\u2192     output_type = flags.get(\"output\", \"code\")\n 203\u2192 \n 204\u2192     if mode == \"ui-to-code\" and output_type != \"code\":\n 205\u2192         if output_type == \"prompt\":\n 206\u2192             effective_prompt = (\n 207\u2192                 f\"{effective_prompt}\\n\\n\"\n 208\u2192                 f\"Provide a detailed prompt that would generate this UI, \"\n 209\u2192                 f\"including layout, components, styling, and functionality.\"\n 210\u2192             )\n 211\u2192         elif output_type == \"spec\":\n 212\u2192             effective_prompt = (\n 213\u2192                 f\"{effective_prompt}\\n\\n\"\n 214\u2192                 f\"Provide a technical specification including components, \"\n 215\u2192                 f\"props, state management, and styling approach.\"\n 216\u2192             )\n 217\u2192         elif output_type == \"description\":\n 218\u2192             effective_prompt = (\n 219\u2192                 f\"{effective_prompt}\\n\\n\"\n 220\u2192                 f\"Provide a detailed description of the UI layout, \"\n 221\u2192                 f\"components, colors, and interactions without generating code.\"\n 222\u2192             )\n 223\u2192 \n 224\u2192     if mode == \"extract-text\" and flags.get(\"language\"):\n 225\u2192         effective_prompt = (\n 226\u2192             f\"{effective_prompt}\\n\\n\"\n 227\u2192             f\"The content is in {flags['language']}. Preserve code syntax and formatting.\"\n 228\u2192         )\n 229\u2192 \n 230\u2192     if mode == \"diagnose-error\" and flags.get(\"context\"):\n 231\u2192         effective_prompt = (\n 232\u2192             f\"{effective_prompt}\\n\\n\"\n 233\u2192             f\"Context: {flags['context']}\\n\\n\"\n 234\u2192             f\"Consider this context when diagnosing the error.\"\n 235\u2192         )\n 236\u2192 \n 237\u2192     if mode == \"diagram\" and flags.get(\"type\"):\n 238\u2192         effective_prompt = (\n 239\u2192             f\"{effective_prompt}\\n\\n\"\n 240\u2192             f\"This is a {flags['type']} diagram. Use appropriate terminology.\"\n 241\u2192         )\n 242\u2192 \n 243\u2192     if mode == \"chart\" and flags.get(\"focus\"):\n 244\u2192         focus_prompts = {\n 245\u2192             \"trends\": \"Focus on identifying trends and patterns over time.\",\n 246\u2192             \"anomalies\": \"Focus on identifying anomalies, outliers, and unusual data points.\",\n 247\u2192             \"comparisons\": \"Focus on comparing different data series and values.\",\n 248\u2192             \"insights\": \"Focus on extracting key insights and actionable conclusions.\",\n 249\u2192         }\n 250\u2192         focus_prompt = focus_prompts.get(flags['focus'], '')\n 251\u2192         if focus_prompt:\n 252\u2192             effective_prompt = f\"{effective_prompt}\\n\\n{focus_prompt}\"\n 253\u2192 \n 254\u2192     # Determine if streaming\n 255\u2192     no_stream = flags.get(\"no-stream\", False)\n 256\u2192 \n 257\u2192     try:\n 258\u2192         if mode == \"diff\":\n 259\u2192             # For diff, analyze both images and compare\n 260\u2192             if no_stream:\n 261\u2192                 result1 = await client.analyze(source1, \"Describe this image in detail.\")\n 262\u2192                 result2 = await client.analyze(source2, \"Describe this image in detail.\")\n 263\u2192                 print(f\"Expected Image:\\n{result1}\\n\\n\")\n 264\u2192                 print(f\"Actual Image:\\n{result2}\\n\\n\")\n 265\u2192                 print(\"Note: Use the vision diff command for precise visual comparison.\")\n 266\u2192             else:\n 267\u2192                 print(\"Analyzing expected image...\", file=sys.stderr)\n 268\u2192                 async for chunk in client.analyze_stream(source1, \"Describe this image in detail.\"):\n 269\u2192                     print(chunk, end=\"\", flush=True)\n 270\u2192                 print(\"\\n\\nAnalyzing actual image...\", file=sys.stderr)\n 271\u2192                 async for chunk in client.analyze_stream(source2, \"Describe this image in detail.\"):\n 272\u2192                     print(chunk, end=\"\", flush=True)\n 273\u2192                 print(\"\\n\\nNote: Use the vision diff command for precise visual comparison.\")\n 274\u2192         else:\n 275\u2192             if no_stream:\n 276\u2192                 result = await client.analyze(source1, effective_prompt)\n 277\u2192                 print(result)\n 278\u2192             else:\n 279\u2192                 # Show \"thinking\" animation while waiting for first chunk\n 280\u2192                 import threading\n 281\u2192                 stop_animation = threading.Event()\n 282\u2192                 animation_thread = threading.Thread(\n 283\u2192                     target=_show_thinking_animation,\n 284\u2192                     args=(stop_animation,),\n 285\u2192                     daemon=True\n 286\u2192                 )\n 287\u2192                 animation_thread.start()\n 288\u2192 \n 289\u2192                 # Stream response\n 290\u2192                 first_chunk = True\n 291\u2192                 async for chunk in client.analyze_stream(source1, effective_prompt):\n 292\u2192                     if first_chunk:\n 293\u2192                         # Stop animation on first chunk\n 294\u2192                         stop_animation.set()\n 295\u2192                         animation_thread.join(timeout=0.2)\n 296\u2192                         first_chunk = False\n 297\u2192                     print(chunk, end=\"\", flush=True)\n 298\u2192                 print()  # New line after streaming completes\n 299\u2192                 if first_chunk:\n 300\u2192                     # In case no chunks were received\n 301\u2192                     stop_animation.set()\n 302\u2192                     animation_thread.join(timeout=0.2)\n 303\u2192     except Exception as e:\n 304\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 305\u2192         sys.exit(1)\n 306\u2192 \n 307\u2192 \n 308\u2192 async def cmd_search(args: list[str]) -> None:\n 309\u2192     \"\"\"Handle the `goz search` command.\n 310\u2192 \n 311\u2192     Usage:\n 312\u2192         goz search <query> [options]\n 313\u2192 \n 314\u2192     Options:\n 315\u2192         --count, -c N       - Number of results (default: 10)\n 316\u2192         --domain, -d DOMAIN - Filter to domain\n 317\u2192         --recency, -r R     - Time filter (oneDay, oneWeek, oneMonth, oneYear, noLimit)\n 318\u2192 \n 319\u2192     Args:\n 320\u2192         args: Command arguments\n 321\u2192     \"\"\"\n 322\u2192     import argparse\n 323\u2192 \n 324\u2192     # Check for help\n 325\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 326\u2192         print(\"\"\"Search command usage:\n 327\u2192 \n 328\u2192   goz search <query> [options]\n 329\u2192 \n 330\u2192 Options:\n 331\u2192   --count, -c N         Number of results to return (default: 10)\n 332\u2192   --domain, -d DOMAIN   Filter results to specific domain\n 333\u2192   --recency, -r R       Time filter:\n 334\u2192                         - oneDay: Results from last 24 hours\n 335\u2192                         - oneWeek: Results from last week\n 336\u2192                         - oneMonth: Results from last month\n 337\u2192                         - oneYear: Results from last year\n 338\u2192                         - noLimit: No time restriction\n 339\u2192 \n 340\u2192 Examples:\n 341\u2192   goz search \"python async await\"\n 342\u2192   goz search \"climate change\" --count 5\n 343\u2192   goz search \"AI news\" --domain news.ycombinator.com --recency oneWeek\n 344\u2192 \"\"\")\n 345\u2192         return\n 346\u2192 \n 347\u2192     parser = argparse.ArgumentParser(prog=\"goz search\", add_help=False)\n 348\u2192     parser.add_argument(\"query\", help=\"Search query\")\n 349\u2192     parser.add_argument(\"--count\", \"-c\", type=int, help=\"Number of results\")\n 350\u2192     parser.add_argument(\"--domain\", \"-d\", help=\"Filter to domain\")\n 351\u2192     parser.add_argument(\"--recency\", \"-r\",\n 352\u2192                         choices=[\"oneDay\", \"oneWeek\", \"oneMonth\", \"oneYear\", \"noLimit\"],\n 353\u2192                         help=\"Time filter\")\n 354\u2192 \n 355\u2192     parsed = parser.parse_args(args)\n 356\u2192 \n 357\u2192     from goz.api.search import SearchClient\n 358\u2192     from goz.config import load_config\n 359\u2192 \n 360\u2192     config = load_config()\n 361\u2192     client = SearchClient(config=config)\n 362\u2192 \n 363\u2192     try:\n 364\u2192         results = await client.search(\n 365\u2192             query=parsed.query,\n 366\u2192             count=parsed.count,\n 367\u2192             domain_filter=parsed.domain,\n 368\u2192             recency_filter=parsed.recency,\n 369\u2192         )\n 370\u2192         for r in results:\n 371\u2192             print(f\"{r.rank}. {r.title}\")\n 372\u2192             print(f\"   {r.url}\")\n 373\u2192             if r.summary:\n 374\u2192                 print(f\"   {r.summary[:100]}...\")\n 375\u2192             print()\n 376\u2192     except Exception as e:\n 377\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 378\u2192         sys.exit(1)\n 379\u2192 \n 380\u2192 \n 381\u2192 async def cmd_read(args: list[str]) -> None:\n 382\u2192     \"\"\"Handle the `goz read` command.\n 383\u2192 \n 384\u2192     Usage:\n 385\u2192         goz read <url> [options]\n 386\u2192 \n 387\u2192     Options:\n 388\u2192         --format, -f FMT  - Output format (markdown, text)\n 389\u2192         --timeout, -t N   - Timeout in seconds (default: 20)\n 390\u2192 \n 391\u2192     Args:\n 392\u2192         args: Command arguments\n 393\u2192     \"\"\"\n 394\u2192     import argparse\n 395\u2192 \n 396\u2192     # Check for help\n 397\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 398\u2192         print(\"\"\"Read command usage:\n 399\u2192 \n 400\u2192   goz read <url> [options]\n 401\u2192 \n 402\u2192 Options:\n 403\u2192   --format, -f FMT    Output format:\n 404\u2192                       - markdown: GitHub Flavored Markdown (default)\n 405\u2192                       - text: Plain text\n 406\u2192   --timeout, -t N     Request timeout in seconds (default: 20)\n 407\u2192 \n 408\u2192 Examples:\n 409\u2192   goz read https://example.com\n 410\u2192   goz read https://example.com --format text\n 411\u2192   goz read https://example.com --timeout 30\n 412\u2192 \"\"\")\n 413\u2192         return\n 414\u2192 \n 415\u2192     parser = argparse.ArgumentParser(prog=\"goz read\", add_help=False)\n 416\u2192     parser.add_argument(\"url\", help=\"URL to read\")\n 417\u2192     parser.add_argument(\"--format\", \"-f\", choices=[\"markdown\", \"text\"],\n 418\u2192                         default=\"markdown\", help=\"Output format\")\n 419\u2192     parser.add_argument(\"--timeout\", \"-t\", type=int, help=\"Timeout in seconds\")\n 420\u2192 \n 421\u2192     parsed = parser.parse_args(args)\n 422\u2192 \n 423\u2192     from goz.api.reader import ReaderClient\n 424\u2192     from goz.config import load_config\n 425\u2192 \n 426\u2192     config = load_config()\n 427\u2192     client = ReaderClient(config=config)\n 428\u2192 \n 429\u2192     try:\n 430\u2192         result = await client.read(\n 431\u2192             url=parsed.url,\n 432\u2192             format=parsed.format,\n 433\u2192             timeout=parsed.timeout,\n 434\u2192         )\n 435\u2192         print(result.content)\n 436\u2192     except Exception as e:\n 437\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 438\u2192         sys.exit(1)\n 439\u2192 \n 440\u2192 \n 441\u2192 async def cmd_repo(args: list[str]) -> None:\n 442\u2192     \"\"\"Handle the `goz repo` command.\n 443\u2192 \n 444\u2192     Usage:\n 445\u2192         goz repo search <owner/repo> <query>\n 446\u2192         goz repo tree <owner/repo>\n 447\u2192         goz repo read <owner/repo> <file_path>\n 448\u2192 \n 449\u2192     Args:\n 450\u2192         args: Command arguments\n 451\u2192     \"\"\"\n 452\u2192     # Check for help or no args\n 453\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 454\u2192         print(\"\"\"Repo command usage:\n 455\u2192 \n 456\u2192   goz repo search <owner/repo> <query>   Search docs and code in repository\n 457\u2192   goz repo tree <owner/repo>             Get repository directory structure\n 458\u2192   goz repo read <owner/repo> <path>      Read a file from repository\n 459\u2192 \n 460\u2192 Search Options:\n 461\u2192   --language <lang>   Result language: en (default) or zh\n 462\u2192 \n 463\u2192 Tree Options:\n 464\u2192   --path <path>       Directory path to inspect (default: repo root)\n 465\u2192   --depth <n>         Expand subdirectory trees (default: 1)\n 466\u2192 \n 467\u2192 Examples:\n 468\u2192   goz repo search facebook/react \"server components\"\n 469\u2192   goz repo search vercel/next.js \"app router\" --language en\n 470\u2192   goz repo tree vercel/next.js\n 471\u2192   goz repo tree vercel/next.js --path packages --depth 2\n 472\u2192   goz repo read anthropics/anthropic-sdk-python README.md\n 473\u2192 \n 474\u2192 Notes:\n 475\u2192   - Repository must be public\n 476\u2192   - Use \"owner/repo\" format (e.g., \"facebook/react\")\n 477\u2192   - Paths are relative to repository root\n 478\u2192 \"\"\")\n 479\u2192         return\n 480\u2192 \n 481\u2192     subcommand = args[0]\n 482\u2192 \n 483\u2192     if subcommand == \"search\":\n 484\u2192         # goz repo search <owner/repo> <query> [--language <lang>]\n 485\u2192         if len(args) < 3:\n 486\u2192             print(\"Error: repo search requires <owner/repo> and <query>\", file=sys.stderr)\n 487\u2192             print(\"Usage: goz repo search <owner/repo> <query> [--language <lang>]\", file=sys.stderr)\n 488\u2192             sys.exit(1)\n 489\u2192 \n 490\u2192         repo = args[1]\n 491\u2192         query = args[2]\n 492\u2192         language = None\n 493\u2192 \n 494\u2192         # Parse optional args\n 495\u2192         i = 3\n 496\u2192         while i < len(args):\n 497\u2192             if args[i] == \"--language\" and i + 1 < len(args):\n 498\u2192                 language = args[i + 1]\n 499\u2192                 i += 2\n 500\u2192             else:\n 501\u2192                 i += 1\n 502\u2192 \n 503\u2192         from goz.api.repo import RepoClient\n 504\u2192         from goz.config import load_config\n 505\u2192 \n 506\u2192         config = load_config()\n 507\u2192         client = RepoClient(config=config)\n 508\u2192 \n 509\u2192         try:\n 510\u2192             results = await client.search(repo, query, language)\n 511\u2192             for r in results:\n 512\u2192                 if r.title:\n 513\u2192                     print(f\"# {r.title}\")\n 514\u2192                 print(r.content)\n 515\u2192                 if r.url:\n 516\u2192                     print(f\"URL: {r.url}\")\n 517\u2192                 print()\n 518\u2192         except Exception as e:\n 519\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 520\u2192             sys.exit(1)\n 521\u2192 \n 522\u2192     elif subcommand == \"tree\":\n 523\u2192         # goz repo tree <owner/repo> [--path <path>] [--depth <n>]\n 524\u2192         if len(args) < 2:\n 525\u2192             print(\"Error: repo tree requires <owner/repo>\", file=sys.stderr)\n 526\u2192             print(\"Usage: goz repo tree <owner/repo> [--path <path>] [--depth <n>]\", file=sys.stderr)\n 527\u2192             sys.exit(1)\n 528\u2192 \n 529\u2192         repo = args[1]\n 530\u2192         path = None\n 531\u2192         depth = 1\n 532\u2192 \n 533\u2192         # Parse optional args\n 534\u2192         i = 2\n 535\u2192         while i < len(args):\n 536\u2192             if args[i] == \"--path\" and i + 1 < len(args):\n 537\u2192                 path = args[i + 1]\n 538\u2192                 i += 2\n 539\u2192             elif args[i] == \"--depth\" and i + 1 < len(args):\n 540\u2192                 try:\n 541\u2192                     depth = int(args[i + 1])\n 542\u2192                 except ValueError:\n 543\u2192                     print(f\"Error: depth must be an integer, got '{args[i + 1]}'\", file=sys.stderr)\n 544\u2192                     sys.exit(1)\n 545\u2192                 i += 2\n 546\u2192             else:\n 547\u2192                 i += 1\n 548\u2192 \n 549\u2192         from goz.api.repo import RepoClient\n 550\u2192         from goz.config import load_config\n 551\u2192 \n 552\u2192         config = load_config()\n 553\u2192         client = RepoClient(config=config)\n 554\u2192 \n 555\u2192         try:\n 556\u2192             result = await client.tree(repo, path, depth)\n 557\u2192             print(result)\n 558\u2192         except Exception as e:\n 559\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 560\u2192             sys.exit(1)\n 561\u2192 \n 562\u2192     elif subcommand == \"read\":\n 563\u2192         # goz repo read <owner/repo> <file_path>\n 564\u2192         if len(args) < 3:\n 565\u2192             print(\"Error: repo read requires <owner/repo> and <file_path>\", file=sys.stderr)\n 566\u2192             print(\"Usage: goz repo read <owner/repo> <file_path>\", file=sys.stderr)\n 567\u2192             sys.exit(1)\n 568\u2192 \n 569\u2192         repo = args[1]\n 570\u2192         file_path = args[2]\n 571\u2192 \n 572\u2192         from goz.api.repo import RepoClient\n 573\u2192         from goz.config import load_config\n 574\u2192 \n 575\u2192         config = load_config()\n 576\u2192         client = RepoClient(config=config)\n 577\u2192 \n 578\u2192         try:\n 579\u2192             result = await client.read(repo, file_path)\n 580\u2192             print(result)\n 581\u2192         except Exception as e:\n 582\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 583\u2192             sys.exit(1)\n 584\u2192 \n 585\u2192     else:\n 586\u2192         print(f\"Error: Unknown repo subcommand '{subcommand}'\", file=sys.stderr)\n 587\u2192         print(\"Run 'goz repo --help' for usage\", file=sys.stderr)\n 588\u2192         sys.exit(1)\n 589\u2192 \n 590\u2192 \n 591\u2192 async def cmd_tools(args: list[str]) -> None:\n 592\u2192     \"\"\"Handle the `goz tools` command.\"\"\"\n 593\u2192     import argparse\n 594\u2192 \n 595\u2192     if args and args[0] in (\"--help\", \"-h\", \"help\"):\n 596\u2192         print(\"\"\"Tools command usage:\n 597\u2192 \n 598\u2192   goz tools [options]\n 599\u2192 \n 600\u2192 Options:\n 601\u2192   --filter TEXT   Filter tool names by substring\n 602\u2192   --full          Show full tool schemas as JSON\n 603\u2192 \"\"\")\n 604\u2192         return\n 605\u2192 \n 606\u2192     parser = argparse.ArgumentParser(prog=\"goz tools\", add_help=False)\n 607\u2192     parser.add_argument(\"--filter\", dest=\"name_filter\", help=\"Filter tool names by substring\")\n 608\u2192     parser.add_argument(\"--full\", action=\"store_true\", help=\"Show full tool schemas\")\n 609\u2192     parsed = parser.parse_args(args)\n 610\u2192 \n 611\u2192     from goz.api.mcp import McpClient\n 612\u2192 \n 613\u2192     client = McpClient()\n 614\u2192     try:\n 615\u2192         tools = await client.list_tools()\n 616\u2192     except Exception as e:\n 617\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 618\u2192         sys.exit(1)\n 619\u2192 \n 620\u2192     if parsed.name_filter:\n 621\u2192         query = parsed.name_filter.lower()\n 622\u2192         tools = [tool for tool in tools if query in str(tool.get(\"name\", \"\")).lower()]\n 623\u2192 \n 624\u2192     if parsed.full:\n 625\u2192         _print_json(tools)\n 626\u2192         return\n 627\u2192 \n 628\u2192     for tool in tools:\n 629\u2192         name = tool.get(\"name\")\n 630\u2192         if name:\n 631\u2192             print(name)\n 632\u2192 \n 633\u2192 \n 634\u2192 async def cmd_tool(args: list[str]) -> None:\n 635\u2192     \"\"\"Handle the `goz tool <name>` command.\"\"\"\n 636\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 637\u2192         print(\"\"\"Tool command usage:\n 638\u2192 \n 639\u2192   goz tool <name>\n 640\u2192 \"\"\")\n 641\u2192         return\n 642\u2192 \n 643\u2192     from goz.api.mcp import McpClient\n 644\u2192 \n 645\u2192     client = McpClient()\n 646\u2192     try:\n 647\u2192         tool = await client.get_tool(args[0])\n 648\u2192     except Exception as e:\n 649\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 650\u2192         sys.exit(1)\n 651\u2192 \n 652\u2192     if tool is None:\n 653\u2192         print(f\"Error: Unknown tool '{args[0]}'\", file=sys.stderr)\n 654\u2192         sys.exit(1)\n 655\u2192 \n 656\u2192     _print_json(tool)\n 657\u2192 \n 658\u2192 \n 659\u2192 async def cmd_call(args: list[str]) -> None:\n 660\u2192     \"\"\"Handle the `goz call <tool>` command.\"\"\"\n 661\u2192     import argparse\n 662\u2192 \n 663\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 664\u2192         print(\"\"\"Call command usage:\n 665\u2192 \n 666\u2192   goz call <tool> [--json JSON|@file.json] [--stdin] [--dry-run]\n 667\u2192 \n 668\u2192 Options:\n 669\u2192   --json VALUE    Inline JSON object or @path/to/file.json\n 670\u2192   --stdin         Read JSON object from stdin\n 671\u2192   --dry-run       Print resolved request payload without calling the tool\n 672\u2192 \"\"\")\n 673\u2192         return\n 674\u2192 \n 675\u2192     parser = argparse.ArgumentParser(prog=\"goz call\", add_help=False)\n 676\u2192     parser.add_argument(\"tool\", help=\"Tool name to call\")\n 677\u2192     parser.add_argument(\"--json\", dest=\"json_payload\", help=\"Inline JSON or @file reference\")\n 678\u2192     parser.add_argument(\"--stdin\", action=\"store_true\", help=\"Read JSON from stdin\")\n 679\u2192     parser.add_argument(\"--dry-run\", action=\"store_true\", help=\"Preview the request without calling\")\n 680\u2192     parsed = parser.parse_args(args)\n 681\u2192 \n 682\u2192     try:\n 683\u2192         arguments = _load_call_arguments(parsed.json_payload, parsed.stdin)\n 684\u2192     except (OSError, ValueError) as e:\n 685\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 686\u2192         sys.exit(1)\n 687\u2192 \n 688\u2192     request_payload = {\n 689\u2192         \"name\": parsed.tool,\n 690\u2192         \"arguments\": arguments,\n 691\u2192     }\n 692\u2192     if parsed.dry_run:\n 693\u2192         _print_json(request_payload)\n 694\u2192         return\n 695\u2192 \n 696\u2192     from goz.api.mcp import McpClient\n 697\u2192 \n 698\u2192     client = McpClient()\n 699\u2192     try:\n 700\u2192         result = await client.call_tool(parsed.tool, arguments)\n 701\u2192     except Exception as e:\n 702\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 703\u2192         sys.exit(1)\n 704\u2192 \n 705\u2192     _print_json(result)\n 706\u2192 \n 707\u2192 \n 708\u2192 async def cmd_run(args: list[str]) -> None:\n 709\u2192     \"\"\"Handle the `goz run` command.\"\"\"\n 710\u2192     from goz.cli.run import cmd_run as run_cmd\n 711\u2192 \n 712\u2192     await run_cmd(args)\n 713\u2192 \n 714\u2192 \n 715\u2192 def cmd_config(args: list[str]) -> None:\n 716\u2192     \"\"\"Handle the `goz config` command.\n 717\u2192 \n 718\u2192     Usage:\n 719\u2192         goz config                - Show current config\n 720\u2192         goz config get <key>      - Get a single value\n 721\u2192         goz config set <key> <val> - Set a value\n 722\u2192         goz config list           - List all keys\n 723\u2192         goz config edit           - Open in editor\n 724\u2192 \n 725\u2192     Args:\n 726\u2192         args: Remaining arguments after 'config'\n 727\u2192     \"\"\"\n 728\u2192     from goz.config import ConfigManager\n 729\u2192 \n 730\u2192     manager = ConfigManager()\n 731\u2192 \n 732\u2192     # No subcommand = show current config\n 733\u2192     if not args:\n 734\u2192         manager.show_config()\n 735\u2192         return\n 736\u2192 \n 737\u2192     subcommand = args[0]\n 738\u2192 \n 739\u2192     if subcommand == \"get\" and len(args) >= 2:\n 740\u2192         key = args[1]\n 741\u2192         try:\n 742\u2192             manager.get_config(key)\n 743\u2192         except ValueError as e:\n 744\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 745\u2192             sys.exit(1)\n 746\u2192 \n 747\u2192     elif subcommand == \"set\" and len(args) >= 2:\n 748\u2192         key = args[1]\n 749\u2192         value = args[2] if len(args) > 2 else \"\"\n 750\u2192         try:\n 751\u2192             manager.set_config(key, value)\n 752\u2192         except ValueError as e:\n 753\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 754\u2192             sys.exit(1)\n 755\u2192 \n 756\u2192     elif subcommand == \"list\":\n 757\u2192         manager.list_keys()\n 758\u2192 \n 759\u2192     elif subcommand == \"edit\":\n 760\u2192         try:\n 761\u2192             manager.edit_config()\n 762\u2192         except Exception as e:\n 763\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 764\u2192             sys.exit(1)\n 765\u2192 \n 766\u2192     elif subcommand in (\"--help\", \"-h\", \"help\"):\n 767\u2192         print(\"\"\"Config command usage:\n 768\u2192 \n 769\u2192   goz config                Show current configuration\n 770\u2192   goz config get <key>      Get a single configuration value\n 771\u2192   goz config set <key> <val> Set a configuration value\n 772\u2192   goz config list           List all available keys with descriptions\n 773\u2192   goz config edit           Open config file in $EDITOR\n 774\u2192 \n 775\u2192 Keys:\n 776\u2192   zai_token     - Z.AI API authentication token (required)\n 777\u2192   zai_base_url  - Base URL for Z.AI API\n 778\u2192   timeout       - Request timeout in seconds\n 779\u2192   vision_model  - Model for image/video analysis\n 780\u2192   chat_model    - Model for chat requests\n 781\u2192   temperature   - Generation temperature\n 782\u2192   top_p         - Generation top_p sampling\n 783\u2192   max_tokens    - Maximum response tokens\n 784\u2192 \"\"\")\n 785\u2192 \n 786\u2192     else:\n 787\u2192         # Treat as show current config (for backwards compatibility)\n 788\u2192         manager.show_config()\n 789\u2192 \n 790\u2192 \n 791\u2192 def cmd_doctor(args: list[str]) -> None:\n 792\u2192     \"\"\"Handle the `goz doctor` command.\n 793\u2192 \n 794\u2192     Usage:\n 795\u2192         goz doctor\n 796\u2192 \n 797\u2192     Runs environment and connectivity checks.\n 798\u2192 \n 799\u2192     Args:\n 800\u2192         args: Remaining arguments\n 801\u2192     \"\"\"\n 802\u2192     import asyncio\n 803\u2192 \n 804\u2192     # Check for help\n 805\u2192     if args and args[0] in (\"--help\", \"-h\", \"help\"):\n 806\u2192         print(\"\"\"Doctor command usage:\n 807\u2192 \n 808\u2192   goz doctor\n 809\u2192 \n 810\u2192 Runs diagnostic checks:\n 811\u2192   - Config file exists\n 812\u2192   - API token is set\n 813\u2192   - API endpoint is reachable\n 814\u2192 \"\"\")\n 815\u2192         return\n 816\u2192 \n 817\u2192     async def run_doctor() -> None:\n 818\u2192         from goz.config import load_config, DEFAULT_CONFIG_FILE\n 819\u2192 \n 820\u2192         checks_passed = 0\n 821\u2192         checks_failed = 0\n 822\u2192 \n 823\u2192         # Check 1: Config file\n 824\u2192         print(\"Checking configuration...\")\n 825\u2192         if DEFAULT_CONFIG_FILE.exists():\n 826\u2192             print(f\"  [PASS] Config file found at {DEFAULT_CONFIG_FILE}\")\n 827\u2192             checks_passed += 1\n 828\u2192         else:\n 829\u2192             print(f\"  [FAIL] Config file not found at {DEFAULT_CONFIG_FILE}\")\n 830\u2192             print(\"         Run 'goz config' to set up.\")\n 831\u2192             checks_failed += 1\n 832\u2192 \n 833\u2192         # Check 2: Load config and validate token\n 834\u2192         try:\n 835\u2192             config = load_config()\n 836\u2192             if config.zai_token:\n 837\u2192                 masked = f\"****{config.zai_token[-4:]}\" if len(config.zai_token) > 4 else \"****\"\n 838\u2192                 print(f\"  [PASS] API token present ({masked})\")\n 839\u2192                 checks_passed += 1\n 840\u2192             else:\n 841\u2192                 print(\"  [FAIL] API token not set\")\n 842\u2192                 checks_failed += 1\n 843\u2192         except Exception as e:\n 844\u2192             print(f\"  [FAIL] Error loading config: {e}\")\n 845\u2192             checks_failed += 1\n 846\u2192             return\n 847\u2192 \n 848\u2192         # Check 3: API connectivity\n 849\u2192         try:\n 850\u2192             import httpx\n 851\u2192             async with httpx.AsyncClient(timeout=5.0) as client:\n 852\u2192                 await client.get(config.zai_base_url)\n 853\u2192                 print(f\"  [PASS] Base URL reachable ({config.zai_base_url})\")\n 854\u2192                 checks_passed += 1\n 855\u2192         except (httpx.ConnectError, httpx.NetworkError) as e:\n 856\u2192             print(f\"  [FAIL] Cannot connect to API: {e}\")\n 857\u2192             checks_failed += 1\n 858\u2192         except Exception as e:\n 859\u2192             print(f\"  [WARN] Could not test connectivity: {e}\")\n 860\u2192 \n 861\u2192         # Summary\n 862\u2192         print()\n 863\u2192         if checks_failed == 0:\n 864\u2192             print(f\"All checks passed! ({checks_passed}/{checks_passed})\")\n 865\u2192         else:\n 866\u2192             print(f\"Some checks failed: {checks_failed} failed, {checks_passed} passed\")\n 867\u2192 \n 868\u2192     asyncio.run(run_doctor())\n 869\u2192 \n 870\u2192 \n 871\u2192 def cmd_tui(args: list[str]) -> None:\n 872\u2192     \"\"\"Launch the TUI.\n 873\u2192 \n 874\u2192     Args:\n 875\u2192         args: Remaining arguments (ignored)\n 876\u2192     \"\"\"\n 877\u2192     from goz.tui import run_tui\n 878\u2192     run_tui()\n 879\u2192 \n 880\u2192 \n 881\u2192 def main() -> None:\n 882\u2192     \"\"\"Run the goz CLI.\n 883\u2192 \n 884\u2192     This is the entry point for the `goz` command.\n 885\u2192     \"\"\"\n 886\u2192     import argparse\n 887\u2192 \n 888\u2192     # Check for --help before argparse to handle it properly\n 889\u2192     if \"--help\" in sys.argv or \"-h\" in sys.argv:\n 890\u2192         print(f\"\"\"goz v{__version__} - Z.AI Tools\n 891\u2192 \n 892\u2192 Usage: goz <command> [args] [options]\n 893\u2192 \n 894\u2192 Commands:\n 895\u2192   run       One-shot agent run with JSONL output\n 896\u2192   vision    Image and video analysis\n 897\u2192   search    Real-time web search\n 898\u2192   read      Fetch and parse web pages\n 899\u2192   repo      GitHub repository exploration\n 900\u2192   tools     List MCP tools\n 901\u2192   tool      Show one MCP tool schema\n 902\u2192   call      Call an MCP tool directly\n 903\u2192   config    Manage configuration\n 904\u2192   doctor    Environment + connectivity checks\n 905\u2192   tui       Launch interactive terminal UI\n 906\u2192 \n 907\u2192 Global Options:\n 908\u2192   --help, -h     Show this help message\n 909\u2192   --version, -v  Show version number\n 910\u2192 \n 911\u2192 For command-specific help:\n 912\u2192   goz vision --help\n 913\u2192   goz run --help\n 914\u2192   goz search --help\n 915\u2192   goz read --help\n 916\u2192   goz repo --help\n 917\u2192   goz tools --help\n 918\u2192   goz tool --help\n 919\u2192   goz call --help\n 920\u2192   goz config --help\n 921\u2192   goz doctor --help\n 922\u2192 \n 923\u2192 Examples:\n 924\u2192   goz vision analyze https://example.com/image.png\n 925\u2192   goz run --format json \"Inspect this repo and report STAGE_RESULT.\"\n 926\u2192   goz vision ui-to-code screenshot.png\n 927\u2192   goz search \"python async await\"\n 928\u2192   goz read https://example.com/article\n 929\u2192   goz repo tree vercel/next.js\n 930\u2192   goz repo search facebook/react \"hooks\"\n 931\u2192   goz tools --filter vision\n 932\u2192   goz tool zai.vision.analyze_image\n 933\u2192   goz call zai.search.webSearchPrime --json '{{\"search_query\":\"test\"}}'\n 934\u2192   goz config get zai_token\n 935\u2192 \n 936\u2192 With no command, launches the interactive TUI.\n 937\u2192 \"\"\")\n 938\u2192         return\n 939\u2192 \n 940\u2192     parser = argparse.ArgumentParser(\n 941\u2192         prog=\"goz\",\n 942\u2192         description=\"goz - Z.AI Tools: vision, search, web reader, and more\",\n 943\u2192         add_help=False,  # We handle help manually\n 944\u2192     )\n 945\u2192     parser.add_argument(\n 946\u2192         \"--version\",\n 947\u2192         action=\"version\",\n 948\u2192         version=f\"%(prog)s {__version__}\",\n 949\u2192     )\n 950\u2192     # Agent mode flags (for use with no command)\n 951\u2192     parser.add_argument(\n 952\u2192         \"--load\",\n 953\u2192         help=\"Load session on startup (for agent mode)\",\n 954\u2192     )\n 955\u2192     parser.add_argument(\n 956\u2192         \"--agent\",\n 957\u2192         help=\"Start with specific agent type (for agent mode)\",\n 958\u2192     )\n 959\u2192     parser.add_argument(\n 960\u2192         \"command\",\n 961\u2192         nargs=\"?\",\n 962\u2192         help=\"Command to run (run, config, vision, search, read, repo, tools, tool, call, doctor, tui)\",\n 963\u2192     )\n 964\u2192     parser.add_argument(\n 965\u2192         \"args\",\n 966\u2192         nargs=argparse.REMAINDER,\n 967\u2192         help=\"Arguments for the command\",\n 968\u2192     )\n 969\u2192 \n 970\u2192     args = parser.parse_args()\n 971\u2192 \n 972\u2192     if args.command is None:\n 973\u2192         # No command = launch AGENT MODE (interactive coding agent)\n 974\u2192         from goz.agent.tui import run_agent_app\n 975\u2192         run_agent_app(session_id=args.load, agent_type=args.agent)\n 976\u2192         return\n 977\u2192 \n 978\u2192     # Dispatch to command handlers\n 979\u2192     if args.command == \"config\":\n 980\u2192         cmd_config(args.args)\n 981\u2192     elif args.command == \"vision\":\n 982\u2192         asyncio.run(cmd_vision(args.args))\n 983\u2192     elif args.command == \"run\":\n 984\u2192         asyncio.run(cmd_run(args.args))\n 985\u2192     elif args.command == \"search\":\n 986\u2192         asyncio.run(cmd_search(args.args))\n 987\u2192     elif args.command == \"read\":\n 988\u2192         asyncio.run(cmd_read(args.args))\n 989\u2192     elif args.command == \"repo\":\n 990\u2192         asyncio.run(cmd_repo(args.args))\n 991\u2192     elif args.command == \"tools\":\n 992\u2192         asyncio.run(cmd_tools(args.args))\n 993\u2192     elif args.command == \"tool\":\n 994\u2192         asyncio.run(cmd_tool(args.args))\n 995\u2192     elif args.command == \"call\":\n 996\u2192         asyncio.run(cmd_call(args.args))\n 997\u2192     elif args.command == \"doctor\":\n 998\u2192         cmd_doctor(args.args)\n 999\u2192     elif args.command in (\"tui\", \"ui\"):\n1000\u2192         cmd_tui(args.args)\n1001\u2192     else:\n1002\u2192         print(f\"Error: Unknown command '{args.command}'\", file=sys.stderr)\n1003\u2192         print(\"Run 'goz --help' for usage\", file=sys.stderr)\n1004\u2192         sys.exit(1)\n1005\u2192 \n1006\u2192 \n1007\u2192 if __name__ == \"__main__\":\n1008\u2192     main()", "is_error": false}}
