        chat_client = FakeChatClient([stream], config=config)\n118\u2192 \n119\u2192         await run_prompt_jsonl(\n120\u2192             \"Persist this run\",\n121\u2192             config=config,\n122\u2192             working_dir=str(tmp_path),\n123\u2192             stdout=stdout,\n124\u2192             chat_client=chat_client,\n125\u2192             session_dir=tmp_path / \"sessions\",\n126\u2192         )\n127\u2192 \n128\u2192         events = [json.loads(line) for line in stdout.getvalue().splitlines()]\n129\u2192         session_id = events[-1][\"part\"][\"session_id\"]\n130\u2192         session_path = tmp_path / \"sessions\" / f\"{session_id}.json\"\n131\u2192 \n132\u2192         assert session_path.exists()\n133\u2192         data = json.loads(session_path.read_text())\n134\u2192         assert data[\"id\"] == session_id\n135\u2192         assert data[\"working_directory\"] == str(tmp_path)\n136\u2192         assert data[\"agent_type\"] == \"engine\"\n137\u2192         assert data[\"messages\"][0][\"role\"] == \"user\"\n138\u2192         assert data[\"messages\"][1][\"role\"] == \"assistant\"\n139\u2192         assert data[\"tool_state\"][\"working_directory\"] == str(tmp_path)\n140\u2192         assert data[\"tool_state\"][\"tools\"][\"bash\"][\"working_dir\"] == str(tmp_path)\n141\u2192 \n142\u2192     @pytest.mark.asyncio\n143\u2192     async def test_resume_session_reuses_saved_history(self, config, tmp_path):\n144\u2192         first_stream = [\n145\u2192             MessageStart(id=\"msg_1\", model=\"test-model\"),\n146\u2192             ContentBlockStart(type=\"text\", index=0),\n147\u2192             ContentBlockDelta(\n148\u2192                 type=\"text_delta\",\n149\u2192                 index=0,\n150\u2192                 text='STAGE_RESULT:\\n{\"verdict\":\"pass\",\"summary\":\"first\",\"files_changed\":[],\"tests\":{\"added\":0,\"passing\":1},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\\n',\n151\u2192             ),\n152\u2192             ContentBlockStop(index=0),\n153\u2192             MessageStop(stop_reason=\"end_turn\"),\n154\u2192         ]\n155\u2192         second_stream = [\n156\u2192             MessageStart(id=\"msg_2\", model=\"test-model\"),\n157\u2192             ContentBlockStart(type=\"text\", index=0),\n158\u2192             ContentBlockDelta(\n159\u2192                 type=\"text_delta\",\n160\u2192                 index=0,\n161\u2192                 text='STAGE_RESULT:\\n{\"verdict\":\"pass\",\"summary\":\"second\",\"files_changed\":[],\"tests\":{\"added\":0,\"passing\":2},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\\n',\n162\u2192             ),\n163\u2192             ContentBlockStop(index=0),\n164\u2192             MessageStop(stop_reason=\"end_turn\"),\n165\u2192         ]\n166\u2192         first_stdout = io.StringIO()\n167\u2192         second_stdout = io.StringIO()\n168\u2192         session_dir = tmp_path / \"sessions\"\n169\u2192 \n170\u2192         first_client = FakeChatClient([first_stream], config=config)\n171\u2192         await run_prompt_jsonl(\n172\u2192             \"First turn\",\n173\u2192             config=config,\n174\u2192             working_dir=str(tmp_path),\n175\u2192             stdout=first_stdout,\n176\u2192             chat_client=first_client,\n177\u2192             session_dir=session_dir,\n178\u2192         )\n179\u2192         first_events = [json.loads(line) for line in first_stdout.getvalue().splitlines()]\n180\u2192         session_id = first_events[-1][\"part\"][\"session_id\"]\n181\u2192 \n182\u2192         second_client = FakeChatClient([second_stream], config=config)\n183\u2192         await run_prompt_jsonl(\n184\u2192             \"Second turn\",\n185\u2192             config=config,\n186\u2192             working_dir=\"/unused\",\n187\u2192             stdout=second_stdout,\n188\u2192             chat_client=second_client,\n189\u2192             resume_session_id=session_id,\n190\u2192             session_dir=session_dir,\n191\u2192         )\n192\u2192 \n193\u2192         second_call_messages = second_client.calls[0][\"messages\"]\n194\u2192         assert second_call_messages[0][\"content\"].startswith(\"First turn\")\n195\u2192         assert \"second\" not in second_call_messages[0][\"content\"].lower()\n196\u2192         assert second_call_messages[1][\"role\"] == \"assistant\"\n197\u2192         assert second_call_messages[2][\"content\"].startswith(\"Second turn\")\n198\u2192 \n199\u2192     @pytest.mark.asyncio\n200\u2192     async def test_saves_session_on_interrupt(self, config, tmp_path, monkeypatch):\n201\u2192         wait_for_interrupt = asyncio.Event()\n202\u2192         registered_handlers: dict[int, object] = {}\n203\u2192 \n204\u2192         class HangingChatClient:\n205\u2192             def __init__(self, *, config):\n206\u2192                 self.config = config\n207\u2192 \n208\u2192             def chat_completion(self, **kwargs):\n209\u2192                 async def iterator():\n210\u2192                     await wait_for_interrupt.wait()\n211\u2192                     yield ContentBlockDelta(type=\"text_delta\", index=0, text=\"unreachable\")\n212\u2192 \n213\u2192                 return iterator()\n214\u2192 \n215\u2192         loop = asyncio.get_running_loop()\n216\u2192 \n217\u2192         def fake_add_signal_handler(signum, callback):\n218\u2192             registered_handlers[signum] = callback\n219\u2192 \n220\u2192         def fake_remove_signal_handler(signum):\n221\u2192             registered_handlers.pop(signum, None)\n222\u2192 \n223\u2192         monkeypatch.setattr(loop, \"add_signal_handler\", fake_add_signal_handler)\n224\u2192         monkeypatch.setattr(loop, \"remove_signal_handler\", fake_remove_signal_handler)\n225\u2192 \n226\u2192         task = asyncio.create_task(\n227\u2192             run_prompt_jsonl(\n228\u2192                 \"Interrupt me\",\n229\u2192                 config=config,\n230\u2192                 working_dir=str(tmp_path),\n231\u2192                 stdout=io.StringIO(),\n232\u2192                 chat_client=HangingChatClient(config=config),\n233\u2192                 session_dir=tmp_path / \"sessions\",\n234\u2192             )\n235\u2192         )\n236\u2192 \n237\u2192         await asyncio.sleep(0)\n238\u2192         registered_handlers[signal.SIGTERM]()\n239\u2192         wait_for_interrupt.set()\n240\u2192         exit_code = await task\n241\u2192 \n242\u2192         session_files = list((tmp_path / \"sessions\").glob(\"*.json\"))\n243\u2192         assert exit_code == 1\n244\u2192         assert len(session_files) == 1\n245\u2192         data = json.loads(session_files[0].read_text())\n246\u2192         assert data[\"messages\"][0][\"content\"].startswith(\"Interrupt me\")\n247\u2192 \n248\u2192     @pytest.mark.asyncio\n249\u2192     async def test_raises_when_chat_fails(self, config, tmp_path):\n250\u2192         class FailingChatClient:\n251\u2192             def chat_completion(self, **kwargs):\n252\u2192                 async def iterator():\n253\u2192                     raise RuntimeError(\"boom\")\n254\u2192                     yield\n255\u2192 \n256\u2192                 return iterator()\n257\u2192 \n258\u2192         stdout = io.StringIO()\n259\u2192         with pytest.raises(RuntimeError):\n260\u2192             await run_prompt_jsonl(\n261\u2192                 \"fail\",\n262\u2192                 config=config,\n263\u2192                 working_dir=str(tmp_path),\n264\u2192                 stdout=stdout,\n265\u2192                 chat_client=FailingChatClient(),\n266\u2192             )\n267\u2192 \n268\u2192     def test_build_default_tool_registry_uses_working_directory(self, config, tmp_path):\n269\u2192         registry = build_default_tool_registry(config, str(tmp_path))\n270\u2192 \n271\u2192         assert registry.get(\"bash\").working_dir == str(tmp_path)\n272\u2192         assert registry.get(\"view_file\").working_dir == str(tmp_path)\n273\u2192         assert registry.get(\"create_file\").working_dir == str(tmp_path)\n274\u2192         assert registry.get(\"str_replace_editor\").working_dir == str(tmp_path)\n275\u2192 \n276\u2192 \n277\u2192 class TestRunCli:\n278\u2192     def test_goz_run_cli_supports_model_override_and_json_output(self, config, capsys):\n279\u2192         observed = {}\n280\u2192 \n281\u2192         async def fake_run(\n282\u2192             prompt,\n283\u2192             *,\n284\u2192             config,\n285\u2192             working_dir,\n286\u2192             stdout=None,\n287\u2192             tool_registry=None,\n288\u2192             chat_client=None,\n289\u2192             resume_session_id=None,\n290\u2192             session_dir=None,\n291\u2192         ):\n292\u2192             observed[\"prompt\"] = prompt\n293\u2192             observed[\"model\"] = config.chat_model\n294\u2192             observed[\"working_dir\"] = working_dir\n295\u2192             observed[\"resume_session_id\"] = resume_session_id\n296\u2192             print(json.dumps({\"type\": \"text\", \"part\": {\"text\": \"ok\"}}))\n297\u2192             print(json.dumps({\"type\": \"step_finish\", \"part\": {\"tokens\": {\"input\": 0, \"output\": 0, \"cache_creation\": 0, \"cache_read\": 0}, \"cost\": 0, \"session_id\": \"session-1\", \"continuation\": {\"resume_session_id\": \"session-1\"}}}))\n298\u2192             return 0\n299\u2192 \n300\u2192         with patch(\"goz.cli.run.load_config\", return_value=config), patch(\"goz.cli.run.run_prompt_jsonl\", side_effect=fake_run):\n301\u2192             from goz.__main__ import main\n302\u2192 \n303\u2192             sys.argv = [\"goz\", \"run\", \"--format\", \"json\", \"--dir\", \".\", \"--model\", \"override-model\", \"hello\", \"world\"]\n304\u2192             main()\n305\u2192 \n306\u2192         captured = capsys.readouterr()\n307\u2192         events = [json.loads(line) for line in captured.out.splitlines()]\n308\u2192         assert events[0][\"type\"] == \"text\"\n309\u2192         assert events[1][\"type\"] == \"step_finish\"\n310\u2192         assert observed == {\n311\u2192             \"prompt\": \"hello world\",\n312\u2192             \"model\": \"override-model\",\n313\u2192             \"working_dir\": str(Path(\".\").resolve()),\n314\u2192             \"resume_session_id\": None,\n315\u2192         }\n316\u2192 \n317\u2192     def test_goz_run_cli_supports_resume_session_without_prompt(self, config, capsys):\n318\u2192         observed = {}\n319\u2192 \n320\u2192         async def fake_run(\n321\u2192             prompt,\n322\u2192             *,\n323\u2192             config,\n324\u2192             working_dir,\n325\u2192             stdout=None,\n326\u2192             tool_registry=None,\n327\u2192             chat_client=None,\n328\u2192             resume_session_id=None,\n329\u2192             session_dir=None,\n330\u2192         ):\n331\u2192             observed[\"prompt\"] = prompt\n332\u2192             observed[\"resume_session_id\"] = resume_session_id\n333\u2192             print(json.dumps({\"type\": \"step_finish\", \"part\": {\"tokens\": {\"input\": 0, \"output\": 0, \"cache_creation\": 0, \"cache_read\": 0}, \"cost\": 0, \"session_id\": resume_session_id, \"continuation\": {\"resume_session_id\": resume_session_id}}}))\n334\u2192             return 0\n335\u2192 \n336\u2192         with patch(\"goz.cli.run.load_config\", return_value=config), patch(\"goz.cli.run.run_prompt_jsonl\", side_effect=fake_run):\n337\u2192             from goz.__main__ import main\n338\u2192 \n339\u2192             sys.argv = [\"goz\", \"run\", \"--format\", \"json\", \"--resume-session\", \"resume-123\"]\n340\u2192             main()\n341\u2192 \n342\u2192         captured = capsys.readouterr()\n343\u2192         events = [json.loads(line) for line in captured.out.splitlines()]\n344\u2192         assert events[0][\"part\"][\"session_id\"] == \"resume-123\"\n345\u2192         assert observed == {\n346\u2192             \"prompt\": \"\",\n347\u2192             \"resume_session_id\": \"resume-123\",\n348\u2192         }\n349\u2192 \n350\u2192     def test_goz_run_cli_emits_error_and_nonzero_exit(self, config, capsys):\n351\u2192         with patch(\"goz.cli.run.load_config\", return_value=config), patch(\n352\u2192             \"goz.cli.run.run_prompt_jsonl\",\n353\u2192             side_effect=RuntimeError(\"bad run\"),\n354\u2192         ):\n355\u2192             from goz.__main__ import main\n356\u2192 \n357\u2192             sys.argv = [\"goz\", \"run\", \"--format\", \"json\", \"hello\"]\n358\u2192             with pytest.raises(SystemExit) as excinfo:\n359\u2192                 main()\n360\u2192 \n361\u2192         captured = capsys.readouterr()\n362\u2192         event = json.loads(captured.out.strip())\n363\u2192         assert excinfo.value.code == 1\n364\u2192         assert event == {\n365\u2192             \"type\": \"error\",\n366\u2192             \"error\": {\n367\u2192                 \"name\": \"RuntimeError\",\n368\u2192                 \"data\": {\"message\": \"bad run\"},\n369\u2192             },\n370\u2192         }", "is_error": false}}
