{"type": "tool_use", "part": {"id": "call_a01dd61fbf734bfcab7af8a2", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/chat_client.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/chat_client.py (453 lines)\n============================================================\n\n  1\u2192 \"\"\"Chat API Client for Z.AI (Issue 17).\n  2\u2192 \n  3\u2192 This module provides the ChatClient class for interacting with the Z.AI\n  4\u2192 chat API using the Anthropic SDK with tool calling support.\n  5\u2192 \n  6\u2192 Acceptance Criteria:\n  7\u2192 1. ChatClient class exists in goz/agent/chat_client.py\n  8\u2192 2. Uses existing Anthropic SDK (same as Vision API)\n  9\u2192 3. Uses config.zai_token and config.zai_base_url\n 10\u2192 4. chat_completion() method sends messages and returns async iterator\n 11\u2192 5. Supports tools parameter for function calling\n 12\u2192 6. Supports tool_choice parameter (\"auto\", \"any\")\n 13\u2192 7. Supports stream parameter (True/False)\n 14\u2192 8. Response chunks yield text deltas\n 15\u2192 9. Tool calls are properly formatted in stream\n 16\u2192 10. Errors raised as appropriate exceptions (AuthError, ApiError, etc.)\n 17\u2192 11. Timeout configurable via config\n 18\u2192 \"\"\"\n 19\u2192 import asyncio\n 20\u2192 import json\n 21\u2192 from dataclasses import dataclass\n 22\u2192 from typing import Any, AsyncIterator, Literal\n 23\u2192 \n 24\u2192 import anthropic\n 25\u2192 from anthropic import AsyncAnthropic\n 26\u2192 \n 27\u2192 from goz.api.errors import AuthError, ApiError, NetworkError, TimeoutError, ZaiError\n 28\u2192 from goz.config import Config\n 29\u2192 \n 30\u2192 \n 31\u2192 # Chunk types for streaming responses (from spec)\n 32\u2192 @dataclass\n 33\u2192 class ContentBlockStart:\n 34\u2192     \"\"\"Start of a content block in the stream.\n 35\u2192 \n 36\u2192     Attributes:\n 37\u2192         type: The type of content block (\"text\" or \"tool_use\")\n 38\u2192         index: The index of this content block\n 39\u2192         id: Tool call ID (only for tool_use type)\n 40\u2192         name: Tool name (only for tool_use type)\n 41\u2192     \"\"\"\n 42\u2192     type: Literal[\"text\", \"tool_use\"]\n 43\u2192     index: int\n 44\u2192     id: str | None = None\n 45\u2192     name: str | None = None\n 46\u2192 \n 47\u2192 \n 48\u2192 @dataclass\n 49\u2192 class ContentBlockDelta:\n 50\u2192     \"\"\"Delta for a content block in the stream.\n 51\u2192 \n 52\u2192     Attributes:\n 53\u2192         type: The type of delta (\"text_delta\" or \"input_json_delta\")\n 54\u2192         index: The index of this content block\n 55\u2192         text: Text content (only for text_delta type)\n 56\u2192         partial_json: Partial JSON string (only for input_json_delta type)\n 57\u2192     \"\"\"\n 58\u2192     type: Literal[\"text_delta\", \"input_json_delta\"]\n 59\u2192     index: int\n 60\u2192     text: str | None = None\n 61\u2192     partial_json: str | None = None\n 62\u2192 \n 63\u2192 \n 64\u2192 @dataclass\n 65\u2192 class ContentBlockStop:\n 66\u2192     \"\"\"End of a content block in the stream.\n 67\u2192 \n 68\u2192     Attributes:\n 69\u2192         index: The index of this content block\n 70\u2192     \"\"\"\n 71\u2192     index: int\n 72\u2192 \n 73\u2192 \n 74\u2192 @dataclass\n 75\u2192 class MessageStart:\n 76\u2192     \"\"\"Start of the message.\n 77\u2192 \n 78\u2192     Attributes:\n 79\u2192         id: Message ID\n 80\u2192         model: Model name\n 81\u2192     \"\"\"\n 82\u2192     id: str\n 83\u2192     model: str\n 84\u2192 \n 85\u2192 \n 86\u2192 @dataclass\n 87\u2192 class MessageStop:\n 88\u2192     \"\"\"End of the message.\n 89\u2192 \n 90\u2192     Attributes:\n 91\u2192         stop_reason: Reason for stopping (\"end_turn\", \"max_tokens\", \"tool_use\")\n 92\u2192     \"\"\"\n 93\u2192     stop_reason: Literal[\"end_turn\", \"max_tokens\", \"tool_use\"]\n 94\u2192 \n 95\u2192 \n 96\u2192 # Union type for all chunk types\n 97\u2192 Chunk = ContentBlockStart | ContentBlockDelta | ContentBlockStop | MessageStart | MessageStop\n 98\u2192 \n 99\u2192 \n100\u2192 class ChatClient:\n101\u2192     \"\"\"Client for Z.AI Chat API with tool calling support.\n102\u2192 \n103\u2192     This client uses the Anthropic SDK to interact with the Z.AI chat API,\n104\u2192     supporting streaming responses, tool calling, and various generation\n105\u2192     parameters.\n106\u2192 \n107\u2192     Attributes:\n108\u2192         config: Configuration object containing API credentials and settings\n109\u2192         _client: Internal AsyncAnthropic client instance\n110\u2192     \"\"\"\n111\u2192 \n112\u2192     def __init__(self, config: Config | None = None) -> None:\n113\u2192         \"\"\"Initialize ChatClient.\n114\u2192 \n115\u2192         Args:\n116\u2192             config: Optional config object. If not provided, loads from default location.\n117\u2192 \n118\u2192         Acceptance Criteria:\n119\u2192         - Uses config.zai_token and config.zai_base_url (AC 3)\n120\u2192         - Uses AsyncAnthropic from existing SDK (AC 2)\n121\u2192         - Timeout is configurable via config (AC 11)\n122\u2192         \"\"\"\n123\u2192         if config is None:\n124\u2192             from goz.config import load_config\n125\u2192             config = load_config()\n126\u2192 \n127\u2192         self.config = config\n128\u2192 \n129\u2192         # Initialize async Anthropic client (same pattern as VisionClient)\n130\u2192         self._client = AsyncAnthropic(\n131\u2192             api_key=self.config.zai_token,\n132\u2192             base_url=self.config.zai_base_url,\n133\u2192             timeout=self.config.timeout,\n134\u2192         )\n135\u2192         self.max_retries = 2\n136\u2192         self.base_retry_delay = 1.0\n137\u2192 \n138\u2192     async def chat_completion(\n139\u2192         self,\n140\u2192         messages: list[dict],\n141\u2192         tools: list[dict] | None = None,\n142\u2192         tool_choice: Literal[\"auto\", \"any\", \"none\"] | dict = \"auto\",\n143\u2192         stream: bool = True,\n144\u2192         temperature: float | None = None,\n145\u2192         max_tokens: int | None = None,\n146\u2192     ) -> AsyncIterator[Chunk]:\n147\u2192         \"\"\"Stream chat completion with tool calling support.\n148\u2192 \n149\u2192         Args:\n150\u2192             messages: Chat history in Anthropic format\n151\u2192             tools: Tool definitions in Anthropic format (optional)\n152\u2192             tool_choice: How to select tools (\"auto\", \"any\", \"none\", or specific tool dict)\n153\u2192             stream: Whether to stream response (True) or wait for complete response (False)\n154\u2192             temperature: Generation temperature (uses config default if None)\n155\u2192             max_tokens: Max tokens in response (uses config default if None)\n156\u2192 \n157\u2192         Yields:\n158\u2192             Chunk objects from the API response\n159\u2192 \n160\u2192         Raises:\n161\u2192             AuthError: For 401/403 authentication failures\n162\u2192             ApiError: For other API errors (4xx, 5xx)\n163\u2192             NetworkError: For connection failures\n164\u2192             TimeoutError: For request timeouts\n165\u2192 \n166\u2192         Acceptance Criteria:\n167\u2192         - Returns async iterator (AC 4)\n168\u2192         - Supports tools parameter (AC 5)\n169\u2192         - Supports tool_choice parameter (AC 6)\n170\u2192         - Supports stream parameter (AC 7)\n171\u2192         - Response chunks yield text deltas (AC 8)\n172\u2192         - Tool calls properly formatted in stream (AC 9)\n173\u2192         - Errors raised as appropriate exceptions (AC 10)\n174\u2192         \"\"\"\n175\u2192         # Build request parameters\n176\u2192         params: dict = {\n177\u2192             \"model\": self.config.chat_model,\n178\u2192             \"messages\": messages,\n179\u2192         }\n180\u2192 \n181\u2192         # Add optional parameters\n182\u2192         if tools is not None:\n183\u2192             params[\"tools\"] = tools\n184\u2192 \n185\u2192         if tool_choice != \"auto\":\n186\u2192             params[\"tool_choice\"] = tool_choice\n187\u2192 \n188\u2192         if temperature is not None:\n189\u2192             params[\"temperature\"] = temperature\n190\u2192         else:\n191\u2192             params[\"temperature\"] = self.config.temperature\n192\u2192 \n193\u2192         if max_tokens is not None:\n194\u2192             params[\"max_tokens\"] = max_tokens\n195\u2192         else:\n196\u2192             params[\"max_tokens\"] = self.config.max_tokens\n197\u2192 \n198\u2192         timeout_ms = int(self.config.timeout * 1000)\n199\u2192 \n200\u2192         for attempt in range(self.max_retries + 1):\n201\u2192             try:\n202\u2192                 if stream:\n203\u2192                     async with self._client.messages.stream(**params) as response_stream:\n204\u2192                         async for event in response_stream:\n205\u2192                             chunk = self._convert_sse_event_to_chunk(event)\n206\u2192                             if chunk is not None:\n207\u2192                                 yield chunk\n208\u2192                 else:\n209\u2192                     response = await self._client.messages.create(**params)\n210\u2192                     async for chunk in self._response_to_chunks(response):\n211\u2192                         yield chunk\n212\u2192                 return\n213\u2192             except anthropic.AuthenticationError as e:\n214\u2192                 status_code = getattr(getattr(e, \"response\", None), \"status_code\", 401)\n215\u2192                 raise AuthError(\n216\u2192                     \"Authentication failed. Check your API token and try again.\",\n217\u2192                     statusCode=status_code,\n218\u2192                 ) from e\n219\u2192             except anthropic.APITimeoutError as e:\n220\u2192                 timeout_error = TimeoutError(timeoutMs=timeout_ms)\n221\u2192                 if attempt >= self.max_retries:\n222\u2192                     raise timeout_error from e\n223\u2192                 await self._sleep_before_retry(attempt)\n224\u2192             except anthropic.APIConnectionError as e:\n225\u2192                 network_error = NetworkError(\n226\u2192                     \"Connection failed while contacting the API. Check your network and retry.\"\n227\u2192                 )\n228\u2192                 if attempt >= self.max_retries:\n229\u2192                     raise network_error from e\n230\u2192                 await self._sleep_before_retry(attempt)\n231\u2192             except anthropic.APIStatusError as e:\n232\u2192                 status_code = getattr(e, \"status_code\", None) or getattr(\n233\u2192                     getattr(e, \"response\", None), \"status_code\", 500\n234\u2192                 )\n235\u2192                 if status_code in (401, 403):\n236\u2192                     raise AuthError(\n237\u2192                         \"Authentication failed. Check your API token and try again.\",\n238\u2192                         statusCode=status_code,\n239\u2192                     ) from e\n240\u2192 \n241\u2192                 if status_code == 429:\n242\u2192                     api_error = ApiError(\n243\u2192                         \"Rate limit exceeded. Wait a moment and retry, or reduce request volume.\",\n244\u2192                         statusCode=status_code,\n245\u2192                     )\n246\u2192                 elif status_code >= 500:\n247\u2192                     api_error = ApiError(\n248\u2192                         \"Server error from the API. Retry shortly; the service may be degraded.\",\n249\u2192                         statusCode=status_code,\n250\u2192                     )\n251\u2192                 else:\n252\u2192                     api_error = ApiError(str(e), statusCode=status_code)\n253\u2192 \n254\u2192                 if attempt >= self.max_retries or status_code < 500 and status_code != 429:\n255\u2192                     raise api_error from e\n256\u2192                 await self._sleep_before_retry(attempt)\n257\u2192             except Exception as e:\n258\u2192                 raise ZaiError(f\"Unexpected error: {e}\") from e\n259\u2192 \n260\u2192     def _convert_sse_event_to_chunk(self, event: anthropic.types.RawMessageStreamEvent) -> Chunk | None:\n261\u2192         \"\"\"Convert Anthropic SSE event to our Chunk type.\n262\u2192 \n263\u2192         Args:\n264\u2192             event: Raw SSE event from Anthropic SDK\n265\u2192 \n266\u2192         Returns:\n267\u2192             Chunk object or None if event type not handled\n268\u2192         \"\"\"\n269\u2192         event_type = event.type\n270\u2192 \n271\u2192         if event_type == \"message_start\":\n272\u2192             return MessageStart(\n273\u2192                 id=event.message.id,\n274\u2192                 model=event.message.model,\n275\u2192             )\n276\u2192 \n277\u2192         elif event_type == \"content_block_start\":\n278\u2192             content_block = event.content_block\n279\u2192             if content_block.type == \"text\":\n280\u2192                 return ContentBlockStart(\n281\u2192                     type=\"text\",\n282\u2192                     index=event.index,\n283\u2192                 )\n284\u2192             elif content_block.type == \"tool_use\":\n285\u2192                 return ContentBlockStart(\n286\u2192                     type=\"tool_use\",\n287\u2192                     index=event.index,\n288\u2192                     id=content_block.id,\n289\u2192                     name=content_block.name,\n290\u2192                 )\n291\u2192 \n292\u2192         elif event_type == \"content_block_delta\":\n293\u2192             delta = event.delta\n294\u2192             if delta.type == \"text_delta\":\n295\u2192                 return ContentBlockDelta(\n296\u2192                     type=\"text_delta\",\n297\u2192                     index=event.index,\n298\u2192                     text=delta.text,\n299\u2192                 )\n300\u2192             elif delta.type == \"input_json_delta\":\n301\u2192                 return ContentBlockDelta(\n302\u2192                     type=\"input_json_delta\",\n303\u2192                     index=event.index,\n304\u2192                     partial_json=delta.partial_json,\n305\u2192                 )\n306\u2192 \n307\u2192         elif event_type == \"content_block_stop\":\n308\u2192             return ContentBlockStop(index=event.index)\n309\u2192 \n310\u2192         elif event_type == \"message_stop\":\n311\u2192             return MessageStop(stop_reason=event.message.stop_reason)\n312\u2192 \n313\u2192         # Return None for unhandled event types\n314\u2192         return None\n315\u2192 \n316\u2192     async def _response_to_chunks(self, response: anthropic.types.Message) -> AsyncIterator[Chunk]:\n317\u2192         \"\"\"Convert non-streaming response to chunk stream.\n318\u2192 \n319\u2192         Args:\n320\u2192             response: Complete response from messages.create()\n321\u2192 \n322\u2192         Yields:\n323\u2192             Chunk objects representing the response\n324\u2192         \"\"\"\n325\u2192         # Yield message start\n326\u2192         yield MessageStart(id=response.id, model=response.model)\n327\u2192 \n328\u2192         # Yield content blocks\n329\u2192         for index, block in enumerate(response.content):\n330\u2192             if block.type == \"text\":\n331\u2192                 yield ContentBlockStart(type=\"text\", index=index)\n332\u2192                 yield ContentBlockDelta(type=\"text_delta\", index=index, text=block.text)\n333\u2192                 yield ContentBlockStop(index=index)\n334\u2192 \n335\u2192             elif block.type == \"tool_use\":\n336\u2192                 yield ContentBlockStart(\n337\u2192                     type=\"tool_use\",\n338\u2192                     index=index,\n339\u2192                     id=block.id,\n340\u2192                     name=block.name,\n341\u2192                 )\n342\u2192                 # Yield the input JSON as a single delta\n343\u2192                 input_json = json.dumps(block.input)\n344\u2192                 yield ContentBlockDelta(\n345\u2192                     type=\"input_json_delta\",\n346\u2192                     index=index,\n347\u2192                     partial_json=input_json,\n348\u2192                 )\n349\u2192                 yield ContentBlockStop(index=index)\n350\u2192 \n351\u2192         # Yield message stop\n352\u2192         yield MessageStop(stop_reason=response.stop_reason)\n353\u2192 \n354\u2192     async def _sleep_before_retry(self, attempt: int) -> None:\n355\u2192         \"\"\"Sleep using exponential backoff before retrying.\"\"\"\n356\u2192         await asyncio.sleep(self.base_retry_delay * (2 ** attempt))\n357\u2192 \n358\u2192     async def extract_tool_calls(\n359\u2192         self,\n360\u2192         chunks: list[Chunk],\n361\u2192     ) -> list[dict]:\n362\u2192         \"\"\"Extract tool calls from accumulated stream chunks.\n363\u2192 \n364\u2192         This method processes a list of chunks and extracts complete\n365\u2192         tool_call objects by accumulating partial_json deltas.\n366\u2192 \n367\u2192         Args:\n368\u2192             chunks: List of chunks from a stream\n369\u2192 \n370\u2192         Returns:\n371\u2192             List of tool_call dicts with id, name, and input keys\n372\u2192 \n373\u2192         Example:\n374\u2192             >>> chunks = []\n375\u2192             >>> async for chunk in client.chat_completion(messages, tools=tools):\n376\u2192             ...     chunks.append(chunk)\n377\u2192             >>> tool_calls = await client.extract_tool_calls(chunks)\n378\u2192         \"\"\"\n379\u2192         tool_calls: list[dict] = []\n380\u2192         current_tool: dict[str, Any] | None = None\n381\u2192         accumulated_json: list[str] = []\n382\u2192 \n383\u2192         for chunk in chunks:\n384\u2192             if isinstance(chunk, ContentBlockStart) and chunk.type == \"tool_use\":\n385\u2192                 # Start of a new tool call\n386\u2192                 current_tool = {\n387\u2192                     \"id\": chunk.id,\n388\u2192                     \"name\": chunk.name,\n389\u2192                     \"input\": {},\n390\u2192                 }\n391\u2192                 accumulated_json = []\n392\u2192 \n393\u2192             elif isinstance(chunk, ContentBlockDelta) and chunk.type == \"input_json_delta\":\n394\u2192                 # Accumulate partial JSON\n395\u2192                 if chunk.partial_json:\n396\u2192                     accumulated_json.append(chunk.partial_json)\n397\u2192 \n398\u2192             elif isinstance(chunk, ContentBlockStop) and current_tool is not None:\n399\u2192                 # End of current tool call - parse accumulated JSON\n400\u2192                 if accumulated_json:\n401\u2192                     try:\n402\u2192                         json_str = \"\".join(accumulated_json)\n403\u2192                         current_tool[\"input\"] = json.loads(json_str)\n404\u2192                     except json.JSONDecodeError:\n405\u2192                         # If JSON is incomplete, keep as string\n406\u2192                         current_tool[\"input\"] = {\"raw\": \"\".join(accumulated_json)}\n407\u2192 \n408\u2192                 tool_calls.append(current_tool)\n409\u2192                 current_tool = None\n410\u2192                 accumulated_json = []\n411\u2192 \n412\u2192         return tool_calls\n413\u2192 \n414\u2192     async def simple_chat(\n415\u2192         self,\n416\u2192         message: str,\n417\u2192         system_prompt: str | None = None,\n418\u2192     ) -> str:\n419\u2192         \"\"\"Simple chat without streaming or tool calling.\n420\u2192 \n421\u2192         This is a convenience method for basic chat interactions.\n422\u2192 \n423\u2192         Args:\n424\u2192             message: User message\n425\u2192             system_prompt: Optional system prompt\n426\u2192 \n427\u2192         Returns:\n428\u2192             Complete response text\n429\u2192         \"\"\"\n430\u2192         messages: list[dict] = [{\"role\": \"user\", \"content\": message}]\n431\u2192 \n432\u2192         params: dict = {\n433\u2192             \"model\": self.config.chat_model,\n434\u2192             \"messages\": messages,\n435\u2192             \"max_tokens\": self.config.max_tokens,\n436\u2192         }\n437\u2192 \n438\u2192         if system_prompt:\n439\u2192             params[\"system\"] = system_prompt\n440\u2192 \n441\u2192         try:\n442\u2192             response = await self._client.messages.create(**params)\n443\u2192             return response.content[0].text\n444\u2192         except anthropic.AuthenticationError as e:\n445\u2192             raise AuthError(str(e))\n446\u2192         except anthropic.APITimeoutError as e:\n447\u2192             raise TimeoutError(timeoutMs=int(self.config.timeout * 1000))\n448\u2192         except anthropic.APIConnectionError as e:\n449\u2192             raise NetworkError(str(e))\n450\u2192         except anthropic.APIStatusError as e:\n451\u2192             raise ApiError(str(e), statusCode=e.status_code)\n452\u2192         except Exception as e:\n453\u2192             raise ZaiError(f\"Unexpected error: {e}\")", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_7516461a71194619b5ce41d7", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/stream_processor.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/stream_processor.py (292 lines)\n============================================================\n\n  1\u2192 \"\"\"Stream Processor for handling Anthropic API streaming responses.\n  2\u2192 \n  3\u2192 This module provides the StreamProcessor class for processing streaming\n  4\u2192 responses from the Anthropic-compatible Z.AI API, extracting text chunks\n  5\u2192 for real-time UI updates and parsing tool calls.\n  6\u2192 \n  7\u2192 Acceptance Criteria (Issue 16):\n  8\u2192 1. StreamProcessor class exists\n  9\u2192 2. process_stream() method takes async iterator of chunks\n 10\u2192 3. Returns ProcessedStream with: full_text, tool_calls, raw_chunks\n 11\u2192 4. extract_tool_calls() parses tool calls from chunks\n 12\u2192 5. Handles partial_json accumulation\n 13\u2192 6. Handles multiple tool calls in one response\n 14\u2192 7. Yields text chunks for real-time UI updates\n 15\u2192 \"\"\"\n 16\u2192 import asyncio\n 17\u2192 import json\n 18\u2192 import logging\n 19\u2192 from dataclasses import dataclass, field\n 20\u2192 from typing import Any, AsyncIterator\n 21\u2192 \n 22\u2192 from goz.config import Config\n 23\u2192 \n 24\u2192 \n 25\u2192 logger = logging.getLogger(__name__)\n 26\u2192 \n 27\u2192 \n 28\u2192 @dataclass\n 29\u2192 class ToolCall:\n 30\u2192     \"\"\"Represents a tool call extracted from a streaming response.\n 31\u2192 \n 32\u2192     Attributes:\n 33\u2192         id: The unique identifier for this tool call\n 34\u2192         name: The name of the tool being called\n 35\u2192         arguments: The arguments passed to the tool (as a dict)\n 36\u2192 \n 37\u2192     Acceptance Criteria 8: ToolCall dataclass: id, name, arguments\n 38\u2192     \"\"\"\n 39\u2192     id: str\n 40\u2192     name: str\n 41\u2192     arguments: dict[str, Any] = field(default_factory=dict)\n 42\u2192 \n 43\u2192 \n 44\u2192 @dataclass\n 45\u2192 class ProcessedStream:\n 46\u2192     \"\"\"Result of processing a complete API stream.\n 47\u2192 \n 48\u2192     Attributes:\n 49\u2192         full_text: The complete accumulated text from the stream\n 50\u2192         tool_calls: List of tool calls extracted from the stream\n 51\u2192         raw_chunks: All raw chunks received (for debugging/replay)\n 52\u2192 \n 53\u2192     Acceptance Criteria 9: ProcessedStream dataclass: full_text, tool_calls, raw_chunks\n 54\u2192     \"\"\"\n 55\u2192     full_text: str\n 56\u2192     tool_calls: list[ToolCall]\n 57\u2192     raw_chunks: list[Any] = field(default_factory=list)\n 58\u2192 \n 59\u2192 \n 60\u2192 class StreamProcessor:\n 61\u2192     \"\"\"Processes streaming responses from Anthropic API.\n 62\u2192 \n 63\u2192     This class handles streaming responses from the Z.AI Anthropic-compatible API.\n 64\u2192     It accumulates text chunks for real-time UI updates and extracts tool calls\n 65\u2192     from content blocks.\n 66\u2192 \n 67\u2192     Acceptance Criteria 1: StreamProcessor class exists\n 68\u2192     Acceptance Criteria 2: process_stream() method takes async iterator of chunks\n 69\u2192 \n 70\u2192     Chunk Types (from Anthropic SDK):\n 71\u2192     - content_block_start: {\"type\": \"text\" | \"tool_use\"}\n 72\u2192     - content_block_delta: {\"type\": \"text_delta\", \"text\": \"...\"}\n 73\u2192                          or {\"type\": \"input_json_delta\", \"partial_json\": \"...\"}\n 74\u2192     - content_block_stop\n 75\u2192     - message_stop\n 76\u2192     \"\"\"\n 77\u2192 \n 78\u2192     def __init__(self, config: Config) -> None:\n 79\u2192         \"\"\"Initialize StreamProcessor.\n 80\u2192 \n 81\u2192         Args:\n 82\u2192             config: Configuration object\n 83\u2192 \n 84\u2192         Acceptance Criteria 1: StreamProcessor class exists\n 85\u2192         \"\"\"\n 86\u2192         self.config = config\n 87\u2192         self._full_text: str = \"\"\n 88\u2192         self._raw_chunks: list[Any] = []\n 89\u2192         self._text_chunks: list[str] = []\n 90\u2192 \n 91\u2192         # Tool call tracking\n 92\u2192         self._tool_blocks: dict[int, dict[str, Any]] = {}  # index -> {id, name, partial_json}\n 93\u2192         self._current_block_index: int | None = None\n 94\u2192 \n 95\u2192     async def process_stream(\n 96\u2192         self,\n 97\u2192         stream: AsyncIterator[Any],\n 98\u2192     ) -> AsyncIterator[str]:\n 99\u2192         \"\"\"Process stream and yield text chunks.\n100\u2192 \n101\u2192         This method consumes the streaming response, yielding text chunks\n102\u2192         for real-time UI updates. After the stream completes, use get_result()\n103\u2192         to retrieve the full processed result including tool calls.\n104\u2192 \n105\u2192         Args:\n106\u2192             stream: Async iterator of chunks from Anthropic SDK\n107\u2192 \n108\u2192         Yields:\n109\u2192             Text chunks as they arrive from the API\n110\u2192 \n111\u2192         Acceptance Criteria 2: process_stream() method takes async iterator of chunks\n112\u2192         Acceptance Criteria 7: Yields text chunks for real-time UI updates\n113\u2192         \"\"\"\n114\u2192         # Reset state for new stream\n115\u2192         self._full_text = \"\"\n116\u2192         self._raw_chunks = []\n117\u2192         self._text_chunks = []\n118\u2192         self._tool_blocks = {}\n119\u2192         self._current_block_index = None\n120\u2192 \n121\u2192         async for chunk in stream:\n122\u2192             # Store raw chunk\n123\u2192             self._raw_chunks.append(chunk)\n124\u2192 \n125\u2192             # Process chunk based on type\n126\u2192             chunk_type = getattr(chunk, 'type', None)\n127\u2192 \n128\u2192             if chunk_type == 'content_block_delta':\n129\u2192                 await self._handle_content_block_delta(chunk)\n130\u2192             elif chunk_type == 'content_block_start':\n131\u2192                 await self._handle_content_block_start(chunk)\n132\u2192             elif chunk_type == 'content_block_stop':\n133\u2192                 await self._handle_content_block_stop(chunk)\n134\u2192             elif chunk_type == 'message_stop':\n135\u2192                 # Stream is complete\n136\u2192                 pass\n137\u2192 \n138\u2192         # Yield all accumulated text chunks\n139\u2192         for text_chunk in self._text_chunks:\n140\u2192             yield text_chunk\n141\u2192 \n142\u2192     async def _handle_content_block_delta(self, chunk: Any) -> None:\n143\u2192         \"\"\"Handle content_block_delta chunk.\n144\u2192 \n145\u2192         Extracts text deltas for UI updates and partial_json for tool arguments.\n146\u2192         \"\"\"\n147\u2192         delta = getattr(chunk, 'delta', None)\n148\u2192         if not delta:\n149\u2192             return\n150\u2192 \n151\u2192         delta_type = delta.get('type', '')\n152\u2192 \n153\u2192         if delta_type == 'text_delta':\n154\u2192             # Text content - yield for UI and accumulate\n155\u2192             text = delta.get('text', '')\n156\u2192             if text:\n157\u2192                 self._full_text += text\n158\u2192                 self._text_chunks.append(text)\n159\u2192 \n160\u2192         elif delta_type == 'input_json_delta':\n161\u2192             # Partial JSON for tool arguments\n162\u2192             if self._current_block_index is not None:\n163\u2192                 partial_json = delta.get('partial_json', '')\n164\u2192                 if self._current_block_index not in self._tool_blocks:\n165\u2192                     self._tool_blocks[self._current_block_index] = {\n166\u2192                         'partial_json': ''\n167\u2192                     }\n168\u2192                 self._tool_blocks[self._current_block_index]['partial_json'] += partial_json\n169\u2192 \n170\u2192     async def _handle_content_block_start(self, chunk: Any) -> None:\n171\u2192         \"\"\"Handle content_block_start chunk.\n172\u2192 \n173\u2192         Identifies new tool_use blocks.\n174\u2192         \"\"\"\n175\u2192         index = getattr(chunk, 'index', None)\n176\u2192         content_block = getattr(chunk, 'content_block', None)\n177\u2192 \n178\u2192         if index is not None and content_block:\n179\u2192             self._current_block_index = index\n180\u2192 \n181\u2192             if content_block.get('type') == 'tool_use':\n182\u2192                 self._tool_blocks[index] = {\n183\u2192                     'id': content_block.get('id', ''),\n184\u2192                     'name': content_block.get('name', ''),\n185\u2192                     'partial_json': ''\n186\u2192                 }\n187\u2192             else:\n188\u2192                 # Text block - just track the index\n189\u2192                 if index not in self._tool_blocks:\n190\u2192                     self._tool_blocks[index] = {}\n191\u2192 \n192\u2192     async def _handle_content_block_stop(self, chunk: Any) -> None:\n193\u2192         \"\"\"Handle content_block_stop chunk.\n194\u2192 \n195\u2192         Finalizes tool argument accumulation.\n196\u2192         \"\"\"\n197\u2192         index = getattr(chunk, 'index', None)\n198\u2192         if index is not None and index in self._tool_blocks:\n199\u2192             # Parse accumulated JSON for tool arguments\n200\u2192             partial_json = self._tool_blocks[index].get('partial_json', '')\n201\u2192             if partial_json:\n202\u2192                 try:\n203\u2192                     self._tool_blocks[index]['arguments'] = json.loads(partial_json)\n204\u2192                 except json.JSONDecodeError:\n205\u2192                     logger.warning(f\"Failed to parse tool arguments: {partial_json}\")\n206\u2192                     self._tool_blocks[index]['arguments'] = {}\n207\u2192 \n208\u2192     def get_result(self) -> ProcessedStream:\n209\u2192         \"\"\"Get the final processed result.\n210\u2192 \n211\u2192         Returns a ProcessedStream containing the full text, extracted tool calls,\n212\u2192         and all raw chunks received.\n213\u2192 \n214\u2192         Returns:\n215\u2192             ProcessedStream with full_text, tool_calls, and raw_chunks\n216\u2192 \n217\u2192         Acceptance Criteria 3: Returns ProcessedStream with: full_text, tool_calls, raw_chunks\n218\u2192         \"\"\"\n219\u2192         tool_calls = self.extract_tool_calls(self._raw_chunks)\n220\u2192 \n221\u2192         return ProcessedStream(\n222\u2192             full_text=self._full_text,\n223\u2192             tool_calls=tool_calls,\n224\u2192             raw_chunks=self._raw_chunks\n225\u2192         )\n226\u2192 \n227\u2192     def extract_tool_calls(self, chunks: list[Any]) -> list[ToolCall]:\n228\u2192         \"\"\"Parse tool calls from accumulated chunks.\n229\u2192 \n230\u2192         This method processes the raw chunks to extract any tool calls that\n231\u2192         were present in the response. It handles partial_json accumulation\n232\u2192         and multiple tool calls in a single response.\n233\u2192 \n234\u2192         Args:\n235\u2192             chunks: List of raw chunks from the API stream\n236\u2192 \n237\u2192         Returns:\n238\u2192             List of ToolCall objects extracted from the stream\n239\u2192 \n240\u2192         Acceptance Criteria 4: extract_tool_calls() parses tool calls from chunks\n241\u2192         Acceptance Criteria 5: Handles partial_json accumulation\n242\u2192         Acceptance Criteria 6: Handles multiple tool calls in one response\n243\u2192         \"\"\"\n244\u2192         # Re-process chunks to extract tool calls\n245\u2192         tool_blocks: dict[int, dict[str, Any]] = {}\n246\u2192 \n247\u2192         for chunk in chunks:\n248\u2192             chunk_type = getattr(chunk, 'type', None)\n249\u2192 \n250\u2192             if chunk_type == 'content_block_start':\n251\u2192                 index = getattr(chunk, 'index', None)\n252\u2192                 content_block = getattr(chunk, 'content_block', None)\n253\u2192 \n254\u2192                 if index is not None and content_block:\n255\u2192                     if content_block.get('type') == 'tool_use':\n256\u2192                         tool_blocks[index] = {\n257\u2192                             'id': content_block.get('id', ''),\n258\u2192                             'name': content_block.get('name', ''),\n259\u2192                             'partial_json': ''\n260\u2192                         }\n261\u2192 \n262\u2192             elif chunk_type == 'content_block_delta':\n263\u2192                 index = getattr(chunk, 'index', None)\n264\u2192                 delta = getattr(chunk, 'delta', None)\n265\u2192 \n266\u2192                 if index is not None and delta and index in tool_blocks:\n267\u2192                     delta_type = delta.get('type', '')\n268\u2192                     if delta_type == 'input_json_delta':\n269\u2192                         partial_json = delta.get('partial_json', '')\n270\u2192                         tool_blocks[index]['partial_json'] += partial_json\n271\u2192 \n272\u2192             elif chunk_type == 'content_block_stop':\n273\u2192                 index = getattr(chunk, 'index', None)\n274\u2192                 if index is not None and index in tool_blocks:\n275\u2192                     partial_json = tool_blocks[index].get('partial_json', '')\n276\u2192                     # Always try to parse - even if partial_json was accumulated\n277\u2192                     try:\n278\u2192                         tool_blocks[index]['arguments'] = json.loads(partial_json) if partial_json else {}\n279\u2192                     except json.JSONDecodeError:\n280\u2192                         tool_blocks[index]['arguments'] = {}\n281\u2192 \n282\u2192         # Convert tool blocks to ToolCall objects\n283\u2192         tool_calls = []\n284\u2192         for block in tool_blocks.values():\n285\u2192             if block.get('name'):  # Only include blocks with a tool name\n286\u2192                 tool_calls.append(ToolCall(\n287\u2192                     id=block.get('id', ''),\n288\u2192                     name=block.get('name', ''),\n289\u2192                     arguments=block.get('arguments', {})\n290\u2192                 ))\n291\u2192 \n292\u2192         return tool_calls", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_449811f50d76476990dd4e0f", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/core.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/core.py (339 lines)\n============================================================\n\n  1\u2192 \"\"\"Core agent class for interactive coding.\n  2\u2192 \n  3\u2192 This module provides the AgentCore class which is the main entry point\n  4\u2192 for the interactive coding agent with full tool integration.\n  5\u2192 \n  6\u2192 Acceptance Criteria (Issue 22):\n  7\u2192 1. AgentCore.process_turn() implements full turn processing\n  8\u2192 2. Process turn: user input -> API stream -> tool calls -> results -> API -> response\n  9\u2192 3. Tool execution is sequential (not parallel)\n 10\u2192 4. Multiple tool calls in one response work correctly\n 11\u2192 5. Tool results are formatted for API consumption\n 12\u2192 6. Tool errors are caught and formatted\n 13\u2192 7. Tool timeouts are handled\n 14\u2192 8. Streaming response yields text chunks for UI\n 15\u2192 9. Turn completes when API stops (no more tool calls)\n 16\u2192 10. Chat history is updated with all messages\n 17\u2192 \"\"\"\n 18\u2192 import asyncio\n 19\u2192 import logging\n 20\u2192 from typing import Any, AsyncIterator\n 21\u2192 \n 22\u2192 from goz.agent.chat_client import ChatClient, Chunk\n 23\u2192 from goz.agent.history import ChatHistory, ChatMessage, ToolCall\n 24\u2192 from goz.agent.tools.base import ToolError, ToolInputError\n 25\u2192 from goz.agent.tools import ToolRegistry\n 26\u2192 from goz.api.errors import ApiError, AuthError, NetworkError, TimeoutError, ZaiError\n 27\u2192 from goz.config import Config\n 28\u2192 \n 29\u2192 \n 30\u2192 logger = logging.getLogger(__name__)\n 31\u2192 \n 32\u2192 # Completion marker for signaling turn completion to UI\n 33\u2192 COMPLETION_MARKER = \"\\x00\"\n 34\u2192 \n 35\u2192 \n 36\u2192 class AgentCore:\n 37\u2192     \"\"\"Core agent class for interactive coding.\n 38\u2192 \n 39\u2192     This class implements the full agent loop with tool integration:\n 40\u2192     - User input -> API stream -> tool calls -> tool execution -> results -> API -> response\n 41\u2192     - Handles multiple iterations (tool -> API -> tool -> API -> response)\n 42\u2192     - Yields text chunks for real-time UI updates\n 43\u2192     - Manages chat history with all messages\n 44\u2192 \n 45\u2192     Attributes:\n 46\u2192         config: Configuration for the agent\n 47\u2192         history: Chat history manager\n 48\u2192         tool_registry: Registry of available tools\n 49\u2192         chat_client: Client for Z.AI Chat API\n 50\u2192         max_iterations: Maximum tool-API iterations to prevent infinite loops\n 51\u2192     \"\"\"\n 52\u2192 \n 53\u2192     def __init__(\n 54\u2192         self,\n 55\u2192         config: Config,\n 56\u2192         history: ChatHistory | None = None,\n 57\u2192         tool_registry: ToolRegistry | None = None,\n 58\u2192         stream_processor: Any = None,\n 59\u2192         max_iterations: int = 10,\n 60\u2192     ) -> None:\n 61\u2192         \"\"\"Initialize AgentCore.\n 62\u2192 \n 63\u2192         Args:\n 64\u2192             config: Configuration object\n 65\u2192             history: Optional ChatHistory (creates new if None)\n 66\u2192             tool_registry: Optional ToolRegistry (creates new if None)\n 67\u2192             stream_processor: Optional stream processor (not used in current implementation)\n 68\u2192             max_iterations: Maximum tool-API iterations per turn (default: 10)\n 69\u2192         \"\"\"\n 70\u2192         self.config = config\n 71\u2192         self.history = history if history is not None else ChatHistory()\n 72\u2192         self.tool_registry = tool_registry if tool_registry is not None else ToolRegistry()\n 73\u2192         self.stream_processor = stream_processor\n 74\u2192         self.max_iterations = max_iterations\n 75\u2192 \n 76\u2192         # Initialize chat client\n 77\u2192         self.chat_client = ChatClient(config=config)\n 78\u2192 \n 79\u2192     async def process_turn(\n 80\u2192         self,\n 81\u2192         user_input: str,\n 82\u2192     ) -> AsyncIterator[str]:\n 83\u2192         \"\"\"Process a user turn and yield streaming response.\n 84\u2192 \n 85\u2192         This is the main agent loop. It:\n 86\u2192         1. Adds user message to history\n 87\u2192         2. Loops (up to max_iterations):\n 88\u2192            a. Calls API with current history\n 89\u2192            b. Streams response to UI (yields text chunks)\n 90\u2192            c. Checks for tool calls\n 91\u2192            d. If no tool calls, breaks\n 92\u2192            e. Executes tools sequentially\n 93\u2192            f. Adds tool calls and results to history\n 94\u2192         3. Adds assistant message to history\n 95\u2192         4. Yields completion marker\n 96\u2192 \n 97\u2192         Args:\n 98\u2192             user_input: User's input message\n 99\u2192 \n100\u2192         Yields:\n101\u2192             Text chunks for real-time UI display, followed by COMPLETION_MARKER\n102\u2192 \n103\u2192         Acceptance Criteria:\n104\u2192         - AC 1: Implements full turn processing\n105\u2192         - AC 2: user input -> API -> tools -> results -> API -> response\n106\u2192         - AC 3: Sequential tool execution\n107\u2192         - AC 4: Multiple tool calls in one response work\n108\u2192         - AC 5: Tool results formatted for API\n109\u2192         - AC 6: Tool errors caught and formatted\n110\u2192         - AC 7: Tool timeouts handled\n111\u2192         - AC 8: Yields text chunks for UI\n112\u2192         - AC 9: Completes when API stops\n113\u2192         - AC 10: History updated with all messages\n114\u2192         \"\"\"\n115\u2192         # Step 1: Add user message to history\n116\u2192         self.history.add(ChatMessage(role=\"user\", content=user_input))\n117\u2192 \n118\u2192         # Step 2: Main loop for tool-API iterations\n119\u2192         for iteration in range(self.max_iterations):\n120\u2192             # Step 2a: Call API with current history\n121\u2192             messages = self.history.to_api_format()\n122\u2192             tools_schema = self.tool_registry.to_openai_schema()\n123\u2192 \n124\u2192             # Step 2b: Process stream and yield text for UI\n125\u2192             accumulated_chunks: list[Chunk] = []\n126\u2192             accumulated_text: list[str] = []\n127\u2192 \n128\u2192             try:\n129\u2192                 stream = self.chat_client.chat_completion(\n130\u2192                     messages=messages,\n131\u2192                     tools=tools_schema if tools_schema else None,\n132\u2192                     tool_choice=\"auto\",\n133\u2192                 )\n134\u2192 \n135\u2192                 async for chunk in stream:\n136\u2192                     accumulated_chunks.append(chunk)\n137\u2192 \n138\u2192                     # Yield text for UI (AC 8)\n139\u2192                     # ContentBlockDelta has type=\"text_delta\" or type=\"input_json_delta\"\n140\u2192                     if hasattr(chunk, 'type') and chunk.type == \"text_delta\":\n141\u2192                         if hasattr(chunk, 'text') and chunk.text:\n142\u2192                             accumulated_text.append(chunk.text)\n143\u2192                             yield chunk.text\n144\u2192 \n145\u2192                 # Step 2c: Extract tool calls from stream\n146\u2192                 tool_calls = await self._extract_tool_calls_from_chunks(accumulated_chunks)\n147\u2192 \n148\u2192                 # Step 2d: Check for completion (no more tool calls)\n149\u2192                 if not tool_calls:\n150\u2192                     # No tools, turn is complete - add assistant message to history\n151\u2192                     assistant_text = \"\".join(accumulated_text)\n152\u2192                     self.history.add(ChatMessage(role=\"assistant\", content=assistant_text))\n153\u2192                     # Yield completion marker (AC 9)\n154\u2192                     yield COMPLETION_MARKER\n155\u2192                     break\n156\u2192 \n157\u2192                 # Step 2e: Execute tools sequentially (AC 3, AC 4)\n158\u2192                 for tool_call_dict in tool_calls:\n159\u2192                     # Create tool call message (AC 10)\n160\u2192                     tool_call_msg = ChatMessage(\n161\u2192                         role=\"tool_call\",\n162\u2192                         content=f\"Called {tool_call_dict['name']}\",\n163\u2192                         tool_calls=[ToolCall(\n164\u2192                             id=tool_call_dict['id'],\n165\u2192                             name=tool_call_dict['name'],\n166\u2192                             input=tool_call_dict['input'],\n167\u2192                         )],\n168\u2192                     )\n169\u2192                     self.history.add(tool_call_msg)\n170\u2192 \n171\u2192                     # Execute tool (AC 5, AC 6, AC 7)\n172\u2192                     tool_result = await self._execute_tool_call(tool_call_dict)\n173\u2192 \n174\u2192                     # Add tool result to history (AC 10)\n175\u2192                     result_msg = ChatMessage(\n176\u2192                         role=\"tool\",\n177\u2192                         content=tool_result,\n178\u2192                         tool_result_id=tool_call_dict['id'],\n179\u2192                     )\n180\u2192                     self.history.add(result_msg)\n181\u2192 \n182\u2192                 # Step 2f: Loop continues with tool results in history\n183\u2192 \n184\u2192             except Exception as e:\n185\u2192                 logger.error(f\"Error during turn processing: {e}\")\n186\u2192                 error_message = self._format_agent_error(e)\n187\u2192                 self.history.add(ChatMessage(role=\"assistant\", content=error_message))\n188\u2192                 yield error_message\n189\u2192                 yield COMPLETION_MARKER\n190\u2192                 break\n191\u2192 \n192\u2192     async def _extract_tool_calls_from_chunks(self, chunks: list[Chunk]) -> list[dict]:\n193\u2192         \"\"\"Extract tool calls from accumulated stream chunks.\n194\u2192 \n195\u2192         Args:\n196\u2192             chunks: List of chunks from the API stream\n197\u2192 \n198\u2192         Returns:\n199\u2192             List of tool_call dicts with id, name, and input keys\n200\u2192         \"\"\"\n201\u2192         # Use the chat_client's method if available\n202\u2192         if hasattr(self.chat_client, 'extract_tool_calls'):\n203\u2192             return await self.chat_client.extract_tool_calls(chunks)\n204\u2192 \n205\u2192         # Fallback: implement extraction here\n206\u2192         import json\n207\u2192 \n208\u2192         tool_calls: list[dict] = []\n209\u2192         current_tool: dict[str, Any] | None = None\n210\u2192         accumulated_json: list[str] = []\n211\u2192 \n212\u2192         for chunk in chunks:\n213\u2192             # Check for ContentBlockStart with tool_use\n214\u2192             if hasattr(chunk, 'type') and chunk.type == \"tool_use\":\n215\u2192                 current_tool = {\n216\u2192                     \"id\": getattr(chunk, 'id', ''),\n217\u2192                     \"name\": getattr(chunk, 'name', ''),\n218\u2192                     \"input\": {},\n219\u2192                 }\n220\u2192                 accumulated_json = []\n221\u2192 \n222\u2192             # Check for ContentBlockDelta with partial JSON\n223\u2192             elif hasattr(chunk, 'type') and chunk.type == \"input_json_delta\":\n224\u2192                 if hasattr(chunk, 'partial_json') and chunk.partial_json:\n225\u2192                     accumulated_json.append(chunk.partial_json)\n226\u2192 \n227\u2192             # Check for ContentBlockStop\n228\u2192             elif hasattr(chunk, 'type') and chunk.type == \"content_block_stop\":\n229\u2192                 if current_tool is not None and accumulated_json:\n230\u2192                     try:\n231\u2192                         json_str = \"\".join(accumulated_json)\n232\u2192                         current_tool[\"input\"] = json.loads(json_str)\n233\u2192                     except json.JSONDecodeError:\n234\u2192                         current_tool[\"input\"] = {\"raw\": \"\".join(accumulated_json)}\n235\u2192                     tool_calls.append(current_tool)\n236\u2192                     current_tool = None\n237\u2192                     accumulated_json = []\n238\u2192 \n239\u2192         # Alternative extraction path using ContentBlockStart type\n240\u2192         for chunk in chunks:\n241\u2192             if hasattr(chunk, 'type') and hasattr(chunk, 'index'):\n242\u2192                 if chunk.type == \"tool_use\" and not any(\n243\u2192                     tc.get('id') == getattr(chunk, 'id', '') for tc in tool_calls\n244\u2192                 ):\n245\u2192                     new_tool = {\n246\u2192                         \"id\": getattr(chunk, 'id', ''),\n247\u2192                         \"name\": getattr(chunk, 'name', ''),\n248\u2192                         \"input\": {},\n249\u2192                     }\n250\u2192                     # Find corresponding input_json_delta chunks\n251\u2192                     for c in chunks:\n252\u2192                         if (hasattr(c, 'index') and c.index == chunk.index and\n253\u2192                             hasattr(c, 'type') and c.type == \"input_json_delta\"):\n254\u2192                             if hasattr(c, 'partial_json') and c.partial_json:\n255\u2192                                 try:\n256\u2192                                     current = new_tool[\"input\"].get(\"_partial\", \"\")\n257\u2192                                     current += c.partial_json\n258\u2192                                     new_tool[\"input\"] = json.loads(current)\n259\u2192                                 except json.JSONDecodeError:\n260\u2192                                     new_tool[\"input\"] = {\"_partial\": current + c.partial_json}\n261\u2192                     if new_tool not in tool_calls:\n262\u2192                         tool_calls.append(new_tool)\n263\u2192 \n264\u2192         return tool_calls\n265\u2192 \n266\u2192     async def _execute_tool_call(self, tool_call: dict) -> str:\n267\u2192         \"\"\"Execute a single tool call and return result.\n268\u2192 \n269\u2192         This handles:\n270\u2192         - Finding the tool by name\n271\u2192         - Executing with timeout\n272\u2192         - Catching and formatting errors\n273\u2192 \n274\u2192         Args:\n275\u2192             tool_call: Tool call dict with id, name, and input\n276\u2192 \n277\u2192         Returns:\n278\u2192             String result to send back to API\n279\u2192 \n280\u2192         Acceptance Criteria:\n281\u2192         - AC 5: Tool results formatted for API\n282\u2192         - AC 6: Tool errors caught and formatted\n283\u2192         - AC 7: Tool timeouts handled\n284\u2192         \"\"\"\n285\u2192         tool_name = tool_call.get('name', '')\n286\u2192         tool = self.tool_registry.get(tool_name)\n287\u2192 \n288\u2192         if tool is None:\n289\u2192             available = \", \".join(sorted(self.tool_registry.tool_names)) or \"none\"\n290\u2192             return f\"Tool '{tool_name}' not found. Available tools: {available}.\"\n291\u2192 \n292\u2192         try:\n293\u2192             # Execute with timeout (AC 7)\n294\u2192             result = await asyncio.wait_for(\n295\u2192                 tool.execute(**tool_call.get('input', {})),\n296\u2192                 timeout=300,  # 5 minutes\n297\u2192             )\n298\u2192             return str(result)\n299\u2192 \n300\u2192         except asyncio.TimeoutError:\n301\u2192             return (\n302\u2192                 f\"Tool '{tool_name}' timed out after 300 seconds. \"\n303\u2192                 \"Try a smaller input or break the task into smaller steps.\"\n304\u2192             )\n305\u2192         except Exception as e:\n306\u2192             logger.error(f\"Tool {tool_name} failed: {e}\")\n307\u2192             return self._format_tool_error(tool_name, e)\n308\u2192 \n309\u2192     def __repr__(self) -> str:\n310\u2192         \"\"\"Return string representation of AgentCore.\"\"\"\n311\u2192         return f\"AgentCore(config={self.config!r}, messages={self.history.message_count})\"\n312\u2192 \n313\u2192     def _format_tool_error(self, tool_name: str, error: Exception) -> str:\n314\u2192         \"\"\"Return a user-facing tool error message.\"\"\"\n315\u2192         if isinstance(error, ToolInputError):\n316\u2192             return f\"Tool '{tool_name}' received invalid input: {error}. Check the required fields and try again.\"\n317\u2192         if isinstance(error, PermissionError):\n318\u2192             return f\"Tool '{tool_name}' failed due to permission denied: {error}. Check file permissions and retry.\"\n319\u2192         if isinstance(error, FileNotFoundError):\n320\u2192             return f\"Tool '{tool_name}' could not find the requested file: {error}. Verify the path and retry.\"\n321\u2192         if isinstance(error, ToolError):\n322\u2192             return f\"Tool '{tool_name}' failed: {error}\"\n323\u2192         return f\"Tool '{tool_name}' failed: {error}\"\n324\u2192 \n325\u2192     def _format_agent_error(self, error: Exception) -> str:\n326\u2192         \"\"\"Return a user-facing assistant error message.\"\"\"\n327\u2192         if isinstance(error, AuthError):\n328\u2192             return f\"Authentication error: {error.message} {error.help or ''}\".strip()\n329\u2192         if isinstance(error, TimeoutError):\n330\u2192             return f\"Request timed out. {error.help or 'Try again.'}\".strip()\n331\u2192         if isinstance(error, NetworkError):\n332\u2192             return f\"Network error: {error.message} {error.help or ''}\".strip()\n333\u2192         if isinstance(error, ApiError):\n334\u2192             help_text = f\" {error.help}\" if error.help else \"\"\n335\u2192             return f\"API error ({error.statusCode}): {error.message}.{help_text}\".strip()\n336\u2192         if isinstance(error, ZaiError):\n337\u2192             help_text = f\" {error.help}\" if error.help else \"\"\n338\u2192             return f\"{error.message}.{help_text}\".strip()\n339\u2192         return f\"Unexpected error: {error}\"", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_a681e90b63f2404ab8383cef", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/sessions.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/sessions.py (279 lines)\n============================================================\n\n  1\u2192 \"\"\"Session persistence for the goz agent.\n  2\u2192 \n  3\u2192 This module provides classes for saving and loading chat sessions:\n  4\u2192 - Session: Dataclass for a saved chat session\n  5\u2192 - SessionInfo: Lightweight metadata about a session\n  6\u2192 - SessionManager: Manages session files (save, load, list, delete)\n  7\u2192 \n  8\u2192 Acceptance Criteria:\n  9\u2192 - AC 1: SessionManager class exists in goz/agent/sessions.py\n 10\u2192 - AC 2: save() method saves session to file\n 11\u2192 - AC 3: load() method loads session from file\n 12\u2192 - AC 4: list_sessions() returns all sessions\n 13\u2192 - AC 5: delete() method deletes session\n 14\u2192 - AC 6: exists() checks if session exists\n 15\u2192 - AC 7: get_info() returns session metadata\n 16\u2192 \"\"\"\n 17\u2192 import errno\n 18\u2192 import json\n 19\u2192 from dataclasses import dataclass, field\n 20\u2192 from datetime import datetime\n 21\u2192 from pathlib import Path\n 22\u2192 \n 23\u2192 from goz.agent.history import ChatMessage\n 24\u2192 \n 25\u2192 \n 26\u2192 @dataclass\n 27\u2192 class Session:\n 28\u2192     \"\"\"A saved chat session.\n 29\u2192 \n 30\u2192     Attributes:\n 31\u2192         id: Session identifier (filename without .json)\n 32\u2192         created_at: When the session was first created\n 33\u2192         updated_at: When the session was last modified\n 34\u2192         working_directory: Working directory at time of save\n 35\u2192         messages: List of chat messages in the session\n 36\u2192         model: Model name used for the session\n 37\u2192         agent_type: Type of agent used (e.g., \"general\", \"coder\")\n 38\u2192         config_snapshot: Config settings at time of save\n 39\u2192     \"\"\"\n 40\u2192 \n 41\u2192     id: str\n 42\u2192     created_at: datetime\n 43\u2192     updated_at: datetime\n 44\u2192     working_directory: str\n 45\u2192     messages: list[ChatMessage]\n 46\u2192     model: str\n 47\u2192     agent_type: str\n 48\u2192     config_snapshot: dict\n 49\u2192     tool_state: dict = field(default_factory=dict)\n 50\u2192 \n 51\u2192     def to_dict(self) -> dict:\n 52\u2192         \"\"\"Convert Session to dict for JSON serialization.\n 53\u2192 \n 54\u2192         Returns:\n 55\u2192             Dict representation of this Session\n 56\u2192         \"\"\"\n 57\u2192         return {\n 58\u2192             \"id\": self.id,\n 59\u2192             \"created_at\": self.created_at.isoformat(),\n 60\u2192             \"updated_at\": self.updated_at.isoformat(),\n 61\u2192             \"working_directory\": self.working_directory,\n 62\u2192             \"messages\": [msg.to_dict() for msg in self.messages],\n 63\u2192             \"model\": self.model,\n 64\u2192             \"agent_type\": self.agent_type,\n 65\u2192             \"config_snapshot\": self.config_snapshot,\n 66\u2192             \"tool_state\": self.tool_state,\n 67\u2192         }\n 68\u2192 \n 69\u2192     @classmethod\n 70\u2192     def from_dict(cls, data: dict) -> \"Session\":\n 71\u2192         \"\"\"Create Session from dict.\n 72\u2192 \n 73\u2192         Args:\n 74\u2192             data: Dict representation of Session\n 75\u2192 \n 76\u2192         Returns:\n 77\u2192             Session instance\n 78\u2192         \"\"\"\n 79\u2192         return cls(\n 80\u2192             id=data[\"id\"],\n 81\u2192             created_at=datetime.fromisoformat(data[\"created_at\"]),\n 82\u2192             updated_at=datetime.fromisoformat(data[\"updated_at\"]),\n 83\u2192             working_directory=data[\"working_directory\"],\n 84\u2192             messages=[ChatMessage.from_dict(m) for m in data[\"messages\"]],\n 85\u2192             model=data[\"model\"],\n 86\u2192             agent_type=data[\"agent_type\"],\n 87\u2192             config_snapshot=data.get(\"config_snapshot\", {}),\n 88\u2192             tool_state=data.get(\"tool_state\", {}),\n 89\u2192         )\n 90\u2192 \n 91\u2192 \n 92\u2192 @dataclass\n 93\u2192 class SessionInfo:\n 94\u2192     \"\"\"Metadata about a session (lightweight).\n 95\u2192 \n 96\u2192     Attributes:\n 97\u2192         id: Session identifier\n 98\u2192         created_at: When the session was first created\n 99\u2192         updated_at: When the session was last modified\n100\u2192         working_directory: Working directory at time of save\n101\u2192         message_count: Number of messages in the session\n102\u2192         model: Model name used for the session\n103\u2192         agent_type: Type of agent used\n104\u2192     \"\"\"\n105\u2192 \n106\u2192     id: str\n107\u2192     created_at: datetime\n108\u2192     updated_at: datetime\n109\u2192     working_directory: str\n110\u2192     message_count: int\n111\u2192     model: str\n112\u2192     agent_type: str\n113\u2192 \n114\u2192 \n115\u2192 class SessionManager:\n116\u2192     \"\"\"Manage session persistence.\n117\u2192 \n118\u2192     This class handles saving, loading, listing, and deleting chat sessions.\n119\u2192     Sessions are stored as JSON files in the session directory.\n120\u2192 \n121\u2192     Attributes:\n122\u2192         session_dir: Directory where session files are stored\n123\u2192     \"\"\"\n124\u2192 \n125\u2192     DEFAULT_SESSION_DIR = Path.home() / \".goz\" / \"sessions\"\n126\u2192 \n127\u2192     def __init__(self, session_dir: Path | None = None) -> None:\n128\u2192         \"\"\"Initialize SessionManager.\n129\u2192 \n130\u2192         Args:\n131\u2192             session_dir: Directory for session files (default: ~/.goz/sessions)\n132\u2192         \"\"\"\n133\u2192         self.session_dir = session_dir or self.DEFAULT_SESSION_DIR\n134\u2192         self.session_dir.mkdir(parents=True, exist_ok=True)\n135\u2192 \n136\u2192     async def save(self, session: Session) -> Path:\n137\u2192         \"\"\"Save session to file.\n138\u2192 \n139\u2192         Args:\n140\u2192             session: Session to save\n141\u2192 \n142\u2192         Returns:\n143\u2192             Path to saved file\n144\u2192         \"\"\"\n145\u2192         # Update the timestamp\n146\u2192         session.updated_at = datetime.now()\n147\u2192 \n148\u2192         file_path = self.session_dir / f\"{session.id}.json\"\n149\u2192 \n150\u2192         try:\n151\u2192             self.session_dir.mkdir(parents=True, exist_ok=True)\n152\u2192             file_path.write_text(json.dumps(session.to_dict(), indent=2), encoding=\"utf-8\")\n153\u2192         except PermissionError as e:\n154\u2192             raise PermissionError(f\"Permission denied while saving session: {file_path}\") from e\n155\u2192         except OSError as e:\n156\u2192             if e.errno == errno.ENOSPC:\n157\u2192                 raise OSError(f\"Disk is full. Could not save session: {file_path}\") from e\n158\u2192             raise OSError(f\"Failed to save session '{session.id}' to {file_path}: {e.strerror or e}\") from e\n159\u2192 \n160\u2192         return file_path\n161\u2192 \n162\u2192     async def load(self, session_id: str) -> Session:\n163\u2192         \"\"\"Load session from file.\n164\u2192 \n165\u2192         Args:\n166\u2192             session_id: Session identifier (without .json)\n167\u2192 \n168\u2192         Returns:\n169\u2192             Loaded Session\n170\u2192 \n171\u2192         Raises:\n172\u2192             FileNotFoundError: If session doesn't exist\n173\u2192             ValueError: If file is corrupted\n174\u2192         \"\"\"\n175\u2192         file_path = self.session_dir / f\"{session_id}.json\"\n176\u2192 \n177\u2192         if not file_path.exists():\n178\u2192             raise FileNotFoundError(f\"Session not found: {session_id}\")\n179\u2192 \n180\u2192         try:\n181\u2192             data = json.loads(file_path.read_text(encoding=\"utf-8\"))\n182\u2192             return Session.from_dict(data)\n183\u2192         except json.JSONDecodeError as e:\n184\u2192             raise ValueError(\n185\u2192                 f\"Corrupted session file: {file_path}. Delete the file and start a fresh session. {e}\"\n186\u2192             ) from e\n187\u2192         except PermissionError as e:\n188\u2192             raise PermissionError(f\"Permission denied while reading session: {file_path}\") from e\n189\u2192         except OSError as e:\n190\u2192             raise OSError(f\"Failed to load session from {file_path}: {e.strerror or e}\") from e\n191\u2192 \n192\u2192     def list_sessions(self) -> list[SessionInfo]:\n193\u2192         \"\"\"List all saved sessions.\n194\u2192 \n195\u2192         Returns:\n196\u2192             List of session metadata, sorted by updated_at (newest first)\n197\u2192         \"\"\"\n198\u2192         sessions: list[SessionInfo] = []\n199\u2192 \n200\u2192         for file_path in self.session_dir.glob(\"*.json\"):\n201\u2192             try:\n202\u2192                 with open(file_path) as f:\n203\u2192                     data = json.load(f)\n204\u2192 \n205\u2192                 sessions.append(\n206\u2192                     SessionInfo(\n207\u2192                         id=data[\"id\"],\n208\u2192                         created_at=datetime.fromisoformat(data[\"created_at\"]),\n209\u2192                         updated_at=datetime.fromisoformat(data[\"updated_at\"]),\n210\u2192                         working_directory=data[\"working_directory\"],\n211\u2192                         message_count=len(data[\"messages\"]),\n212\u2192                         model=data[\"model\"],\n213\u2192                         agent_type=data.get(\"agent_type\", \"general\"),\n214\u2192                     )\n215\u2192                 )\n216\u2192             except (json.JSONDecodeError, KeyError):\n217\u2192                 # Skip corrupted files\n218\u2192                 continue\n219\u2192 \n220\u2192         # Sort by updated_at, newest first\n221\u2192         sessions.sort(key=lambda s: s.updated_at, reverse=True)\n222\u2192         return sessions\n223\u2192 \n224\u2192     async def delete(self, session_id: str) -> bool:\n225\u2192         \"\"\"Delete a session.\n226\u2192 \n227\u2192         Args:\n228\u2192             session_id: Session to delete\n229\u2192 \n230\u2192         Returns:\n231\u2192             True if deleted, False if not found\n232\u2192         \"\"\"\n233\u2192         file_path = self.session_dir / f\"{session_id}.json\"\n234\u2192 \n235\u2192         if file_path.exists():\n236\u2192             file_path.unlink()\n237\u2192             return True\n238\u2192         return False\n239\u2192 \n240\u2192     def exists(self, session_id: str) -> bool:\n241\u2192         \"\"\"Check if session exists.\n242\u2192 \n243\u2192         Args:\n244\u2192             session_id: Session identifier to check\n245\u2192 \n246\u2192         Returns:\n247\u2192             True if session exists, False otherwise\n248\u2192         \"\"\"\n249\u2192         return (self.session_dir / f\"{session_id}.json\").exists()\n250\u2192 \n251\u2192     async def get_info(self, session_id: str) -> SessionInfo | None:\n252\u2192         \"\"\"Get session metadata without loading full session.\n253\u2192 \n254\u2192         Args:\n255\u2192             session_id: Session identifier\n256\u2192 \n257\u2192         Returns:\n258\u2192             SessionInfo if session exists, None otherwise\n259\u2192         \"\"\"\n260\u2192         file_path = self.session_dir / f\"{session_id}.json\"\n261\u2192 \n262\u2192         if not file_path.exists():\n263\u2192             return None\n264\u2192 \n265\u2192         try:\n266\u2192             with open(file_path) as f:\n267\u2192                 data = json.load(f)\n268\u2192 \n269\u2192             return SessionInfo(\n270\u2192                 id=data[\"id\"],\n271\u2192                 created_at=datetime.fromisoformat(data[\"created_at\"]),\n272\u2192                 updated_at=datetime.fromisoformat(data[\"updated_at\"]),\n273\u2192                 working_directory=data[\"working_directory\"],\n274\u2192                 message_count=len(data[\"messages\"]),\n275\u2192                 model=data[\"model\"],\n276\u2192                 agent_type=data.get(\"agent_type\", \"general\"),\n277\u2192             )\n278\u2192         except (json.JSONDecodeError, KeyError):\n279\u2192             return None", "is_error": false}}
