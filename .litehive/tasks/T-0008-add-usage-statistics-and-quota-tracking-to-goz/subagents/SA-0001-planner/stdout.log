ield chunk\n 49\u2192 \n 50\u2192         return iterator()\n 51\u2192 \n 52\u2192 \n 53\u2192 class TestRunPromptJsonl:\n 54\u2192     @pytest.mark.asyncio\n 55\u2192     async def test_emits_jsonl_events_and_step_finish(self, config, tmp_path):\n 56\u2192         first_stream = [\n 57\u2192             MessageStart(id=\"msg_1\", model=\"test-model\"),\n 58\u2192             ContentBlockStart(type=\"tool_use\", index=0, id=\"call_1\", name=\"bash\"),\n 59\u2192             ContentBlockDelta(type=\"input_json_delta\", index=0, partial_json='{\"command\":\"pwd\"}'),\n 60\u2192             ContentBlockStop(index=0),\n 61\u2192             MessageStop(stop_reason=\"tool_use\"),\n 62\u2192         ]\n 63\u2192         second_stream = [\n 64\u2192             MessageStart(id=\"msg_2\", model=\"test-model\"),\n 65\u2192             ContentBlockStart(type=\"text\", index=0),\n 66\u2192             ContentBlockDelta(type=\"text_delta\", index=0, text=\"Answer\\n\"),\n 67\u2192             ContentBlockDelta(\n 68\u2192                 type=\"text_delta\",\n 69\u2192                 index=0,\n 70\u2192                 text='STAGE_RESULT:\\n{\"verdict\":\"pass\",\"summary\":\"ok\",\"files_changed\":[],\"tests\":{\"added\":0,\"passing\":1},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\\n',\n 71\u2192             ),\n 72\u2192             ContentBlockStop(index=0),\n 73\u2192             MessageStop(stop_reason=\"end_turn\"),\n 74\u2192         ]\n 75\u2192         stdout = io.StringIO()\n 76\u2192         chat_client = FakeChatClient([first_stream, second_stream], config=config)\n 77\u2192 \n 78\u2192         exit_code = await run_prompt_jsonl(\n 79\u2192             \"Run pwd and report\",\n 80\u2192             config=config,\n 81\u2192             working_dir=str(tmp_path),\n 82\u2192             stdout=stdout,\n 83\u2192             chat_client=chat_client,\n 84\u2192         )\n 85\u2192 \n 86\u2192         assert exit_code == 0\n 87\u2192         even