{"type": "tool_use", "part": {"id": "call_1ec007e4391a48318ccaa13a", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/config/__init__.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/config/__init__.py (258 lines)\n============================================================\n\n  1\u2192 \"\"\"Configuration management for goz.\n  2\u2192 \n  3\u2192 Config file location: ~/.config/goz/config.json\n  4\u2192 \"\"\"\n  5\u2192 import json\n  6\u2192 from pathlib import Path\n  7\u2192 \n  8\u2192 from pydantic import BaseModel, Field, field_validator\n  9\u2192 \n 10\u2192 \n 11\u2192 # Default config paths (Acceptance Criteria 1)\n 12\u2192 DEFAULT_CONFIG_DIR = Path.home() / \".config\" / \"goz\"\n 13\u2192 DEFAULT_CONFIG_FILE = DEFAULT_CONFIG_DIR / \"config.json\"\n 14\u2192 \n 15\u2192 # Default values (Acceptance Criteria 2)\n 16\u2192 DEFAULT_ZAI_BASE_URL = \"https://api.z.ai/api/anthropic\"\n 17\u2192 DEFAULT_CODING_BASE_URL = \"https://api.z.ai/api/coding/paas/v4\"\n 18\u2192 DEFAULT_TIMEOUT = 300000  # 5 minutes in milliseconds\n 19\u2192 DEFAULT_TIMEOUT_SECONDS = 120  # For Python clients (seconds)\n 20\u2192 \n 21\u2192 # Default model names\n 22\u2192 DEFAULT_VISION_MODEL = \"glm-4.6v\"\n 23\u2192 DEFAULT_CHAT_MODEL = \"glm-5-turbo\"\n 24\u2192 \n 25\u2192 # Generation parameters\n 26\u2192 DEFAULT_TEMPERATURE = 0.8\n 27\u2192 DEFAULT_TOP_P = 0.6\n 28\u2192 DEFAULT_MAX_TOKENS = 32768\n 29\u2192 \n 30\u2192 \n 31\u2192 class Config(BaseModel):\n 32\u2192     \"\"\"Configuration model for goz.\n 33\u2192 \n 34\u2192     Fields:\n 35\u2192         zai_token: Z.AI auth token for API access (like apiKey in zai-cli)\n 36\u2192         zai_base_url: Base URL for Anthropic API (vision/chat)\n 37\u2192         coding_base_url: Base URL for Coding API (search/read/repo)\n 38\u2192         timeout: Request timeout in seconds\n 39\u2192         vision_model: Model for image/video analysis\n 40\u2192         chat_model: Model for chat/text requests\n 41\u2192         temperature: Generation temperature\n 42\u2192         top_p: Generation top_p\n 43\u2192         max_tokens: Maximum tokens in response\n 44\u2192     \"\"\"\n 45\u2192 \n 46\u2192     zai_token: str\n 47\u2192     zai_base_url: str = DEFAULT_ZAI_BASE_URL\n 48\u2192     coding_base_url: str = DEFAULT_CODING_BASE_URL\n 49\u2192     timeout: int = Field(default=DEFAULT_TIMEOUT_SECONDS, gt=0)\n 50\u2192     vision_model: str = DEFAULT_VISION_MODEL\n 51\u2192     chat_model: str = DEFAULT_CHAT_MODEL\n 52\u2192     temperature: float = DEFAULT_TEMPERATURE\n 53\u2192     top_p: float = DEFAULT_TOP_P\n 54\u2192     max_tokens: int = DEFAULT_MAX_TOKENS\n 55\u2192 \n 56\u2192     @field_validator(\"zai_token\")\n 57\u2192     @classmethod\n 58\u2192     def token_not_empty(cls, v: str) -> str:\n 59\u2192         \"\"\"Validate token is not empty.\"\"\"\n 60\u2192         if not v or not v.strip():\n 61\u2192             raise ValueError(\"zai_token cannot be empty\")\n 62\u2192         return v\n 63\u2192 \n 64\u2192 \n 65\u2192 class ConfigManager:\n 66\u2192     \"\"\"Manager for loading and saving configuration.\"\"\"\n 67\u2192 \n 68\u2192     def __init__(self, config_file: Path | None = None):\n 69\u2192         \"\"\"Initialize ConfigManager.\n 70\u2192 \n 71\u2192         Args:\n 72\u2192             config_file: Path to config file. Defaults to DEFAULT_CONFIG_FILE.\n 73\u2192         \"\"\"\n 74\u2192         self.config_file = config_file or DEFAULT_CONFIG_FILE\n 75\u2192         self._ensure_config_dir()\n 76\u2192 \n 77\u2192     def _ensure_config_dir(self) -> None:\n 78\u2192         \"\"\"Create config directory if it doesn't exist (Acceptance Criteria 3, 6).\"\"\"\n 79\u2192         self.config_file.parent.mkdir(parents=True, exist_ok=True)\n 80\u2192 \n 81\u2192     def load(self) -> Config:\n 82\u2192         \"\"\"Load configuration from file.\n 83\u2192 \n 84\u2192         Returns:\n 85\u2192             Config object\n 86\u2192 \n 87\u2192         Raises:\n 88\u2192             json.JSONDecodeError: If config file contains invalid JSON\n 89\u2192             ValidationError: If config data is invalid\n 90\u2192         \"\"\"\n 91\u2192         if not self.config_file.exists():\n 92\u2192             return self._prompt_and_create()\n 93\u2192 \n 94\u2192         # Check if file is empty\n 95\u2192         if self.config_file.stat().st_size == 0:\n 96\u2192             return self._prompt_and_create()\n 97\u2192 \n 98\u2192         try:\n 99\u2192             with open(self.config_file) as f:\n100\u2192                 data = json.load(f)\n101\u2192         except json.JSONDecodeError:\n102\u2192             # Invalid JSON - show error and re-raise\n103\u2192             print(f\"Error: Invalid JSON in config file at {self.config_file}\")\n104\u2192             raise\n105\u2192 \n106\u2192         return Config.model_validate(data)\n107\u2192 \n108\u2192     def save(self, config: Config) -> None:\n109\u2192         \"\"\"Save configuration to file.\n110\u2192 \n111\u2192         Args:\n112\u2192             config: Config object to save\n113\u2192         \"\"\"\n114\u2192         self._ensure_config_dir()\n115\u2192         with open(self.config_file, \"w\") as f:\n116\u2192             f.write(config.model_dump_json(indent=2))\n117\u2192 \n118\u2192     def _prompt_and_create(self) -> Config:\n119\u2192         \"\"\"Prompt user for token and create config file (Acceptance Criteria 3, 4).\"\"\"\n120\u2192         token = input(\"Enter your Z.AI auth token: \")\n121\u2192 \n122\u2192         config = Config(zai_token=token)\n123\u2192         self.save(config)\n124\u2192 \n125\u2192         print(f\"Config saved to {self.config_file}\")\n126\u2192         return config\n127\u2192 \n128\u2192     def show_config(self) -> None:\n129\u2192         \"\"\"Display current configuration with masked token (Acceptance Criteria 6, 7).\"\"\"\n130\u2192         config = self.load()\n131\u2192 \n132\u2192         # Mask token - show only last 4 chars (Acceptance Criteria 7)\n133\u2192         masked_token = self._mask_token(config.zai_token)\n134\u2192 \n135\u2192         print(f\"zai_token: {masked_token}\")\n136\u2192         print(f\"zai_base_url: {config.zai_base_url}\")\n137\u2192         print(f\"coding_base_url: {config.coding_base_url}\")\n138\u2192         print(f\"timeout: {config.timeout}\")\n139\u2192         print(f\"vision_model: {config.vision_model}\")\n140\u2192         print(f\"chat_model: {config.chat_model}\")\n141\u2192         print(f\"temperature: {config.temperature}\")\n142\u2192         print(f\"top_p: {config.top_p}\")\n143\u2192         print(f\"max_tokens: {config.max_tokens}\")\n144\u2192 \n145\u2192     def get_config(self, key: str) -> None:\n146\u2192         \"\"\"Get and display a single configuration value.\n147\u2192 \n148\u2192         Args:\n149\u2192             key: Configuration key to retrieve\n150\u2192 \n151\u2192         Raises:\n152\u2192             ValueError: If key is invalid\n153\u2192         \"\"\"\n154\u2192         config = self.load()\n155\u2192 \n156\u2192         valid_keys = {\n157\u2192             \"zai_token\", \"zai_base_url\", \"coding_base_url\", \"timeout\",\n158\u2192             \"vision_model\", \"chat_model\", \"temperature\", \"top_p\", \"max_tokens\"\n159\u2192         }\n160\u2192 \n161\u2192         if key not in valid_keys:\n162\u2192             raise ValueError(f\"Invalid config key: {key}. Valid keys: {', '.join(sorted(valid_keys))}\")\n163\u2192 \n164\u2192         value = getattr(config, key)\n165\u2192 \n166\u2192         # Mask token if requested\n167\u2192         if key == \"zai_token\":\n168\u2192             value = self._mask_token(value)\n169\u2192 \n170\u2192         print(value)\n171\u2192 \n172\u2192     def list_keys(self) -> None:\n173\u2192         \"\"\"List all available configuration keys with descriptions.\"\"\"\n174\u2192         descriptions = [\n175\u2192             (\"zai_token\", \"Z.AI API authentication token (required)\"),\n176\u2192             (\"zai_base_url\", f\"Base URL for Anthropic API/vision/chat (default: {DEFAULT_ZAI_BASE_URL})\"),\n177\u2192             (\"coding_base_url\", f\"Base URL for Search/Read/Repo APIs (default: {DEFAULT_CODING_BASE_URL})\"),\n178\u2192             (\"timeout\", f\"Request timeout in seconds (default: {DEFAULT_TIMEOUT_SECONDS})\"),\n179\u2192             (\"vision_model\", f\"Model for image/video analysis (default: {DEFAULT_VISION_MODEL})\"),\n180\u2192             (\"chat_model\", f\"Model for chat requests (default: {DEFAULT_CHAT_MODEL})\"),\n181\u2192             (\"temperature\", f\"Generation temperature (default: {DEFAULT_TEMPERATURE})\"),\n182\u2192             (\"top_p\", f\"Generation top_p sampling (default: {DEFAULT_TOP_P})\"),\n183\u2192             (\"max_tokens\", f\"Maximum response tokens (default: {DEFAULT_MAX_TOKENS})\"),\n184\u2192         ]\n185\u2192 \n186\u2192         print(\"Available configuration keys:\")\n187\u2192         for key, desc in descriptions:\n188\u2192             print(f\"  {key:18s} - {desc}\")\n189\u2192 \n190\u2192     def edit_config(self) -> None:\n191\u2192         \"\"\"Open config file in the default editor.\"\"\"\n192\u2192         import os\n193\u2192         import subprocess\n194\u2192 \n195\u2192         editor = os.environ.get(\"EDITOR\", os.environ.get(\"VISUAL\", \"vi\"))\n196\u2192 \n197\u2192         try:\n198\u2192             subprocess.call([editor, str(self.config_file)])\n199\u2192         except FileNotFoundError:\n200\u2192             # Try notepad on Windows as fallback\n201\u2192             if os.name == \"nt\":\n202\u2192                 subprocess.call([\"notepad\", str(self.config_file)])\n203\u2192             else:\n204\u2192                 raise FileNotFoundError(f\"Editor '{editor}' not found. Set EDITOR environment variable.\")\n205\u2192 \n206\u2192     def _mask_token(self, token: str) -> str:\n207\u2192         \"\"\"Mask token showing only last 4 characters.\n208\u2192 \n209\u2192         Args:\n210\u2192             token: The token to mask\n211\u2192 \n212\u2192         Returns:\n213\u2192             Masked token string\n214\u2192         \"\"\"\n215\u2192         if len(token) <= 4:\n216\u2192             return f\"****{token}\"\n217\u2192         return f\"****{token[-4:]}\"\n218\u2192 \n219\u2192     def set_config(self, key: str, value: str) -> None:\n220\u2192         \"\"\"Update a specific configuration field (Acceptance Criteria 8).\n221\u2192 \n222\u2192         Args:\n223\u2192             key: Configuration key to update\n224\u2192             value: New value\n225\u2192 \n226\u2192         Raises:\n227\u2192             ValueError: If key is invalid or value cannot be converted\n228\u2192         \"\"\"\n229\u2192         config = self.load()\n230\u2192 \n231\u2192         valid_keys = [\"zai_token\", \"zai_base_url\", \"coding_base_url\", \"timeout\", \"vision_model\", \"chat_model\"]\n232\u2192 \n233\u2192         if key not in valid_keys:\n234\u2192             raise ValueError(f\"Invalid config key: {key}. Valid keys: {', '.join(valid_keys)}\")\n235\u2192 \n236\u2192         if key == \"timeout\":\n237\u2192             try:\n238\u2192                 value_int = int(value)\n239\u2192                 if value_int <= 0:\n240\u2192                     raise ValueError(\"timeout must be a positive integer\")\n241\u2192                 setattr(config, key, value_int)\n242\u2192             except ValueError as e:\n243\u2192                 raise ValueError(f\"Invalid timeout value: {e}\") from e\n244\u2192         else:\n245\u2192             setattr(config, key, value)\n246\u2192 \n247\u2192         self.save(config)\n248\u2192         print(\"Config updated successfully\")\n249\u2192 \n250\u2192 \n251\u2192 def load_config() -> Config:\n252\u2192     \"\"\"Load configuration, prompting for first-time setup if needed.\n253\u2192 \n254\u2192     Returns:\n255\u2192         Config object\n256\u2192     \"\"\"\n257\u2192     manager = ConfigManager()\n258\u2192     return manager.load()", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_bb24044740cf48c6bb5e332f", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/tests/test_chat_client.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/tests/test_chat_client.py (752 lines)\n============================================================\n\n  1\u2192 \"\"\"Tests for ChatClient (Issue 17).\n  2\u2192 \n  3\u2192 TDD approach:\n  4\u2192 1. Write tests FIRST\n  5\u2192 2. Verify tests FAIL\n  6\u2192 3. Implement code\n  7\u2192 4. Verify tests PASS\n  8\u2192 \"\"\"\n  9\u2192 import asyncio\n 10\u2192 from datetime import datetime\n 11\u2192 from typing import Literal\n 12\u2192 from dataclasses import dataclass, field\n 13\u2192 from unittest.mock import AsyncMock, MagicMock, patch\n 14\u2192 \n 15\u2192 import pytest\n 16\u2192 from anthropic import AsyncAnthropic\n 17\u2192 \n 18\u2192 from goz.config import Config\n 19\u2192 from goz.api.errors import AuthError, ApiError, NetworkError, TimeoutError\n 20\u2192 \n 21\u2192 \n 22\u2192 # Import the actual classes from chat_client for testing\n 23\u2192 from goz.agent.chat_client import (\n 24\u2192     ChatClient,\n 25\u2192     ContentBlockStart,\n 26\u2192     ContentBlockDelta,\n 27\u2192     ContentBlockStop,\n 28\u2192     MessageStart,\n 29\u2192     MessageStop,\n 30\u2192     Chunk,\n 31\u2192 )\n 32\u2192 \n 33\u2192 \n 34\u2192 class TestChatClientTDD:\n 35\u2192     \"\"\"TDD tests for ChatClient.\n 36\u2192 \n 37\u2192     Test sequence:\n 38\u2192     1. Class initialization\n 39\u2192     2. Simple chat completion (no tools, no stream)\n 40\u2192     3. Chat completion with streaming\n 41\u2192     4. Chat completion with tools\n 42\u2192     5. Tool call extraction from stream\n 43\u2192     6. Error handling\n 44\u2192     \"\"\"\n 45\u2192 \n 46\u2192     @pytest.fixture\n 47\u2192     def config(self) -> Config:\n 48\u2192         \"\"\"Create test config.\"\"\"\n 49\u2192         return Config(\n 50\u2192             zai_token=\"test-token\",\n 51\u2192             zai_base_url=\"https://api.test.com\",\n 52\u2192             chat_model=\"test-model\",\n 53\u2192             timeout=60,\n 54\u2192         )\n 55\u2192 \n 56\u2192     @pytest.fixture\n 57\u2192     def mock_anthropic(self):\n 58\u2192         \"\"\"Mock AsyncAnthropic client.\"\"\"\n 59\u2192         mock_client = MagicMock(spec=AsyncAnthropic)\n 60\u2192         return mock_client\n 61\u2192 \n 62\u2192     # TEST 1: ChatClient class exists and initializes correctly\n 63\u2192     def test_01_chat_client_class_exists(self, config):\n 64\u2192         \"\"\"Acceptance Criterion 1: ChatClient class exists.\"\"\"\n 65\u2192         # This test will fail until we create the class\n 66\u2192         from goz.agent.chat_client import ChatClient\n 67\u2192 \n 68\u2192         client = ChatClient(config)\n 69\u2192         assert client is not None\n 70\u2192         assert client.config is config\n 71\u2192 \n 72\u2192     # TEST 2: ChatClient uses AsyncAnthropic from SDK\n 73\u2192     def test_02_uses_anthropic_sdk(self, config):\n 74\u2192         \"\"\"Acceptance Criterion 2: Uses existing Anthropic SDK.\"\"\"\n 75\u2192         from goz.agent.chat_client import ChatClient\n 76\u2192 \n 77\u2192         client = ChatClient(config)\n 78\u2192 \n 79\u2192         # Verify the client has an _client attribute that's an AsyncAnthropic\n 80\u2192         assert hasattr(client, '_client')\n 81\u2192         assert isinstance(client._client, AsyncAnthropic)\n 82\u2192 \n 83\u2192         # Verify it's configured with the right params\n 84\u2192         assert client._client.api_key == config.zai_token\n 85\u2192         assert client._client.base_url == config.zai_base_url\n 86\u2192 \n 87\u2192     # TEST 3: chat_completion method exists and returns async iterator\n 88\u2192     @pytest.mark.asyncio\n 89\u2192     async def test_03_chat_completion_returns_iterator(self, config):\n 90\u2192         \"\"\"Acceptance Criteria 3, 4: Uses config, returns async iterator.\"\"\"\n 91\u2192         from goz.agent.chat_client import ChatClient\n 92\u2192 \n 93\u2192         client = ChatClient(config)\n 94\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n 95\u2192 \n 96\u2192         # Mock the API response\n 97\u2192         with patch.object(client._client, 'messages') as mock_messages:\n 98\u2192             mock_stream = AsyncMock()\n 99\u2192             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n100\u2192             mock_stream.__aenter__ = AsyncMock(return_value=mock_stream)\n101\u2192             mock_stream.__aexit__ = AsyncMock()\n102\u2192 \n103\u2192             mock_messages.stream.return_value = mock_stream\n104\u2192 \n105\u2192             # Call chat_completion\n106\u2192             result = client.chat_completion(messages)\n107\u2192 \n108\u2192             # Verify it's an async iterator\n109\u2192             assert hasattr(result, '__aiter__')\n110\u2192             assert hasattr(result, '__anext__')\n111\u2192 \n112\u2192     # TEST 4: Simple text streaming works\n113\u2192     @pytest.mark.asyncio\n114\u2192     async def test_04_simple_text_streaming(self, config):\n115\u2192         \"\"\"Acceptance Criterion 8: Response chunks yield text deltas.\"\"\"\n116\u2192         from goz.agent.chat_client import ChatClient\n117\u2192 \n118\u2192         client = ChatClient(config)\n119\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n120\u2192 \n121\u2192         # Create events that will be converted to chunks\n122\u2192         events = []\n123\u2192 \n124\u2192         # Text delta events\n125\u2192         for text in [\"Hello\", \" there\", \"!\"]:\n126\u2192             event = MagicMock()\n127\u2192             event.type = \"content_block_delta\"\n128\u2192             event.index = 0\n129\u2192             delta = MagicMock()\n130\u2192             delta.type = \"text_delta\"\n131\u2192             delta.text = text\n132\u2192             event.delta = delta\n133\u2192             events.append(event)\n134\u2192 \n135\u2192         # Message stop\n136\u2192         stop = MagicMock()\n137\u2192         stop.type = \"message_stop\"\n138\u2192         msg = MagicMock()\n139\u2192         msg.stop_reason = \"end_turn\"\n140\u2192         stop.message = msg\n141\u2192         events.append(stop)\n142\u2192 \n143\u2192         # Convert events using the client's conversion method\n144\u2192         chunks = []\n145\u2192         for event in events:\n146\u2192             chunk = client._convert_sse_event_to_chunk(event)\n147\u2192             if chunk is not None:\n148\u2192                 chunks.append(chunk)\n149\u2192 \n150\u2192         # Verify we got text chunks\n151\u2192         text_chunks = [c for c in chunks if isinstance(c, ContentBlockDelta) and c.text]\n152\u2192         assert len(text_chunks) == 3\n153\u2192         assert text_chunks[0].text == \"Hello\"\n154\u2192         assert text_chunks[1].text == \" there\"\n155\u2192         assert text_chunks[2].text == \"!\"\n156\u2192 \n157\u2192         # Also verify streaming works end-to-end with a simple mock\n158\u2192         with patch.object(client._client, 'messages') as mock_messages:\n159\u2192             async def empty_stream():\n160\u2192                 return\n161\u2192                 yield  # Make it an async generator\n162\u2192 \n163\u2192             mock_stream_context = MagicMock()\n164\u2192             mock_stream_context.__aenter__ = AsyncMock(return_value=empty_stream())\n165\u2192             mock_stream_context.__aexit__ = AsyncMock()\n166\u2192             mock_messages.stream.return_value = mock_stream_context\n167\u2192 \n168\u2192             # Should not raise\n169\u2192             chunks = []\n170\u2192             async for chunk in client.chat_completion(messages, stream=True):\n171\u2192                 chunks.append(chunk)\n172\u2192             # Empty stream returns no chunks\n173\u2192             assert len(chunks) == 0\n174\u2192 \n175\u2192     # TEST 5: Tools parameter is supported\n176\u2192     @pytest.mark.asyncio\n177\u2192     async def test_05_tools_parameter_supported(self, config):\n178\u2192         \"\"\"Acceptance Criterion 5: Supports tools parameter.\"\"\"\n179\u2192         from goz.agent.chat_client import ChatClient\n180\u2192 \n181\u2192         client = ChatClient(config)\n182\u2192         messages = [{\"role\": \"user\", \"content\": \"Read main.py\"}]\n183\u2192 \n184\u2192         tools = [\n185\u2192             {\n186\u2192                 \"name\": \"view_file\",\n187\u2192                 \"description\": \"View file contents\",\n188\u2192                 \"input_schema\": {\n189\u2192                     \"type\": \"object\",\n190\u2192                     \"properties\": {\n191\u2192                         \"file_path\": {\"type\": \"string\"}\n192\u2192                     },\n193\u2192                     \"required\": [\"file_path\"]\n194\u2192                 }\n195\u2192             }\n196\u2192         ]\n197\u2192 \n198\u2192         with patch.object(client._client, 'messages') as mock_messages:\n199\u2192             mock_stream = AsyncMock()\n200\u2192             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n201\u2192             mock_stream_context = MagicMock()\n202\u2192             mock_stream_context.__aenter__ = AsyncMock(return_value=mock_stream)\n203\u2192             mock_stream_context.__aexit__ = AsyncMock()\n204\u2192             mock_messages.stream.return_value = mock_stream_context\n205\u2192 \n206\u2192             # Call with tools\n207\u2192             async for _ in client.chat_completion(messages, tools=tools):\n208\u2192                 pass\n209\u2192 \n210\u2192             # Verify tools were passed to the API\n211\u2192             call_args = mock_messages.stream.call_args\n212\u2192             assert 'tools' in call_args.kwargs or len(call_args.args) > 1\n213\u2192 \n214\u2192     # TEST 6: tool_choice parameter is supported\n215\u2192     @pytest.mark.asyncio\n216\u2192     async def test_06_tool_choice_supported(self, config):\n217\u2192         \"\"\"Acceptance Criterion 6: Supports tool_choice parameter.\"\"\"\n218\u2192         from goz.agent.chat_client import ChatClient\n219\u2192 \n220\u2192         client = ChatClient(config)\n221\u2192         messages = [{\"role\": \"user\", \"content\": \"Read main.py\"}]\n222\u2192 \n223\u2192         with patch.object(client._client, 'messages') as mock_messages:\n224\u2192             mock_stream = AsyncMock()\n225\u2192             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n226\u2192             mock_stream_context = MagicMock()\n227\u2192             mock_stream_context.__aenter__ = AsyncMock(return_value=mock_stream)\n228\u2192             mock_stream_context.__aexit__ = AsyncMock()\n229\u2192             mock_messages.stream.return_value = mock_stream_context\n230\u2192 \n231\u2192             # Call with tool_choice\n232\u2192             async for _ in client.chat_completion(messages, tool_choice=\"any\"):\n233\u2192                 pass\n234\u2192 \n235\u2192             # Verify tool_choice was passed\n236\u2192             call_args = mock_messages.stream.call_args\n237\u2192             assert 'tool_choice' in call_args.kwargs or len(call_args.args) > 2\n238\u2192 \n239\u2192     # TEST 7: stream parameter is supported\n240\u2192     @pytest.mark.asyncio\n241\u2192     async def test_07_stream_parameter_supported(self, config):\n242\u2192         \"\"\"Acceptance Criterion 7: Supports stream parameter.\"\"\"\n243\u2192         from goz.agent.chat_client import ChatClient\n244\u2192 \n245\u2192         client = ChatClient(config)\n246\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n247\u2192 \n248\u2192         with patch.object(client._client, 'messages') as mock_messages:\n249\u2192             # Test with stream=True\n250\u2192             mock_stream = AsyncMock()\n251\u2192             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n252\u2192             mock_stream_context = MagicMock()\n253\u2192             mock_stream_context.__aenter__ = AsyncMock(return_value=mock_stream)\n254\u2192             mock_stream_context.__aexit__ = AsyncMock()\n255\u2192             mock_messages.stream.return_value = mock_stream_context\n256\u2192 \n257\u2192             async for _ in client.chat_completion(messages, stream=True):\n258\u2192                 pass\n259\u2192 \n260\u2192             # Test with stream=False (should use create instead of stream)\n261\u2192             mock_create_response = MagicMock()\n262\u2192             mock_create_response.id = \"msg_123\"\n263\u2192             mock_create_response.model = \"test-model\"\n264\u2192             mock_create_response.content = [MagicMock(text=\"Response\", type=\"text\")]\n265\u2192             mock_create_response.stop_reason = \"end_turn\"\n266\u2192             mock_messages.create = AsyncMock(return_value=mock_create_response)\n267\u2192 \n268\u2192             async for _ in client.chat_completion(messages, stream=False):\n269\u2192                 pass\n270\u2192 \n271\u2192     # TEST 8: Tool calls are properly formatted in stream\n272\u2192     @pytest.mark.asyncio\n273\u2192     async def test_08_tool_calls_formatted_correctly(self, config):\n274\u2192         \"\"\"Acceptance Criterion 9: Tool calls are properly formatted in stream.\"\"\"\n275\u2192         from goz.agent.chat_client import ChatClient\n276\u2192 \n277\u2192         client = ChatClient(config)\n278\u2192 \n279\u2192         # Create events for tool call\n280\u2192         events = []\n281\u2192 \n282\u2192         # Start tool_use block\n283\u2192         start = MagicMock()\n284\u2192         start.type = \"content_block_start\"\n285\u2192         start.index = 0\n286\u2192         cb = MagicMock()\n287\u2192         cb.type = \"tool_use\"\n288\u2192         cb.id = \"call_123\"\n289\u2192         cb.name = \"view_file\"\n290\u2192         start.content_block = cb\n291\u2192         events.append(start)\n292\u2192 \n293\u2192         # Delta with partial JSON\n294\u2192         delta1 = MagicMock()\n295\u2192         delta1.type = \"content_block_delta\"\n296\u2192         delta1.index = 0\n297\u2192         d1 = MagicMock()\n298\u2192         d1.type = \"input_json_delta\"\n299\u2192         d1.partial_json = '{\"file_path\":\"main.py\"}'\n300\u2192         delta1.delta = d1\n301\u2192         events.append(delta1)\n302\u2192 \n303\u2192         # Stop\n304\u2192         stop = MagicMock()\n305\u2192         stop.type = \"content_block_stop\"\n306\u2192         stop.index = 0\n307\u2192         events.append(stop)\n308\u2192 \n309\u2192         # Convert events using the client's conversion method\n310\u2192         chunks = []\n311\u2192         for event in events:\n312\u2192             chunk = client._convert_sse_event_to_chunk(event)\n313\u2192             if chunk is not None:\n314\u2192                 chunks.append(chunk)\n315\u2192 \n316\u2192         # Verify we got the tool use start\n317\u2192         tool_use_starts = [c for c in chunks if isinstance(c, ContentBlockStart) and c.type == \"tool_use\"]\n318\u2192         assert len(tool_use_starts) == 1\n319\u2192         assert tool_use_starts[0].name == \"view_file\"\n320\u2192         assert tool_use_starts[0].id == \"call_123\"\n321\u2192 \n322\u2192         # Verify we got the partial JSON delta\n323\u2192         json_deltas = [c for c in chunks if isinstance(c, ContentBlockDelta) and c.type == \"input_json_delta\"]\n324\u2192         assert len(json_deltas) == 1\n325\u2192 \n326\u2192     # TEST 9: AuthError is raised for authentication failures\n327\u2192     @pytest.mark.asyncio\n328\u2192     async def test_09_auth_error_handling(self, config):\n329\u2192         \"\"\"Acceptance Criterion 10: AuthError raised for 401/403.\"\"\"\n330\u2192         from goz.agent.chat_client import ChatClient\n331\u2192         import anthropic\n332\u2192 \n333\u2192         client = ChatClient(config)\n334\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n335\u2192 \n336\u2192         # Create error-raising context manager\n337\u2192         class ErrorContext:\n338\u2192             async def __aenter__(self):\n339\u2192                 mock_response = MagicMock()\n340\u2192                 mock_response.status_code = 401\n341\u2192                 raise anthropic.AuthenticationError(\n342\u2192                     message=\"Invalid token\",\n343\u2192                     response=mock_response,\n344\u2192                     body=None,\n345\u2192                 )\n346\u2192             async def __aexit__(self, *args):\n347\u2192                 pass\n348\u2192 \n349\u2192         with patch.object(client._client, 'messages') as mock_messages:\n350\u2192             def mock_stream_func(**kwargs):\n351\u2192                 return ErrorContext()\n352\u2192             mock_messages.stream.side_effect = mock_stream_func\n353\u2192 \n354\u2192             # Should raise AuthError\n355\u2192             with pytest.raises(AuthError):\n356\u2192                 async for _ in client.chat_completion(messages):\n357\u2192                     pass\n358\u2192 \n359\u2192     # TEST 10: ApiError is raised for API errors\n360\u2192     @pytest.mark.asyncio\n361\u2192     async def test_10_api_error_handling(self, config):\n362\u2192         \"\"\"Acceptance Criterion 10: ApiError raised for 4xx/5xx.\"\"\"\n363\u2192         from goz.agent.chat_client import ChatClient\n364\u2192         import anthropic\n365\u2192 \n366\u2192         client = ChatClient(config)\n367\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n368\u2192 \n369\u2192         class ErrorContext:\n370\u2192             async def __aenter__(self):\n371\u2192                 mock_response = MagicMock()\n372\u2192                 mock_response.status_code = 429\n373\u2192                 raise anthropic.APIStatusError(\n374\u2192                     message=\"Rate limit exceeded\",\n375\u2192                     response=mock_response,\n376\u2192                     body=None,\n377\u2192                 )\n378\u2192             async def __aexit__(self, *args):\n379\u2192                 pass\n380\u2192 \n381\u2192         with patch.object(client._client, 'messages') as mock_messages:\n382\u2192             def mock_stream_func(**kwargs):\n383\u2192                 return ErrorContext()\n384\u2192             mock_messages.stream.side_effect = mock_stream_func\n385\u2192 \n386\u2192             # Should raise ApiError\n387\u2192             with pytest.raises(ApiError) as exc_info:\n388\u2192                 async for _ in client.chat_completion(messages):\n389\u2192                     pass\n390\u2192 \n391\u2192             assert exc_info.value.statusCode == 429\n392\u2192 \n393\u2192     @pytest.mark.asyncio\n394\u2192     async def test_10b_rate_limit_retried_before_success(self, config):\n395\u2192         \"\"\"429 errors should retry with exponential backoff and preserve success.\"\"\"\n396\u2192         from goz.agent.chat_client import ChatClient\n397\u2192         import anthropic\n398\u2192 \n399\u2192         client = ChatClient(config)\n400\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n401\u2192 \n402\u2192         response = MagicMock()\n403\u2192         response.id = \"msg_123\"\n404\u2192         response.model = \"test-model\"\n405\u2192         response.content = []\n406\u2192         response.stop_reason = \"end_turn\"\n407\u2192 \n408\u2192         mock_response = MagicMock()\n409\u2192         mock_response.status_code = 429\n410\u2192 \n411\u2192         class ErrorContext:\n412\u2192             async def __aenter__(self):\n413\u2192                 raise anthropic.APIStatusError(\n414\u2192                     message=\"Rate limit exceeded\",\n415\u2192                     response=mock_response,\n416\u2192                     body=None,\n417\u2192                 )\n418\u2192 \n419\u2192             async def __aexit__(self, *args):\n420\u2192                 pass\n421\u2192 \n422\u2192         with patch.object(client._client, \"messages\") as mock_messages, \\\n423\u2192              patch(\"goz.agent.chat_client.asyncio.sleep\", new=AsyncMock()) as mock_sleep:\n424\u2192             mock_messages.create = AsyncMock(side_effect=[\n425\u2192                 anthropic.APIStatusError(\n426\u2192                     message=\"Rate limit exceeded\",\n427\u2192                     response=mock_response,\n428\u2192                     body=None,\n429\u2192                 ),\n430\u2192                 anthropic.APIStatusError(\n431\u2192                     message=\"Rate limit exceeded\",\n432\u2192                     response=mock_response,\n433\u2192                     body=None,\n434\u2192                 ),\n435\u2192                 response,\n436\u2192             ])\n437\u2192 \n438\u2192             chunks = []\n439\u2192             async for chunk in client.chat_completion(messages, stream=False):\n440\u2192                 chunks.append(chunk)\n441\u2192 \n442\u2192             assert chunks\n443\u2192             assert mock_messages.create.await_count == 3\n444\u2192             assert mock_sleep.await_count == 2\n445\u2192 \n446\u2192     @pytest.mark.asyncio\n447\u2192     async def test_10c_server_error_retries_then_raises(self, config):\n448\u2192         \"\"\"5xx errors should retry up to the configured maximum.\"\"\"\n449\u2192         from goz.agent.chat_client import ChatClient\n450\u2192         import anthropic\n451\u2192 \n452\u2192         client = ChatClient(config)\n453\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n454\u2192 \n455\u2192         mock_response = MagicMock()\n456\u2192         mock_response.status_code = 500\n457\u2192 \n458\u2192         class ErrorContext:\n459\u2192             async def __aenter__(self):\n460\u2192                 raise anthropic.APIStatusError(\n461\u2192                     message=\"Server unavailable\",\n462\u2192                     response=mock_response,\n463\u2192                     body=None,\n464\u2192                 )\n465\u2192 \n466\u2192             async def __aexit__(self, *args):\n467\u2192                 pass\n468\u2192 \n469\u2192         with patch.object(client._client, \"messages\") as mock_messages, \\\n470\u2192              patch(\"goz.agent.chat_client.asyncio.sleep\", new=AsyncMock()) as mock_sleep:\n471\u2192             mock_messages.stream.side_effect = [ErrorContext(), ErrorContext(), ErrorContext()]\n472\u2192 \n473\u2192             with pytest.raises(ApiError) as exc_info:\n474\u2192                 async for _ in client.chat_completion(messages):\n475\u2192                     pass\n476\u2192 \n477\u2192             assert exc_info.value.statusCode == 500\n478\u2192             assert mock_messages.stream.call_count == 3\n479\u2192             assert mock_sleep.await_count == 2\n480\u2192 \n481\u2192     # TEST 11: NetworkError is raised for connection failures\n482\u2192     @pytest.mark.asyncio\n483\u2192     async def test_11_network_error_handling(self, config):\n484\u2192         \"\"\"Acceptance Criterion 10: NetworkError for connection failures.\"\"\"\n485\u2192         from goz.agent.chat_client import ChatClient\n486\u2192         import anthropic\n487\u2192 \n488\u2192         client = ChatClient(config)\n489\u2192 \n490\u2192         # Test the error handling - APIConnectionError requires message and request\n491\u2192         mock_request = MagicMock()\n492\u2192         try:\n493\u2192             raise anthropic.APIConnectionError(message=\"Connection failed\", request=mock_request)\n494\u2192         except anthropic.APIConnectionError:\n495\u2192             # Should be converted to NetworkError by the client\n496\u2192             from goz.api.errors import NetworkError\n497\u2192             raised = False\n498\u2192             try:\n499\u2192                 raise NetworkError(\"Connection failed\")\n500\u2192             except NetworkError:\n501\u2192                 raised = True\n502\u2192             assert raised, \"NetworkError should be raised for APIConnectionError\"\n503\u2192 \n504\u2192     # TEST 12: TimeoutError is raised for timeouts\n505\u2192     @pytest.mark.asyncio\n506\u2192     async def test_12_timeout_error_handling(self, config):\n507\u2192         \"\"\"Acceptance Criterion 10: TimeoutError for request timeouts.\"\"\"\n508\u2192         from goz.agent.chat_client import ChatClient\n509\u2192         from anthropic import APITimeoutError\n510\u2192 \n511\u2192         client = ChatClient(config)\n512\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n513\u2192 \n514\u2192         # Mock timeout error\n515\u2192         class ErrorContext:\n516\u2192             async def __aenter__(self):\n517\u2192                 raise APITimeoutError(\"Request timed out\")\n518\u2192             async def __aexit__(self, *args):\n519\u2192                 pass\n520\u2192 \n521\u2192         with patch.object(client._client, 'messages') as mock_messages:\n522\u2192             def mock_stream_func(**kwargs):\n523\u2192                 return ErrorContext()\n524\u2192             mock_messages.stream.side_effect = mock_stream_func\n525\u2192 \n526\u2192             # Should raise TimeoutError\n527\u2192             with pytest.raises(TimeoutError):\n528\u2192                 async for _ in client.chat_completion(messages):\n529\u2192                     pass\n530\u2192 \n531\u2192     @pytest.mark.asyncio\n532\u2192     async def test_12b_timeout_error_includes_retry_guidance_after_exhaustion(self, config):\n533\u2192         \"\"\"Timeouts should be retried, then surface a useful final message.\"\"\"\n534\u2192         from goz.agent.chat_client import ChatClient\n535\u2192         from anthropic import APITimeoutError\n536\u2192 \n537\u2192         client = ChatClient(config)\n538\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n539\u2192 \n540\u2192         class ErrorContext:\n541\u2192             async def __aenter__(self):\n542\u2192                 raise APITimeoutError(\"Request timed out\")\n543\u2192 \n544\u2192             async def __aexit__(self, *args):\n545\u2192                 pass\n546\u2192 \n547\u2192         with patch.object(client._client, \"messages\") as mock_messages, \\\n548\u2192              patch(\"goz.agent.chat_client.asyncio.sleep\", new=AsyncMock()) as mock_sleep:\n549\u2192             mock_messages.stream.side_effect = [ErrorContext(), ErrorContext(), ErrorContext()]\n550\u2192 \n551\u2192             with pytest.raises(TimeoutError) as exc_info:\n552\u2192                 async for _ in client.chat_completion(messages):\n553\u2192                     pass\n554\u2192 \n555\u2192             assert \"timed out\" in exc_info.value.message.lower()\n556\u2192             assert mock_messages.stream.call_count == 3\n557\u2192             assert mock_sleep.await_count == 2\n558\u2192 \n559\u2192     # TEST 13: Timeout is configurable via config\n560\u2192     def test_13_timeout_configurable(self, config):\n561\u2192         \"\"\"Acceptance Criterion 11: Timeout is configurable via config.\"\"\"\n562\u2192         from goz.agent.chat_client import ChatClient\n563\u2192 \n564\u2192         # Set custom timeout\n565\u2192         config.timeout = 120\n566\u2192 \n567\u2192         client = ChatClient(config)\n568\u2192 \n569\u2192         # Verify the client has the timeout configured\n570\u2192         # The Anthropic SDK uses timeout parameter\n571\u2192         assert client._client.timeout is not None\n572\u2192 \n573\u2192     # TEST 14: temperature and max_tokens parameters are supported\n574\u2192     @pytest.mark.asyncio\n575\u2192     async def test_14_temperature_and_max_tokens(self, config):\n576\u2192         \"\"\"Verify temperature and max_tokens parameters work.\"\"\"\n577\u2192         from goz.agent.chat_client import ChatClient\n578\u2192 \n579\u2192         client = ChatClient(config)\n580\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n581\u2192 \n582\u2192         with patch.object(client._client, 'messages') as mock_messages:\n583\u2192             mock_stream = AsyncMock()\n584\u2192             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n585\u2192             mock_stream_context = MagicMock()\n586\u2192             mock_stream_context.__aenter__ = AsyncMock(return_value=mock_stream)\n587\u2192             mock_stream_context.__aexit__ = AsyncMock()\n588\u2192             mock_messages.stream.return_value = mock_stream_context\n589\u2192 \n590\u2192             # Call with temperature and max_tokens\n591\u2192             async for _ in client.chat_completion(\n592\u2192                 messages,\n593\u2192                 temperature=0.5,\n594\u2192                 max_tokens=1000\n595\u2192             ):\n596\u2192                 pass\n597\u2192 \n598\u2192             # Verify parameters were passed\n599\u2192             call_args = mock_messages.stream.call_args\n600\u2192 \n601\u2192             # Check that temperature and max_tokens were in the call\n602\u2192             kwargs = call_args.kwargs\n603\u2192             assert 'temperature' in kwargs or len(call_args.args) > 3\n604\u2192             assert 'max_tokens' in kwargs or len(call_args.args) > 4\n605\u2192 \n606\u2192     # TEST 15: Non-streaming mode works\n607\u2192     @pytest.mark.asyncio\n608\u2192     async def test_15_non_streaming_mode(self, config):\n609\u2192         \"\"\"Verify non-streaming mode returns chunks from response.\"\"\"\n610\u2192         from goz.agent.chat_client import ChatClient\n611\u2192 \n612\u2192         client = ChatClient(config)\n613\u2192 \n614\u2192         # Test the _response_to_chunks method directly\n615\u2192         mock_response = MagicMock()\n616\u2192         mock_response.id = \"msg_123\"\n617\u2192         mock_response.model = \"test-model\"\n618\u2192 \n619\u2192         # Create proper content block\n620\u2192         content_block = MagicMock()\n621\u2192         content_block.type = \"text\"\n622\u2192         content_block.text = \"Hello there!\"\n623\u2192         mock_response.content = [content_block]\n624\u2192 \n625\u2192         mock_response.stop_reason = \"end_turn\"\n626\u2192 \n627\u2192         # Collect chunks from the response\n628\u2192         chunks = []\n629\u2192         async for chunk in client._response_to_chunks(mock_response):\n630\u2192             chunks.append(chunk)\n631\u2192 \n632\u2192         # Should yield chunks for the response\n633\u2192         assert len(chunks) > 0\n634\u2192 \n635\u2192         # Should have text content\n636\u2192         text_chunks = [c for c in chunks if isinstance(c, ContentBlockDelta) and c.text]\n637\u2192         assert len(text_chunks) > 0\n638\u2192         assert \"Hello there!\" in text_chunks[0].text\n639\u2192 \n640\u2192 \n641\u2192 class TestChatClientIntegration:\n642\u2192     \"\"\"Integration-style tests with more realistic mock scenarios.\"\"\"\n643\u2192 \n644\u2192     @pytest.fixture\n645\u2192     def config(self) -> Config:\n646\u2192         \"\"\"Create test config.\"\"\"\n647\u2192         return Config(\n648\u2192             zai_token=\"test-token\",\n649\u2192             zai_base_url=\"https://api.test.com\",\n650\u2192             chat_model=\"test-model\",\n651\u2192             timeout=60,\n652\u2192         )\n653\u2192 \n654\u2192     @pytest.mark.asyncio\n655\u2192     async def test_full_conversation_flow(self, config):\n656\u2192         \"\"\"Test a realistic conversation flow - tests event conversion.\"\"\"\n657\u2192         from goz.agent.chat_client import ChatClient\n658\u2192 \n659\u2192         client = ChatClient(config)\n660\u2192 \n661\u2192         # Simulate a response with text then a tool call\n662\u2192         events = []\n663\u2192 \n664\u2192         # Message start\n665\u2192         msg_start = MagicMock()\n666\u2192         msg_start.type = \"message_start\"\n667\u2192         msg = MagicMock()\n668\u2192         msg.id = \"msg_123\"\n669\u2192         msg.model = \"test-model\"\n670\u2192         msg_start.message = msg\n671\u2192         events.append(msg_start)\n672\u2192 \n673\u2192         # Content block start (text)\n674\u2192         cb_start = MagicMock()\n675\u2192         cb_start.type = \"content_block_start\"\n676\u2192         cb_start.index = 0\n677\u2192         cb = MagicMock()\n678\u2192         cb.type = \"text\"\n679\u2192         cb_start.content_block = cb\n680\u2192         events.append(cb_start)\n681\u2192 \n682\u2192         # Text deltas\n683\u2192         for text in [\"I'll\", \" read\", \" main.py\", \" for you.\"]:\n684\u2192             delta = MagicMock()\n685\u2192             delta.type = \"content_block_delta\"\n686\u2192             delta.index = 0\n687\u2192             d = MagicMock()\n688\u2192             d.type = \"text_delta\"\n689\u2192             d.text = text\n690\u2192             delta.delta = d\n691\u2192             events.append(delta)\n692\u2192 \n693\u2192         # Content block stop\n694\u2192         cb_stop = MagicMock()\n695\u2192         cb_stop.type = \"content_block_stop\"\n696\u2192         cb_stop.index = 0\n697\u2192         events.append(cb_stop)\n698\u2192 \n699\u2192         # Content block start (tool_use)\n700\u2192         tool_start = MagicMock()\n701\u2192         tool_start.type = \"content_block_start\"\n702\u2192         tool_start.index = 1\n703\u2192         tb = MagicMock()\n704\u2192         tb.type = \"tool_use\"\n705\u2192         tb.id = \"call_456\"\n706\u2192         tb.name = \"view_file\"\n707\u2192         tool_start.content_block = tb\n708\u2192         events.append(tool_start)\n709\u2192 \n710\u2192         # Tool input delta\n711\u2192         tool_delta = MagicMock()\n712\u2192         tool_delta.type = \"content_block_delta\"\n713\u2192         tool_delta.index = 1\n714\u2192         td = MagicMock()\n715\u2192         td.type = \"input_json_delta\"\n716\u2192         td.partial_json = '{\"file_path\":\"main.py\"}'\n717\u2192         tool_delta.delta = td\n718\u2192         events.append(tool_delta)\n719\u2192 \n720\u2192         # Tool block stop\n721\u2192         tool_stop = MagicMock()\n722\u2192         tool_stop.type = \"content_block_stop\"\n723\u2192         tool_stop.index = 1\n724\u2192         events.append(tool_stop)\n725\u2192 \n726\u2192         # Message stop\n727\u2192         msg_stop = MagicMock()\n728\u2192         msg_stop.type = \"message_stop\"\n729\u2192         ms = MagicMock()\n730\u2192         ms.stop_reason = \"tool_use\"\n731\u2192         msg_stop.message = ms\n732\u2192         events.append(msg_stop)\n733\u2192 \n734\u2192         # Convert events using the client's conversion method\n735\u2192         chunks = []\n736\u2192         for event in events:\n737\u2192             chunk = client._convert_sse_event_to_chunk(event)\n738\u2192             if chunk is not None:\n739\u2192                 chunks.append(chunk)\n740\u2192 \n741\u2192         # Verify we got message start\n742\u2192         msg_starts = [c for c in chunks if isinstance(c, MessageStart)]\n743\u2192         assert len(msg_starts) == 1\n744\u2192 \n745\u2192         # Verify we got text chunks\n746\u2192         text_chunks = [c for c in chunks if isinstance(c, ContentBlockDelta) and c.text]\n747\u2192         assert len(text_chunks) == 4\n748\u2192 \n749\u2192         # Verify we got tool use start\n750\u2192         tool_starts = [c for c in chunks if isinstance(c, ContentBlockStart) and c.type == \"tool_use\"]\n751\u2192         assert len(tool_starts) == 1\n752\u2192         assert tool_starts[0].name == \"view_file\"", "is_error": false}}
