{"type": "tool_use", "part": {"id": "call_07c8b131bd8e4339848f4983", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/errors.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/errors.py (160 lines)\n============================================================\n\n  1\u2192 \"\"\"Error types for Z.AI API client.\n  2\u2192 \n  3\u2192 These error types are used throughout the API client for consistent error handling.\n  4\u2192 \"\"\"\n  5\u2192 \n  6\u2192 from __future__ import annotations\n  7\u2192 \n  8\u2192 \n  9\u2192 \n 10\u2192 class ZaiError(Exception):\n 11\u2192     \"\"\"Base error class for all Z.AI API errors.\n 12\u2192 \n 13\u2192     Attributes:\n 14\u2192         message: Human-readable error message\n 15\u2192         code: Error code for programmatic handling\n 16\u2192         statusCode: HTTP status code (optional)\n 17\u2192         help: Helpful hint for resolving the error (optional)\n 18\u2192     \"\"\"\n 19\u2192 \n 20\u2192     def __init__(\n 21\u2192         self,\n 22\u2192         message: str,\n 23\u2192         code: str = \"ZAI_ERROR\",\n 24\u2192         statusCode: int | None = None,\n 25\u2192         help: str | None = None,\n 26\u2192     ) -> None:\n 27\u2192         \"\"\"Initialize ZaiError.\n 28\u2192 \n 29\u2192         Args:\n 30\u2192             message: Human-readable error message\n 31\u2192             code: Error code for programmatic handling\n 32\u2192             statusCode: HTTP status code (optional)\n 33\u2192             help: Helpful hint for resolving the error (optional)\n 34\u2192         \"\"\"\n 35\u2192         self.message = message\n 36\u2192         self.code = code\n 37\u2192         self.statusCode = statusCode\n 38\u2192         self.help = help\n 39\u2192         super().__init__(self.message)\n 40\u2192 \n 41\u2192     def __str__(self) -> str:\n 42\u2192         \"\"\"Return string representation showing error code and message.\"\"\"\n 43\u2192         return f\"[{self.code}] {self.message}\"\n 44\u2192 \n 45\u2192     def __repr__(self) -> str:\n 46\u2192         \"\"\"Return detailed string representation.\"\"\"\n 47\u2192         return (\n 48\u2192             f\"{self.__class__.__name__}(message={self.message!r}, code={self.code!r}, \"\n 49\u2192             f\"statusCode={self.statusCode!r}, help={self.help!r})\"\n 50\u2192         )\n 51\u2192 \n 52\u2192 \n 53\u2192 class AuthError(ZaiError):\n 54\u2192     \"\"\"Authentication/authorization error (401, 403).\n 55\u2192 \n 56\u2192     This error is raised when the API token is invalid, expired, or missing.\n 57\u2192     \"\"\"\n 58\u2192 \n 59\u2192     def __init__(self, message: str, statusCode: int = 401) -> None:\n 60\u2192         \"\"\"Initialize AuthError.\n 61\u2192 \n 62\u2192         Args:\n 63\u2192             message: Human-readable error message\n 64\u2192             statusCode: HTTP status code (default: 401)\n 65\u2192         \"\"\"\n 66\u2192         super().__init__(\n 67\u2192             message=message,\n 68\u2192             code=\"AUTH_ERROR\",\n 69\u2192             statusCode=statusCode,\n 70\u2192             help=\"Authentication failed. Check your API key in ~/.config/goz/config.json. \"\n 71\u2192             \"Run 'goz config set zai_token <your-token>' to update.\",\n 72\u2192         )\n 73\u2192 \n 74\u2192 \n 75\u2192 class ApiError(ZaiError):\n 76\u2192     \"\"\"General API error (4xx, 5xx responses).\n 77\u2192 \n 78\u2192     This error is raised for API errors that are not authentication-related.\n 79\u2192     \"\"\"\n 80\u2192 \n 81\u2192     def __init__(self, message: str, statusCode: int = 500) -> None:\n 82\u2192         \"\"\"Initialize ApiError.\n 83\u2192 \n 84\u2192         Args:\n 85\u2192             message: Human-readable error message\n 86\u2192             statusCode: HTTP status code (default: 500)\n 87\u2192         \"\"\"\n 88\u2192         super().__init__(\n 89\u2192             message=message,\n 90\u2192             code=\"API_ERROR\",\n 91\u2192             statusCode=statusCode,\n 92\u2192             help=self._default_help(statusCode),\n 93\u2192         )\n 94\u2192 \n 95\u2192     @staticmethod\n 96\u2192     def _default_help(status_code: int) -> str:\n 97\u2192         \"\"\"Return actionable guidance based on HTTP status code.\"\"\"\n 98\u2192         if status_code == 429:\n 99\u2192             return \"Rate limit hit. Wait a moment before retrying, or reduce request volume.\"\n100\u2192         if status_code >= 500:\n101\u2192             return \"The service is having problems. Retry shortly; if it persists, try again later.\"\n102\u2192         return \"Check the request input and try again.\"\n103\u2192 \n104\u2192 \n105\u2192 class NetworkError(ZaiError):\n106\u2192     \"\"\"Network connection error.\n107\u2192 \n108\u2192     This error is raised when the client cannot connect to the API server.\n109\u2192     \"\"\"\n110\u2192 \n111\u2192     def __init__(self, message: str) -> None:\n112\u2192         \"\"\"Initialize NetworkError.\n113\u2192 \n114\u2192         Args:\n115\u2192             message: Human-readable error message\n116\u2192         \"\"\"\n117\u2192         super().__init__(\n118\u2192             message=message,\n119\u2192             code=\"NETWORK_ERROR\",\n120\u2192             help=\"Network connection failed. Check your internet connection and try again.\",\n121\u2192         )\n122\u2192 \n123\u2192 \n124\u2192 class TimeoutError(ZaiError):\n125\u2192     \"\"\"Request timeout error.\n126\u2192 \n127\u2192     This error is raised when the API request takes too long to complete.\n128\u2192     \"\"\"\n129\u2192 \n130\u2192     def __init__(self, timeoutMs: int) -> None:\n131\u2192         \"\"\"Initialize TimeoutError.\n132\u2192 \n133\u2192         Args:\n134\u2192             timeoutMs: Timeout value in milliseconds\n135\u2192         \"\"\"\n136\u2192         super().__init__(\n137\u2192             message=f\"Request timed out after {timeoutMs}ms\",\n138\u2192             code=\"TIMEOUT_ERROR\",\n139\u2192             help=\"Try again or increase timeout with Z_AI_TIMEOUT env var\",\n140\u2192         )\n141\u2192 \n142\u2192 \n143\u2192 class ValidationError(ZaiError):\n144\u2192     \"\"\"Validation error for invalid input parameters.\n145\u2192 \n146\u2192     This error is raised when input validation fails, such as invalid URLs,\n147\u2192     invalid format values, or other parameter validation issues.\n148\u2192     \"\"\"\n149\u2192 \n150\u2192     def __init__(self, message: str) -> None:\n151\u2192         \"\"\"Initialize ValidationError.\n152\u2192 \n153\u2192         Args:\n154\u2192             message: Human-readable error message describing the validation failure\n155\u2192         \"\"\"\n156\u2192         super().__init__(\n157\u2192             message=message,\n158\u2192             code=\"VALIDATION_ERROR\",\n159\u2192             help=\"Check your input parameters and try again.\",\n160\u2192         )", "is_error": false}}
