{"type": "tool_use", "part": {"id": "call_079d9bd7e2014eab83e417cb", "name": "view_file", "input": {"file_path": "goz/cli/run.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/cli/run.py (395 lines)\n============================================================\n\n  1\u2192 \"\"\"JSONL CLI runner for litehive-compatible one-shot agent execution.\"\"\"\n  2\u2192 \n  3\u2192 from __future__ import annotations\n  4\u2192 \n  5\u2192 import argparse\n  6\u2192 import asyncio\n  7\u2192 import json\n  8\u2192 import signal\n  9\u2192 import sys\n 10\u2192 import uuid\n 11\u2192 from dataclasses import dataclass\n 12\u2192 from datetime import datetime\n 13\u2192 from pathlib import Path\n 14\u2192 from typing import Any, TextIO\n 15\u2192 \n 16\u2192 from goz.agent.chat_client import ChatClient, Chunk, ContentBlockDelta, ContentBlockStart, ContentBlockStop\n 17\u2192 from goz.agent.history import ChatHistory, ChatMessage, ToolCall\n 18\u2192 from goz.agent.sessions import Session, SessionManager\n 19\u2192 from goz.agent.tools import (\n 20\u2192     BashTool,\n 21\u2192     CreateFileTool,\n 22\u2192     GlobTool,\n 23\u2192     GrepTool,\n 24\u2192     ReadTool,\n 25\u2192     RepoReadTool,\n 26\u2192     RepoSearchTool,\n 27\u2192     RepoTreeTool,\n 28\u2192     SearchTool,\n 29\u2192     StrReplaceEditorTool,\n 30\u2192     ToolRegistry,\n 31\u2192     ViewFileTool,\n 32\u2192 )\n 33\u2192 from goz.config import Config, load_config\n 34\u2192 \n 35\u2192 \n 36\u2192 MAX_ITERATIONS = 10\n 37\u2192 DEFAULT_AGENT_TYPE = \"engine\"\n 38\u2192 STEP_FINISH_TOKENS = {\n 39\u2192     \"input\": 0,\n 40\u2192     \"output\": 0,\n 41\u2192     \"cache_creation\": 0,\n 42\u2192     \"cache_read\": 0,\n 43\u2192 }\n 44\u2192 STAGE_RESULT_INSTRUCTION = \"\"\"\n 45\u2192 \n 46\u2192 End your final answer with:\n 47\u2192 STAGE_RESULT:\n 48\u2192 {\"verdict\":\"pass\",\"summary\":\"one-line summary\",\"files_changed\":[\"path/to/file\"],\"tests\":{\"added\":0,\"passing\":0},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\n 49\u2192 \n 50\u2192 Return valid JSON after STAGE_RESULT:. Include a verdict.\n 51\u2192 \"\"\".strip()\n 52\u2192 \n 53\u2192 \n 54\u2192 def _emit_event(event: dict[str, Any], stdout: TextIO) -> None:\n 55\u2192     stdout.write(json.dumps(event, ensure_ascii=True) + \"\\n\")\n 56\u2192     stdout.flush()\n 57\u2192 \n 58\u2192 \n 59\u2192 def emit_text_event(text: str, stdout: TextIO) -> None:\n 60\u2192     _emit_event({\"type\": \"text\", \"part\": {\"text\": text}}, stdout)\n 61\u2192 \n 62\u2192 \n 63\u2192 def emit_tool_use_event(\n 64\u2192     tool_call: dict[str, Any],\n 65\u2192     result: str,\n 66\u2192     stdout: TextIO,\n 67\u2192     *,\n 68\u2192     is_error: bool = False,\n 69\u2192 ) -> None:\n 70\u2192     _emit_event(\n 71\u2192         {\n 72\u2192             \"type\": \"tool_use\",\n 73\u2192             \"part\": {\n 74\u2192                 \"id\": tool_call[\"id\"],\n 75\u2192                 \"name\": tool_call[\"name\"],\n 76\u2192                 \"input\": tool_call[\"input\"],\n 77\u2192                 \"output\": result,\n 78\u2192                 \"is_error\": is_error,\n 79\u2192             },\n 80\u2192         },\n 81\u2192         stdout,\n 82\u2192     )\n 83\u2192 \n 84\u2192 \n 85\u2192 def emit_error_event(name: str, message: str, stdout: TextIO) -> None:\n 86\u2192     _emit_event(\n 87\u2192         {\n 88\u2192             \"type\": \"error\",\n 89\u2192             \"error\": {\n 90\u2192                 \"name\": name,\n 91\u2192                 \"data\": {\"message\": message},\n 92\u2192             },\n 93\u2192         },\n 94\u2192         stdout,\n 95\u2192     )\n 96\u2192 \n 97\u2192 \n 98\u2192 def emit_step_finish_event(stdout: TextIO, session_id: str) -> None:\n 99\u2192     _emit_event(\n100\u2192         {\n101\u2192             \"type\": \"step_finish\",\n102\u2192             \"part\": {\n103\u2192                 \"tokens\": dict(STEP_FINISH_TOKENS),\n104\u2192                 \"cost\": 0,\n105\u2192                 \"session_id\": session_id,\n106\u2192                 \"continuation\": {\"resume_session_id\": session_id},\n107\u2192             },\n108\u2192         },\n109\u2192         stdout,\n110\u2192     )\n111\u2192 \n112\u2192 \n113\u2192 @dataclass\n114\u2192 class RunSessionState:\n115\u2192     session_id: str\n116\u2192     created_at: datetime\n117\u2192     history: ChatHistory\n118\u2192     working_dir: str\n119\u2192     agent_type: str\n120\u2192     config: Config\n121\u2192     session_manager: SessionManager\n122\u2192     tool_registry: ToolRegistry\n123\u2192 \n124\u2192     async def save(self) -> Path:\n125\u2192         session = Session(\n126\u2192             id=self.session_id,\n127\u2192             created_at=self.created_at,\n128\u2192             updated_at=datetime.now(),\n129\u2192             working_directory=self.working_dir,\n130\u2192             messages=list(self.history.messages),\n131\u2192             model=self.config.chat_model,\n132\u2192             agent_type=self.agent_type,\n133\u2192             config_snapshot=self.config.model_dump() if hasattr(self.config, \"model_dump\") else {},\n134\u2192             tool_state=_serialize_tool_state(self.tool_registry, self.working_dir),\n135\u2192         )\n136\u2192         return await self.session_manager.save(session)\n137\u2192 \n138\u2192 \n139\u2192 def _serialize_tool_state(tool_registry: ToolRegistry, working_dir: str) -> dict[str, Any]:\n140\u2192     return {\n141\u2192         \"working_directory\": working_dir,\n142\u2192         \"tools\": {\n143\u2192             tool.name: {\n144\u2192                 \"working_dir\": getattr(tool, \"working_dir\", None),\n145\u2192             }\n146\u2192             for tool in tool_registry.list_all()\n147\u2192         },\n148\u2192     }\n149\u2192 \n150\u2192 \n151\u2192 def build_default_tool_registry(config: Config, working_dir: str) -> ToolRegistry:\n152\u2192     \"\"\"Create the default tool set for one-shot CLI runs.\"\"\"\n153\u2192     registry = ToolRegistry()\n154\u2192     registry.register(BashTool(working_dir=working_dir))\n155\u2192     registry.register(ViewFileTool(working_dir=working_dir))\n156\u2192     registry.register(CreateFileTool(working_dir=working_dir))\n157\u2192     registry.register(StrReplaceEditorTool(working_dir=working_dir))\n158\u2192     registry.register(GlobTool(working_dir=working_dir))\n159\u2192     registry.register(GrepTool(working_dir=working_dir))\n160\u2192     registry.register(SearchTool(config))\n161\u2192     registry.register(ReadTool(config))\n162\u2192     registry.register(RepoSearchTool(config))\n163\u2192     registry.register(RepoTreeTool(config))\n164\u2192     registry.register(RepoReadTool(config))\n165\u2192     return registry\n166\u2192 \n167\u2192 \n168\u2192 def _build_prompt(user_prompt: str) -> str:\n169\u2192     return f\"{user_prompt.rstrip()}\\n\\n{STAGE_RESULT_INSTRUCTION}\"\n170\u2192 \n171\u2192 \n172\u2192 def _parse_tool_calls(chunks: list[Chunk]) -> list[dict[str, Any]]:\n173\u2192     tool_calls: list[dict[str, Any]] = []\n174\u2192     tool_calls_by_index: dict[int, dict[str, Any]] = {}\n175\u2192 \n176\u2192     for chunk in chunks:\n177\u2192         if isinstance(chunk, ContentBlockStart) and chunk.type == \"tool_use\":\n178\u2192             tool_calls_by_index[chunk.index] = {\n179\u2192                 \"id\": chunk.id or \"\",\n180\u2192                 \"name\": chunk.name or \"\",\n181\u2192                 \"input_json\": [],\n182\u2192             }\n183\u2192         elif isinstance(chunk, ContentBlockDelta) and chunk.type == \"input_json_delta\":\n184\u2192             block = tool_calls_by_index.get(chunk.index)\n185\u2192             if block is not None and chunk.partial_json:\n186\u2192                 block[\"input_json\"].append(chunk.partial_json)\n187\u2192         elif isinstance(chunk, ContentBlockStop):\n188\u2192             block = tool_calls_by_index.get(chunk.index)\n189\u2192             if block is None:\n190\u2192                 continue\n191\u2192             input_text = \"\".join(block.pop(\"input_json\"))\n192\u2192             try:\n193\u2192                 parsed_input = json.loads(input_text) if input_text else {}\n194\u2192             except json.JSONDecodeError:\n195\u2192                 parsed_input = {\"raw\": input_text}\n196\u2192             tool_calls.append(\n197\u2192                 {\n198\u2192                     \"id\": block[\"id\"],\n199\u2192                     \"name\": block[\"name\"],\n200\u2192                     \"input\": parsed_input,\n201\u2192                 }\n202\u2192             )\n203\u2192 \n204\u2192     return tool_calls\n205\u2192 \n206\u2192 \n207\u2192 async def _execute_tool_call(tool_registry: ToolRegistry, tool_call: dict[str, Any]) -> tuple[str, bool]:\n208\u2192     tool = tool_registry.get(tool_call[\"name\"])\n209\u2192     if tool is None:\n210\u2192         return f\"Tool not found: {tool_call['name']}\", True\n211\u2192 \n212\u2192     try:\n213\u2192         result = await asyncio.wait_for(tool.execute(**tool_call[\"input\"]), timeout=300)\n214\u2192     except asyncio.TimeoutError:\n215\u2192         return f\"Tool {tool_call['name']} timed out after 300 seconds\", True\n216\u2192     except Exception as exc:\n217\u2192         return f\"Tool {tool_call['name']} failed: {exc}\", True\n218\u2192 \n219\u2192     return str(result), False\n220\u2192 \n221\u2192 \n222\u2192 async def run_prompt_jsonl(\n223\u2192     prompt: str,\n224\u2192     *,\n225\u2192     config: Config,\n226\u2192     working_dir: str,\n227\u2192     stdout: TextIO | None = None,\n228\u2192     tool_registry: ToolRegistry | None = None,\n229\u2192     chat_client: ChatClient | None = None,\n230\u2192     resume_session_id: str | None = None,\n231\u2192     session_dir: Path | None = None,\n232\u2192 ) -> int:\n233\u2192     \"\"\"Execute one agent prompt and emit JSONL events.\"\"\"\n234\u2192     stdout = stdout or sys.stdout\n235\u2192     session_manager = SessionManager(session_dir=session_dir)\n236\u2192     session: Session | None = None\n237\u2192     if resume_session_id is not None:\n238\u2192         session = await session_manager.load(resume_session_id)\n239\u2192         working_dir = session.working_directory\n240\u2192 \n241\u2192     history = ChatHistory(messages=list(session.messages) if session else None)\n242\u2192     registry = tool_registry or build_default_tool_registry(config, working_dir)\n243\u2192     client = chat_client or ChatClient(config=config)\n244\u2192     state = RunSessionState(\n245\u2192         session_id=resume_session_id or uuid.uuid4().hex,\n246\u2192         created_at=session.created_at if session else datetime.now(),\n247\u2192         history=history,\n248\u2192         working_dir=working_dir,\n249\u2192         agent_type=session.agent_type if session else DEFAULT_AGENT_TYPE,\n250\u2192         config=config,\n251\u2192         session_manager=session_manager,\n252\u2192         tool_registry=registry,\n253\u2192     )\n254\u2192 \n255\u2192     if prompt:\n256\u2192         history.add(ChatMessage(role=\"user\", content=_build_prompt(prompt)))\n257\u2192 \n258\u2192     loop = asyncio.get_running_loop()\n259\u2192     interrupted_by: dict[str, str | None] = {\"signal\": None}\n260\u2192     current_task = asyncio.current_task()\n261\u2192 \n262\u2192     async def _handle_interrupt(signame: str) -> None:\n263\u2192         interrupted_by[\"signal\"] = signame\n264\u2192         await state.save()\n265\u2192         if current_task is not None:\n266\u2192             current_task.cancel()\n267\u2192 \n268\u2192     for signum in (signal.SIGTERM, signal.SIGINT):\n269\u2192         try:\n270\u2192             loop.add_signal_handler(\n271\u2192                 signum,\n272\u2192                 lambda current_signum=signum: asyncio.create_task(\n273\u2192                     _handle_interrupt(signal.Signals(current_signum).name)\n274\u2192                 ),\n275\u2192             )\n276\u2192         except (NotImplementedError, RuntimeError):\n277\u2192             continue\n278\u2192 \n279\u2192     try:\n280\u2192         for _ in range(MAX_ITERATIONS):\n281\u2192             chunks: list[Chunk] = []\n282\u2192             assistant_chunks: list[str] = []\n283\u2192 \n284\u2192             stream = client.chat_completion(\n285\u2192                 messages=history.to_api_format(),\n286\u2192                 tools=registry.to_openai_schema(),\n287\u2192                 tool_choice=\"auto\",\n288\u2192             )\n289\u2192 \n290\u2192             async for chunk in stream:\n291\u2192                 chunks.append(chunk)\n292\u2192                 if isinstance(chunk, ContentBlockDelta) and chunk.type == \"text_delta\" and chunk.text:\n293\u2192                     assistant_chunks.append(chunk.text)\n294\u2192                     emit_text_event(chunk.text, stdout)\n295\u2192 \n296\u2192             tool_calls = _parse_tool_calls(chunks)\n297\u2192             if not tool_calls:\n298\u2192                 history.add(ChatMessage(role=\"assistant\", content=\"\".join(assistant_chunks)))\n299\u2192                 emit_step_finish_event(stdout, state.session_id)\n300\u2192                 return 0\n301\u2192 \n302\u2192             history.add(\n303\u2192                 ChatMessage(\n304\u2192                     role=\"assistant\",\n305\u2192                     content=\"\".join(assistant_chunks),\n306\u2192                     tool_calls=[\n307\u2192                         ToolCall(\n308\u2192                             id=tool_call[\"id\"],\n309\u2192                             name=tool_call[\"name\"],\n310\u2192                             input=tool_call[\"input\"],\n311\u2192                         )\n312\u2192                         for tool_call in tool_calls\n313\u2192                     ],\n314\u2192                 )\n315\u2192             )\n316\u2192 \n317\u2192             for tool_call in tool_calls:\n318\u2192                 result, is_error = await _execute_tool_call(registry, tool_call)\n319\u2192                 emit_tool_use_event(tool_call, result, stdout, is_error=is_error)\n320\u2192                 history.add(\n321\u2192                     ChatMessage(\n322\u2192                         role=\"tool\",\n323\u2192                         content=result,\n324\u2192                         tool_result_id=tool_call[\"id\"],\n325\u2192                     )\n326\u2192                 )\n327\u2192     except asyncio.CancelledError:\n328\u2192         emit_error_event(\"Interrupted\", f\"Run interrupted by {interrupted_by['signal'] or 'signal'}\", stdout)\n329\u2192         return 1\n330\u2192     finally:\n331\u2192         for signum in (signal.SIGTERM, signal.SIGINT):\n332\u2192             try:\n333\u2192                 loop.remove_signal_handler(signum)\n334\u2192             except (NotImplementedError, RuntimeError):\n335\u2192                 continue\n336\u2192         await state.save()\n337\u2192 \n338\u2192     emit_error_event(\"MaxIterationsExceeded\", f\"Exceeded {MAX_ITERATIONS} agent iterations\", stdout)\n339\u2192     return 1\n340\u2192 \n341\u2192 \n342\u2192 async def cmd_run(args: list[str]) -> None:\n343\u2192     \"\"\"Handle the `goz run` command.\"\"\"\n344\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n345\u2192         print(\"\"\"Run command usage:\n346\u2192 \n347\u2192   goz run [options] <prompt>\n348\u2192 \n349\u2192 Options:\n350\u2192   --format, -f json   Output ExternalCLIAdapter-compatible JSONL (default: json)\n351\u2192   --dir DIR           Working directory for file and shell tools\n352\u2192   --model MODEL       Override chat model for this invocation\n353\u2192   --resume-session ID Resume a previously saved engine session\n354\u2192 \n355\u2192 Examples:\n356\u2192   goz run --format json \"Summarize this repo and report STAGE_RESULT.\"\n357\u2192   goz run --dir /tmp/project --model glm-5 \"Run pytest and explain failures.\"\n358\u2192   goz run --resume-session abc123 \"Continue with the next step.\"\n359\u2192 \"\"\")\n360\u2192         return\n361\u2192 \n362\u2192     parser = argparse.ArgumentParser(prog=\"goz run\", add_help=False)\n363\u2192     parser.add_argument(\"--format\", \"-f\", choices=[\"json\"], default=\"json\", help=\"Output format\")\n364\u2192     parser.add_argument(\"--dir\", dest=\"working_dir\", help=\"Working directory for the run\")\n365\u2192     parser.add_argument(\"--model\", help=\"Override chat model\")\n366\u2192     parser.add_argument(\"--resume-session\", dest=\"resume_session_id\", help=\"Resume a saved session by ID\")\n367\u2192     parser.add_argument(\"prompt\", nargs=\"*\", help=\"Prompt to execute\")\n368\u2192     parsed = parser.parse_args(args)\n369\u2192 \n370\u2192     if not parsed.prompt and not parsed.resume_session_id:\n371\u2192         raise SystemExit(\"goz run requires a prompt unless --resume-session is provided\")\n372\u2192 \n373\u2192     try:\n374\u2192         config = load_config()\n375\u2192         if parsed.model:\n376\u2192             config = config.model_copy(update={\"chat_model\": parsed.model})\n377\u2192 \n378\u2192         working_dir = str(Path(parsed.working_dir or \".\").resolve())\n379\u2192         if parsed.working_dir and not Path(working_dir).exists():\n380\u2192             raise FileNotFoundError(f\"Working directory does not exist: {working_dir}\")\n381\u2192         if parsed.working_dir and not Path(working_dir).is_dir():\n382\u2192             raise NotADirectoryError(f\"Working directory is not a directory: {working_dir}\")\n383\u2192 \n384\u2192         exit_code = await run_prompt_jsonl(\n385\u2192             \" \".join(parsed.prompt),\n386\u2192             config=config,\n387\u2192             working_dir=working_dir,\n388\u2192             resume_session_id=parsed.resume_session_id,\n389\u2192         )\n390\u2192     except Exception as exc:\n391\u2192         emit_error_event(type(exc).__name__, str(exc), sys.stdout)\n392\u2192         sys.exit(1)\n393\u2192 \n394\u2192     if exit_code != 0:\n395\u2192         sys.exit(exit_code)", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_27b4f75be6dd4d8fa13b8751", "name": "view_file", "input": {"file_path": "goz/__main__.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/__main__.py (1008 lines)\n============================================================\n\n   1\u2192 \"\"\"Main entry point for the goz CLI.\"\"\"\n   2\u2192 \n   3\u2192 import asyncio\n   4\u2192 import json\n   5\u2192 import itertools\n   6\u2192 import sys\n   7\u2192 import threading\n   8\u2192 import time\n   9\u2192 from pathlib import Path\n  10\u2192 \n  11\u2192 from goz import __version__\n  12\u2192 \n  13\u2192 \n  14\u2192 def _show_thinking_animation(stop_event: threading.Event) -> None:\n  15\u2192     \"\"\"Show a \"thinking\" animation in a separate thread.\n  16\u2192 \n  17\u2192     Args:\n  18\u2192         stop_event: Threading event to stop the animation\n  19\u2192     \"\"\"\n  20\u2192     animation = [\"|\", \"/\", \"-\", \"\\\\\"]\n  21\u2192     try:\n  22\u2192         for frame in itertools.cycle(animation):\n  23\u2192             if stop_event.is_set():\n  24\u2192                 break\n  25\u2192             # Print the animation frame with carriage return to overwrite\n  26\u2192             print(f\"\\r{frame} Thinking...\", end=\"\", flush=True)\n  27\u2192             time.sleep(0.1)\n  28\u2192     finally:\n  29\u2192         # Clear the animation line when done\n  30\u2192         print(\"\\r\" + \" \" * 20 + \"\\r\", end=\"\", flush=True)\n  31\u2192 \n  32\u2192 \n  33\u2192 def _print_json(data: object) -> None:\n  34\u2192     \"\"\"Print JSON with stable formatting.\"\"\"\n  35\u2192     print(json.dumps(data, indent=2, ensure_ascii=True))\n  36\u2192 \n  37\u2192 \n  38\u2192 def _load_json_value(raw_value: str) -> object:\n  39\u2192     \"\"\"Load JSON from an inline value or @file reference.\"\"\"\n  40\u2192     source = raw_value\n  41\u2192     if raw_value.startswith(\"@\"):\n  42\u2192         source = Path(raw_value[1:]).read_text()\n  43\u2192 \n  44\u2192     try:\n  45\u2192         return json.loads(source)\n  46\u2192     except json.JSONDecodeError as e:\n  47\u2192         raise ValueError(f\"Invalid JSON: {e}\") from e\n  48\u2192 \n  49\u2192 \n  50\u2192 def _load_call_arguments(json_arg: str | None, use_stdin: bool) -> dict:\n  51\u2192     \"\"\"Resolve call arguments from --json or --stdin.\"\"\"\n  52\u2192     if json_arg is not None and use_stdin:\n  53\u2192         raise ValueError(\"Use either --json or --stdin, not both\")\n  54\u2192 \n  55\u2192     if json_arg is None and not use_stdin:\n  56\u2192         return {}\n  57\u2192 \n  58\u2192     payload = _load_json_value(sys.stdin.read() if use_stdin else json_arg or \"{}\")\n  59\u2192     if not isinstance(payload, dict):\n  60\u2192         raise ValueError(\"Tool arguments must be a JSON object\")\n  61\u2192     return payload\n  62\u2192 \n  63\u2192 \n  64\u2192 async def cmd_vision(args: list[str]) -> None:\n  65\u2192     \"\"\"Handle the `goz vision` command.\n  66\u2192 \n  67\u2192     Usage:\n  68\u2192         goz vision <image> [prompt]           - Analyze image (default)\n  69\u2192         goz vision analyze <image> [prompt]   - General analysis\n  70\u2192         goz vision ui-to-code <image>         - Convert UI to code\n  71\u2192         goz vision extract-text <image>       - OCR text extraction\n  72\u2192         goz vision diagnose-error <image>     - Diagnose error screenshot\n  73\u2192         goz vision diagram <image>            - Explain diagram\n  74\u2192         goz vision chart <image>              - Analyze chart\n  75\u2192         goz vision diff <expected> <actual>   - Compare images\n  76\u2192         goz vision video <video> [prompt]     - Analyze video\n  77\u2192 \n  78\u2192     Options:\n  79\u2192         --no-stream     - Disable streaming (wait for full response)\n  80\u2192         --output <type> - 