vent[\"type\"] for event in events] == [\"tool_use\", \"text\", \"text\", \"step_finish\"]\n 89\u2192         assert events[0][\"part\"][\"name\"] == \"bash\"\n 90\u2192         assert events[0][\"part\"][\"input\"] == {\"command\": \"pwd\"}\n 91\u2192         assert events[-1][\"part\"] == {\n 92\u2192             \"tokens\": {\"input\": 0, \"output\": 0, \"cache_creation\": 0, \"cache_read\": 0},\n 93\u2192             \"cost\": 0,\n 94\u2192             \"session_id\": events[-1][\"part\"][\"session_id\"],\n 95\u2192             \"continuation\": {\"resume_session_id\": events[-1][\"part\"][\"session_id\"]},\n 96\u2192         }\n 97\u2192         combined_text = \"\".join(event[\"part\"][\"text\"] for event in events if event[\"type\"] == \"text\")\n 98\u2192         assert \"STAGE_RESULT:\" in combined_text\n 99\u2192         assert '\"verdict\":\"pass\"' in combined_text\n100\u2192         assert \"STAGE_RESULT:\" in chat_client.calls[0][\"messages\"][0][\"content\"]\n101\u2192         assert chat_client.calls[0][\"tools\"]\n102\u2192 \n103\u2192     @pytest.mark.asyncio\n104\u2192     async def test_saves_session_state_to_disk(self, config, tmp_path):\n105\u2192         stream = [\n106\u2192             MessageStart(id=\"msg_1\", model=\"test-model\"),\n107\u2192             ContentBlockStart(type=\"text\", index=0),\n108\u2192             ContentBlockDelta(\n109\u2192                 type=\"text_delta\",\n110\u2192                 index=0,\n111\u2192                 text='STAGE_RESULT:\\n{\"verdict\":\"pass\",\"summary\":\"ok\",\"files_changed\":[],\"tests\":{\"added\":0,\"passing\":1},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\\n',\n112\u2192             ),\n113\u2192             ContentBlockStop(index=0),\n114\u2192             MessageStop(stop_reason=\"end_turn\"),\n115\u2192         ]\n116\u2192         stdout = io.StringIO()\n117\u2192         chat_client = FakeChatClient([stream], config=config)\n118\u2192 \n119\u2192         await run_prompt_jsonl(\n120\u2192             \"Persist this run\",\n121\u2192             config=config,\n122\u2192             working_dir=str(tmp_path),\n123\u2192             stdout=stdout,\n124\u2192             chat_client=chat_client,\n125\u2192             session_dir=tmp_path / \"sessions\",\n126\u2192         )\n127\u2192 \n128\u2192         events = [json.loads(line) for line in stdout.getvalue().splitlines()]\n129\u2192         session_id = events[-1][\"part\"][\"session_id\"]\n130\u2192         session_path = tmp_path / \"sessions\" / f\"{session_id}.json\"\n131\u2192 \n132\u2192         assert session_path.exists()\n133\u2192         data = json.loads(session_path.read_text())\n134\u2192         assert data[\"id\"] == session_id\n135\u2192         assert data[\"working_directory\"] == str(tmp_path)\n136\u2192         assert data[\"agent_type\"] == \"engine\"\n137\u2192         assert data[\"messages\"][0][\"role\"] == \"user\"\n138\u2192         assert data[\"messages\"][1][\"role\"] == \"assistant\"\n139\u2192         assert data[\"tool_state\"][\"working_directory\"] == str(tmp_path)\n140\u2192         assert data[\"tool_state\"][\"tools\"][\"bash\"][\"working_dir\"] == str(tmp_path)\n141\u2192 \n142\u2192     @pytest.mark.asyncio\n143\u2192     async def test_resume_session_reuses_saved_history(self, config, tmp_path):\n144\u2192         first_stream = [\n145\u2192             MessageStart(id=\"msg_1\", model=\"test-model\"),\n146\u2192             ContentBlockStart(type=\"text\", index=0),\n147\u2192             ContentBlockDelta(\n148\u2192                 type=\"text_delta\",\n149\u2192                 index=0,\n150\u2192                 text='STAGE_RESULT:\\n{\"verdict\":\"pass\",\"summary\":\"first\",\"files_changed\":[],\"tests\":{\"added\":0,\"passing\":1},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\\n',\n151\u2192             ),\n152\u2192             ContentBlockStop(index=0),\n153\u2192             MessageStop(stop_reason=\"end_turn\"),\n154\u2192         ]\n155\u2192         second_stream = [\n156\u2192             MessageStart(id=\"msg_2\", model=\"test-model\"),\n157\u2192             ContentBlockStart(type=\"text\", index=0),\n158\u2192             ContentBlockDelta(\n159\u2192                 type=\"text_delta\",\n160\u2192                 index=0,\n161\u2192                 text='STAGE_RESULT:\\n{\"verdict\":\"pass\",\"summary\":\"second\",\"files_changed\":[],\"tests\":{\"added\":0,\"passing\":2},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\\n',\n162\u2192             ),\n163\u2192             ContentBlockStop(index=0),\n164\u2192             MessageStop(stop_reason=\"end_turn\"),\n165\u2192         ]\n166\u2192         first_stdout = io.StringIO()\n167\u2192         second_stdout = io.StringIO()\n168\u2192         session_dir = tmp_path / \"sessions\"\n169\u2192 \n170\u2192         first_client = FakeChatClient([first_stream], config=config)\n171\u2192         await run_prompt_jsonl(\n172\u2192             \"First turn\",\n173\u2192             config=config,\n174\u2192             working_dir=str(tmp_path),\n175\u2192             stdout=first_stdout,\n176\u2192             chat_client=first_client,\n177\u2192             session_dir=session_dir,\n178\u2192         )\n179\u2192         first_events = [json.loads(line) for line in first_stdout.getvalue().splitlines()]\n180\u2192         session_id = first_events[-1][\"part\"][\"session_id\"]\n181\u2192 \n182\u2192         second_client = FakeChatClient([second_stream], config=config)\n183\u2192         await run_prompt_jsonl(\n184\u2192             \"Second turn\",\n185\u2192             config=config,\n186\u2192             working_dir=\"/unused\",\n187\u2192             stdout=second_stdout,\n188\u2192             chat_client=second_client,\n189\u2192             resume_session_id=session_id,\n190\u2192             session_dir=session_dir,\n191\u2192         )\n192\u2192 \n193\u2192         second_call_messages = second_client.calls[0][\"messages\"]\n194\u2192         assert second_call_messages[0][\"content\"].startswith(\"First turn\")\n195\u2192         assert \"second\" not in second_call_messages[0][\"content\"].lower()\n196\u2192         assert second_call_messages[1][\"role\"] == \"assistant\"\n197\u2192         assert second_call_messages[2][\"content\"].startswith(\"Second turn\")\n198\u2192 \n199\u2192     @pytest.mark.asyncio\n200\u2192     async def test_saves_session_on_interrupt(self, config, tmp_path, monkeypatch):\n201\u2192         wait_for_interrupt = asyncio.Event()\n202\u2192         registered_handlers: dict[int, object] = {}\n203\u2192 \n204\u2192         class HangingChatClient:\n205\u2192             def __init__(self, *, config):\n206\u2192                 self.config = config\n207\u2192 \n208\u2192             def chat_completion(self, **kwargs):\n209\u2192                 async def iterator():\n210\u2192                     await wait_for_interrupt.wait()\n211\u2192                     yield ContentBlockDelta(type=\"text_delta\", index=0, text=\"unreachable\")\n212\u2192 \n213\u2192                 return iterator()\n214\u2192 \n215\u2192         loop = asyncio.get_running_loop()\n216\u2192 \n217\u2192         def fake_add_signal_handler(signum, callback):\n218\u2192             registered_handlers[signum] = callback\n219\u2192 \n220\u2192         def fake_remove_signal_handler(signum):\n221\u2192             registered_handlers.pop(signum, None)\n222\u2192 \n223\u2192         monkeypatch.setattr(loop, \"add_signal_handler\", fake_add_signal_handler)\n224\u2192         monkeypatch.setattr(loop, \"remove_signal_handler\", fake_remove_signal_handler)\n225\u2192 \n226\u2192         task = asyncio.create_task(\n227\u2192             run_prompt_jsonl(\n228\u2192                 \"Interrupt me\",\n229\u2192                 config=config,\n230\u2192                 working_dir=str(tmp_path),\n231\u2192                 stdout=io.StringIO(),\n232\u2192                 chat_client=HangingChatClient(config=config),\n233\u2192                 session_dir=tmp_path / \"sessions\",\n234\u2192             )\n235\u2192         )\n236\u2192 \n237\u2192         await asyncio.sleep(0)\n238\u2192         registered_handlers[signal.SIGTERM]()\n239\u2192         wait_for_interrupt.set()\n240\u2192         exit_code = await task\n241\u2192 \n242\u2192         session_files = list((tmp_path / \"sessions\").glob(\"*.json\"))\n243\u2192         assert exit_code == 1\n244\u2192         assert len(session_files) == 1\n245\u2192         data = json.loads(session_files[0].read_text())\n246\u2192         assert data[\"messages\"][0][\"content\"].startswith(\"Interrupt me\")\n247\u2192 \n248\u2192     @pytest.mark.asyncio\n249\u2192     async def test_raises_when_chat_fails(self, config, tmp_path):\n250\u2192         class FailingChatClient:\n251\u2192             def chat_completion(self, **kwargs):\n252\u2192                 async def iterator():\n253\u2192                     raise RuntimeError(\"boom\")\n254\u2192                     yield\n255\u2192 \n256\u2192                 return iterator()\n257\u2192 \n258\u2192         stdout = io.StringIO()\n259\u2192         with pytest.raises(RuntimeError):\n260\u2192             await run_prompt_jsonl(\n261\u2192                 \"fail\",\n262\u2192                 config=config,\n263\u2192                 working_dir=str(tmp_path),\n264\u2192                 stdout=stdout,\n265\u2192                 chat_client=FailingChatClient(),\n266\u2192             )\n267\u2192 \n268\u2192     def test_build_default_tool_registry_uses_working_directory(self, config, tmp_path):\n269\u2192         registry = build_default_tool_registry(config, str(tmp_path))\n270\u2192 \n271\u2192         assert registry.get(\"bash\").working_dir == str(tmp_path)\n272\u2192         assert registry.get(\"view_file\").working_dir == str(tmp_path)\n273\u2192         assert registry.get(\"create_file\").working_dir == str(tmp_path)\n274\u2192         assert registry.get(\"str_replace_editor\").working_dir == str(tmp_path)\n275\u2192 \n276\u2192 \n277\u2192 class TestRunCli:\n278\u2192     def test_goz_run_cli_supports_model_override_and_json_output(self, config, capsys):\n279\u2192         observed = {}\n280\u2192 \n281\u2192         async def fake_run(\n282\u2192             prompt,\n283\u2192             *,\n284\u2192             config,\n285\u2192             working_dir,\n286\u2192             stdout=None,\n287\u2192             tool_registry=None,\n288\u2192             chat_client=None,\n289\u2192             resume_session_id=None,\n290\u2192             session_dir=None,\n291\u2192         ):\n292\u2192             observed[\"prompt\"] = prompt\n293\u2192             observed[\"model\"] = config.chat_model\n294\u2192             observed[\"working_dir\"] = working_dir\n295\u2192             observed[\"resume_session_id\"] = resume_session_id\n296\u2192             print(json.dumps({\"type\": \"text\", \"part\": {\"text\": \"ok\"}}))\n297\u2192             print(json.dumps({\"type\": \"step_finish\", \"part\": {\"tokens\": {\"input\": 0, \"output\": 0, \"cache_creation\": 0, \"cache_read\": 0}, \"cost\": 0, \"session_id\": \"session-1\", \"continuation\": {\"resume_session_id\": \"session-1\"}}}))\n298\u2192             return 0\n299\u2192 \n300\u2192         with patch(\"goz.cli.run.load_config\", return_value=config), patch(\"goz.cli.run.run_prompt_jsonl\", side_effect=fake_run):\n301\u2192             from goz.__main__ import main\n302\u2192 \n303\u2192             sys.argv = [\"goz\", \"run\", \"--format\", \"json\", \"--dir\", \".\", \"--model\", \"override-model\", \"hello\", \"world\"]\n304\u2192             main()\n305\u2192 \n306\u2192         captured = capsys.readouterr()\n307\u2192         events = [json.loads(line) for line in captured.out.splitlines()]\n308\u2192         assert events[0][\"type\"] == \"text\"\n309\u2192         assert events[1][\"type\"] == \"step_finish\"\n310\u2192         assert observed == {\n311\u2192             \"prompt\": \"hello world\",\n312\u2192             \"model\": \"override-model\",\n313\u2192             \"working_dir\": str(Path(\".\").resolve()),\n314\u2192             \"resume_session_id\": None,\n315\u2192         }\n316\u2192 \n317\u2192     def test_goz_run_cli_supports_resume_session_without_prompt(self, config, capsys):\n318\u2192         observed = {}\n319\u2192 \n320\u2192         async def fake_run(\n321\u2192             prompt,\n322\u2192             *,\n323\u2192             config,\n324\u2192             working_dir,\n325\u2192             stdout=None,\n326\u2192             tool_registry=None,\n327\u2192             chat_client=None,\n328\u2192             resume_session_id=None,\n329\u2192             session_dir=None,\n330\u2192         ):\n331\u2192             observed[\"prompt\"] = prompt\n332\u2192             observed[\"resume_session_id\"] = resume_session_id\n333\u2192             print(json.dumps({\"type\": \"step_finish\", \"part\": {\"tokens\": {\"input\": 0, \"output\": 0, \"cache_creation\": 0, \"cache_read\": 0}, \"cost\": 0, \"session_id\": resume_session_id, \"continuation\": {\"resume_session_id\": resume_session_id}}}))\n334\u2192             return 0\n335\u2192 \n336\u2192         with patch(\"goz.cli.run.load_config\", return_value=config), patch(\"goz.cli.run.run_prompt_jsonl\", side_effect=fake_run):\n337\u2192             from goz.__main__ import main\n338\u2192 \n339\u2192             sys.argv = [\"goz\", \"run\", \"--format\", \"json\", \"--resume-session\", \"resume-123\"]\n340\u2192             main()\n341\u2192 \n342\u2192         captured = capsys.readouterr()\n343\u2192         events = [json.loads(line) for line in captured.out.splitlines()]\n344\u2192         assert events[0][\"part\"][\"session_id\"] == \"resume-123\"\n345\u2192         assert observed == {\n346\u2192             \"prompt\": \"\",\n347\u2192             \"resume_session_id\": \"resume-123\",\n348\u2192         }\n349\u2192 \n350\u2192     def test_goz_run_cli_emits_error_and_nonzero_exit(self, config, capsys):\n351\u2192         with patch(\"goz.cli.run.load_config\", return_value=config), patch(\n352\u2192             \"goz.cli.run.run_prompt_jsonl\",\n353\u2192             side_effect=RuntimeError(\"bad run\"),\n354\u2192         ):\n355\u2192             from goz.__main__ import main\n356\u2192 \n357\u2192             sys.argv = [\"goz\", \"run\", \"--format\", \"json\", \"hello\"]\n358\u2192             with pytest.raises(SystemExit) as excinfo:\n359\u2192                 main()\n360\u2192 \n361\u2192         captured = capsys.readouterr()\n362\u2192         event = json.loads(captured.out.strip())\n363\u2192         assert excinfo.value.code == 1\n364\u2192         assert event == {\n365\u2192             \"type\": \"error\",\n366\u2192             \"error\": {\n367\u2192                 \"name\": \"RuntimeError\",\n368\u2192                 \"data\": {\"message\": \"bad run\"},\n369\u2192             },\n370\u2192         }", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_4afd47d0fca44f319d7ce569", "name": "view_file", "input": {"file_path": "tests/test_chat_client.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/tests/test_chat_client.py (752 lines)\n============================================================\n\n  1\u2192 \"\"\"Tests for ChatClient (Issue 17).\n  2\u2192 \n  3\u2192 TDD approach:\n  4\u2192 1. Write tests FIRST\n  5\u2192 2. Verify tests FAIL\n  6\u2192 3. Implement code\n  7\u2192 4. Verify tests PASS\n  8\u2192 \"\"\"\n  9\u2192 import asyncio\n 10\u2192 from datetime import datetime\n 11\u2192 from typing import Literal\n 12\u2192 from dataclasses import dataclass, field\n 13\u2192 from unittest.mock import AsyncMock, MagicMock, patch\n 14\u2192 \n 15\u2192 import pytest\n 16\u2192 from anthropic import AsyncAnthropic\n 17\u2192 \n 18\u2192 from goz.config import Config\n 19\u2192 from goz.api.errors import AuthError, ApiError, NetworkError, TimeoutError\n 20\u2192 \n 21\u2192 \n 22\u2192 # Import the actual classes from chat_client for testing\n 23\u2192 from goz.agent.chat_client import (\n 24\u2192     ChatClient,\n 25\u2192     ContentBlockStart,\n 26\u2192     ContentBlockDelta,\n 27\u2192     ContentBlockStop,\n 28\u2192     MessageStart,\n 29\u2192     MessageStop,\n 30\u2192     Chunk,\n 31\u2192 )\n 32\u2192 \n 33\u2192 \n 34\u2192 class TestChatClientTDD:\n 35\u2192     \"\"\"TDD tests for ChatClient.\n 36\u2192 \n 37\u2192     Test sequence:\n 38\u2192     1. Class initialization\n 39\u2192     2. Simple chat completion (no tools, no stream)\n 40\u2192     3. Chat completion with streaming\n 41\u2192     4. Chat completion with tools\n 42\u2192     5. Tool call extraction from stream\n 43\u2192     6. Error handling\n 44\u2192     \"\"\"\n 45\u2192 \n 46\u2192     @pytest.fixture\n 47\u2192     def config(self) -> Config:\n 48\u2192         \"\"\"Create test config.\"\"\"\n 49\u2192         return Config(\n 50\u2192             zai_token=\"test-token\",\n 51\u2192             zai_base_url=\"https://api.test.com\",\n 52\u2192             chat_model=\"test-model\",\n 53\u2192             timeout=60,\n 54\u2192         )\n 55\u2192 \n 56\u2192     @pytest.fixture\n 57\u2192     def mock_anthropic(self):\n 58\u2192         \"\"\"Mock AsyncAnthropic client.\"\"\"\n 59\u2192         mock_client = MagicMock(spec=AsyncAnthropic)\n 60\u2192         return mock_client\n 61\u2192 \n 62\u2192     # TEST 1: ChatClient class exists and initializes correctly\n 63\u2192     def test_01_chat_client_class_exists(self, config):\n 64\u2192         \"\"\"Acceptance Criterion 1: ChatClient class exists.\"\"\"\n 65\u2192         # This test will fail until we create the class\n 66\u2192         from goz.agent.chat_client import ChatClient\n 67\u2192 \n 68\u2192         client = ChatClient(config)\n 69\u2192         assert client is not None\n 70\u2192         assert client.config is config\n 71\u2192 \n 72\u2192     # TEST 2: ChatClient uses AsyncAnthropic from SDK\n 73\u2192     def test_02_uses_anthropic_sdk(self, config):\n 74\u2192         \"\"\"Acceptance Criterion 2: Uses existing Anthropic SDK.\"\"\"\n 75\u2192         from goz.agent.chat_client import ChatClient\n 76\u2192 \n 77\u2192         client = ChatClient(config)\n 78\u2192 \n 79\u2192         # Verify the client has an _client attribute that's an AsyncAnthropic\n 80\u2192         assert hasattr(client, '_client')\n 81\u2192         assert isinstance(client._client, AsyncAnthropic)\n 82\u2192 \n 83\u2192         # Verify it's configured with the right params\n 84\u2192         assert client._client.api_key == config.zai_token\n 85\u2192         assert client._client.base_url == config.zai_base_url\n 86\u2192 \n 87\u2192     # TEST 3: chat_completion method exists and returns async iterator\n 88\u2192     @pytest.mark.asyncio\n 89\u2192     async def test_03_chat_completion_returns_iterator(self, config):\n 90\u2192         \"\"\"Acceptance Criteria 3, 4: Uses config, returns async iterator.\"\"\"\n 91\u2192         from goz.agent.chat_client import ChatClient\n 92\u2192 \n 93\u2192         client = ChatClient(config)\n 94\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n 95\u2192 \n 96\u2192         # Mock the API response\n 97\u2192         with patch.object(client._client, 'messages') as mock_messages:\n 98\u2192             mock_stream = AsyncMock()\n 99\u2192             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n100\u2192             mock_stream.__aenter__ = AsyncMock(return_value=mock_stream)\n101\u2192             mock_stream.__aexit__ = AsyncMock()\n102\u2192 \n103\u2192             mock_messages.stream.return_value = mock_stream\n104\u2192 \n105\u2192             # Call chat_completion\n106\u2192             result = client.chat_completion(messages)\n107\u2192 \n108\u2192             # Verify it's an async iterator\n109\u2192             assert hasattr(result, '__aiter__')\n110\u2192             assert hasattr(result, '__anext__')\n111\u2192 \n112\u2192     # TEST 4: Simple text streaming works\n113\u2192     @pytest.mark.asyncio\n114\u2192     async def test_04_simple_text_streaming(self, config):\n115\u2192         \"\"\"Acceptance Criterion 8: Response chunks yield text deltas.\"\"\"\n116\u2192         from goz.agent.chat_client import ChatClient\n117\u2192 \n118\u2192         client = ChatClient(config)\n119\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n120\u2192 \n121\u2192         # Create events that will be converted to chunks\n122\u2192         events = []\n123\u2192 \n124\u2192         # Text delta events\n125\u2192         for text in [\"Hello\", \" there\", \"!\"]:\n126\u2192             event = MagicMock()\n127\u2192             event.type = \"content_block_delta\"\n128\u2192             event.index = 0\n129\u2192             delta = MagicMock()\n130\u2192             delta.type = \"text_delta\"\n131\u2192             delta.text = text\n132\u2192             event.delta = delta\n133\u2192             events.append(event)\n134\u2192 \n135\u2192         # Message stop\n136\u2192         stop = MagicMock()\n137\u2192         stop.type = \"message_stop\"\n138\u2192         msg = MagicMock()\n139\u2192         msg.stop_reason = \"end_turn\"\n140\u2192         stop.message = msg\n141\u2192         events.append(stop)\n142\u2192 \n143\u2192         # Convert events using the client's conversion method\n144\u2192         chunks = []\n145\u2192         for event in events:\n146\u2192             chunk = client._convert_sse_event_to_chunk(event)\n147\u2192             if chunk is not None:\n148\u2192                 chunks.append(chunk)\n149\u2192 \n150\u2192         # Verify we got text chunks\n151\u2192         text_chunks = [c for c in chunks if isinstance(c, ContentBlockDelta) and c.text]\n152\u2192         assert len(text_chunks) == 3\n153\u2192         assert text_chunks[0].text == \"Hello\"\n154\u2192         assert text_chunks[1].text == \" there\"\n155\u2192         assert text_chunks[2].text == \"!\"\n156\u2192 \n157\u2192         # Also verify streaming works end-to-end with a simple mock\n158\u2192         with patch.object(client._client, 'messages') as mock_messages:\n159\u2192             async def empty_stream():\n160\u2192                 return\n161\u2192                 yield  # Make it an async generator\n162\u2192 \n163\u2192             mock_stream_context = MagicMock()\n164\u2192             mock_stream_context.__aenter__ = AsyncMock(return_value=empty_stream())\n165\u2192             mock_stream_context.__aexit__ = AsyncMock()\n166\u2192             mock_messages.stream.return_value = mock_stream_context\n167\u2192 \n168\u2192             # Should not raise\n169\u2192             chunks = []\n170\u2192             async for chunk in client.chat_completion(messages, stream=True):\n171\u2192                 chunks.append(chunk)\n172\u2192             # Empty stream returns no chunks\n173\u2192             assert len(chunks) == 0\n174\u2192 \n175\u2192     # TEST 5: Tools parameter is supported\n176\u2192     @pytest.mark.asyncio\n177\u2192     async def test_05_tools_parameter_supported(self, config):\n178\u2192         \"\"\"Acceptance Criterion 5: Supports tools parameter.\"\"\"\n179\u2192         from goz.agent.chat_client import ChatClient\n180\u2192 \n181\u2192         client = ChatClient(config)\n182\u2192         messages = [{\"role\": \"user\", \"content\": \"Read main.py\"}]\n183\u2192 \n184\u2192         tools = [\n185\u2192             {\n186\u2192                 \"name\": \"view_file\",\n187\u2192                 \"description\": \"View file contents\",\n188\u2192                 \"input_schema\": {\n189\u2192                     \"type\": \"object\",\n190\u2192                     \"properties\": {\n191\u2192                         \"file_path\": {\"type\": \"string\"}\n192\u2192                     },\n193\u2192                     \"required\": [\"file_path\"]\n194\u2192                 }\n195\u2192             }\n196\u2192         ]\n197\u2192 \n198\u2192         with patch.object(client._client, 'messages') as mock_messages:\n199\u2192             mock_stream = AsyncMock()\n200\u2192             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n201\u2192             mock_stream_context = MagicMock()\n202\u2192             mock_stream_context.__aenter__ = AsyncMock(return_value=mock_stream)\n203\u2192             mock_stream_context.__aexit__ = AsyncMock()\n204\u2192             mock_messages.stream.return_value = mock_stream_context\n205\u2192 \n206\u2192             # Call with tools\n207\u2192             async for _ in client.chat_completion(messages, tools=tools):\n208\u2192                 pass\n209\u2192 \n210\u2192             # Verify tools were passed to the API\n211\u2192             call_args = mock_messages.stream.call_args\n212\u2192             assert 'tools' in call_args.kwargs or len(call_args.args) > 1\n213\u2192 \n214\u2192     # TEST 6: tool_choice parameter is supported\n215\u2192     @pytest.mark.asyncio\n216\u2192     async def test_06_tool_choice_supported(self, config):\n217\u2192         \"\"\"Acceptance Criterion 6: Supports tool_choice parameter.\"\"\"\n218\u2192         from goz.agent.chat_client import ChatClient\n219\u2192 \n220\u2192         client = ChatClient(config)\n221\u2192         messages = [{\"role\": \"user\", \"content\": \"Read main.py\"}]\n222\u2192 \n223\u2192         with patch.object(client._client, 'messages') as mock_messages:\n224\u2192             mock_stream = AsyncMock()\n225\u2192             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n226\u2192             mock_stream_context = MagicMock()\n227\u2192             mock_stream_context.__aenter__ = AsyncMock(return_value=mock_stream)\n228\u2192             mock_stream_context.__aexit__ = AsyncMock()\n229\u2192             mock_messages.stream.return_value = mock_stream_context\n230\u2192 \n231\u2192             # Call with tool_choice\n232\u2192             async for _ in client.chat_completion(messages, tool_choice=\"any\"):\n233\u2192                 pass\n234\u2192 \n235\u2192             # Verify tool_choice was passed\n236\u2192             call_args = mock_messages.stream.call_args\n237\u2192             assert 'tool_choice' in call_args.kwargs or len(call_args.args) > 2\n238\u2192 \n239\u2192     # TEST 7: stream parameter is supported\n240\u2192     @pytest.mark.asyncio\n241\u2192     async def test_07_stream_parameter_supported(self, config):\n242\u2192         \"\"\"Acceptance Criterion 7: Supports stream parameter.\"\"\"\n243\u2192         from goz.agent.chat_client import ChatClient\n244\u2192 \n245\u2192         client = ChatClient(config)\n246\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n247\u2192 \n248\u2192         with patch.object(client._client, 'messages') as mock_messages:\n249\u2192             # Test with stream=True\n250\u2192             mock_stream = AsyncMock()\n251\u2192             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n252\u2192             mock_stream_context = MagicMock()\n253\u2192             mock_stream_context.__aenter__ = AsyncMock(return_value=mock_stream)\n254\u2192             mock_stream_context.__aexit__ = AsyncMock()\n255\u2192             mock_messages.stream.return_value = mock_stream_context\n256\u2192 \n257\u2192             async for _ in client.chat_completion(messages, stream=True):\n258\u2192                 pass\n259\u2192 \n260\u2192             # Test with stream=False (should use create instead of stream)\n261\u2192             mock_create_response = MagicMock()\n262\u2192             mock_create_response.id = \"msg_123\"\n263\u2192             mock_create_response.model = \"test-model\"\n264\u2192             mock_create_response.content = [MagicMock(text=\"Response\", type=\"text\")]\n265\u2192             mock_create_response.stop_reason = \"end_turn\"\n266\u2192             mock_messages.create = AsyncMock(return_value=mock_create_response)\n267\u2192 \n268\u2192             async for _ in client.chat_completion(messages, stream=False):\n269\u2192                 pass\n270\u2192 \n271\u2192     # TEST 8: Tool calls are properly formatted in stream\n272\u2192     @pytest.mark.asyncio\n273\u2192     async def test_08_tool_calls_formatted_correctly(self, config):\n274\u2192         \"\"\"Acceptance Criterion 9: Tool calls are properly formatted in stream.\"\"\"\n275\u2192         from goz.agent.chat_client import ChatClient\n276\u2192 \n277\u2192         client = ChatClient(config)\n278\u2192 \n279\u2192         # Create events for tool call\n280\u2192         events = []\n281\u2192 \n282\u2192         # Start tool_use block\n283\u2192         start = MagicMock()\n284\u2192         start.type = \"content_block_start\"\n285\u2192         start.index = 0\n286\u2192         cb =