{"type": "tool_use", "part": {"id": "call_6292fb67cd7945d0be2444d7", "name": "view_file", "input": {"file_path": "tests/test_usage_tracking.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/tests/test_usage_tracking.py (443 lines)\n============================================================\n\n  1\u2192 \"\"\"Tests for T-0008: Usage statistics and quota tracking.\n  2\u2192 \n  3\u2192 Acceptance criteria tested:\n  4\u2192 - chat_client.py extracts usage.input_tokens and usage.output_tokens from streaming events\n  5\u2192 - Per-turn token counts accumulated in session state via UsageAccumulator\n  6\u2192 - step_finish JSONL event includes tokens and cost\n  7\u2192 - goz usage command calls monitor endpoints\n  8\u2192 - Quota/rate limit errors are detected and reported clearly\n  9\u2192 \"\"\"\n 10\u2192 \n 11\u2192 from __future__ import annotations\n 12\u2192 \n 13\u2192 import io\n 14\u2192 import json\n 15\u2192 from unittest.mock import AsyncMock, MagicMock, patch\n 16\u2192 \n 17\u2192 import pytest\n 18\u2192 \n 19\u2192 from goz.agent.chat_client import (\n 20\u2192     ChatClient,\n 21\u2192     ContentBlockDelta,\n 22\u2192     ContentBlockStart,\n 23\u2192     ContentBlockStop,\n 24\u2192     MessageStart,\n 25\u2192     MessageStop,\n 26\u2192     UsageDelta,\n 27\u2192 )\n 28\u2192 from goz.agent.usage import UsageAccumulator, UsageSnapshot\n 29\u2192 from goz.api.errors import QuotaError, is_quota_error\n 30\u2192 from goz.cli.run import emit_step_finish_event, run_prompt_jsonl\n 31\u2192 from goz.config import Config\n 32\u2192 \n 33\u2192 \n 34\u2192 @pytest.fixture\n 35\u2192 def config() -> Config:\n 36\u2192     return Config(\n 37\u2192         zai_token=\"test-token\",\n 38\u2192         zai_base_url=\"https://api.test.com\",\n 39\u2192         chat_model=\"test-model\",\n 40\u2192         timeout=60,\n 41\u2192     )\n 42\u2192 \n 43\u2192 \n 44\u2192 class TestMessageStartUsageExtraction:\n 45\u2192     def test_message_start_carries_usage_fields(self):\n 46\u2192         ms = MessageStart(\n 47\u2192             id=\"msg_1\",\n 48\u2192             model=\"glm-5-turbo\",\n 49\u2192             usage_input_tokens=1500,\n 50\u2192             usage_cache_read=800,\n 51\u2192             usage_cache_creation=200,\n 52\u2192         )\n 53\u2192         assert ms.usage_input_tokens == 1500\n 54\u2192         assert ms.usage_cache_read == 800\n 55\u2192         assert ms.usage_cache_creation == 200\n 56\u2192 \n 57\u2192     def test_message_start_defaults_to_zero(self):\n 58\u2192         ms = MessageStart(id=\"msg_1\", model=\"test\")\n 59\u2192         assert ms.usage_input_tokens == 0\n 60\u2192         assert ms.usage_cache_read == 0\n 61\u2192         assert ms.usage_cache_creation == 0\n 62\u2192 \n 63\u2192     def test_convert_message_start_extracts_usage(self, config):\n 64\u2192         client = ChatClient(config)\n 65\u2192 \n 66\u2192         usage = MagicMock()\n 67\u2192         usage.input_tokens = 2000\n 68\u2192         usage.cache_read_input_tokens = 500\n 69\u2192         usage.cache_creation_input_tokens = 100\n 70\u2192 \n 71\u2192         msg = MagicMock()\n 72\u2192         msg.id = \"msg_abc\"\n 73\u2192         msg.model = \"glm-5-turbo\"\n 74\u2192         msg.usage = usage\n 75\u2192 \n 76\u2192         event = MagicMock()\n 77\u2192         event.type = \"message_start\"\n 78\u2192         event.message = msg\n 79\u2192 \n 80\u2192         chunk = client._convert_sse_event_to_chunk(event)\n 81\u2192         assert isinstance(chunk, MessageStart)\n 82\u2192         assert chunk.usage_input_tokens == 2000\n 83\u2192         assert chunk.usage_cache_read == 500\n 84\u2192         assert chunk.usage_cache_creation == 100\n 85\u2192 \n 86\u2192     def test_convert_message_start_handles_missing_usage(self, config):\n 87\u2192         client = ChatClient(config)\n 88\u2192 \n 89\u2192         msg = MagicMock()\n 90\u2192         msg.id = \"msg_abc\"\n 91\u2192         msg.model = \"glm-5-turbo\"\n 92\u2192         msg.usage = None\n 93\u2192 \n 94\u2192         event = MagicMock()\n 95\u2192         event.type = \"message_start\"\n 96\u2192         event.message = msg\n 97\u2192 \n 98\u2192         chunk = client._convert_sse_event_to_chunk(event)\n 99\u2192         assert isinstance(chunk, MessageStart)\n100\u2192         assert chunk.usage_input_tokens == 0\n101\u2192         assert chunk.usage_cache_read == 0\n102\u2192 \n103\u2192 \n104\u2192 class TestUsageDeltaChunk:\n105\u2192     def test_usage_delta_has_output_tokens(self):\n106\u2192         ud = UsageDelta(output_tokens=42)\n107\u2192         assert ud.output_tokens == 42\n108\u2192 \n109\u2192     def test_usage_delta_defaults_to_zero(self):\n110\u2192         ud = UsageDelta()\n111\u2192         assert ud.output_tokens == 0\n112\u2192 \n113\u2192     def test_convert_message_delta_extracts_output_tokens(self, config):\n114\u2192         client = ChatClient(config)\n115\u2192 \n116\u2192         event = MagicMock()\n117\u2192         event.type = \"message_delta\"\n118\u2192         event.usage = MagicMock()\n119\u2192         event.usage.output_tokens = 350\n120\u2192 \n121\u2192         chunk = client._convert_sse_event_to_chunk(event)\n122\u2192         assert isinstance(chunk, UsageDelta)\n123\u2192         assert chunk.output_tokens == 350\n124\u2192 \n125\u2192     def test_convert_message_delta_handles_missing_usage(self, config):\n126\u2192         client = ChatClient(config)\n127\u2192 \n128\u2192         event = MagicMock()\n129\u2192         event.type = \"message_delta\"\n130\u2192         event.usage = None\n131\u2192 \n132\u2192         chunk = client._convert_sse_event_to_chunk(event)\n133\u2192         assert isinstance(chunk, UsageDelta)\n134\u2192         assert chunk.output_tokens == 0\n135\u2192 \n136\u2192     def test_message_stop_carries_usage(self):\n137\u2192         ms = MessageStop(stop_reason=\"end_turn\", usage_output_tokens=500)\n138\u2192         assert ms.usage_output_tokens == 500\n139\u2192 \n140\u2192     def test_message_stop_defaults_to_zero(self):\n141\u2192         ms = MessageStop(stop_reason=\"end_turn\")\n142\u2192         assert ms.usage_output_tokens == 0\n143\u2192 \n144\u2192 \n145\u2192 class TestUsageAccumulator:\n146\u2192     def test_full_turn_accumulation(self):\n147\u2192         acc = UsageAccumulator()\n148\u2192         acc.begin_turn()\n149\u2192 \n150\u2192         class UsageStart:\n151\u2192             input_tokens = 1000\n152\u2192             cache_read_input_tokens = 200\n153\u2192             cache_creation_input_tokens = 50\n154\u2192 \n155\u2192         acc.apply_message_start(UsageStart())\n156\u2192 \n157\u2192         class UsageEnd:\n158\u2192             output_tokens = 500\n159\u2192 \n160\u2192         acc.apply_message_delta(UsageEnd())\n161\u2192 \n162\u2192         snap = acc.finalise_turn()\n163\u2192         assert snap.input_tokens == 1000\n164\u2192         assert snap.output_tokens == 500\n165\u2192         assert snap.cache_read_input_tokens == 200\n166\u2192         assert snap.cache_creation_input_tokens == 50\n167\u2192 \n168\u2192         assert acc.total_input_tokens == 1000\n169\u2192         assert acc.total_output_tokens == 500\n170\u2192         assert acc.turn_count == 1\n171\u2192 \n172\u2192     def test_multi_turn_accumulation(self):\n173\u2192         acc = UsageAccumulator()\n174\u2192 \n175\u2192         for i in range(3):\n176\u2192             acc.begin_turn()\n177\u2192 \n178\u2192             class UStart:\n179\u2192                 input_tokens = 100\n180\u2192                 cache_read_input_tokens = 0\n181\u2192                 cache_creation_input_tokens = 0\n182\u2192 \n183\u2192             acc.apply_message_start(UStart())\n184\u2192 \n185\u2192             class UDelta:\n186\u2192                 output_tokens = 50\n187\u2192 \n188\u2192             acc.apply_message_delta(UDelta())\n189\u2192             acc.finalise_turn()\n190\u2192 \n191\u2192         assert acc.turn_count == 3\n192\u2192         assert acc.total_input_tokens == 300\n193\u2192         assert acc.total_output_tokens == 150\n194\u2192 \n195\u2192     def test_snapshot_to_dict(self):\n196\u2192         snap = UsageSnapshot(\n197\u2192             input_tokens=100,\n198\u2192             output_tokens=50,\n199\u2192             cache_read_input_tokens=20,\n200\u2192             cache_creation_input_tokens=10,\n201\u2192         )\n202\u2192         d = snap.to_dict()\n203\u2192         assert d == {\"input\": 100, \"output\": 50, \"cache_read\": 20, \"cache_creation\": 10}\n204\u2192 \n205\u2192     def test_snapshot_cost_usd(self):\n206\u2192         snap = UsageSnapshot(input_tokens=1_000_000, output_tokens=1_000_000)\n207\u2192         cost = snap.cost_usd(model=\"claude-sonnet-4-20250514\")\n208\u2192         assert cost > 0\n209\u2192         assert abs(cost - 18.0) < 0.01\n210\u2192 \n211\u2192     def test_finalise_turn_empty(self):\n212\u2192         acc = UsageAccumulator()\n213\u2192         snap = acc.finalise_turn()\n214\u2192         assert snap.total_tokens() == 0\n215\u2192 \n216\u2192 \n217\u2192 class TestStepFinishWithUsage:\n218\u2192     def test_emit_step_finish_with_tokens_and_cost(self):\n219\u2192         stdout = io.StringIO()\n220\u2192         tokens = {\"input\": 1000, \"output\": 500, \"cache_creation\": 50, \"cache_read\": 200}\n221\u2192         emit_step_finish_event(stdout, \"session-1\", tokens=tokens, cost=0.015)\n222\u2192         event = json.loads(stdout.getvalue().strip())\n223\u2192         assert event[\"type\"] == \"step_finish\"\n224\u2192         assert event[\"part\"][\"tokens\"] == tokens\n225\u2192         assert event[\"part\"][\"cost\"] == 0.015\n226\u2192         assert event[\"part\"][\"session_id\"] == \"session-1\"\n227\u2192 \n228\u2192     def test_emit_step_finish_defaults(self):\n229\u2192         stdout = io.StringIO()\n230\u2192         emit_step_finish_event(stdout, \"session-2\")\n231\u2192         event = json.loads(stdout.getvalue().strip())\n232\u2192         assert event[\"part\"][\"tokens\"] == {\n233\u2192             \"input\": 0,\n234\u2192             \"output\": 0,\n235\u2192             \"cache_creation\": 0,\n236\u2192             \"cache_read\": 0,\n237\u2192         }\n238\u2192         assert event[\"part\"][\"cost\"] == 0.0\n239\u2192 \n240\u2192 \n241\u2192 class TestRunPromptJsonlWithUsage:\n242\u2192     @pytest.mark.asyncio\n243\u2192     async def test_step_finish_includes_real_usage(self, config, tmp_path):\n244\u2192         stream = [\n245\u2192             MessageStart(\n246\u2192                 id=\"msg_1\",\n247\u2192                 model=\"glm-5-turbo\",\n248\u2192                 usage_input_tokens=800,\n249\u2192                 usage_cache_read=100,\n250\u2192                 usage_cache_creation=50,\n251\u2192             ),\n252\u2192             ContentBlockStart(type=\"text\", index=0),\n253\u2192             ContentBlockDelta(type=\"text_delta\", index=0, text=\"Done\"),\n254\u2192             ContentBlockStop(index=0),\n255\u2192             UsageDelta(output_tokens=200),\n256\u2192             MessageStop(stop_reason=\"end_turn\"),\n257\u2192         ]\n258\u2192 \n259\u2192         class FakeClient:\n260\u2192             def __init__(self, *, config):\n261\u2192                 self.config = config\n262\u2192 \n263\u2192             def chat_completion(self, **kwargs):\n264\u2192                 async def gen():\n265\u2192                     for chunk in stream:\n266\u2192                         yield chunk\n267\u2192 \n268\u2192                 return gen()\n269\u2192 \n270\u2192         stdout = io.StringIO()\n271\u2192         exit_code = await run_prompt_jsonl(\n272\u2192             \"test prompt\",\n273\u2192             config=config,\n274\u2192             working_dir=str(tmp_path),\n275\u2192             stdout=stdout,\n276\u2192             chat_client=FakeClient(config=config),\n277\u2192         )\n278\u2192         assert exit_code == 0\n279\u2192         events = [json.loads(line) for line in stdout.getvalue().splitlines()]\n280\u2192         finish = events[-1]\n281\u2192         assert finish[\"type\"] == \"step_finish\"\n282\u2192         assert finish[\"part\"][\"tokens\"][\"input\"] == 800\n283\u2192         assert finish[\"part\"][\"tokens\"][\"output\"] == 200\n284\u2192         assert finish[\"part\"][\"tokens\"][\"cache_read\"] == 100\n285\u2192         assert finish[\"part\"][\"tokens\"][\"cache_creation\"] == 50\n286\u2192         assert finish[\"part\"][\"cost\"] > 0\n287\u2192 \n288\u2192 \n289\u2192 class TestQuotaErrorDetection:\n290\u2192     def test_quota_error_is_detected(self):\n291\u2192         err = QuotaError(\"exceeded\", zai_code=1302)\n292\u2192         assert is_quota_error(err)\n293\u2192         assert err.zai_code == 1302\n294\u2192 \n295\u2192     def test_all_quota_codes_detected(self):\n296\u2192         for code in (1302, 1305, 1308, 1310):\n297\u2192             err = QuotaError(\"test\", zai_code=code)\n298\u2192             assert is_quota_error(err)\n299\u2192 \n300\u2192     def test_non_quota_error_not_detected(self):\n301\u2192         from goz.api.errors import ApiError\n302\u2192 \n303\u2192         err = ApiError(\"regular error\")\n304\u2192         assert not is_quota_error(err)\n305\u2192 \n306\u2192     @pytest.mark.asyncio\n307\u2192     async def test_chat_client_raises_quota_error_for_zai_code(self, config):\n308\u2192         import anthropic\n309\u2192 \n310\u2192         client = ChatClient(config)\n311\u2192         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n312\u2192 \n313\u2192         mock_response = MagicMock()\n314\u2192         mock_response.status_code = 429\n315\u2192         mock_response.text = '{\"error\":{\"code\":1302,\"message\":\"Quota exceeded\"}}'\n316\u2192 \n317\u2192         with patch.object(client._client, \"messages\") as mock_messages:\n318\u2192 \n319\u2192             class ErrorCtx:\n320\u2192                 async def __aenter__(self):\n321\u2192                     raise anthropic.APIStatusError(\n322\u2192                         message=\"Quota exceeded\",\n323\u2192                         response=mock_response,\n324\u2192                         body={\"error\": {\"code\": 1302, \"message\": \"Quota exceeded\"}},\n325\u2192                     )\n326\u2192 \n327\u2192                 async def __aexit__(self, *a):\n328\u2192                     pass\n329\u2192 \n330\u2192             mock_messages.stream.side_effect = [ErrorCtx()]\n331\u2192             with pytest.raises(QuotaError) as exc_info:\n332\u2192                 async for _ in client.chat_completion(messages):\n333\u2192                     pass\n334\u2192             assert exc_info.value.zai_code == 1302\n335\u2192 \n336\u2192 \n337\u2192 class TestMonitorClient:\n338\u2192     @pytest.mark.asyncio\n339\u2192     async def test_fetch_quota_limit(self, config):\n340\u2192         from goz.api.monitor import MonitorClient\n341\u2192 \n342\u2192         client = MonitorClient(config=config)\n343\u2192         mock_resp = MagicMock()\n344\u2192         mock_resp.json.return_value = {\n345\u2192             \"data\": {\n346\u2192                 \"limit\": 500000,\n347\u2192                 \"used\": 200000,\n348\u2192                 \"remaining\": 300000,\n349\u2192                 \"window\": \"5h\",\n350\u2192             }\n351\u2192         }\n352\u2192         mock_resp.raise_for_status = MagicMock()\n353\u2192 \n354\u2192         with patch(\"goz.api.monitor.httpx.AsyncClient\") as mock_client_cls:\n355\u2192             mock_client = AsyncMock()\n356\u2192             mock_client.get = AsyncMock(return_value=mock_resp)\n357\u2192             mock_client.__aenter__ = AsyncMock(return_value=mock_client)\n358\u2192             mock_client.__aexit__ = AsyncMock()\n359\u2192             mock_client_cls.return_value = mock_client\n360\u2192 \n361\u2192             quota = await client.fetch_quota_limit()\n362\u2192 \n363\u2192         assert quota.limit == 500000\n364\u2192         assert quota.remaining == 300000\n365\u2192         assert quota.used == 200000\n366\u2192         assert quota.window_label == \"5h\"\n367\u2192 \n368\u2192     @pytest.mark.asyncio\n369\u2192     async def test_fetch_model_usage(self, config):\n370\u2192         from goz.api.monitor import MonitorClient\n371\u2192 \n372\u2192         client = MonitorClient(config=config)\n373\u2192         mock_resp = MagicMock()\n374\u2192         mock_resp.json.return_value = {\n375\u2192             \"data\": [\n376\u2192                 {\n377\u2192                     \"model\": \"glm-5-turbo\",\n378\u2192                     \"input_tokens\": 100000,\n379\u2192                     \"output_tokens\": 50000,\n380\u2192                     \"total_tokens\": 150000,\n381\u2192                     \"cost\": 1.25,\n382\u2192                     \"requests\": 42,\n383\u2192                 }\n384\u2192             ]\n385\u2192         }\n386\u2192         mock_resp.raise_for_status = MagicMock()\n387\u2192 \n388\u2192         with patch(\"goz.api.monitor.httpx.AsyncClient\") as mock_client_cls:\n389\u2192             mock_client = AsyncMock()\n390\u2192             mock_client.get = AsyncMock(return_value=mock_resp)\n391\u2192             mock_client.__aenter__ = AsyncMock(return_value=mock_client)\n392\u2192             mock_client.__aexit__ = AsyncMock()\n393\u2192             mock_client_cls.return_value = mock_client\n394\u2192 \n395\u2192             report = await client.fetch_model_usage(days=7)\n396\u2192 \n397\u2192         assert report.period_days == 7\n398\u2192         assert len(report.entries) == 1\n399\u2192         assert report.entries[0].model == \"glm-5-turbo\"\n400\u2192         assert report.entries[0].input_tokens == 100000\n401\u2192         assert report.entries[0].output_tokens == 50000\n402\u2192         assert report.entries[0].cost == 1.25\n403\u2192         assert report.entries[0].requests == 42\n404\u2192 \n405\u2192 \n406\u2192 class TestUsageCommand:\n407\u2192     @pytest.mark.asyncio\n408\u2192     async def test_cmd_usage_json_output(self, config, capsys):\n409\u2192         from goz.api.monitor import QuotaInfo, ModelUsageReport, ModelUsageEntry\n410\u2192         from goz.cli.usage import cmd_usage\n411\u2192 \n412\u2192         mock_monitor = MagicMock()\n413\u2192         mock_monitor.fetch_quota_limit = AsyncMock(\n414\u2192             return_value=QuotaInfo(limit=500000, remaining=300000, used=200000, window_label=\"5h\")\n415\u2192         )\n416\u2192         mock_monitor.fetch_model_usage = AsyncMock(\n417\u2192             side_effect=lambda days=7: ModelUsageReport(\n418\u2192                 period_days=days,\n419\u2192                 entries=[\n420\u2192                     ModelUsageEntry(\n421\u2192                         model=\"glm-5-turbo\",\n422\u2192                         input_tokens=100000,\n423\u2192                         output_tokens=50000,\n424\u2192                         total_tokens=150000,\n425\u2192                         cost=1.25,\n426\u2192                         requests=42,\n427\u2192                     )\n428\u2192                 ],\n429\u2192             )\n430\u2192         )\n431\u2192 \n432\u2192         with (\n433\u2192             patch(\"goz.cli.usage.load_config\", return_value=config),\n434\u2192             patch(\"goz.api.monitor.MonitorClient\", return_value=mock_monitor),\n435\u2192         ):\n436\u2192             await cmd_usage([\"--json\"])\n437\u2192 \n438\u2192         captured = capsys.readouterr()\n439\u2192         data = json.loads(captured.out)\n440\u2192         assert \"quota\" in data\n441\u2192         assert data[\"quota\"][\"remaining\"] == 300000\n442\u2192         assert \"7_day\" in data\n443\u2192         assert data[\"7_day\"][0][\"model\"] == \"glm-5-turbo\"", "is_error": false}}
