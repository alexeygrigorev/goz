 STAGE_RESULT:\n 52\u2192 {\"verdict\":\"pass\",\"summary\":\"one-line summary\",\"files_changed\":[\"path/to/file\"],\"tests\":{\"added\":0,\"passing\":0},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\n 53\u2192 \n 54\u2192 Return valid JSON after STAGE_RESULT:. Include a verdict.\n 55\u2192 \"\"\".strip()\n 56\u2192 \n 57\u2192 \n 58\u2192 def _emit_event(event: dict[str, Any], stdout: TextIO) -> None:\n 59\u2192     stdout.write(json.dumps(event, ensure_ascii=True) + \"\\n\")\n 60\u2192     stdout.flush()\n 61\u2192 \n 62\u2192 \n 63\u2192 def emit_text_event(text: str, stdout: TextIO) -> None:\n 64\u2192     _emit_event({\"type\": \"text\", \"part\": {\"text\": text}}, stdout)\n 65\u2192 \n 66\u2192 \n 67\u2192 def emit_tool_use_event(\n 68\u2192     tool_call: dict[str, Any],\n 69\u2192     result: str,\n 70\u2192     stdout: TextIO,\n 71\u2192     *,\n 72\u2192     is_error: bool = False,\n 73\u2192 ) -> None:\n 74\u2192     _emit_event(\n 75\u2192         {\n 76\u2192             \"type\": \"tool_use\",\n 77\u2192             \"part\": {\n 78\u2192                 \"id\": tool_call[\"id\"],\n 79\u2192                 \"name\": tool_call[\"name\"],\n 80\u2192                 \"input\": tool_call[\"input\"],\n 81\u2192                 \"output\": result,\n 82\u2192                 \"is_error\": is_error,\n 83\u2192             },\n 84\u2192         },\n 85\u2192         stdout,\n 86\u2192     )\n 87\u2192 \n 88\u2192 \n 89\u2192 def emit_error_event(name: str, message: str, stdout: TextIO) -> None:\n 90\u2192     _emit_event(\n 91\u2192         {\n 92\u2192             \"type\": \"error\",\n 93\u2192             \"error\": {\n 94\u2192                 \"name\": name,\n 95\u2192                 \"data\": {\"message\": message},\n 96\u2192             },\n 97\u2192         },\n 98\u2192         stdout,\n 99\u2192     )\n100\u2192 \n101\u2192 \n102\u2192 def emit_step_finish_event(\n103\u2192     stdout: TextIO,\n104\u2192     session_id: str,\n105\u2192     *,\n106\u2192     tokens: dict[str, int] | None = None,\n107\u2192     cost: float = 0.0,\n108\u2192 ) -> None:\n109\u2192     _emit_event(\n110\u2192         {\n111\u2192             \"type\": \"step_finish\",\n112\u2192             \"part\": {\n113\u2192                 \"tokens\": tokens or {\"input\": 0, \"output\": 0, \"cache_creation\": 0, \"cache_read\": 0},\n114\u2192                 \"cost\": cost,\n115\u2192                 \"session_id\": session_id,\n116\u2192                 \"continuation\": {\"resume_session_id\": session_id},\n117\u2192             },\n118\u2192         },\n119\u2192         stdout,\n120\u2192     )\n121\u2192 \n122\u2192 \n123\u2192 @dataclass\n124\u2192 class RunSessionState:\n125\u2192     session_id: str\n126\u2192     created_at: datetime\n127\u2192     history: ChatHistory\n128\u2192     working_dir: str\n129\u2192     agent_type: str\n130\u2192     config: Config\n131\u2192     session_manager: SessionManager\n132\u2192     tool_registry: ToolRegistry\n133\u2192 \n134\u2192     async def save(self) -> Path:\n135\u2192         session = Session(\n136\u2192             id=self.session_id,\n137\u2192             created_at=self.created_at,\n138\u2192             updated_at=datetime.now(),\n139\u2192             working_directory=self.working_dir,\n140\u2192             messages=list(self.history.messages),\n141\u2192             model=self.config.chat_model,\n142\u2192             agent_type=self.agent_type,\n143\u2192             config_snapshot=self.config.model_dump() if hasattr(self.config, \"model_dump\") else {},\n144\u2192             tool_state=_serialize_tool_state(self.tool_registry, self.working_dir),\n145\u2192         )\n146\u2192         return await self.session_manager.save(session)\n147\u2192 \n148\u2192 \n149\u2192 def _serialize_tool_state(tool_registry: ToolRegistry, working_dir: str) -> dict[str, Any]:\n150\u2192     return {\n151\u2192         \"working_directory\": working_dir,\n152\u2192         \"tools\": {\n153\u2192             tool.name: {\n154\u2192                 \"working_dir\": getattr(tool, \"working_dir\", None),\n155\u2192             }\n156\u2192             for tool in tool_registry.list_all()\n157\u2192         },\n158\u2192     }\n159\u2192 \n160\u2192 \n161\u2192 def build_default_tool_registry(config: Config, working_dir: str) -> ToolRegistry:\n162\u2192     \"\"\"Create the default tool set for one-shot CLI runs.\"\"\"\n163\u2192     registry = ToolRegistry()\n164\u2192     registry.register(BashTool(working_dir=working_dir))\n165\u2192     registry.register(ViewFileTool(working_dir=working_dir))\n166\u2192     registry.register(CreateFileTool(working_dir=working_dir))\n167\u2192     registry.register(StrReplaceEditorTool(working_dir=working_dir))\n168\u2192     registry.register(GlobTool(working_dir=working_dir))\n169\u2192     registry.register(GrepTool(working_dir=working_dir))\n170\u2192     registry.register(SearchTool(config))\n171\u2192     registry.register(ReadTool(config))\n172\u2192     registry.register(RepoSearchTool(config))\n173\u2192     registry.register(RepoTreeTool(config))\n174\u2192     registry.register(RepoReadTool(config))\n175\u2192     return registry\n176\u2192 \n177\u2192 \n178\u2192 def _build_prompt(user_prompt: str) -> str:\n179\u2192     return f\"{user_prompt.rstrip()}\\n\\n{STAGE_RESULT_INSTRUCTION}\"\n180\u2192 \n181\u2192 \n182\u2192 def _parse_tool_calls(chunks: list[Chunk]) -> list[dict[str, Any]]:\n183\u2192     tool_calls: list[dict[str, Any]] = []\n184\u2192     tool_calls_by_index: dict[int, dict[str, Any]] = {}\n185\u2192 \n186\u2192     for chunk in chunks:\n187\u2192         if isinstance(chunk, ContentBlockStart) and chunk.type == \"tool_use\":\n188\u2192             tool_calls_by_index[chunk.index] = {\n189\u2192                 \"id\": chunk.id or \"\",\n190\u2192                 \"name\": chunk.name or \"\",\n191\u2192                 \"input_json\": [],\n192\u2192             }\n193\u2192         elif isinstance(chunk, ContentBlockDelta) and chunk.type == \"input_json_delta\":\n194\u2192             block = tool_calls_by_index.get(chunk.index)\n195\u2192             if block is not None and chunk.partial_json:\n196\u2192                 block[\"input_json\"].append(chunk.partial_json)\n197\u2192         elif isinstance(chunk, ContentBlockStop):\n198\u2192             block = tool_calls_by_index.get(chunk.index)\n199\u2192             if block is None:\n200\u2192                 continue\n201\u2192             input_text = \"\".join(block.pop(\"input_json\"))\n202\u2192             try:\n203\u2192                 parsed_input = json.loads(input_text) if input_text else {}\n204\u2192             except json.JSONDecodeError:\n205\u2192                 parsed_input = {\"raw\": input_text}\n206\u2192             tool_calls.append(\n207\u2192                 {\n208\u2192                     \"id\": block[\"id\"],\n209\u2192                     \"name\": block[\"name\"],\n210\u2192                     \"input\": parsed_input,\n211\u2192                 }\n212\u2192             )\n213\u2192 \n214\u2192     return tool_calls\n215\u2192 \n216\u2192 \n217\u2192 async def _execute_tool_call(\n218\u2192     tool_registry: ToolRegistry, tool_call: dict[str, Any]\n219\u2192 ) -> tuple[str, bool]:\n220\u2192     tool = tool_registry.get(tool_call[\"name\"])\n221\u2192     if tool is None:\n222\u2192         return f\"Tool not found: {tool_call['name']}\", True\n223\u2192 \n224\u2192     try:\n225\u2192         result = await asyncio.wait_for(tool.execute(**tool_call[\"input\"]), timeout=300)\n226\u2192     except asyncio.TimeoutError:\n227\u2192         return f\"Tool {tool_call['name']} timed out after 300 seconds\", True\n228\u2192     except Exception as exc:\n229\u2192         return f\"Tool {tool_call['name']} failed: {exc}\", True\n230\u2192 \n231\u2192     return str(result), False\n232\u2192 \n233\u2192 \n234\u2192 async def run_prompt_jsonl(\n235\u2192     prompt: str,\n236\u2192     *,\n237\u2192     config: Config,\n238\u2192     working_dir: str,\n239\u2192     stdout: TextIO | None = None,\n240\u2192     tool_registry: ToolRegistry | None = None,\n241\u2192     chat_client: ChatClient | None = None,\n242\u2192     resume_session_id: str | None = None,\n243\u2192     session_dir: Path | None = None,\n244\u2192 ) -> int:\n245\u2192     \"\"\"Execute one agent prompt and emit JSONL events.\"\"\"\n246\u2192     stdout = stdout or sys.stdout\n247\u2192     session_manager = SessionManager(session_dir=session_dir)\n248\u2192     session: Session | None = None\n249\u2192     if resume_session_id is not None:\n250\u2192         session = await session_manager.load(resume_session_id)\n251\u2192         working_dir = session.working_directory\n252\u2192 \n253\u2192     history = ChatHistory(messages=list(session.messages) if session else None)\n254\u2192     registry = tool_registry or build_default_tool_registry(config, working_dir)\n255\u2192     client = chat_client or ChatClient(config=config)\n256\u2192     state = RunSessionState(\n257\u2192         session_id=resume_session_id or uuid.uuid4().hex,\n258\u2192         created_at=session.created_at if session else datetime.now(),\n259\u2192         history=history,\n260\u2192         working_dir=working_dir,\n261\u2192         agent_type=session.agent_type if session else DEFAULT_AGENT_TYPE,\n262\u2192         config=config,\n263\u2192         session_manager=session_manager,\n264\u2192         tool_registry=registry,\n265\u2192     )\n266\u2192 \n267\u2192     if prompt:\n268\u2192         history.add(ChatMessage(role=\"user\", content=_build_prompt(prompt)))\n269\u2192 \n270\u2192     loop = asyncio.get_running_loop()\n271\u2192     interrupted_by: dict[str, str | None] = {\"signal\": None}\n272\u2192     current_task = asyncio.current_task()\n273\u2192 \n274\u2192     async def _handle_interrupt(signame: str) -> None:\n275\u2192         interrupted_by[\"signal\"] = signame\n276\u2192         await state.save()\n277\u2192         if current_task is not None:\n278\u2192             current_task.cancel()\n279\u2192 \n280\u2192     for signum in (signal.SIGTERM, signal.SIGINT):\n281\u2192         try:\n282\u2192             loop.add_signal_handler(\n283\u2192                 signum,\n284\u2192                 lambda current_signum=signum: asyncio.create_task(\n285\u2192                     _handle_interrupt(signal.Signals(current_signum).name)\n286\u2192                 ),\n287\u2192             )\n288\u2192         except (NotImplementedError, RuntimeError):\n289\u2192             continue\n290\u2192 \n291\u2192     iteration = 0\n292\u2192     try:\n293\u2192 <<<<<<< Updated upstream\n294\u2192         while True:\n295\u2192             iteration += 1\n296\u2192             if MAX_ITERATIONS is not None and iteration > MAX_ITERATIONS:\n297\u2192                 break\n298\u2192 =======\n299\u2192         usage_acc = UsageAccumulator()\n300\u2192         for _ in range(MAX_ITERATIONS):\n301\u2192 >>>>>>> Stashed changes\n302\u2192             chunks: list[Chunk] = []\n303\u2192             assistant_chunks: list[str] = []\n304\u2192             usage_acc.begin_turn()\n305\u2192 \n306\u2192             stream = client.chat_completion(\n307\u2192                 messages=history.to_api_format(),\n308\u2192                 tools=registry.to_openai_schema(),\n309\u2192                 tool_choice=\"auto\",\n310\u2192             )\n311\u2192 \n312\u2192             async for chunk in stream:\n313\u2192                 chunks.append(chunk)\n314\u2192                 if (\n315\u2192                     isinstance(chunk, ContentBlockDelta)\n316\u2192                     and chunk.type == \"text_delta\"\n317\u2192                     and chunk.text\n318\u2192                 ):\n319\u2192                     assistant_chunks.append(chunk.text)\n320\u2192                     emit_text_event(chunk.text, stdout)\n321\u2192                 elif isinstance(chunk, MessageStart):\n322\u2192                     usage_obj = type(\n323\u2192                         \"U\",\n324\u2192                         (),\n325\u2192                         {\n326\u2192                             \"input_tokens\": chunk.usage_input_tokens,\n327\u2192                             \"cache_read_input_tokens\": chunk.usage_cache_read,\n328\u2192                             \"cache_creation_input_tokens\": chunk.usage_cache_creation,\n329\u2192                         },\n330\u2192                     )()\n331\u2192                     usage_acc.apply_message_start(usage_obj)\n332\u2192                 elif isinstance(chunk, UsageDelta):\n333\u2192                     usage_obj = type(\"U\", (), {\"output_tokens\": chunk.output_tokens})()\n334\u2192                     usage_acc.apply_message_delta(usage_obj)\n335\u2192 \n336\u2192             snap = usage_acc.finalise_turn()\n337\u2192 \n338\u2192             tool_calls = _parse_tool_calls(chunks)\n339\u2192             if not tool_calls:\n340\u2192                 history.add(ChatMessage(role=\"assistant\", content=\"\".join(assistant_chunks)))\n341\u2192                 emit_step_finish_event(\n342\u2192                     stdout,\n343\u2192                     state.session_id,\n344\u2192                     tokens=snap.to_dict(),\n345\u2192                     cost=snap.cost_usd(model=config.chat_model),\n346\u2192                 )\n347\u2192                 return 0\n348\u2192 \n349\u2192             history.add(\n350\u2192                 ChatMessage(\n351\u2192                     role=\"assistant\",\n352\u2192                     content=\"\".join(assistant_chunks),\n353\u2192                     tool_calls=[\n354\u2192                         ToolCall(\n355\u2192                             id=tool_call[\"id\"],\n356\u2192                             name=tool_call[\"name\"],\n357\u2192                             input=tool_call[\"input\"],\n358\u2192                         )\n359\u2192                         for tool_call in tool_calls\n360\u2192                     ],\n361\u2192                 )\n362\u2192             )\n363\u2192 \n364\u2192             for tool_call in tool_calls:\n365\u2192                 result, is_error = await _execute_tool_call(registry, tool_call)\n366\u2192                 emit_tool_use_event(tool_call, result, stdout, is_error=is_error)\n367\u2192                 history.add(\n368\u2192                     ChatMessage(\n369\u2192                         role=\"tool\",\n370\u2192                         content=result,\n371\u2192                         tool_result_id=tool_call[\"id\"],\n372\u2192                     )\n373\u2192                 )\n374\u2192     except asyncio.CancelledError:\n375\u2192         emit_error_event(\n376\u2192             \"Interrupted\", f\"Run interrupted by {interrupted_by['signal'] or 'signal'}\", stdout\n377\u2192         )\n378\u2192         return 1\n379\u2192     finally:\n380\u2192         for signum in (signal.SIGTERM, signal.SIGINT):\n381\u2192             try:\n382\u2192                 loop.remove_signal_handler(signum)\n383\u2192             except (NotImplementedError, RuntimeError):\n384\u2192                 continue\n385\u2192         await state.save()\n386\u2192 \n387\u2192     emit_error_event(\"MaxIterationsExceeded\", f\"Exceeded {MAX_ITERATIONS} agent iterations\", stdout)\n388\u2192     return 1\n389\u2192 \n390\u2192 \n391\u2192 async def cmd_run(args: list[str]) -> None:\n392\u2192     \"\"\"Handle the `goz run` command.\"\"\"\n393\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n394\u2192         print(\"\"\"Run command usage:\n395\u2192 \n396\u2192   goz run [options] <prompt>\n397\u2192 \n398\u2192 Options:\n399\u2192   --format, -f json   Output ExternalCLIAdapter-compatible JSONL (default: json)\n400\u2192   --dir DIR           Working directory for file and shell tools\n401\u2192   --model MODEL       Override chat model for this invocation\n402\u2192   --resume-session ID Resume a previously saved engine session\n403\u2192 \n404\u2192 Examples:\n405\u2192   goz run --format json \"Summarize this repo and report STAGE_RESULT.\"\n406\u2192   goz run --dir /tmp/project --model glm-5 \"Run pytest and explain failures.\"\n407\u2192   goz run --resume-session abc123 \"Continue with the next step.\"\n408\u2192 \"\"\")\n409\u2192         return\n410\u2192 \n411\u2192     parser = argparse.ArgumentParser(prog=\"goz run\", add_help=False)\n412\u2192     parser.add_argument(\"--format\", \"-f\", choices=[\"json\"], default=\"json\", help=\"Output format\")\n413\u2192     parser.add_argument(\"--dir\", dest=\"working_dir\", help=\"Working directory for the run\")\n414\u2192     parser.add_argument(\"--model\", help=\"Override chat model\")\n415\u2192     parser.add_argument(\n416\u2192         \"--resume-session\", dest=\"resume_session_id\", help=\"Resume a saved session by ID\"\n417\u2192     )\n418\u2192     parser.add_argument(\"prompt\", nargs=\"*\", help=\"Prompt to execute\")\n419\u2192     parsed = parser.parse_args(args)\n420\u2192 \n421\u2192     if not parsed.prompt and not parsed.resume_session_id:\n422\u2192         raise SystemExit(\"goz run requires a prompt unless --resume-session is provided\")\n423\u2192 \n424\u2192     try:\n425\u2192         config = load_config()\n426\u2192         if parsed.model:\n427\u2192             config = config.model_copy(update={\"chat_model\": parsed.model})\n428\u2192 \n429\u2192         working_dir = str(Path(parsed.working_dir or \".\").resolve())\n430\u2192         if parsed.working_dir and not Path(working_dir).exists():\n431\u2192             raise FileNotFoundError(f\"Working directory does not exist: {working_dir}\")\n432\u2192         if parsed.working_dir and not Path(working_dir).is_dir():\n433\u2192             raise NotADirectoryError(f\"Working directory is not a directory: {working_dir}\")\n434\u2192 \n435\u2192         exit_code = await run_prompt_jsonl(\n436\u2192             \" \".join(parsed.prompt),\n437\u2192             config=config,\n438\u2192             working_dir=working_dir,\n439\u2192             resume_session_id=parsed.resume_session_id,\n440\u2192         )\n441\u2192     except Exception as exc:\n442\u2192         emit_error_event(type(exc).__name__, str(exc), sys.stdout)\n443\u2192         sys.exit(1)\n444\u2192 \n445\u2192     if exit_code != 0:\n446\u2192         sys.exit(exit_code)", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_7666f9acc9ab44ca9ada494e", "name": "view_file", "input": {"file_path": "goz/agent/stream_processor.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/stream_processor.py (292 lines)\n============================================================\n\n  1\u2192 \"\"\"Stream Processor for handling Anthropic API streaming responses.\n  2\u2192 \n  3\u2192 This module provides the StreamProcessor class for processing streaming\n  4\u2192 responses from the Anthropic-compatible Z.AI API, extracting text chunks\n  5\u2192 for real-time UI updates and parsing tool calls.\n  6\u2192 \n  7\u2192 Acceptance Criteria (Issue 16):\n  8\u2192 1. StreamProcessor class exists\n  9\u2192 2. process_stream() method takes async iterator of chunks\n 10\u2192 3. Returns ProcessedStream with: full_text, tool_calls, raw_chunks\n 11\u2192 4. extract_tool_calls() parses tool calls from chunks\n 12\u2192 5. Handles partial_json accumulation\n 13\u2192 6. Handles multiple tool calls in one response\n 14\u2192 7. Yields text chunks for real-time UI updates\n 15\u2192 \"\"\"\n 16\u2192 import asyncio\n 17\u2192 import json\n 18\u2192 import logging\n 19\u2192 from dataclasses import dataclass, field\n 20\u2192 from typing import Any, AsyncIterator\n 21\u2192 \n 22\u2192 from goz.config import Config\n 23\u2192 \n 24\u2192 \n 25\u2192 logger = logging.getLogger(__name__)\n 26\u2192 \n 27\u2192 \n 28\u2192 @dataclass\n 29\u2192 class ToolCall:\n 30\u2192     \"\"\"Represents a tool call extracted from a streaming response.\n 31\u2192 \n 32\u2192     Attributes:\n 33\u2192         id: The unique identifier for this tool call\n 34\u2192         name: The name of the tool being called\n 35\u2192         arguments: The arguments passed to the tool (as a dict)\n 36\u2192 \n 37\u2192     Acceptance Criteria 8: ToolCall dataclass: id, name, arguments\n 38\u2192     \"\"\"\n 39\u2192     id: str\n 40\u2192     name: str\n 41\u2192     arguments: dict[str, Any] = field(default_factory=dict)\n 42\u2192 \n 43\u2192 \n 44\u2192 @dataclass\n 45\u2192 class ProcessedStream:\n 46\u2192     \"\"\"Result of processing a complete API stream.\n 47\u2192 \n 48\u2192     Attributes:\n 49\u2192         full_text: The complete accumulated text from the stream\n 50\u2192         tool_calls: List of tool calls extracted from the stream\n 51\u2192         raw_chunks: All raw chunks received (for debugging/replay)\n 52\u2192 \n 53\u2192     Acceptance Criteria 9: ProcessedStream dataclass: full_text, tool_calls, raw_chunks\n 54\u2192     \"\"\"\n 55\u2192     full_text: str\n 56\u2192     tool_calls: list[ToolCall]\n 57\u2192     raw_chunks: list[Any] = field(default_factory=list)\n 58\u2192 \n 59\u2192 \n 60\u2192 class StreamProcessor:\n 61\u2192     \"\"\"Processes streaming responses from Anthropic API.\n 62\u2192 \n 63\u2192     This class handles streaming responses from the Z.AI Anthropic-compatible API.\n 64\u2192     It accumulates text chunks for real-time UI updates and extracts tool calls\n 65\u2192     from content blocks.\n 66\u2192 \n 67\u2192     Acceptance Criteria 1: StreamProcessor class exists\n 68\u2192     Acceptance Criteria 2: process_stream() method takes async iterator of chunks\n 69\u2192 \n 70\u2192     Chunk Types (from Anthropic SDK):\n 71\u2192     - content_block_start: {\"type\": \"text\" | \"tool_use\"}\n 72\u2192     - content_block_delta: {\"type\": \"text_delta\", \"text\": \"...\"}\n 73\u2192                          or {\"type\": \"input_json_delta\", \"partial_json\": \"...\"}\n 74\u2192     - content_block_stop\n 75\u2192     - message_stop\n 76\u2192     \"\"\"\n 77\u2192 \n 78\u2192     def __init__(self, config: Config) -> None:\n 79\u2192         \"\"\"Initialize StreamProcessor.\n 80\u2192 \n 81\u2192         Args:\n 82\u2192             config: Configuration object\n 83\u2192 \n 84\u2192         Acceptance Criteria 1: StreamProcessor class exists\n 85\u2192         \"\"\"\n 86\u2192         self.config = config\n 87\u2192         self._full_text: str = \"\"\n 88\u2192         self._raw_chunks: list[Any] = []\n 89\u2192         self._text_chunks: list[str] = []\n 90\u2192 \n 91\u2192         # Tool call tracking\n 92\u2192         self._tool_blocks: dict[int, dict[str, Any]] = {}  # index -> {id, name, partial_json}\n 93\u2192         self._current_block_index: int | None = None\n 94\u2192 \n 95\u2192     async def process_stream(\n 96\u2192         self,\n 97\u2192         stream: AsyncIterator[Any],\n 98\u2192     ) -> AsyncIterator[str]:\n 99\u2192         \"\"\"Process stream and yield text chunks.\n100\u2192 \n101\u2192         This method consumes the streaming response, yielding text chunks\n102\u2192         for real-time UI updates. After the stream completes, use get_result()\n103\u2192         to retrieve the full processed result including tool calls.\n104\u2192 \n105\u2192         Args:\n106\u2192             stream: Async iterator of chunks from Anthropic SDK\n107\u2192 \n108\u2192         Yields:\n109\u2192             Text chunks as they arrive from the API\n110\u2192 \n111\u2192         Acceptance Criteria 2: process_stream() method takes async iterator of chunks\n112\u2192         Acceptance Criteria 7: Yields text chunks for real-time UI updates\n113\u2192         \"\"\"\n114\u2192         # Reset state for new stream\n115\u2192         self._full_text = \"\"\n116\u2192         self._raw_chunks = []\n117\u2192         self._text_chunks = []\n118\u2192         self._tool_blocks = {}\n119\u2192         self._current_block_index = None\n120\u2192 \n121\u2192         async for chunk in stream:\n122\u2192             # Store raw chunk\n123\u2192             self._raw_chunks.append(chunk)\n124\u2192 \n125\u2192             # Process chunk based on type\n126\u2192             chunk_type = getattr(chunk, 'type', None)\n127\u2192 \n128\u2192             if chunk_type == 'content_block_delta':\n129\u2192                 await self._handle_content_block_delta(chunk)\n130\u2192             elif chunk_type == 'content_block_start':\n131\u2192                 await self._handle_content_block_start(chunk)\n132\u2192             elif chunk_type == 'content_block_stop':\n133\u2192                 await self._handle_content_block_stop(chunk)\n134\u2192             elif chunk_type == 'message_stop':\n135\u2192                 # Stream is complete\n136\u2192                 pass\n137\u2192 \n138\u2192         # Yield all accumulated text chunks\n139\u2192         for text_chunk in self._text_chunks:\n140\u2192             yield text_chunk\n141\u2192 \n142\u2192     async def _handle_content_block_delta(self, chunk: Any) -> None:\n143\u2192         \"\"\"Handle content_block_delta chunk.\n144\u2192 \n145\u2192         Extracts text deltas for UI updates and partial_json for tool arguments.\n146\u2192         \"\"\"\n147\u2192         delta = getattr(chunk, 'delta', None)\n148\u2192         if not delta:\n149\u2192             return\n150\u2192 \n151\u2192         delta_type = delta.get('type', '')\n152\u2192 \n153\u2192         if delta_type == 'text_delta':\n154\u2192             # Text content - yield for UI and accumulate\n155\u2192             text = delta.get('text', '')\n156\u2192             if text:\n157\u2192                 self._full_text += text\n158\u2192                 self._text_chunks.append(text)\n159\u2192 \n160\u2192         elif delta_type == 'input_json_delta':\n161\u2192             # Partial JSON for tool arguments\n162\u2192             if self._current_block_index is not None:\n163\u2192                 partial_json = delta.get('partial_json', '')\n164\u2192                 if self._current_block_index not in self._tool_blocks:\n165\u2192                     self._tool_blocks[self._current_block_index] = {\n166\u2192                         'partial_json': ''\n167\u2192                     }\n168\u2192                 self._tool_blocks[self._current_block_index]['partial_json'] += partial_json\n169\u2192 \n170\u2192     async def _handle_content_block_start(self, chunk: Any) -> None:\n171\u2192         \"\"\"Handle content_block_start chunk.\n172\u2192 \n173\u2192         Identifies new tool_use blocks.\n174\u2192         \"\"\"\n175\u2192         index = getattr(chunk, 'index', None)\n176\u2192         content_block = getattr(chunk, 'content_block', None)\n177\u2192 \n178\u2192         if index is not None and content_block:\n179\u2192             self._current_block_index = index\n180\u2192 \n181\u2192             if content_block.get('type') == 'tool_use':\n182\u2192                 self._tool_blocks[index] = {\n183\u2192                     'id': content_block.get('id', ''),\n184\u2192                     'name': content_block.get('name', ''),\n185\u2192                     'partial_json': ''\n186\u2192                 }\n187\u2192             else:\n188\u2192                 # Text block - just track the index\n189\u2192                 if index not in self._tool_blocks:\n190\u2192                     self._tool_blocks[index] = {}\n191\u2192 \n192\u2192     async def _handle_content_block_stop(self, chunk: Any) -> None:\n193\u2192         \"\"\"Handle content_block_stop chunk.\n194\u2192 \n195\u2192         Finalizes tool argument accumulation.\n196\u2192         \"\"\"\n197\u2192         index = getattr(chunk, 'index', None)\n198\u2192         if index is not None and index in self._tool_blocks:\n199\u2192             # Parse accumulated JSON for tool arguments\n200\u2192             partial_json = self._tool_blocks[index].get('partial_json', '')\n201\u2192             if partial_json:\n202\u2192                 try:\n203\u2192                     self._tool_blocks[index]['arguments'] = json.loads(partial_json)\n204\u2192                 except json.JSONDecodeError:\n205\u2192                     logger.warning(f\"Failed to parse tool arguments: {partial_json}\")\n206\u2192                     self._tool_blocks[index]['arguments'] = {}\n207\u2192 \n208\u2192     def get_result(self) -> ProcessedStream:\n209\u2192         \"\"\"Get the final processed result.\n210\u2192 \n211\u2192         Returns a ProcessedStream containing the full text, extracted tool calls,\n212\u2192         and all raw chunks received.\n213\u2192 \n214\u2192         Returns:\n215\u2192             ProcessedStream with full_text, tool_calls, and raw_chunks\n216\u2192 \n217\u2192         Acceptance Criteria 3: Returns ProcessedStream with: full_text, tool_calls, raw_chunks\n218\u2192         \"\"\"\n219\u2192         tool_calls = self.extract_tool_calls(self._raw_chunks)\n220\u2192 \n221\u2192         return ProcessedStream(\n222\u2192             full_text=self._full_text,\n223\u2192             tool_calls=tool_calls,\n224\u2192             raw_chunks=self._raw_chunks\n225\u2192         )\n226\u2192 \n227\u2192     def extract_tool_calls(self, chunks: list[Any]) -> list[ToolCall]:\n228\u2192         \"\"\"Parse tool calls from accumulated chunks.\n229\u2192 \n230\u2192         This method processes the raw chunks to extract any tool calls that\n231\u2192         were present in the response. It handles partial_json accumulation\n232\u2192         and multiple tool calls in a single response.\n233\u2192 \n234\u2192         Args:\n235\u2192             chunks: List of raw chunks from the API stream\n236\u2192 \n237\u2192         Returns:\n238\u2192             List of ToolCall objects extracted from the stream\n239\u2192 \n240\u2192         Acceptance Criteria 4: extract_tool_calls() parses tool calls from chunks\n241\u2192         Acceptance Criteria 5: Handles partial_json accumulation\n242\u2192         Acceptance Criteria 6: Handles multiple tool calls in one response\n243\u2192         \"\"\"\n244\u2192         # Re-process chunks to extract tool calls\n245\u2192         tool_blocks: dict[int, dict[str, Any]] = {}\n246\u2192 \n247\u2192         for chunk in chunks:\n248\u2192             chunk_type = getattr(chunk, 'type', None)\n249\u2192 \n250\u2192             if chunk_type == 'content_block_start':\n251\u2192                 index = getattr(chunk, 'index', None)\n252\u2192                 content_block = getattr(chunk, 'content_block', None)\n253\u2192 \n254\u2192                 if index is not None and content_block:\n255\u2192                     if content_block.get('type') == 'tool_use':\n256\u2192                         tool_blocks[index] = {\n257\u2192                             'id': content_block.get('id', ''),\n258\u2192                             'name': content_block.get('name', ''),\n259\u2192                             'partial_json': ''\n260\u2192                         }\n261\u2192 \n262\u2192             elif chunk_type == 'content_block_delta':\n263\u2192                 index = getattr(chunk, 'index', None)\n264\u2192                 delta = getattr(chunk, 'delta', None)\n265\u2192 \n266\u2192                 if index is not None and delta and index in tool_blocks:\n267\u2192                     delta_type = delta.get('type', '')\n268\u2192                     if delta_type == 'input_json_delta':\n269\u2192                         partial_json = delta.get('partial_json', '')\n270\u2192                         tool_blocks[index]['partial_json'] += partial_json\n271\u2192 \n272\u2192             elif chunk_type == 'content_block_stop':\n273\u2192                 index = getattr(chunk, 'index', None)\n274\u2192                 if index is not None and index in tool_blocks:\n275\u2192                     partial_json = tool_blocks[index].get('partial_json', '')\n276\u2192                     # Always try to parse - even if partial_json was accumulated\n277\u2192                     try:\n278\u2192                         tool_blocks[index]['arguments'] = json.loads(partial_json) if partial_json else {}\n279\u2192                     except json.JSONDecodeError:\n280\u2192                         tool_blocks[index]['arguments'] = {}\n281\u2192 \n282\u2192         # Convert tool blocks to ToolCall objects\n283\u2192         tool_calls = []\n284\u2192         for block in tool_blocks.values():\n285\u2192             if block.get('name'):  # Only include blocks with a tool name\n286\u2192                 tool_calls.append(ToolCall(\n287\u2192                     id=block.get('id', ''),\n288\u2192                     name=block.get('name', ''),\n289\u2192                     arguments=block.get('arguments', {})\n290\u2192                 ))\n291\u2192 \n292\u2192         return tool_calls", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_efa4955793e440b4ba4c0836", "name": "view_file", "input": {"file_path": "goz/agent/core.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/core.py (339 lines)\n============================================================\n\n  1\u2192 \"\"\"Core agent class for interactive coding.\n  2\u2192 \n  3\u2192 This module provides the AgentCore class which is the main entry point\n  4\u2192 for the interactive coding agent with full tool integration.\n  5\u2192 \n  6\u2192 Acceptance Criteria (Issue 22):\n  7\u2192 1. AgentCore.process_turn() implements full turn processing\n  8\u2192 2. Process turn: user input -> API stream -> tool calls -> results -> API -> response\n  9\u2192 3. Tool execution is sequential (not parallel)\n 10\u2192 4. Multiple tool calls in one response work correctly\n 11\u2192 5. Tool results are formatted for API consumption\n 12\u2192 6. Tool errors are caught and formatted\n 13\u2192 7. Tool timeouts are handled\n 14\u2192 8. Streaming response yields text chunks for UI\n 15\u2192 9. Turn completes when API stops (no more tool calls)\n 16\u2192 10. Chat history is updated with all messages\n 17\u2192 \"\"\"\n 18\u2192 import asyncio\n 19\u2192 import logging\n 20\u2192 from typing import Any, AsyncIterator\n 21\u2192 \n 22\u2192 from goz.agent.chat_client import ChatClient, Chunk\n 23\u2192 from goz.agent.history import ChatHistory, ChatMessage, ToolCall\n 24\u2192 from goz.agent.tools.base import ToolError, ToolInputError\n 25\u2192 from goz.agent.tools import ToolRegistry\n 26\u2192 from goz.api.errors import ApiError, AuthError, NetworkError, TimeoutError, ZaiError\n 27\u2192 from goz.config import Config\n 28\u2192 \n 29\u2192 \n 30\u2192 logger = logging.getLogger(__name__)\n 31\u2192 \n 32\u2192 # Completion marker for signaling turn completion to UI\n 33\u2192 COMPLETION_MARKER = \"\\x00\"\n 34\u2192 \n 35\u2192 \n 36\u2192 class AgentCore:\n 37\u2192     \"\"\"Core agent class for interactive coding.\n 38\u2192 \n 39\u2192     This class implements the full agent loop with tool integration:\n 40\u2192     - User input -> API stream -> tool calls -> tool execution -> results -> API -> response\n 41\u2192     - Handles multiple iterations (tool -> API -> tool -> API -> response)\n 42\u2192     - Yields text chunks for real-time UI updates\n 43\u2192     - Manages chat history with all messages\n 44\u2192 \n 45\u2192     Attributes:\n 46\u2192         config: Configuration for the agent\n 47\u2192         history: Chat history manager\n 48\u2192         tool_registry: Registry of available tools\n 49\u2192         chat_client: Client for Z.AI Chat API\n 50\u2192         max_iterations: Maximum tool-API iterations to prevent infinite loops\n 51\u2192     \"\"\"\n 52\u2192 \n 53\u2192     def __init__(\n 54\u2192         self,\n 55\u2192         config: Config,\n 56\u2192         history: ChatHistory | None = None,\n 57\u2192         tool_registry: ToolRegistry | None = None,\n 58\u2192         stream_processor: Any = None,\n 59\u2192         max_iterations: int = 10,\n 60\u2192     ) -> None:\n 61\u2192         \"\"\"Initialize AgentCore.\n 62\u2192 \n 63\u2192         Args:\n 64\u2192             config: Configuration object\n 65\u2192             history: Optional ChatHistory (creates new if None)\n 66\u2192             tool_registry: Optional ToolRegistry (creates new if None)\n 67\u2192             stream_processor: Optional stream processor (not used in current implementation)\n 68\u2192             max_iterations: Maximum tool-API iterations per turn (default: 10)\n 69\u2192         \"\"\"\n 70\u2192         self.config = config\n 71\u2192         self.history = history if history is not None else ChatHistory()\n 72\u2192         self.tool_registry = tool_registry if tool_registry is not None else ToolRegistry()\n 73\u2192         self.stream_processor = stream_processor\n 74\u2192         self.max_iterations = max_iterations\n 75\u2192 \n 76\u2192         # Initialize chat client\n 77\u2192         self.chat_client = ChatClient(config=config)\n 78\u2192 \n 79\u2192     async def process_turn(\n 80\u2192         self,\n 81\u2192         user_input: str,\n 82\u2192     ) -> AsyncIterator[str]:\n 83\u2192         \"\"\"Process a user turn and yield streaming response.\n 84\u2192 \n 85\u2192         This is the main agent loop. It:\n 86\u2192         1. Adds user message to history\n 87\u2192         2. Loops (up to max_iterations):\n 88\u2192            a. Calls API with current history\n 89\u2192            b. Streams response to UI (yields text chunks)\n 90\u2192            c. Checks for tool calls\n 91\u2192            d. If no tool calls, breaks\n 92\u2192            e. Executes tools sequentially\n 93\u2192            f. Adds tool calls and results to history\n 94\u2192         3. Adds assistant message to history\n 95\u2192         4. Yields completion marker\n 96\u2192 \n 97\u2192         Args:\n 98\u2192             user_input: User's input message\n 99\u2192 \n100\u2192         Yields:\n101\u2192             Text chunks for real-time UI display, followed by COMPLETION_MARKER\n102\u2192 \n103\u2192         Acceptance Criteria:\n104\u2192         - AC 1: Implements full turn processing\n105\u2192         - AC 2: user input -> API -> tools -> results -> API -> response\n106\u2192         - AC 3: Sequential tool execution\n107\u2192         - AC 4: Multiple tool calls in one response work\n108\u2192         - AC 5: Tool results formatted for API\n109\u2192         - AC 6: Tool errors caught and formatted\n110\u2192         - AC 7: Tool timeouts handled\n111\u2192         - AC 8: Yields text chunks for UI\n112\u2192         - AC 9: Completes when API stops\n113\u2192         - AC 10: History updated with all messages\n114\u2192         \"\"\"\n115\u2192         # Step 1: Add user message to history\n116\u2192         self.history.add(ChatMessage(role=\"user\", content=user_input))\n117\u2192 \n118\u2192         # Step 2: Main loop for tool-API iterations\n119\u2192         for iteration in range(self.max_iterations):\n120\u2192             # Step 2a: Call API with current history\n121\u2192             messages = self.history.to_api_format()\n122\u2192             tools_schema = self.tool_registry.to_openai_schema()\n123\u2192 \n124\u2192             # Step 2b: Process stream and yield text for UI\n125\u2192             accumulated_chunks: list[Chunk] = []\n126\u2192             accumulated_text: list[str] = []\n127\u2192 \n128\u2192             try:\n129\u2192                 stream = self.chat_client.chat_completion(\n130\u2192                     messages=messages,\n131\u2192                     tools=tools_schema if tools_schema else None,\n132\u2192                     tool_choice=\"auto\",\n133\u2192                 )\n134\u2192 \n135\u2192                 async for chunk in stream:\n136\u2192                     accumulated_chunks.append(chunk)\n137\u2192 \n138\u2192                     # Yield text for UI (AC 8)\n139\u2192                     # ContentBlockDelta has type=\"text_delta\" or type=\"input_json_delta\"\n140\u2192                     if hasattr(chunk, 'type') and chunk.type == \"text_delta\":\n141\u2192                         if hasattr(chunk, 'text') and chunk.text:\n142\u2192                             accumulated_text.append(chunk.text)\n143\u2192                             yield chunk.text\n144\u2192 \n145\u2192                 # Step 2c: Extract tool calls from stream\n146\u2192                 tool_calls = await self._extract_tool_calls_from_chunks(accumulated_chunks)\n147\u2192 \n148\u2192                 # Step 2d: Check for completion (no more tool calls)\n149\u2192                 if not tool_calls:\n150\u2192                     # No tools, turn is complete - add assistant message to history\n151\u2192                     assistant_text = \"\".join(accumulated_text)\n152\u2192                     self.history.add(ChatMessage(role=\"assistant\", content=assistant_text))\n153\u2192                     # Yield completion marker (AC 9)\n154\u2192                     yield COMPLETION_MARKER\n155\u2192                     break\n156\u2192 \n157\u2192                 # Step 2e: Execute tools sequentially (AC 3, AC 4)\n158\u2192                 for tool_call_dict in tool_calls:\n159\u2192                     # Create tool call message (AC 10)\n160\u2192                     tool_call_msg = ChatMessage(\n161\u2192                         role=\"tool_call\",\n162\u2192                         content=f\"Called {tool_call_dict['name']}\",\n163\u2192                         tool_calls=[ToolCall(\n164\u2192                             id=tool_call_dict['id'],\n165\u2192                             name=tool_call_dict['name'],\n166\u2192                             input=tool_call_dict['input'],\n167\u2192                         )],\n168\u2192                     )\n169\u2192                     self.history.add(tool_call_msg)\n170\u2192 \n171\u2192                     # Execute tool (AC 5, AC 6, AC 7)\n172\u2192                     tool_result = await self._execute_tool_call(tool_call_dict)\n173\u2192 \n174\u2192                     # Add tool result to history (AC 10)\n175\u2192                     result_msg = ChatMessage(\n176\u2192                         role=\"tool\",\n177\u2192                         content=tool_result,\n178\u2192                         tool_result_id=tool_call_dict['id'],\n179\u2192                     )\n180\u2192                     self.history.add(result_msg)\n181\u2192 \n182\u2192                 # Step 2f: Loop continues with tool results in history\n183\u2192 \n184\u2192             except Exception as e:\n185\u2192                 logger.error(f\"Error during turn processing: {e}\")\n186\u2192                 error_message = self._format_agent_error(e)\n187\u2192                 self.history.add(ChatMessage(role=\"assistant\", content=error_message))\n188\u2192                 yield error_message\n189\u2192                 yield COMPLETION_MARKER\n190\u2192                 break\n191\u2192 \n192\u2192     async def _extract_tool_calls_from_chunks(self, chunks: list[Chunk]) -> list[dict]:\n193\u2192         \"\"\"Extract tool calls from accumulated stream chunks.\n194\u2192 \n195\u2192         Args:\n196\u2192             chunks: List of chunks from the API stream\n197\u2192 \n198\u2192         Returns:\n199\u2192             List of tool_call dicts with id, name, and input keys\n200\u2192         \"\"\"\n201\u2192         # Use the chat_client's method if available\n202\u2192         if hasattr(self.chat_client, 'extract_tool_calls'):\n203\u2192             return await self.chat_client.extract_tool_calls(chunks)\n204\u2192 \n205\u2192         # Fallback: implement extraction here\n206\u2192         import json\n207\u2192 \n208\u2192         tool_calls: list[dict] = []\n209\u2192         current_tool: dict[str, Any] | None = None\n210\u2192         accumulated_json: list[str] = []\n211\u2192 \n212\u2192         for chunk in chunks:\n213\u2192             # Check for ContentBlockStart with tool_use\n214\u2192             if hasattr(chunk, 'type') and chunk.type == \"tool_use\":\n215\u2192                 current_tool = {\n216\u2192                     \"id\": getattr(chunk, 'id', ''),\n217\u2192                     \"name\": getattr(chunk, 'name', ''),\n218\u2192                     \"input\": {},\n219\u2192                 }\n220\u2192                 accumulated_json = []\n221\u2192 \n222\u2192             # Check for ContentBlockDelta with partial JSON\n223\u2192             elif hasattr(chunk, 'type') and chunk.type == \"input_json_delta\":\n224\u2192                 if hasattr(chunk, 'partial_json') and chunk.partial_json:\n225\u2192                     accumulated_json.append(chunk.partial_json)\n226\u2192 \n227\u2192             # Check for ContentBlockStop\n228\u2192             elif hasattr(chunk, 'type') and chunk.type == \"content_block_stop\":\n229\u2192                 if current_tool is not None and accumulated_json:\n230\u2192                     try:\n231\u2192                         json_str = \"\".join(accumulated_json)\n232\u2192                         current_tool[\"input\"] = json.loads(json_str)\n233\u2192                     except json.JSONDecodeError:\n234\u2192                         current_tool[\"input\"] = {\"raw\": \"\".join(accumulated_json)}\n235\u2192                     tool_calls.append(current_tool)\n236\u2192                     current_tool = None\n237\u2192                     accumulated_json = []\n238\u2192 \n239\u2192         # Alternative extraction path using ContentBlockStart type\n240\u2192         for chunk in chunks:\n241\u2192             if hasattr(chunk, 'type') and hasattr(chunk, 'index'):\n242\u2192                 if chunk.type == \"tool_use\" and not any(\n243\u2192                     tc.get('id') == getattr(chunk, 'id', '') for tc in tool_calls\n244\u2192                 ):\n245\u2192                     new_tool = {\n246\u2192                         \"id\": getattr(chunk, 'id', ''),\n247\u2192                         \"name\": getattr(chunk, 'name', ''),\n248\u2192                         \"input\": {},\n249\u2192                     }\n250\u2192                     # Find corresponding input_json_delta chunks\n251\u2192                     for c in chunks:\n252\u2192                         if (hasattr(c, 'index') and c.index == chunk.index and\n253\u2192                             hasattr(c, 'type') and c.type == \"input_json_delta\"):\n254\u2192                             if hasattr(c, 'partial_json') and c.partial_json:\n255\u2192                                 try:\n256\u2192                                     current = new_tool[\"input\"].get(\"_partial\", \"\")\n257\u2192                                     current += c.partial_json\n258\u2192                                     new_tool[\"input\"] = json.loads(current)\n259\u2192                                 except json.JSONDecodeError:\n260\u2192                                     new_tool[\"input\"] = {\"_partial\": current + c.partial_json}\n261\u2192                     if new_tool not in tool_calls:\n262\u2192                         tool_calls.append(new_tool)\n263\u2192 \n264\u2192         return tool_calls\n265\u2192 \n266\u2192     async def _execute_tool_call(self, tool_call: dict) -> str:\n267\u2192         \"\"\"Execute a single tool call and return result.\n268\u2192 \n269\u2192         This handles:\n270\u2192         - Finding the tool by name\n271\u2192         - Executing with timeout\n272\u2192         - Catching and formatting errors\n273\u2192 \n274\u2192         Args:\n275\u2192             tool_call: Tool call dict with id, name, and input\n276\u2192 \n277\u2192         Returns:\n278\u2192             String result to send back to API\n279\u2192 \n280\u2192         Acceptance Criteria:\n281\u2192         - AC 5: Tool results formatted for API\n282\u2192         - AC 6: Tool errors caught and formatted\n283\u2192         - AC 7: Tool timeouts handled\n284\u2192         \"\"\"\n285\u2192         tool_name = tool_call.get('name', '')\n286\u2192         tool = self.tool_registry.get(tool_name)\n287\u2192 \n288\u2192         if tool is None:\n289\u2192             available = \", \".join(sorted(self.tool_registry.tool_names)) or \"none\"\n290\u2192             return f\"Tool '{tool_name}' not found. Available tools: {available}.\"\n291\u2192 \n292\u2192         try:\n293\u2192             # Execute with timeout (AC 7)\n294\u2192             result = await asyncio.wait_for(\n295\u2192                 tool.execute(**tool_call.get('input', {})),\n296\u2192                 timeout=300,  # 5 minutes\n297\u2192             )\n298\u2192             return str(result)\n299\u2192 \n300\u2192         except asyncio.TimeoutError:\n301\u2192             return (\n302\u2192                 f\"Tool '{tool_name}' timed out after 300 seconds. \"\n303\u2192                 \"Try a smaller input or break the task into smaller steps.\"\n304\u2192             )\n305\u2192         except Exception as e:\n306\u2192             logger.error(f\"Tool {tool_name} failed: {e}\")\n307\u2192             return self._format_tool_error(tool_name, e)\n308\u2192 \n309\u2192     def __repr__(self) -> str:\n310\u2192         \"\"\"Return string representation of AgentCore.\"\"\"\n311\u2192         return f\"AgentCore(config={self.config!r}, messages={self.history.message_count})\"\n312\u2192 \n313\u2192     def _format_tool_error(self, tool_name: str, error: Exception) -> str:\n314\u2192         \"\"\"Return a user-facing tool error message.\"\"\"\n315\u2192         if isinstance(error, ToolInputError):\n316\u2192             return f\"Tool '{tool_name}' received invalid input: {error}. Check the required fields and try again.\"\n317\u2192         if isinstance(error, PermissionError):\n318\u2192             return f\"Tool '{tool_name}' failed due to permission denied: {error}. Check file permissions and retry.\"\n319\u2192         if isinstance(error, FileNotFoundError):\n320\u2192             return f\"Tool '{tool_name}' could not find the requested file: {error}. Verify the path and retry.\"\n321\u2192         if isinstance(error, ToolError):\n322\u2192             return f\"Tool '{tool_name}' failed: {error}\"\n323\u2192         return f\"Tool '{tool_name}' failed: {error}\"\n324\u2192 \n325\u2192     def _format_agent_error(self, error: Exception) -> str:\n326\u2192         \"\"\"Return a user-facing assistant error message.\"\"\"\n327\u2192         if isinstance(error, AuthError):\n328\u2192             return f\"Authentication error: {error.message} {error.help or ''}\".strip()\n329\u2192         if isinstance(error, TimeoutError):\n330\u2192             return f\"Request timed out. {error.help or 'Try again.'}\".strip()\n331\u2192         if isinstance(error, NetworkError):\n332\u2192             return f\"Network error: {error.message} {error.help or ''}\".strip()\n333\u2192         if isinstance(error, ApiError):\n334\u2192             help_text = f\" {error.help}\" if error.help else \"\"\n335\u2192             return f\"API error ({error.statusCode}): {error.message}.{help_text}\".strip()\n336\u2192         if isinstance(error, ZaiError):\n337\u2192             help_text = f\" {error.help}\" if error.help else \"\"\n338\u2192             return f\"{error.message}.{help_text}\".strip()\n339\u2192         return f\"Unexpected error: {error}\"", "is_error": false}}
