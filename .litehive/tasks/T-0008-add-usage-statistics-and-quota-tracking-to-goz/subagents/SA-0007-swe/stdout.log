{"type": "tool_use", "part": {"id": "call_72e93df4d7604ed3addd1484", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/errors.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/errors.py (220 lines)\n============================================================\n\n  1\u2192 \"\"\"Error types for Z.AI API client.\n  2\u2192 \n  3\u2192 These error types are used throughout the API client for consistent error handling.\n  4\u2192 \"\"\"\n  5\u2192 \n  6\u2192 from __future__ import annotations\n  7\u2192 \n  8\u2192 \n  9\u2192 \n 10\u2192 class ZaiError(Exception):\n 11\u2192     \"\"\"Base error class for all Z.AI API errors.\n 12\u2192 \n 13\u2192     Attributes:\n 14\u2192         message: Human-readable error message\n 15\u2192         code: Error code for programmatic handling\n 16\u2192         statusCode: HTTP status code (optional)\n 17\u2192         help: Helpful hint for resolving the error (optional)\n 18\u2192     \"\"\"\n 19\u2192 \n 20\u2192     def __init__(\n 21\u2192         self,\n 22\u2192         message: str,\n 23\u2192         code: str = \"ZAI_ERROR\",\n 24\u2192         statusCode: int | None = None,\n 25\u2192         help: str | None = None,\n 26\u2192     ) -> None:\n 27\u2192         \"\"\"Initialize ZaiError.\n 28\u2192 \n 29\u2192         Args:\n 30\u2192             message: Human-readable error message\n 31\u2192             code: Error code for programmatic handling\n 32\u2192             statusCode: HTTP status code (optional)\n 33\u2192             help: Helpful hint for resolving the error (optional)\n 34\u2192         \"\"\"\n 35\u2192         self.message = message\n 36\u2192         self.code = code\n 37\u2192         self.statusCode = statusCode\n 38\u2192         self.help = help\n 39\u2192         super().__init__(self.message)\n 40\u2192 \n 41\u2192     def __str__(self) -> str:\n 42\u2192         \"\"\"Return string representation showing error code and message.\"\"\"\n 43\u2192         return f\"[{self.code}] {self.message}\"\n 44\u2192 \n 45\u2192     def __repr__(self) -> str:\n 46\u2192         \"\"\"Return detailed string representation.\"\"\"\n 47\u2192         return (\n 48\u2192             f\"{self.__class__.__name__}(message={self.message!r}, code={self.code!r}, \"\n 49\u2192             f\"statusCode={self.statusCode!r}, help={self.help!r})\"\n 50\u2192         )\n 51\u2192 \n 52\u2192 \n 53\u2192 class AuthError(ZaiError):\n 54\u2192     \"\"\"Authentication/authorization error (401, 403).\n 55\u2192 \n 56\u2192     This error is raised when the API token is invalid, expired, or missing.\n 57\u2192     \"\"\"\n 58\u2192 \n 59\u2192     def __init__(self, message: str, statusCode: int = 401) -> None:\n 60\u2192         \"\"\"Initialize AuthError.\n 61\u2192 \n 62\u2192         Args:\n 63\u2192             message: Human-readable error message\n 64\u2192             statusCode: HTTP status code (default: 401)\n 65\u2192         \"\"\"\n 66\u2192         super().__init__(\n 67\u2192             message=message,\n 68\u2192             code=\"AUTH_ERROR\",\n 69\u2192             statusCode=statusCode,\n 70\u2192             help=\"Authentication failed. Check your API key in ~/.config/goz/config.json. \"\n 71\u2192             \"Run 'goz config set zai_token <your-token>' to update.\",\n 72\u2192         )\n 73\u2192 \n 74\u2192 \n 75\u2192 class ApiError(ZaiError):\n 76\u2192     \"\"\"General API error (4xx, 5xx responses).\n 77\u2192 \n 78\u2192     This error is raised for API errors that are not authentication-related.\n 79\u2192     \"\"\"\n 80\u2192 \n 81\u2192     def __init__(self, message: str, statusCode: int = 500) -> None:\n 82\u2192         \"\"\"Initialize ApiError.\n 83\u2192 \n 84\u2192         Args:\n 85\u2192             message: Human-readable error message\n 86\u2192             statusCode: HTTP status code (default: 500)\n 87\u2192         \"\"\"\n 88\u2192         super().__init__(\n 89\u2192             message=message,\n 90\u2192             code=\"API_ERROR\",\n 91\u2192             statusCode=statusCode,\n 92\u2192             help=self._default_help(statusCode),\n 93\u2192         )\n 94\u2192 \n 95\u2192     @staticmethod\n 96\u2192     def _default_help(status_code: int) -> str:\n 97\u2192         \"\"\"Return actionable guidance based on HTTP status code.\"\"\"\n 98\u2192         if status_code == 429:\n 99\u2192             return \"Rate limit hit. Wait a moment before retrying, or reduce request volume.\"\n100\u2192         if status_code >= 500:\n101\u2192             return \"The service is having problems. Retry shortly; if it persists, try again later.\"\n102\u2192         return \"Check the request input and try again.\"\n103\u2192 \n104\u2192 \n105\u2192 class NetworkError(ZaiError):\n106\u2192     \"\"\"Network connection error.\n107\u2192 \n108\u2192     This error is raised when the client cannot connect to the API server.\n109\u2192     \"\"\"\n110\u2192 \n111\u2192     def __init__(self, message: str) -> None:\n112\u2192         \"\"\"Initialize NetworkError.\n113\u2192 \n114\u2192         Args:\n115\u2192             message: Human-readable error message\n116\u2192         \"\"\"\n117\u2192         super().__init__(\n118\u2192             message=message,\n119\u2192             code=\"NETWORK_ERROR\",\n120\u2192             help=\"Network connection failed. Check your internet connection and try again.\",\n121\u2192         )\n122\u2192 \n123\u2192 \n124\u2192 class TimeoutError(ZaiError):\n125\u2192     \"\"\"Request timeout error.\n126\u2192 \n127\u2192     This error is raised when the API request takes too long to complete.\n128\u2192     \"\"\"\n129\u2192 \n130\u2192     def __init__(self, timeoutMs: int) -> None:\n131\u2192         \"\"\"Initialize TimeoutError.\n132\u2192 \n133\u2192         Args:\n134\u2192             timeoutMs: Timeout value in milliseconds\n135\u2192         \"\"\"\n136\u2192         super().__init__(\n137\u2192             message=f\"Request timed out after {timeoutMs}ms\",\n138\u2192             code=\"TIMEOUT_ERROR\",\n139\u2192             help=\"Try again or increase timeout with Z_AI_TIMEOUT env var\",\n140\u2192         )\n141\u2192 \n142\u2192 \n143\u2192 class ValidationError(ZaiError):\n144\u2192     \"\"\"Validation error for invalid input parameters.\n145\u2192 \n146\u2192     This error is raised when input validation fails, such as invalid URLs,\n147\u2192     invalid format values, or other parameter validation issues.\n148\u2192     \"\"\"\n149\u2192 \n150\u2192     def __init__(self, message: str) -> None:\n151\u2192         \"\"\"Initialize ValidationError.\n152\u2192 \n153\u2192         Args:\n154\u2192             message: Human-readable error message describing the validation failure\n155\u2192         \"\"\"\n156\u2192         super().__init__(\n157\u2192             message=message,\n158\u2192             code=\"VALIDATION_ERROR\",\n159\u2192             help=\"Check your input parameters and try again.\",\n160\u2192         )\n161\u2192 \n162\u2192 \n163\u2192 # Z.AI quota/rate-limit error codes\n164\u2192 QUOTA_ERROR_CODES = {\n165\u2192     1302: \"QuotaExceededError\",\n166\u2192     1305: \"RateLimitError\",\n167\u2192     1308: \"TokenBudgetExceededError\",\n168\u2192     1310: \"ConcurrentRequestLimitError\",\n169\u2192 }\n170\u2192 \n171\u2192 QUOTA_ERROR_DESCRIPTIONS = {\n172\u2192     1302: \"API quota exceeded. Your usage has reached the plan limit.\",\n173\u2192     1305: \"Rate limit hit. Too many requests in a short time window.\",\n174\u2192     1308: \"Token budget exceeded for this billing period.\",\n175\u2192     1310: \"Concurrent request limit reached. Wait for in-flight requests to finish.\",\n176\u2192 }\n177\u2192 \n178\u2192 QUOTA_ERROR_HELP = {\n179\u2192     1302: \"Check your usage with 'goz usage' and consider upgrading your plan.\",\n180\u2192     1305: \"Wait a moment before retrying, or reduce request volume.\",\n181\u2192     1308: \"Reduce token usage or wait for the next billing period to reset.\",\n182\u2192     1310: \"Wait for current requests to finish before sending new ones.\",\n183\u2192 }\n184\u2192 \n185\u2192 \n186\u2192 class QuotaError(ZaiError):\n187\u2192     \"\"\"Quota or rate-limit error from Z.AI (error codes 1302/1305/1308/1310).\n188\u2192 \n189\u2192     This error is raised when the Z.AI API returns a quota-related error code,\n190\u2192     indicating that usage limits have been exceeded.\n191\u2192     \"\"\"\n192\u2192 \n193\u2192     def __init__(self, message: str, zai_code: int = 1302, statusCode: int = 429) -> None:\n194\u2192         \"\"\"Initialize QuotaError.\n195\u2192 \n196\u2192         Args:\n197\u2192             message: Human-readable error message from the API\n198\u2192             zai_code: Z.AI-specific error code (1302, 1305, 1308, or 1310)\n199\u2192             statusCode: HTTP status code (typically 429)\n200\u2192         \"\"\"\n201\u2192         code_name = QUOTA_ERROR_CODES.get(zai_code, \"QUOTA_ERROR\")\n202\u2192         help_text = QUOTA_ERROR_HELP.get(zai_code, \"Check your usage with 'goz usage'.\")\n203\u2192         super().__init__(\n204\u2192             message=message,\n205\u2192             code=code_name,\n206\u2192             statusCode=statusCode,\n207\u2192             help=help_text,\n208\u2192         )\n209\u2192         self.zai_code = zai_code\n210\u2192 \n211\u2192 \n212\u2192 def is_quota_error(error: ZaiError) -> bool:\n213\u2192     \"\"\"Check if an error is a quota-related error (codes 1302/1305/1308/1310).\"\"\"\n214\u2192     if isinstance(error, QuotaError):\n215\u2192         return True\n216\u2192     # Also check if a generic error carries a quota code in its message\n217\u2192     for code in QUOTA_ERROR_CODES:\n218\u2192         if f\"[{code}]\" in str(error) or f\"code {code}\" in str(error).lower():\n219\u2192             return True\n220\u2192     return False", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_b705f70ea69a488bbee806c0", "name": "view_file", "input": {"file_path": "/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/__main__.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/__main__.py (1031 lines)\n============================================================\n\n   1\u2192 \"\"\"Main entry point for the goz CLI.\"\"\"\n   2\u2192 \n   3\u2192 import asyncio\n   4\u2192 import json\n   5\u2192 import itertools\n   6\u2192 import sys\n   7\u2192 import threading\n   8\u2192 import time\n   9\u2192 from pathlib import Path\n  10\u2192 \n  11\u2192 from goz import __version__\n  12\u2192 \n  13\u2192 \n  14\u2192 def _show_thinking_animation(stop_event: threading.Event) -> None:\n  15\u2192     \"\"\"Show a \"thinking\" animation in a separate thread.\n  16\u2192 \n  17\u2192     Args:\n  18\u2192         stop_event: Threading event to stop the animation\n  19\u2192     \"\"\"\n  20\u2192     animation = [\"|\", \"/\", \"-\", \"\\\\\"]\n  21\u2192     try:\n  22\u2192         for frame in itertools.cycle(animation):\n  23\u2192             if stop_event.is_set():\n  24\u2192                 break\n  25\u2192             # Print the animation frame with carriage return to overwrite\n  26\u2192             print(f\"\\r{frame} Thinking...\", end=\"\", flush=True)\n  27\u2192             time.sleep(0.1)\n  28\u2192     finally:\n  29\u2192         # Clear the animation line when done\n  30\u2192         print(\"\\r\" + \" \" * 20 + \"\\r\", end=\"\", flush=True)\n  31\u2192 \n  32\u2192 \n  33\u2192 def _print_json(data: object) -> None:\n  34\u2192     \"\"\"Print JSON with stable formatting.\"\"\"\n  35\u2192     print(json.dumps(data, indent=2, ensure_ascii=True))\n  36\u2192 \n  37\u2192 \n  38\u2192 def _load_json_value(raw_value: str) -> object:\n  39\u2192     \"\"\"Load JSON from an inline value or @file reference.\"\"\"\n  40\u2192     source = raw_value\n  41\u2192     if raw_value.startswith(\"@\"):\n  42\u2192         source = Path(raw_value[1:]).read_text()\n  43\u2192 \n  44\u2192     try:\n  45\u2192         return json.loads(source)\n  46\u2192     except json.JSONDecodeError as e:\n  47\u2192         raise ValueError(f\"Invalid JSON: {e}\") from e\n  48\u2192 \n  49\u2192 \n  50\u2192 def _load_call_arguments(json_arg: str | None, use_stdin: bool) -> dict:\n  51\u2192     \"\"\"Resolve call arguments from --json or --stdin.\"\"\"\n  52\u2192     if json_arg is not None and use_stdin:\n  53\u2192         raise ValueError(\"Use either --json or --stdin, not both\")\n  54\u2192 \n  55\u2192     if json_arg is None and not use_stdin:\n  56\u2192         return {}\n  57\u2192 \n  58\u2192     payload = _load_json_value(sys.stdin.read() if use_stdin else json_arg or \"{}\")\n  59\u2192     if not isinstance(payload, dict):\n  60\u2192         raise ValueError(\"Tool arguments must be a JSON object\")\n  61\u2192     return payload\n  62\u2192 \n  63\u2192 \n  64\u2192 async def cmd_vision(args: list[str]) -> None:\n  65\u2192     \"\"\"Handle the `goz vision` command.\n  66\u2192 \n  67\u2192     Usage:\n  68\u2192         goz vision <image> [prompt]           - Analyze image (default)\n  69\u2192         goz vision analyze <image> [prompt]   - General analysis\n  70\u2192         goz vision ui-to-code <image>         - Convert UI to code\n  71\u2192         goz vision extract-text <image>       - OCR text extraction\n  72\u2192         goz vision diagnose-error <image>     - Diagnose error screenshot\n  73\u2192         goz vision diagram <image>            - Explain diagram\n  74\u2192         goz vision chart <image>              - Analyze chart\n  75\u2192         goz vision diff <expected> <actual>   - Compare images\n  76\u2192         goz vision video <video> [prompt]     - Analyze video\n  77\u2192 \n  78\u2192     Options:\n  79\u2192         --no-stream     - Disable streaming (wait for full response)\n  80\u2192         --output <type> - Output type for ui-to-code (code, prompt, spec, description)\n  81\u2192         --language <lang> - Programming language for extract-text\n  82\u2192         --context <ctx> - Error context for diagnose-error\n  83\u2192         --type <type>   - Diagram type\n  84\u2192         --focus <focus> - Chart focus (trends, anomalies, comparisons, insights)\n  85\u2192 \n  86\u2192     Args:\n  87\u2192         args: Command arguments\n  88\u2192     \"\"\"\n  89\u2192 \n  90\u2192     # Check for help flag\n  91\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n  92\u2192         print(\"\"\"Vision command usage:\n  93\u2192 \n  94\u2192   goz vision <image> [prompt]           - Analyze image (default)\n  95\u2192   goz vision analyze <image> [prompt]   - General image analysis\n  96\u2192   goz vision ui-to-code <image>         - Convert UI to code\n  97\u2192   goz vision extract-text <image>       - Extract text (OCR)\n  98\u2192   goz vision diagnose-error <image>     - Diagnose error screenshot\n  99\u2192   goz vision diagram <image>            - Explain technical diagram\n 100\u2192   goz vision chart <image>              - Analyze data visualization\n 101\u2192   goz vision diff <expected> <actual>   - Compare two screenshots\n 102\u2192   goz vision video <video> [prompt]     - Analyze video content\n 103\u2192 \n 104\u2192 Options:\n 105\u2192   --no-stream           - Disable streaming output\n 106\u2192   --output <type>       - ui-to-code output (code, prompt, spec, description)\n 107\u2192   --language <lang>     - Programming language for extract-text\n 108\u2192   --context <ctx>       - Error context for diagnose-error\n 109\u2192   --type <type>         - Diagram type (flowchart, sequence, architecture, etc.)\n 110\u2192   --focus <focus>       - Chart focus (trends, anomalies, comparisons, insights)\n 111\u2192 \n 112\u2192 File constraints:\n 113\u2192   Images: 5MB max (JPG, PNG, JPEG)\n 114\u2192   Videos: 8MB max (MP4, MOV, M4V)\n 115\u2192 \"\"\")\n 116\u2192         return\n 117\u2192 \n 118\u2192     from goz.api.vision import VisionClient\n 119\u2192     from goz.config import load_config\n 120\u2192 \n 121\u2192     config = load_config()\n 122\u2192     client = VisionClient(config=config)\n 123\u2192 \n 124\u2192     # Parse flags and positional args\n 125\u2192     flags = {}\n 126\u2192     positional = []\n 127\u2192 \n 128\u2192     i = 0\n 129\u2192     while i < len(args):\n 130\u2192         arg = args[i]\n 131\u2192         if arg.startswith(\"--\"):\n 132\u2192             key = arg[2:]\n 133\u2192             # Check if next arg is a value (not a flag)\n 134\u2192             if i + 1 < len(args) and not args[i + 1].startswith(\"-\"):\n 135\u2192                 flags[key] = args[i + 1]\n 136\u2192                 i += 2\n 137\u2192             else:\n 138\u2192                 flags[key] = True\n 139\u2192                 i += 1\n 140\u2192         elif arg.startswith(\"-\") and len(arg) == 2:\n 141\u2192             key = arg[1:]\n 142\u2192             if i + 1 < len(args) and not args[i + 1].startswith(\"-\"):\n 143\u2192                 flags[key] = args[i + 1]\n 144\u2192                 i += 2\n 145\u2192             else:\n 146\u2192                 flags[key] = True\n 147\u2192                 i += 1\n 148\u2192         else:\n 149\u2192             positional.append(arg)\n 150\u2192             i += 1\n 151\u2192 \n 152\u2192     # Determine mode and source\n 153\u2192     mode = \"analyze\"  # Default mode\n 154\u2192     source1 = None\n 155\u2192     source2 = None\n 156\u2192     prompt = None\n 157\u2192 \n 158\u2192     # Check if first positional arg is a known subcommand\n 159\u2192     known_modes = {\n 160\u2192         \"analyze\",\n 161\u2192         \"ui-to-code\",\n 162\u2192         \"extract-text\",\n 163\u2192         \"diagnose-error\",\n 164\u2192         \"diagram\",\n 165\u2192         \"chart\",\n 166\u2192         \"diff\",\n 167\u2192         \"video\",\n 168\u2192     }\n 169\u2192 \n 170\u2192     if positional[0] in known_modes:\n 171\u2192         mode = positional[0]\n 172\u2192         source1 = positional[1] if len(positional) > 1 else None\n 173\u2192 \n 174\u2192         if mode == \"diff\":\n 175\u2192             source2 = positional[2] if len(positional) > 2 else None\n 176\u2192             prompt = positional[3] if len(positional) > 3 else None\n 177\u2192         else:\n 178\u2192             prompt = positional[2] if len(positional) > 2 else None\n 179\u2192     else:\n 180\u2192         # Old behavior: first arg is source\n 181\u2192         source1 = positional[0]\n 182\u2192         prompt = positional[1] if len(positional) > 1 else None\n 183\u2192 \n 184\u2192     # Validate we have a source\n 185\u2192     if not source1:\n 186\u2192         print(\"Error: Missing image/video source\", file=sys.stderr)\n 187\u2192         print(\"Run 'goz vision --help' for usage\", file=sys.stderr)\n 188\u2192         sys.exit(1)\n 189\u2192 \n 190\u2192     if mode == \"diff\" and not source2:\n 191\u2192         print(\"Error: diff mode requires two sources: <expected> <actual>\", file=sys.stderr)\n 192\u2192         sys.exit(1)\n 193\u2192 \n 194\u2192     # Build prompt based on mode\n 195\u2192     default_prompts = {\n 196\u2192         \"analyze\": \"Describe this image in detail.\",\n 197\u2192         \"ui-to-code\": \"Convert this UI to production-ready code.\",\n 198\u2192         \"extract-text\": \"Extract all text from this image.\",\n 199\u2192         \"diagnose-error\": \"Diagnose this error and suggest fixes.\",\n 200\u2192         \"diagram\": \"Explain this technical diagram.\",\n 201\u2192         \"chart\": \"Analyze this data visualization.\",\n 202\u2192         \"video\": \"Analyze this video content.\",\n 203\u2192     }\n 204\u2192 \n 205\u2192     effective_prompt = prompt or default_prompts.get(mode, \"Describe this image.\")\n 206\u2192 \n 207\u2192     # Enhance prompt with mode-specific options\n 208\u2192     output_type = flags.get(\"output\", \"code\")\n 209\u2192 \n 210\u2192     if mode == \"ui-to-code\" and output_type != \"code\":\n 211\u2192         if output_type == \"prompt\":\n 212\u2192             effective_prompt = (\n 213\u2192                 f\"{effective_prompt}\\n\\n\"\n 214\u2192                 f\"Provide a detailed prompt that would generate this UI, \"\n 215\u2192                 f\"including layout, components, styling, and functionality.\"\n 216\u2192             )\n 217\u2192         elif output_type == \"spec\":\n 218\u2192             effective_prompt = (\n 219\u2192                 f\"{effective_prompt}\\n\\n\"\n 220\u2192                 f\"Provide a technical specification including components, \"\n 221\u2192                 f\"props, state management, and styling approach.\"\n 222\u2192             )\n 223\u2192         elif output_type == \"description\":\n 224\u2192             effective_prompt = (\n 225\u2192                 f\"{effective_prompt}\\n\\n\"\n 226\u2192                 f\"Provide a detailed description of the UI layout, \"\n 227\u2192                 f\"components, colors, and interactions without generating code.\"\n 228\u2192             )\n 229\u2192 \n 230\u2192     if mode == \"extract-text\" and flags.get(\"language\"):\n 231\u2192         effective_prompt = (\n 232\u2192             f\"{effective_prompt}\\n\\n\"\n 233\u2192             f\"The content is in {flags['language']}. Preserve code syntax and formatting.\"\n 234\u2192         )\n 235\u2192 \n 236\u2192     if mode == \"diagnose-error\" and flags.get(\"context\"):\n 237\u2192         effective_prompt = (\n 238\u2192             f\"{effective_prompt}\\n\\n\"\n 239\u2192             f\"Context: {flags['context']}\\n\\n\"\n 240\u2192             f\"Consider this context when diagnosing the error.\"\n 241\u2192         )\n 242\u2192 \n 243\u2192     if mode == \"diagram\" and flags.get(\"type\"):\n 244\u2192         effective_prompt = (\n 245\u2192             f\"{effective_prompt}\\n\\nThis is a {flags['type']} diagram. Use appropriate terminology.\"\n 246\u2192         )\n 247\u2192 \n 248\u2192     if mode == \"chart\" and flags.get(\"focus\"):\n 249\u2192         focus_prompts = {\n 250\u2192             \"trends\": \"Focus on identifying trends and patterns over time.\",\n 251\u2192             \"anomalies\": \"Focus on identifying anomalies, outliers, and unusual data points.\",\n 252\u2192             \"comparisons\": \"Focus on comparing different data series and values.\",\n 253\u2192             \"insights\": \"Focus on extracting key insights and actionable conclusions.\",\n 254\u2192         }\n 255\u2192         focus_prompt = focus_prompts.get(flags[\"focus\"], \"\")\n 256\u2192         if focus_prompt:\n 257\u2192             effective_prompt = f\"{effective_prompt}\\n\\n{focus_prompt}\"\n 258\u2192 \n 259\u2192     # Determine if streaming\n 260\u2192     no_stream = flags.get(\"no-stream\", False)\n 261\u2192 \n 262\u2192     try:\n 263\u2192         if mode == \"diff\":\n 264\u2192             # For diff, analyze both images and compare\n 265\u2192             if no_stream:\n 266\u2192                 result1 = await client.analyze(source1, \"Describe this image in detail.\")\n 267\u2192                 result2 = await client.analyze(source2, \"Describe this image in detail.\")\n 268\u2192                 print(f\"Expected Image:\\n{result1}\\n\\n\")\n 269\u2192                 print(f\"Actual Image:\\n{result2}\\n\\n\")\n 270\u2192                 print(\"Note: Use the vision diff command for precise visual comparison.\")\n 271\u2192             else:\n 272\u2192                 print(\"Analyzing expected image...\", file=sys.stderr)\n 273\u2192                 async for chunk in client.analyze_stream(source1, \"Describe this image in detail.\"):\n 274\u2192                     print(chunk, end=\"\", flush=True)\n 275\u2192                 print(\"\\n\\nAnalyzing actual image...\", file=sys.stderr)\n 276\u2192                 async for chunk in client.analyze_stream(source2, \"Describe this image in detail.\"):\n 277\u2192                     print(chunk, end=\"\", flush=True)\n 278\u2192                 print(\"\\n\\nNote: Use the vision diff command for precise visual comparison.\")\n 279\u2192         else:\n 280\u2192             if no_stream:\n 281\u2192                 result = await client.analyze(source1, effective_prompt)\n 282\u2192                 print(result)\n 283\u2192             else:\n 284\u2192                 # Show \"thinking\" animation while waiting for first chunk\n 285\u2192                 import threading\n 286\u2192 \n 287\u2192                 stop_animation = threading.Event()\n 288\u2192                 animation_thread = threading.Thread(\n 289\u2192                     target=_show_thinking_animation, args=(stop_animation,), daemon=True\n 290\u2192                 )\n 291\u2192                 animation_thread.start()\n 292\u2192 \n 293\u2192                 # Stream response\n 294\u2192                 first_chunk = True\n 295\u2192                 async for chunk in client.analyze_stream(source1, effective_prompt):\n 296\u2192                     if first_chunk:\n 297\u2192                         # Stop animation on first chunk\n 298\u2192                         stop_animation.set()\n 299\u2192                         animation_thread.join(timeout=0.2)\n 300\u2192                         first_chunk = False\n 301\u2192                     print(chunk, end=\"\", flush=True)\n 302\u2192                 print()  # New line after streaming completes\n 303\u2192                 if first_chunk:\n 304\u2192                     # In case no chunks were received\n 305\u2192                     stop_animation.set()\n 306\u2192                     animation_thread.join(timeout=0.2)\n 307\u2192     except Exception as e:\n 308\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 309\u2192         sys.exit(1)\n 310\u2192 \n 311\u2192 \n 312\u2192 async def cmd_search(args: list[str]) -> None:\n 313\u2192     \"\"\"Handle the `goz search` command.\n 314\u2192 \n 315\u2192     Usage:\n 316\u2192         goz search <query> [options]\n 317\u2192 \n 318\u2192     Options:\n 319\u2192         --count, -c N       - Number of results (default: 10)\n 320\u2192         --domain, -d DOMAIN - Filter to domain\n 321\u2192         --recency, -r R     - Time filter (oneDay, oneWeek, oneMonth, oneYear, noLimit)\n 322\u2192 \n 323\u2192     Args:\n 324\u2192         args: Command arguments\n 325\u2192     \"\"\"\n 326\u2192     import argparse\n 327\u2192 \n 328\u2192     # Check for help\n 329\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 330\u2192         print(\"\"\"Search command usage:\n 331\u2192 \n 332\u2192   goz search <query> [options]\n 333\u2192 \n 334\u2192 Options:\n 335\u2192   --count, -c N         Number of results to return (default: 10)\n 336\u2192   --domain, -d DOMAIN   Filter results to specific domain\n 337\u2192   --recency, -r R       Time filter:\n 338\u2192                         - oneDay: Results from last 24 hours\n 339\u2192                         - oneWeek: Results from last week\n 340\u2192                         - oneMonth: Results from last month\n 341\u2192                         - oneYear: Results from last year\n 342\u2192                         - noLimit: No time restriction\n 343\u2192 \n 344\u2192 Examples:\n 345\u2192   goz search \"python async await\"\n 346\u2192   goz search \"climate change\" --count 5\n 347\u2192   goz search \"AI news\" --domain news.ycombinator.com --recency oneWeek\n 348\u2192 \"\"\")\n 349\u2192         return\n 350\u2192 \n 351\u2192     parser = argparse.ArgumentParser(prog=\"goz search\", add_help=False)\n 352\u2192     parser.add_argument(\"query\", help=\"Search query\")\n 353\u2192     parser.add_argument(\"--count\", \"-c\", type=int, help=\"Number of results\")\n 354\u2192     parser.add_argument(\"--domain\", \"-d\", help=\"Filter to domain\")\n 355\u2192     parser.add_argument(\n 356\u2192         \"--recency\",\n 357\u2192         \"-r\",\n 358\u2192         choices=[\"oneDay\", \"oneWeek\", \"oneMonth\", \"oneYear\", \"noLimit\"],\n 359\u2192         help=\"Time filter\",\n 360\u2192     )\n 361\u2192 \n 362\u2192     parsed = parser.parse_args(args)\n 363\u2192 \n 364\u2192     from goz.api.search import SearchClient\n 365\u2192     from goz.config import load_config\n 366\u2192 \n 367\u2192     config = load_config()\n 368\u2192     client = SearchClient(config=config)\n 369\u2192 \n 370\u2192     try:\n 371\u2192         results = await client.search(\n 372\u2192             query=parsed.query,\n 373\u2192             count=parsed.count,\n 374\u2192             domain_filter=parsed.domain,\n 375\u2192             recency_filter=parsed.recency,\n 376\u2192         )\n 377\u2192         for r in results:\n 378\u2192             print(f\"{r.rank}. {r.title}\")\n 379\u2192             print(f\"   {r.url}\")\n 380\u2192             if r.summary:\n 381\u2192                 print(f\"   {r.summary[:100]}...\")\n 382\u2192             print()\n 383\u2192     except Exception as e:\n 384\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 385\u2192         sys.exit(1)\n 386\u2192 \n 387\u2192 \n 388\u2192 async def cmd_read(args: list[str]) -> None:\n 389\u2192     \"\"\"Handle the `goz read` command.\n 390\u2192 \n 391\u2192     Usage:\n 392\u2192         goz read <url> [options]\n 393\u2192 \n 394\u2192     Options:\n 395\u2192         --format, -f FMT  - Output format (markdown, text)\n 396\u2192         --timeout, -t N   - Timeout in seconds (default: 20)\n 397\u2192 \n 398\u2192     Args:\n 399\u2192         args: Command arguments\n 400\u2192     \"\"\"\n 401\u2192     import argparse\n 402\u2192 \n 403\u2192     # Check for help\n 404\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 405\u2192         print(\"\"\"Read command usage:\n 406\u2192 \n 407\u2192   goz read <url> [options]\n 408\u2192 \n 409\u2192 Options:\n 410\u2192   --format, -f FMT    Output format:\n 411\u2192                       - markdown: GitHub Flavored Markdown (default)\n 412\u2192                       - text: Plain text\n 413\u2192   --timeout, -t N     Request timeout in seconds (default: 20)\n 414\u2192 \n 415\u2192 Examples:\n 416\u2192   goz read https://example.com\n 417\u2192   goz read https://example.com --format text\n 418\u2192   goz read https://example.com --timeout 30\n 419\u2192 \"\"\")\n 420\u2192         return\n 421\u2192 \n 422\u2192     parser = argparse.ArgumentParser(prog=\"goz read\", add_help=False)\n 423\u2192     parser.add_argument(\"url\", help=\"URL to read\")\n 424\u2192     parser.add_argument(\n 425\u2192         \"--format\", \"-f\", choices=[\"markdown\", \"text\"], default=\"markdown\", help=\"Output format\"\n 426\u2192     )\n 427\u2192     parser.add_argument(\"--timeout\", \"-t\", type=int, help=\"Timeout in seconds\")\n 428\u2192 \n 429\u2192     parsed = parser.parse_args(args)\n 430\u2192 \n 431\u2192     from goz.api.reader import ReaderClient\n 432\u2192     from goz.config import load_config\n 433\u2192 \n 434\u2192     config = load_config()\n 435\u2192     client = ReaderClient(config=config)\n 436\u2192 \n 437\u2192     try:\n 438\u2192         result = await client.read(\n 439\u2192             url=parsed.url,\n 440\u2192             format=parsed.format,\n 441\u2192             timeout=parsed.timeout,\n 442\u2192         )\n 443\u2192         print(result.content)\n 444\u2192     except Exception as e:\n 445\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 446\u2192         sys.exit(1)\n 447\u2192 \n 448\u2192 \n 449\u2192 async def cmd_repo(args: list[str]) -> None:\n 450\u2192     \"\"\"Handle the `goz repo` command.\n 451\u2192 \n 452\u2192     Usage:\n 453\u2192         goz repo search <owner/repo> <query>\n 454\u2192         goz repo tree <owner/repo>\n 455\u2192         goz repo read <owner/repo> <file_path>\n 456\u2192 \n 457\u2192     Args:\n 458\u2192         args: Command arguments\n 459\u2192     \"\"\"\n 460\u2192     # Check for help or no args\n 461\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 462\u2192         print(\"\"\"Repo command usage:\n 463\u2192 \n 464\u2192   goz repo search <owner/repo> <query>   Search docs and code in repository\n 465\u2192   goz repo tree <owner/repo>             Get repository directory structure\n 466\u2192   goz repo read <owner/repo> <path>      Read a file from repository\n 467\u2192 \n 468\u2192 Search Options:\n 469\u2192   --language <lang>   Result language: en (default) or zh\n 470\u2192 \n 471\u2192 Tree Options:\n 472\u2192   --path <path>       Directory path to inspect (default: repo root)\n 473\u2192   --depth <n>         Expand subdirectory trees (default: 1)\n 474\u2192 \n 475\u2192 Examples:\n 476\u2192   goz repo search facebook/react \"server components\"\n 477\u2192   goz repo search vercel/next.js \"app router\" --language en\n 478\u2192   goz repo tree vercel/next.js\n 479\u2192   goz repo tree vercel/next.js --path packages --depth 2\n 480\u2192   goz repo read anthropics/anthropic-sdk-python README.md\n 481\u2192 \n 482\u2192 Notes:\n 483\u2192   - Repository must be public\n 484\u2192   - Use \"owner/repo\" format (e.g., \"facebook/react\")\n 485\u2192   - Paths are relative to repository root\n 486\u2192 \"\"\")\n 487\u2192         return\n 488\u2192 \n 489\u2192     subcommand = args[0]\n 490\u2192 \n 491\u2192     if subcommand == \"search\":\n 492\u2192         # goz repo search <owner/repo> <query> [--language <lang>]\n 493\u2192         if len(args) < 3:\n 494\u2192             print(\"Error: repo search requires <owner/repo> and <query>\", file=sys.stderr)\n 495\u2192             print(\n 496\u2192                 \"Usage: goz repo search <owner/repo> <query> [--language <lang>]\", file=sys.stderr\n 497\u2192             )\n 498\u2192             sys.exit(1)\n 499\u2192 \n 500\u2192         repo = args[1]\n 501\u2192         query = args[2]\n 502\u2192         language = None\n 503\u2192 \n 504\u2192         # Parse optional args\n 505\u2192         i = 3\n 506\u2192         while i < len(args):\n 507\u2192             if args[i] == \"--language\" and i + 1 < len(args):\n 508\u2192                 language = args[i + 1]\n 509\u2192                 i += 2\n 510\u2192             else:\n 511\u2192                 i += 1\n 512\u2192 \n 513\u2192         from goz.api.repo import RepoClient\n 514\u2192         from goz.config import load_config\n 515\u2192 \n 516\u2192         config = load_config()\n 517\u2192         client = RepoClient(config=config)\n 518\u2192 \n 519\u2192         try:\n 520\u2192             results = await client.search(repo, query, language)\n 521\u2192             for r in results:\n 522\u2192                 if r.title:\n 523\u2192                     print(f\"# {r.title}\")\n 524\u2192                 print(r.content)\n 525\u2192                 if r.url:\n 526\u2192                     print(f\"URL: {r.url}\")\n 527\u2192                 print()\n 528\u2192         except Exception as e:\n 529\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 530\u2192             sys.exit(1)\n 531\u2192 \n 532\u2192     elif subcommand == \"tree\":\n 533\u2192         # goz repo tree <owner/repo> [--path <path>] [--depth <n>]\n 534\u2192         if len(args) < 2:\n 535\u2192             print(\"Error: repo tree requires <owner/repo>\", file=sys.stderr)\n 536\u2192             print(\n 537\u2192                 \"Usage: goz repo tree <owner/repo> [--path <path>] [--depth <n>]\", file=sys.stderr\n 538\u2192             )\n 539\u2192             sys.exit(1)\n 540\u2192 \n 541\u2192         repo = args[1]\n 542\u2192         path = None\n 543\u2192         depth = 1\n 544\u2192 \n 545\u2192         # Parse optional args\n 546\u2192         i = 2\n 547\u2192         while i < len(args):\n 548\u2192             if args[i] == \"--path\" and i + 1 < len(args):\n 549\u2192                 path = args[i + 1]\n 550\u2192                 i += 2\n 551\u2192             elif args[i] == \"--depth\" and i + 1 < len(args):\n 552\u2192                 try:\n 553\u2192                     depth = int(args[i + 1])\n 554\u2192                 except ValueError:\n 555\u2192                     print(f\"Error: depth must be an integer, got '{args[i + 1]}'\", file=sys.stderr)\n 556\u2192                     sys.exit(1)\n 557\u2192                 i += 2\n 558\u2192             else:\n 559\u2192                 i += 1\n 560\u2192 \n 561\u2192         from goz.api.repo import RepoClient\n 562\u2192         from goz.config import load_config\n 563\u2192 \n 564\u2192         config = load_config()\n 565\u2192         client = RepoClient(config=config)\n 566\u2192 \n 567\u2192         try:\n 568\u2192             result = await client.tree(repo, path, depth)\n 569\u2192             print(result)\n 570\u2192         except Exception as e:\n 571\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 572\u2192             sys.exit(1)\n 573\u2192 \n 574\u2192     elif subcommand == \"read\":\n 575\u2192         # goz repo read <owner/repo> <file_path>\n 576\u2192         if len(args) < 3:\n 577\u2192             print(\"Error: repo read requires <owner/repo> and <file_path>\", file=sys.stderr)\n 578\u2192             print(\"Usage: goz repo read <owner/repo> <file_path>\", file=sys.stderr)\n 579\u2192             sys.exit(1)\n 580\u2192 \n 581\u2192         repo = args[1]\n 582\u2192         file_path = args[2]\n 583\u2192 \n 584\u2192         from goz.api.repo import RepoClient\n 585\u2192         from goz.config import load_config\n 586\u2192 \n 587\u2192         config = load_config()\n 588\u2192         client = RepoClient(config=config)\n 589\u2192 \n 590\u2192         try:\n 591\u2192             result = await client.read(repo, file_path)\n 592\u2192             print(result)\n 593\u2192         except Exception as e:\n 594\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 595\u2192             sys.exit(1)\n 596\u2192 \n 597\u2192     else:\n 598\u2192         print(f\"Error: Unknown repo subcommand '{subcommand}'\", file=sys.stderr)\n 599\u2192         print(\"Run 'goz repo --help' for usage\", file=sys.stderr)\n 600\u2192         sys.exit(1)\n 601\u2192 \n 602\u2192 \n 603\u2192 async def cmd_tools(args: list[str]) -> None:\n 604\u2192     \"\"\"Handle the `goz tools` command.\"\"\"\n 605\u2192     import argparse\n 606\u2192 \n 607\u2192     if args and args[0] in (\"--help\", \"-h\", \"help\"):\n 608\u2192         print(\"\"\"Tools command usage:\n 609\u2192 \n 610\u2192   goz tools [options]\n 611\u2192 \n 612\u2192 Options:\n 613\u2192   --filter TEXT   Filter tool names by substring\n 614\u2192   --full          Show full tool schemas as JSON\n 615\u2192 \"\"\")\n 616\u2192         return\n 617\u2192 \n 618\u2192     parser = argparse.ArgumentParser(prog=\"goz tools\", add_help=False)\n 619\u2192     parser.add_argument(\"--filter\", dest=\"name_filter\", help=\"Filter tool names by substring\")\n 620\u2192     parser.add_argument(\"--full\", action=\"store_true\", help=\"Show full tool schemas\")\n 621\u2192     parsed = parser.parse_args(args)\n 622\u2192 \n 623\u2192     from goz.api.mcp import McpClient\n 624\u2192 \n 625\u2192     client = McpClient()\n 626\u2192     try:\n 627\u2192         tools = await client.list_tools()\n 628\u2192     except Exception as e:\n 629\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 630\u2192         sys.exit(1)\n 631\u2192 \n 632\u2192     if parsed.name_filter:\n 633\u2192         query = parsed.name_filter.lower()\n 634\u2192         tools = [tool for tool in tools if query in str(tool.get(\"name\", \"\")).lower()]\n 635\u2192 \n 636\u2192     if parsed.full:\n 637\u2192         _print_json(tools)\n 638\u2192         return\n 639\u2192 \n 640\u2192     for tool in tools:\n 641\u2192         name = tool.get(\"name\")\n 642\u2192         if name:\n 643\u2192             print(name)\n 644\u2192 \n 645\u2192 \n 646\u2192 async def cmd_tool(args: list[str]) -> None:\n 647\u2192     \"\"\"Handle the `goz tool <name>` command.\"\"\"\n 648\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 649\u2192         print(\"\"\"Tool command usage:\n 650\u2192 \n 651\u2192   goz tool <name>\n 652\u2192 \"\"\")\n 653\u2192         return\n 654\u2192 \n 655\u2192     from goz.api.mcp import McpClient\n 656\u2192 \n 657\u2192     client = McpClient()\n 658\u2192     try:\n 659\u2192         tool = await client.get_tool(args[0])\n 660\u2192     except Exception as e:\n 661\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 662\u2192         sys.exit(1)\n 663\u2192 \n 664\u2192     if tool is None:\n 665\u2192         print(f\"Error: Unknown tool '{args[0]}'\", file=sys.stderr)\n 666\u2192         sys.exit(1)\n 667\u2192 \n 668\u2192     _print_json(tool)\n 669\u2192 \n 670\u2192 \n 671\u2192 async def cmd_call(args: list[str]) -> None:\n 672\u2192     \"\"\"Handle the `goz call <tool>` command.\"\"\"\n 673\u2192     import argparse\n 674\u2192 \n 675\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n 676\u2192         print(\"\"\"Call command usage:\n 677\u2192 \n 678\u2192   goz call <tool> [--json JSON|@file.json] [--stdin] [--dry-run]\n 679\u2192 \n 680\u2192 Options:\n 681\u2192   --json VALUE    Inline JSON object or @path/to/file.json\n 682\u2192   --stdin         Read JSON object from stdin\n 683\u2192   --dry-run       Print resolved request payload without calling the tool\n 684\u2192 \"\"\")\n 685\u2192         return\n 686\u2192 \n 687\u2192     parser = argparse.ArgumentParser(prog=\"goz call\", add_help=False)\n 688\u2192     parser.add_argument(\"tool\", help=\"Tool name to call\")\n 689\u2192     parser.add_argument(\"--json\", dest=\"json_payload\", help=\"Inline JSON or @file reference\")\n 690\u2192     parser.add_argument(\"--stdin\", action=\"store_true\", help=\"Read JSON from stdin\")\n 691\u2192     parser.add_argument(\n 692\u2192         \"--dry-run\", action=\"store_true\", help=\"Preview the request without calling\"\n 693\u2192     )\n 694\u2192     parsed = parser.parse_args(args)\n 695\u2192 \n 696\u2192     try:\n 697\u2192         arguments = _load_call_arguments(parsed.json_payload, parsed.stdin)\n 698\u2192     except (OSError, ValueError) as e:\n 699\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 700\u2192         sys.exit(1)\n 701\u2192 \n 702\u2192     request_payload = {\n 703\u2192         \"name\": parsed.tool,\n 704\u2192         \"arguments\": arguments,\n 705\u2192     }\n 706\u2192     if parsed.dry_run:\n 707\u2192         _print_json(request_payload)\n 708\u2192         return\n 709\u2192 \n 710\u2192     from goz.api.mcp import McpClient\n 711\u2192 \n 712\u2192     client = McpClient()\n 713\u2192     try:\n 714\u2192         result = await client.call_tool(parsed.tool, arguments)\n 715\u2192     except Exception as e:\n 716\u2192         print(f\"Error: {e}\", file=sys.stderr)\n 717\u2192         sys.exit(1)\n 718\u2192 \n 719\u2192     _print_json(result)\n 720\u2192 \n 721\u2192 \n 722\u2192 async def cmd_run(args: list[str]) -> None:\n 723\u2192     \"\"\"Handle the `goz run` command.\"\"\"\n 724\u2192     from goz.cli.run import cmd_run as run_cmd\n 725\u2192 \n 726\u2192     await run_cmd(args)\n 727\u2192 \n 728\u2192 \n 729\u2192 def cmd_config(args: list[str]) -> None:\n 730\u2192     \"\"\"Handle the `goz config` command.\n 731\u2192 \n 732\u2192     Usage:\n 733\u2192         goz config                - Show current config\n 734\u2192         goz config get <key>      - Get a single value\n 735\u2192         goz config set <key> <val> - Set a value\n 736\u2192         goz config list           - List all keys\n 737\u2192         goz config edit           - Open in editor\n 738\u2192 \n 739\u2192     Args:\n 740\u2192         args: Remaining arguments after 'config'\n 741\u2192     \"\"\"\n 742\u2192     from goz.config import ConfigManager\n 743\u2192 \n 744\u2192     manager = ConfigManager()\n 745\u2192 \n 746\u2192     # No subcommand = show current config\n 747\u2192     if not args:\n 748\u2192         manager.show_config()\n 749\u2192         return\n 750\u2192 \n 751\u2192     subcommand = args[0]\n 752\u2192 \n 753\u2192     if subcommand == \"get\" and len(args) >= 2:\n 754\u2192         key = args[1]\n 755\u2192         try:\n 756\u2192             manager.get_config(key)\n 757\u2192         except ValueError as e:\n 758\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 759\u2192             sys.exit(1)\n 760\u2192 \n 761\u2192     elif subcommand == \"set\" and len(args) >= 2:\n 762\u2192         key = args[1]\n 763\u2192         value = args[2] if len(args) > 2 else \"\"\n 764\u2192         try:\n 765\u2192             manager.set_config(key, value)\n 766\u2192         except ValueError as e:\n 767\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 768\u2192             sys.exit(1)\n 769\u2192 \n 770\u2192     elif subcommand == \"list\":\n 771\u2192         manager.list_keys()\n 772\u2192 \n 773\u2192     elif subcommand == \"edit\":\n 774\u2192         try:\n 775\u2192             manager.edit_config()\n 776\u2192         except Exception as e:\n 777\u2192             print(f\"Error: {e}\", file=sys.stderr)\n 778\u2192             sys.exit(1)\n 779\u2192 \n 780\u2192     elif subcommand in (\"--help\", \"-h\", \"help\"):\n 781\u2192         print(\"\"\"Config command usage:\n 782\u2192 \n 783\u2192   goz config                Show current configuration\n 784\u2192   goz config get <key>      Get a single configuration value\n 785\u2192   goz config set <key> <val> Set a configuration value\n 786\u2192   goz config list           List all available keys with descriptions\n 787\u2192   goz config edit           Open config file in $EDITOR\n 788\u2192 \n 789\u2192 Keys:\n 790\u2192   zai_token     - Z.AI API authentication token (required)\n 791\u2192   zai_base_url  - Base URL for Z.AI API\n 792\u2192   timeout       - Request timeout in seconds\n 793\u2192   vision_model  - Model for image/video analysis\n 794\u2192   chat_model    - Model for chat requests\n 795\u2192   temperature   - Generation temperature\n 796\u2192   top_p         - Generation top_p sampling\n 797\u2192   max_tokens    - Maximum response tokens\n 798\u2192 \"\"\")\n 799\u2192 \n 800\u2192     else:\n 801\u2192         # Treat as show current config (for backwards compatibility)\n 802\u2192         manager.show_config()\n 803\u2192 \n 804\u2192 \n 805\u2192 def cmd_doctor(args: list[str]) -> None:\n 806\u2192     \"\"\"Handle the `goz doctor` command.\n 807\u2192 \n 808\u2192     Usage:\n 809\u2192         goz doctor\n 810\u2192 \n 811\u2192     Runs environment and connectivity checks.\n 812\u2192 \n 813\u2192     Args:\n 814\u2192         args: Remaining arguments\n 815\u2192     \"\"\"\n 816\u2192     import asyncio\n 817\u2192 \n 818\u2192     # Check for help\n 819\u2192     if args and args[0] in (\"--help\", \"-h\", \"help\"):\n 820\u2192         print(\"\"\"Doctor command usage:\n 821\u2192 \n 822\u2192   goz doctor\n 823\u2192 \n 824\u2192 Runs diagnostic checks:\n 825\u2192   - Config file exists\n 826\u2192   - API token is set\n 827\u2192   - API endpoint is reachable\n 828\u2192 \"\"\")\n 829\u2192         return\n 830\u2192 \n 831\u2192     async def run_doctor() -> None:\n 832\u2192         from goz.config import load_config, DEFAULT_CONFIG_FILE\n 833\u2192 \n 834\u2192         checks_passed = 0\n 835\u2192         checks_failed = 0\n 836\u2192 \n 837\u2192         # Check 1: Config file\n 838\u2192         print(\"Checking configuration...\")\n 839\u2192         if DEFAULT_CONFIG_FILE.exists():\n 840\u2192             print(f\"  [PASS] Config file found at {DEFAULT_CONFIG_FILE}\")\n 841\u2192             checks_passed += 1\n 842\u2192         else:\n 843\u2192             print(f\"  [FAIL] Config file not found at {DEFAULT_CONFIG_FILE}\")\n 844\u2192             print(\"         Run 'goz config' to set up.\")\n 845\u2192             checks_failed += 1\n 846\u2192 \n 847\u2192         # Check 2: Load config and validate token\n 848\u2192         try:\n 849\u2192             config = load_config()\n 850\u2192             if config.zai_token:\n 851\u2192                 masked = f\"****{config.zai_token[-4:]}\" if len(config.zai_token) > 4 else \"****\"\n 852\u2192                 print(f\"  [PASS] API token present ({masked})\")\n 853\u2192                 checks_passed += 1\n 854\u2192             else:\n 855\u2192                 print(\"  [FAIL] API token not set\")\n 856\u2192                 checks_failed += 1\n 857\u2192         except Exception as e:\n 858\u2192             print(f\"  [FAIL] Error loading config: {e}\")\n 859\u2192             checks_failed += 1\n 860\u2192             return\n 861\u2192 \n 862\u2192         # Check 3: API connectivity\n 863\u2192         try:\n 864\u2192             import httpx\n 865\u2192 \n 866\u2192             async with httpx.AsyncClient(timeout=5.0) as client:\n 867\u2192                 await client.get(config.zai_base_url)\n 868\u2192                 print(f\"  [PASS] Base URL reachable ({config.zai_base_url})\")\n 869\u2192                 checks_passed += 1\n 870\u2192         except (httpx.ConnectError, httpx.NetworkError) as e:\n 871\u2192             print(f\"  [FAIL] Cannot connect to API: {e}\")\n 872\u2192             checks_failed += 1\n 873\u2192         except Exception as e:\n 874\u2192             print(f\"  [WARN] Could not test connectivity: {e}\")\n 875\u2192 \n 876\u2192         # Summary\n 877\u2192         print()\n 878\u2192         if checks_failed == 0:\n 879\u2192             print(f\"All checks passed! ({checks_passed}/{checks_passed})\")\n 880\u2192         else:\n 881\u2192             print(f\"Some checks failed: {checks_failed} failed, {checks_passed} passed\")\n 882\u2192 \n 883\u2192     asyncio.run(run_doctor())\n 884\u2192 \n 885\u2192 \n 886\u2192 def cmd_tui(args: list[str]) -> None:\n 887\u2192     \"\"\"Launch the TUI.\n 888\u2192 \n 889\u2192     Args:\n 890\u2192         args: Remaining arguments (ignored)\n 891\u2192     \"\"\"\n 892\u2192     from goz.tui import run_tui\n 893\u2192 \n 894\u2192     run_tui()\n 895\u2192 \n 896\u2192 \n 897\u2192 def main() -> None:\n 898\u2192     \"\"\"Run the goz CLI.\n 899\u2192 \n 900\u2192     This is the entry point for the `goz` command.\n 901\u2192     \"\"\"\n 902\u2192     import argparse\n 903\u2192 \n 904\u2192     # Check for --help before argparse to handle it properly\n 905\u2192     if \"--help\" in sys.argv or \"-h\" in sys.argv:\n 906\u2192         print(f\"\"\"goz v{__version__} - Z.AI Tools\n 907\u2192 \n 908\u2192 Usage: goz <command> [args] [options]\n 909\u2192 \n 910\u2192 Commands:\n 911\u2192   run       One-shot agent run with JSONL output\n 912\u2192   vision    Image and video analysis\n 913\u2192   search    Real-time web search\n 914\u2192   read      Fetch and parse web pages\n 915\u2192   repo      GitHub repository exploration\n 916\u2192   tools     List MCP tools\n 917\u2192   tool      Show one MCP tool schema\n 918\u2192   call      Call an MCP tool directly\n 919\u2192   config    Manage configuration\n 920\u2192   doctor    Environment + connectivity checks\n 921\u2192   usage     Show token usage and quota\n 922\u2192   tui       Launch interactive terminal UI\n 923\u2192 \n 924\u2192 Global Options:\n 925\u2192   --help, -h     Show this help message\n 926\u2192   --version, -v  Show version number\n 927\u2192 \n 928\u2192 For command-specific help:\n 929\u2192   goz vision --help\n 930\u2192   goz run --help\n 931\u2192   goz search --help\n 932\u2192   goz read --help\n 933\u2192   goz repo --help\n 934\u2192   goz tools --help\n 935\u2192   goz tool --help\n 936\u2192   goz call --help\n 937\u2192   goz config --help\n 938\u2192   goz doctor --help\n 939\u2192   goz usage --help\n 940\u2192 \n 941\u2192 Examples:\n 942\u2192   goz vision analyze https://example.com/image.png\n 943\u2192   goz run --format json \"Inspect this repo and report STAGE_RESULT.\"\n 944\u2192   goz vision ui-to-code screenshot.png\n 945\u2192   goz search \"python async await\"\n 946\u2192   goz read https://example.com/article\n 947\u2192   goz repo tree vercel/next.js\n 948\u2192   goz repo search facebook/react \"hooks\"\n 949\u2192   goz tools --filter vision\n 950\u2192   goz tool zai.vision.analyze_image\n 951\u2192   goz call zai.search.webSearchPrime --json '{{\"search_query\":\"test\"}}'\n 952\u2192   goz config get zai_token\n 953\u2192 \n 954\u2192 With no command, launches the interactive TUI.\n 955\u2192 \"\"\")\n 956\u2192         return\n 957\u2192 \n 958\u2192     parser = argparse.ArgumentParser(\n 959\u2192         prog=\"goz\",\n 960\u2192         description=\"goz - Z.AI Tools: vision, search, web reader, and more\",\n 961\u2192         add_help=False,  # We handle help manually\n 962\u2192     )\n 963\u2192     parser.add_argument(\n 964\u2192         \"--version\",\n 965\u2192         action=\"version\",\n 966\u2192         version=f\"%(prog)s {__version__}\",\n 967\u2192     )\n 968\u2192     # Agent mode flags (for use with no command)\n 969\u2192     parser.add_argument(\n 970\u2192         \"--load\",\n 971\u2192         help=\"Load session on startup (for agent mode)\",\n 972\u2192     )\n 973\u2192     parser.add_argument(\n 974\u2192         \"--agent\",\n 975\u2192         help=\"Start with specific agent type (for agent mode)\",\n 976\u2192     )\n 977\u2192     parser.add_argument(\n 978\u2192         \"command\",\n 979\u2192         nargs=\"?\",\n 980\u2192         help=\"Command to run (run, config, vision, search, read, repo, tools, tool, call, doctor, tui)\",\n 981\u2192     )\n 982\u2192     parser.add_argument(\n 983\u2192         \"args\",\n 984\u2192         nargs=argparse.REMAINDER,\n 985\u2192         help=\"Arguments for the command\",\n 986\u2192     )\n 987\u2192 \n 988\u2192     args = parser.parse_args()\n 989\u2192 \n 990\u2192     if args.command is None:\n 991\u2192         # No command = launch AGENT MODE (interactive coding agent)\n 992\u2192         from goz.agent.tui import run_agent_app\n 993\u2192 \n 994\u2192         run_agent_app(session_id=args.load, agent_type=args.agent)\n 995\u2192         return\n 996\u2192 \n 997\u2192     # Dispatch to command handlers\n 998\u2192     if args.command == \"config\":\n 999\u2192         cmd_config(args.args)\n1000\u2192     elif args.command == \"vision\":\n1001\u2192         asyncio.run(cmd_vision(args.args))\n1002\u2192     elif args.command == \"run\":\n1003\u2192         asyncio.run(cmd_run(args.args))\n1004\u2192     elif args.command == \"search\":\n1005\u2192         asyncio.run(cmd_search(args.args))\n1006\u2192     elif args.command == \"read\":\n1007\u2192         asyncio.run(cmd_read(args.args))\n1008\u2192     elif args.command == \"repo\":\n1009\u2192         asyncio.run(cmd_repo(args.args))\n1010\u2192     elif args.command == \"tools\":\n1011\u2192         asyncio.run(cmd_tools(args.args))\n1012\u2192     elif args.command == \"tool\":\n1013\u2192         asyncio.run(cmd_tool(args.args))\n1014\u2192     elif args.command == \"call\":\n1015\u2192         asyncio.run(cmd_call(args.args))\n1016\u2192     elif args.command == \"doctor\":\n1017\u2192         cmd_doctor(args.args)\n1018\u2192     elif args.command == \"usage\":\n1019\u2192         from goz.cli.usage import cmd_usage as _cmd_usage\n1020\u2192 \n1021\u2192         asyncio.run(_cmd_usage(args.args))\n1022\u2192     elif args.command in (\"tui\", \"ui\"):\n1023\u2192         cmd_tui(args.args)\n1024\u2192     else:\n1025\u2192         print(f\"Error: Unknown command '{args.command}'\", file=sys.stderr)\n1026\u2192         print(\"Run 'goz --help' for usage\", file=sys.stderr)\n1027\u2192         sys.exit(1)\n1028\u2192 \n1029\u2192 \n1030\u2192 if __name__ == \"__main__\":\n1031\u2192     main()", "is_error": false}}
