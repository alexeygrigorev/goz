{"type": "tool_use", "part": {"id": "call_c03d88697b6245b7b3afe8c8", "name": "view_file", "input": {"file_path": "goz/agent/chat_client.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/chat_client.py (530 lines)\n============================================================\n\n  1\u2192 \"\"\"Chat API Client for Z.AI (Issue 17).\n  2\u2192 \n  3\u2192 This module provides the ChatClient class for interacting with the Z.AI\n  4\u2192 chat API using the Anthropic SDK with tool calling support.\n  5\u2192 \n  6\u2192 Acceptance Criteria:\n  7\u2192 1. ChatClient class exists in goz/agent/chat_client.py\n  8\u2192 2. Uses existing Anthropic SDK (same as Vision API)\n  9\u2192 3. Uses config.zai_token and config.zai_base_url\n 10\u2192 4. chat_completion() method sends messages and returns async iterator\n 11\u2192 5. Supports tools parameter for function calling\n 12\u2192 6. Supports tool_choice parameter (\"auto\", \"any\")\n 13\u2192 7. Supports stream parameter (True/False)\n 14\u2192 8. Response chunks yield text deltas\n 15\u2192 9. Tool calls are properly formatted in stream\n 16\u2192 10. Errors raised as appropriate exceptions (AuthError, ApiError, etc.)\n 17\u2192 11. Timeout configurable via config\n 18\u2192 \n 19\u2192 T-0008 additions:\n 20\u2192 - MessageStart carries usage from message_start event\n 21\u2192 - UsageDelta chunk type carries usage from message_delta event\n 22\u2192 - QuotaError detection for Z.AI codes 1302/1305/1308/1310\n 23\u2192 \"\"\"\n 24\u2192 \n 25\u2192 import asyncio\n 26\u2192 import json\n 27\u2192 from dataclasses import dataclass\n 28\u2192 from typing import Any, AsyncIterator, Literal\n 29\u2192 \n 30\u2192 import anthropic\n 31\u2192 from anthropic import AsyncAnthropic\n 32\u2192 \n 33\u2192 from goz.api.errors import AuthError, ApiError, NetworkError, TimeoutError, ZaiError, QuotaError\n 34\u2192 from goz.config import Config\n 35\u2192 \n 36\u2192 \n 37\u2192 # Chunk types for streaming responses (from spec)\n 38\u2192 @dataclass\n 39\u2192 class ContentBlockStart:\n 40\u2192     \"\"\"Start of a content block in the stream.\n 41\u2192 \n 42\u2192     Attributes:\n 43\u2192         type: The type of content block (\"text\" or \"tool_use\")\n 44\u2192         index: The index of this content block\n 45\u2192         id: Tool call ID (only for tool_use type)\n 46\u2192         name: Tool name (only for tool_use type)\n 47\u2192     \"\"\"\n 48\u2192 \n 49\u2192     type: Literal[\"text\", \"tool_use\"]\n 50\u2192     index: int\n 51\u2192     id: str | None = None\n 52\u2192     name: str | None = None\n 53\u2192 \n 54\u2192 \n 55\u2192 @dataclass\n 56\u2192 class ContentBlockDelta:\n 57\u2192     \"\"\"Delta for a content block in the stream.\n 58\u2192 \n 59\u2192     Attributes:\n 60\u2192         type: The type of delta (\"text_delta\" or \"input_json_delta\")\n 61\u2192         index: The index of this content block\n 62\u2192         text: Text content (only for text_delta type)\n 63\u2192         partial_json: Partial JSON string (only for input_json_delta type)\n 64\u2192     \"\"\"\n 65\u2192 \n 66\u2192     type: Literal[\"text_delta\", \"input_json_delta\"]\n 67\u2192     index: int\n 68\u2192     text: str | None = None\n 69\u2192     partial_json: str | None = None\n 70\u2192 \n 71\u2192 \n 72\u2192 @dataclass\n 73\u2192 class ContentBlockStop:\n 74\u2192     \"\"\"End of a content block in the stream.\n 75\u2192 \n 76\u2192     Attributes:\n 77\u2192         index: The index of this content block\n 78\u2192     \"\"\"\n 79\u2192 \n 80\u2192     index: int\n 81\u2192 \n 82\u2192 \n 83\u2192 @dataclass\n 84\u2192 class MessageStart:\n 85\u2192     \"\"\"Start of the message.\n 86\u2192 \n 87\u2192     Attributes:\n 88\u2192         id: Message ID\n 89\u2192         model: Model name\n 90\u2192         usage_input_tokens: Input tokens from message_start.usage\n 91\u2192         usage_cache_read: Cache read tokens from message_start.usage\n 92\u2192         usage_cache_creation: Cache creation tokens from message_start.usage\n 93\u2192     \"\"\"\n 94\u2192 \n 95\u2192     id: str\n 96\u2192     model: str\n 97\u2192     usage_input_tokens: int = 0\n 98\u2192     usage_cache_read: int = 0\n 99\u2192     usage_cache_creation: int = 0\n100\u2192 \n101\u2192 \n102\u2192 @dataclass\n103\u2192 class MessageStop:\n104\u2192     \"\"\"End of the message.\n105\u2192 \n106\u2192     Attributes:\n107\u2192         stop_reason: Reason for stopping (\"end_turn\", \"max_tokens\", \"tool_use\")\n108\u2192         usage_output_tokens: Output tokens from message_delta.usage\n109\u2192     \"\"\"\n110\u2192 \n111\u2192     stop_reason: Literal[\"end_turn\", \"max_tokens\", \"tool_use\"]\n112\u2192     usage_output_tokens: int = 0\n113\u2192 \n114\u2192 \n115\u2192 @dataclass\n116\u2192 class UsageDelta:\n117\u2192     \"\"\"Usage data from message_delta event.\n118\u2192 \n119\u2192     Attributes:\n120\u2192         output_tokens: Output tokens generated so far\n121\u2192     \"\"\"\n122\u2192 \n123\u2192     output_tokens: int = 0\n124\u2192 \n125\u2192 \n126\u2192 # Union type for all chunk types\n127\u2192 Chunk = (\n128\u2192     ContentBlockStart\n129\u2192     | ContentBlockDelta\n130\u2192     | ContentBlockStop\n131\u2192     | MessageStart\n132\u2192     | MessageStop\n133\u2192     | UsageDelta\n134\u2192 )\n135\u2192 \n136\u2192 \n137\u2192 class ChatClient:\n138\u2192     \"\"\"Client for Z.AI Chat API with tool calling support.\n139\u2192 \n140\u2192     This client uses the Anthropic SDK to interact with the Z.AI chat API,\n141\u2192     supporting streaming responses, tool calling, and various generation\n142\u2192     parameters.\n143\u2192 \n144\u2192     Attributes:\n145\u2192         config: Configuration object containing API credentials and settings\n146\u2192         _client: Internal AsyncAnthropic client instance\n147\u2192     \"\"\"\n148\u2192 \n149\u2192     def __init__(self, config: Config | None = None) -> None:\n150\u2192         \"\"\"Initialize ChatClient.\n151\u2192 \n152\u2192         Args:\n153\u2192             config: Optional config object. If not provided, loads from default location.\n154\u2192 \n155\u2192         Acceptance Criteria:\n156\u2192         - Uses config.zai_token and config.zai_base_url (AC 3)\n157\u2192         - Uses AsyncAnthropic from existing SDK (AC 2)\n158\u2192         - Timeout is configurable via config (AC 11)\n159\u2192         \"\"\"\n160\u2192         if config is None:\n161\u2192             from goz.config import load_config\n162\u2192 \n163\u2192             config = load_config()\n164\u2192 \n165\u2192         self.config = config\n166\u2192 \n167\u2192         # Initialize async Anthropic client (same pattern as VisionClient)\n168\u2192         self._client = AsyncAnthropic(\n169\u2192             api_key=self.config.zai_token,\n170\u2192             base_url=self.config.zai_base_url,\n171\u2192             timeout=self.config.timeout,\n172\u2192         )\n173\u2192         self.max_retries = 2\n174\u2192         self.base_retry_delay = 1.0\n175\u2192 \n176\u2192     async def chat_completion(\n177\u2192         self,\n178\u2192         messages: list[dict],\n179\u2192         tools: list[dict] | None = None,\n180\u2192         tool_choice: Literal[\"auto\", \"any\", \"none\"] | dict = \"auto\",\n181\u2192         stream: bool = True,\n182\u2192         temperature: float | None = None,\n183\u2192         max_tokens: int | None = None,\n184\u2192     ) -> AsyncIterator[Chunk]:\n185\u2192         \"\"\"Stream chat completion with tool calling support.\n186\u2192 \n187\u2192         Args:\n188\u2192             messages: Chat history in Anthropic format\n189\u2192             tools: Tool definitions in Anthropic format (optional)\n190\u2192             tool_choice: How to select tools (\"auto\", \"any\", \"none\", or specific tool dict)\n191\u2192             stream: Whether to stream response (True) or wait for complete response (False)\n192\u2192             temperature: Generation temperature (uses config default if None)\n193\u2192             max_tokens: Max tokens in response (uses config default if None)\n194\u2192 \n195\u2192         Yields:\n196\u2192             Chunk objects from the API response\n197\u2192 \n198\u2192         Raises:\n199\u2192             AuthError: For 401/403 authentication failures\n200\u2192             ApiError: For other API errors (4xx, 5xx)\n201\u2192             NetworkError: For connection failures\n202\u2192             TimeoutError: For request timeouts\n203\u2192 \n204\u2192         Acceptance Criteria:\n205\u2192         - Returns async iterator (AC 4)\n206\u2192         - Supports tools parameter (AC 5)\n207\u2192         - Supports tool_choice parameter (AC 6)\n208\u2192         - Supports stream parameter (AC 7)\n209\u2192         - Response chunks yield text deltas (AC 8)\n210\u2192         - Tool calls properly formatted in stream (AC 9)\n211\u2192         - Errors raised as appropriate exceptions (AC 10)\n212\u2192         \"\"\"\n213\u2192         # Build request parameters\n214\u2192         params: dict = {\n215\u2192             \"model\": self.config.chat_model,\n216\u2192             \"messages\": messages,\n217\u2192         }\n218\u2192 \n219\u2192         # Add optional parameters\n220\u2192         if tools is not None:\n221\u2192             params[\"tools\"] = tools\n222\u2192 \n223\u2192         if tool_choice != \"auto\":\n224\u2192             params[\"tool_choice\"] = tool_choice\n225\u2192 \n226\u2192         if temperature is not None:\n227\u2192             params[\"temperature\"] = temperature\n228\u2192         else:\n229\u2192             params[\"temperature\"] = self.config.temperature\n230\u2192 \n231\u2192         if max_tokens is not None:\n232\u2192             params[\"max_tokens\"] = max_tokens\n233\u2192         else:\n234\u2192             params[\"max_tokens\"] = self.config.max_tokens\n235\u2192 \n236\u2192         timeout_ms = int(self.config.timeout * 1000)\n237\u2192 \n238\u2192         for attempt in range(self.max_retries + 1):\n239\u2192             try:\n240\u2192                 if stream:\n241\u2192                     async with self._client.messages.stream(**params) as response_stream:\n242\u2192                         async for event in response_stream:\n243\u2192                             chunk = self._convert_sse_event_to_chunk(event)\n244\u2192                             if chunk is not None:\n245\u2192                                 yield chunk\n246\u2192                 else:\n247\u2192                     response = await self._client.messages.create(**params)\n248\u2192                     async for chunk in self._response_to_chunks(response):\n249\u2192                         yield chunk\n250\u2192                 return\n251\u2192             except anthropic.AuthenticationError as e:\n252\u2192                 status_code = getattr(getattr(e, \"response\", None), \"status_code\", 401)\n253\u2192                 raise AuthError(\n254\u2192                     \"Authentication failed. Check your API token and try again.\",\n255\u2192                     statusCode=status_code,\n256\u2192                 ) from e\n257\u2192             except anthropic.APITimeoutError as e:\n258\u2192                 timeout_error = TimeoutError(timeoutMs=timeout_ms)\n259\u2192                 if attempt >= self.max_retries:\n260\u2192                     raise timeout_error from e\n261\u2192                 await self._sleep_before_retry(attempt)\n262\u2192             except anthropic.APIConnectionError as e:\n263\u2192                 network_error = NetworkError(\n264\u2192                     \"Connection failed while contacting the API. Check your network and retry.\"\n265\u2192                 )\n266\u2192                 if attempt >= self.max_retries:\n267\u2192                     raise network_error from e\n268\u2192                 await self._sleep_before_retry(attempt)\n269\u2192             except anthropic.APIStatusError as e:\n270\u2192                 status_code = getattr(e, \"status_code\", None) or getattr(\n271\u2192                     getattr(e, \"response\", None), \"status_code\", 500\n272\u2192                 )\n273\u2192                 if status_code in (401, 403):\n274\u2192                     raise AuthError(\n275\u2192                         \"Authentication failed. Check your API token and try again.\",\n276\u2192                         statusCode=status_code,\n277\u2192                     ) from e\n278\u2192 \n279\u2192                 zai_code = self._extract_zai_error_code(e)\n280\u2192                 if zai_code in (1302, 1305, 1308, 1310):\n281\u2192                     raise QuotaError(str(e), zai_code=zai_code, statusCode=status_code) from e\n282\u2192 \n283\u2192                 if status_code == 429:\n284\u2192                     api_error = ApiError(\n285\u2192                         \"Rate limit exceeded. Wait a moment and retry, or reduce request volume.\",\n286\u2192                         statusCode=status_code,\n287\u2192                     )\n288\u2192                 elif status_code >= 500:\n289\u2192                     api_error = ApiError(\n290\u2192                         \"Server error from the API. Retry shortly; the service may be degraded.\",\n291\u2192                         statusCode=status_code,\n292\u2192                     )\n293\u2192                 else:\n294\u2192                     api_error = ApiError(str(e), statusCode=status_code)\n295\u2192 \n296\u2192                 if attempt >= self.max_retries or status_code < 500 and status_code != 429:\n297\u2192                     raise api_error from e\n298\u2192                 await self._sleep_before_retry(attempt)\n299\u2192             except Exception as e:\n300\u2192                 raise ZaiError(f\"Unexpected error: {e}\") from e\n301\u2192 \n302\u2192     def _convert_sse_event_to_chunk(\n303\u2192         self, event: anthropic.types.RawMessageStreamEvent\n304\u2192     ) -> Chunk | None:\n305\u2192         \"\"\"Convert Anthropic SSE event to our Chunk type.\n306\u2192 \n307\u2192         Args:\n308\u2192             event: Raw SSE event from Anthropic SDK\n309\u2192 \n310\u2192         Returns:\n311\u2192             Chunk object or None if event type not handled\n312\u2192         \"\"\"\n313\u2192         event_type = event.type\n314\u2192 \n315\u2192         if event_type == \"message_start\":\n316\u2192             usage = getattr(event.message, \"usage\", None)\n317\u2192             input_tokens = getattr(usage, \"input_tokens\", 0) or 0\n318\u2192             cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n319\u2192             cache_creation = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n320\u2192             return MessageStart(\n321\u2192                 id=event.message.id,\n322\u2192                 model=event.message.model,\n323\u2192                 usage_input_tokens=input_tokens,\n324\u2192                 usage_cache_read=cache_read,\n325\u2192                 usage_cache_creation=cache_creation,\n326\u2192             )\n327\u2192 \n328\u2192         elif event_type == \"content_block_start\":\n329\u2192             content_block = event.content_block\n330\u2192             if content_block.type == \"text\":\n331\u2192                 return ContentBlockStart(\n332\u2192                     type=\"text\",\n333\u2192                     index=event.index,\n334\u2192                 )\n335\u2192             elif content_block.type == \"tool_use\":\n336\u2192                 return ContentBlockStart(\n337\u2192                     type=\"tool_use\",\n338\u2192                     index=event.index,\n339\u2192                     id=content_block.id,\n340\u2192                     name=content_block.name,\n341\u2192                 )\n342\u2192 \n343\u2192         elif event_type == \"content_block_delta\":\n344\u2192             delta = event.delta\n345\u2192             if delta.type == \"text_delta\":\n346\u2192                 return ContentBlockDelta(\n347\u2192                     type=\"text_delta\",\n348\u2192                     index=event.index,\n349\u2192                     text=delta.text,\n350\u2192                 )\n351\u2192             elif delta.type == \"input_json_delta\":\n352\u2192                 return ContentBlockDelta(\n353\u2192                     type=\"input_json_delta\",\n354\u2192                     index=event.index,\n355\u2192                     partial_json=delta.partial_json,\n356\u2192                 )\n357\u2192 \n358\u2192         elif event_type == \"content_block_stop\":\n359\u2192             return ContentBlockStop(index=event.index)\n360\u2192 \n361\u2192         elif event_type == \"message_delta\":\n362\u2192             usage = getattr(event, \"usage\", None)\n363\u2192             output_tokens = getattr(usage, \"output_tokens\", 0) or 0\n364\u2192             return UsageDelta(output_tokens=output_tokens)\n365\u2192 \n366\u2192         elif event_type == \"message_stop\":\n367\u2192             return MessageStop(stop_reason=event.message.stop_reason)\n368\u2192 \n369\u2192         # Return None for unhandled event types\n370\u2192         return None\n371\u2192 \n372\u2192     async def _response_to_chunks(self, response: anthropic.types.Message) -> AsyncIterator[Chunk]:\n373\u2192         \"\"\"Convert non-streaming response to chunk stream.\n374\u2192 \n375\u2192         Args:\n376\u2192             response: Complete response from messages.create()\n377\u2192 \n378\u2192         Yields:\n379\u2192             Chunk objects representing the response\n380\u2192         \"\"\"\n381\u2192         # Yield message start\n382\u2192         yield MessageStart(id=response.id, model=response.model)\n383\u2192 \n384\u2192         # Yield content blocks\n385\u2192         for index, block in enumerate(response.content):\n386\u2192             if block.type == \"text\":\n387\u2192                 yield ContentBlockStart(type=\"text\", index=index)\n388\u2192                 yield ContentBlockDelta(type=\"text_delta\", index=index, text=block.text)\n389\u2192                 yield ContentBlockStop(index=index)\n390\u2192 \n391\u2192             elif block.type == \"tool_use\":\n392\u2192                 yield ContentBlockStart(\n393\u2192                     type=\"tool_use\",\n394\u2192                     index=index,\n395\u2192                     id=block.id,\n396\u2192                     name=block.name,\n397\u2192                 )\n398\u2192                 # Yield the input JSON as a single delta\n399\u2192                 input_json = json.dumps(block.input)\n400\u2192                 yield ContentBlockDelta(\n401\u2192                     type=\"input_json_delta\",\n402\u2192                     index=index,\n403\u2192                     partial_json=input_json,\n404\u2192                 )\n405\u2192                 yield ContentBlockStop(index=index)\n406\u2192 \n407\u2192         # Yield message stop\n408\u2192         yield MessageStop(stop_reason=response.stop_reason)\n409\u2192 \n410\u2192     async def _sleep_before_retry(self, attempt: int) -> None:\n411\u2192         \"\"\"Sleep using exponential backoff before retrying.\"\"\"\n412\u2192         await asyncio.sleep(self.base_retry_delay * (2**attempt))\n413\u2192 \n414\u2192     @staticmethod\n415\u2192     def _extract_zai_error_code(exc: anthropic.APIStatusError) -> int | None:\n416\u2192         \"\"\"Try to extract a Z.AI numeric error code from an APIStatusError.\"\"\"\n417\u2192         try:\n418\u2192             body = getattr(exc, \"body\", None)\n419\u2192             if isinstance(body, dict):\n420\u2192                 code = body.get(\"error\", body).get(\"code\")\n421\u2192                 if isinstance(code, int):\n422\u2192                     return code\n423\u2192             resp = getattr(exc, \"response\", None)\n424\u2192             if resp is not None:\n425\u2192                 raw = getattr(resp, \"text\", \"\")\n426\u2192                 if raw:\n427\u2192                     data = json.loads(raw)\n428\u2192                     code = data.get(\"error\", data).get(\"code\")\n429\u2192                     if isinstance(code, int):\n430\u2192                         return code\n431\u2192         except (json.JSONDecodeError, AttributeError, TypeError):\n432\u2192             pass\n433\u2192         return None\n434\u2192 \n435\u2192     async def extract_tool_calls(\n436\u2192         self,\n437\u2192         chunks: list[Chunk],\n438\u2192     ) -> list[dict]:\n439\u2192         \"\"\"Extract tool calls from accumulated stream chunks.\n440\u2192 \n441\u2192         This method processes a list of chunks and extracts complete\n442\u2192         tool_call objects by accumulating partial_json deltas.\n443\u2192 \n444\u2192         Args:\n445\u2192             chunks: List of chunks from a stream\n446\u2192 \n447\u2192         Returns:\n448\u2192             List of tool_call dicts with id, name, and input keys\n449\u2192 \n450\u2192         Example:\n451\u2192             >>> chunks = []\n452\u2192             >>> async for chunk in client.chat_completion(messages, tools=tools):\n453\u2192             ...     chunks.append(chunk)\n454\u2192             >>> tool_calls = await client.extract_tool_calls(chunks)\n455\u2192         \"\"\"\n456\u2192         tool_calls: list[dict] = []\n457\u2192         current_tool: dict[str, Any] | None = None\n458\u2192         accumulated_json: list[str] = []\n459\u2192 \n460\u2192         for chunk in chunks:\n461\u2192             if isinstance(chunk, ContentBlockStart) and chunk.type == \"tool_use\":\n462\u2192                 # Start of a new tool call\n463\u2192                 current_tool = {\n464\u2192                     \"id\": chunk.id,\n465\u2192                     \"name\": chunk.name,\n466\u2192                     \"input\": {},\n467\u2192                 }\n468\u2192                 accumulated_json = []\n469\u2192 \n470\u2192             elif isinstance(chunk, ContentBlockDelta) and chunk.type == \"input_json_delta\":\n471\u2192                 # Accumulate partial JSON\n472\u2192                 if chunk.partial_json:\n473\u2192                     accumulated_json.append(chunk.partial_json)\n474\u2192 \n475\u2192             elif isinstance(chunk, ContentBlockStop) and current_tool is not None:\n476\u2192                 # End of current tool call - parse accumulated JSON\n477\u2192                 if accumulated_json:\n478\u2192                     try:\n479\u2192                         json_str = \"\".join(accumulated_json)\n480\u2192                         current_tool[\"input\"] = json.loads(json_str)\n481\u2192                     except json.JSONDecodeError:\n482\u2192                         # If JSON is incomplete, keep as string\n483\u2192                         current_tool[\"input\"] = {\"raw\": \"\".join(accumulated_json)}\n484\u2192 \n485\u2192                 tool_calls.append(current_tool)\n486\u2192                 current_tool = None\n487\u2192                 accumulated_json = []\n488\u2192 \n489\u2192         return tool_calls\n490\u2192 \n491\u2192     async def simple_chat(\n492\u2192         self,\n493\u2192         message: str,\n494\u2192         system_prompt: str | None = None,\n495\u2192     ) -> str:\n496\u2192         \"\"\"Simple chat without streaming or tool calling.\n497\u2192 \n498\u2192         This is a convenience method for basic chat interactions.\n499\u2192 \n500\u2192         Args:\n501\u2192             message: User message\n502\u2192             system_prompt: Optional system prompt\n503\u2192 \n504\u2192         Returns:\n505\u2192             Complete response text\n506\u2192         \"\"\"\n507\u2192         messages: list[dict] = [{\"role\": \"user\", \"content\": message}]\n508\u2192 \n509\u2192         params: dict = {\n510\u2192             \"model\": self.config.chat_model,\n511\u2192             \"messages\": messages,\n512\u2192             \"max_tokens\": self.config.max_tokens,\n513\u2192         }\n514\u2192 \n515\u2192         if system_prompt:\n516\u2192             params[\"system\"] = system_prompt\n517\u2192 \n518\u2192         try:\n519\u2192             response = await self._client.messages.create(**params)\n520\u2192             return response.content[0].text\n521\u2192         except anthropic.AuthenticationError as e:\n522\u2192             raise AuthError(str(e))\n523\u2192         except anthropic.APITimeoutError as e:\n524\u2192             raise TimeoutError(timeoutMs=int(self.config.timeout * 1000))\n525\u2192         except anthropic.APIConnectionError as e:\n526\u2192             raise NetworkError(str(e))\n527\u2192         except anthropic.APIStatusError as e:\n528\u2192             raise ApiError(str(e), statusCode=e.status_code)\n529\u2192         except Exception as e:\n530\u2192             raise ZaiError(f\"Unexpected error: {e}\")", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_0711934ae70d4de5a07210cb", "name": "view_file", "input": {"file_path": "goz/agent/usage.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/usage.py (193 lines)\n============================================================\n\n  1\u2192 \"\"\"Usage tracking for Z.AI token consumption and cost.\n  2\u2192 \n  3\u2192 This module provides data structures and utilities for tracking token usage\n  4\u2192 across streaming API responses, computing costs, and accumulating per-session\n  5\u2192 statistics.\n  6\u2192 \n  7\u2192 Acceptance Criteria (T-0008):\n  8\u2192 - Per-turn token counts extracted from message_start/message_delta events\n  9\u2192 - Accumulated in session state\n 10\u2192 - step_finish JSONL event includes tokens and cost\n 11\u2192 \"\"\"\n 12\u2192 \n 13\u2192 from __future__ import annotations\n 14\u2192 \n 15\u2192 import math\n 16\u2192 from dataclasses import dataclass, field\n 17\u2192 \n 18\u2192 \n 19\u2192 # Approximate per-Mtoken pricing (USD) for common models.\n 20\u2192 # These are best-effort estimates; actual billing comes from the API.\n 21\u2192 _MODEL_PRICING: dict[str, dict[str, float]] = {\n 22\u2192     \"glm-5-turbo\": {\"input\": 2.0, \"output\": 8.0, \"cache_read\": 0.5, \"cache_creation\": 2.5},\n 23\u2192     \"glm-4.6v\": {\"input\": 2.0, \"output\": 8.0, \"cache_read\": 0.5, \"cache_creation\": 2.5},\n 24\u2192     \"claude-sonnet-4-20250514\": {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75},\n 25\u2192     \"claude-3-5-sonnet-20241022\": {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75},\n 26\u2192 }\n 27\u2192 \n 28\u2192 _DEFAULT_PRICING = {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75}\n 29\u2192 \n 30\u2192 \n 31\u2192 def _get_pricing(model: str) -> dict[str, float]:\n 32\u2192     \"\"\"Return pricing dict for *model*, falling back to defaults.\"\"\"\n 33\u2192     for key, pricing in _MODEL_PRICING.items():\n 34\u2192         if key in model:\n 35\u2192             return pricing\n 36\u2192     return _DEFAULT_PRICING\n 37\u2192 \n 38\u2192 \n 39\u2192 @dataclass\n 40\u2192 class UsageSnapshot:\n 41\u2192     \"\"\"Token counts from a single API response (one streaming turn).\n 42\u2192 \n 43\u2192     Attributes:\n 44\u2192         input_tokens: Total input tokens for the request.\n 45\u2192         output_tokens: Total output tokens generated.\n 46\u2192         cache_read_input_tokens: Tokens served from prompt cache (read).\n 47\u2192         cache_creation_input_tokens: Tokens stored into prompt cache (write).\n 48\u2192     \"\"\"\n 49\u2192 \n 50\u2192     input_tokens: int = 0\n 51\u2192     output_tokens: int = 0\n 52\u2192     cache_read_input_tokens: int = 0\n 53\u2192     cache_creation_input_tokens: int = 0\n 54\u2192 \n 55\u2192     def cost_usd(self, model: str = \"\") -> float:\n 56\u2192         \"\"\"Compute approximate USD cost for this snapshot.\"\"\"\n 57\u2192         pricing = _get_pricing(model)\n 58\u2192         return (\n 59\u2192             self.input_tokens * pricing[\"input\"]\n 60\u2192             + self.output_tokens * pricing[\"output\"]\n 61\u2192             + self.cache_read_input_tokens * pricing[\"cache_read\"]\n 62\u2192             + self.cache_creation_input_tokens * pricing[\"cache_creation\"]\n 63\u2192         ) / 1_000_000.0\n 64\u2192 \n 65\u2192     def total_tokens(self) -> int:\n 66\u2192         \"\"\"Return the sum of all token counts.\"\"\"\n 67\u2192         return (\n 68\u2192             self.input_tokens\n 69\u2192             + self.output_tokens\n 70\u2192             + self.cache_read_input_tokens\n 71\u2192             + self.cache_creation_input_tokens\n 72\u2192         )\n 73\u2192 \n 74\u2192     def to_dict(self) -> dict:\n 75\u2192         \"\"\"Serialise to a plain dict (for JSONL emission).\"\"\"\n 76\u2192         return {\n 77\u2192             \"input\": self.input_tokens,\n 78\u2192             \"output\": self.output_tokens,\n 79\u2192             \"cache_read\": self.cache_read_input_tokens,\n 80\u2192             \"cache_creation\": self.cache_creation_input_tokens,\n 81\u2192         }\n 82\u2192 \n 83\u2192 \n 84\u2192 @dataclass\n 85\u2192 class UsageAccumulator:\n 86\u2192     \"\"\"Accumulates usage across multiple turns in a session.\n 87\u2192 \n 88\u2192     Usage is captured in two phases per streaming response:\n 89\u2192     1. ``message_start`` carries initial input / cache tokens.\n 90\u2192     2. ``message_delta`` carries the final output token count.\n 91\u2192 \n 92\u2192     The accumulator merges these into a :class:`UsageSnapshot` per turn\n 93\u2192     and maintains running totals.\n 94\u2192     \"\"\"\n 95\u2192 \n 96\u2192     # Running totals across all turns\n 97\u2192     total_input_tokens: int = 0\n 98\u2192     total_output_tokens: int = 0\n 99\u2192     total_cache_read_tokens: int = 0\n100\u2192     total_cache_creation_tokens: int = 0\n101\u2192     turn_count: int = 0\n102\u2192 \n103\u2192     # Per-turn snapshots (append-only)\n104\u2192     turns: list[UsageSnapshot] = field(default_factory=list)\n105\u2192 \n106\u2192     # --- Streaming helpers ---------------------------------------------------\n107\u2192 \n108\u2192     def begin_turn(self) -> None:\n109\u2192         \"\"\"Prepare for a new streaming turn.\"\"\"\n110\u2192         self.turns.append(UsageSnapshot())\n111\u2192 \n112\u2192     def apply_message_start(self, usage: object) -> None:\n113\u2192         \"\"\"Merge ``message_start`` usage data into the current turn.\n114\u2192 \n115\u2192         Args:\n116\u2192             usage: An object with ``input_tokens``, optionally\n117\u2192                 ``cache_read_input_tokens`` and ``cache_creation_input_tokens``.\n118\u2192         \"\"\"\n119\u2192         if not self.turns:\n120\u2192             self.begin_turn()\n121\u2192         snap = self.turns[-1]\n122\u2192         snap.input_tokens = getattr(usage, \"input_tokens\", 0) or 0\n123\u2192         snap.cache_read_input_tokens = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n124\u2192         snap.cache_creation_input_tokens = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n125\u2192 \n126\u2192     def apply_message_delta(self, usage: object) -> None:\n127\u2192         \"\"\"Merge ``message_delta`` usage data into the current turn.\n128\u2192 \n129\u2192         Args:\n130\u2192             usage: An object with ``output_tokens``, optionally cumulative\n131\u2192                 ``input_tokens``, ``cache_read_input_tokens``, etc.\n132\u2192         \"\"\"\n133\u2192         if not self.turns:\n134\u2192             self.begin_turn()\n135\u2192         snap = self.turns[-1]\n136\u2192         # message_delta carries cumulative output_tokens\n137\u2192         snap.output_tokens = getattr(usage, \"output_tokens\", 0) or 0\n138\u2192         # Update input/cache if provided (some APIs send cumulative totals here)\n139\u2192         if hasattr(usage, \"input_tokens\") and usage.input_tokens is not None:\n140\u2192             snap.input_tokens = usage.input_tokens\n141\u2192         if hasattr(usage, \"cache_read_input_tokens\") and usage.cache_read_input_tokens is not None:\n142\u2192             snap.cache_read_input_tokens = usage.cache_read_input_tokens\n143\u2192         if hasattr(usage, \"cache_creation_input_tokens\") and usage.cache_creation_input_tokens is not None:\n144\u2192             snap.cache_creation_input_tokens = usage.cache_creation_input_tokens\n145\u2192 \n146\u2192     def finalise_turn(self) -> UsageSnapshot:\n147\u2192         \"\"\"Close the current turn, roll into running totals, and return it.\"\"\"\n148\u2192         if not self.turns:\n149\u2192             return UsageSnapshot()\n150\u2192         snap = self.turns[-1]\n151\u2192         self.total_input_tokens += snap.input_tokens\n152\u2192         self.total_output_tokens += snap.output_tokens\n153\u2192         self.total_cache_read_tokens += snap.cache_read_input_tokens\n154\u2192         self.total_cache_creation_tokens += snap.cache_creation_input_tokens\n155\u2192         self.turn_count += 1\n156\u2192         return snap\n157\u2192 \n158\u2192     def current_turn_snapshot(self) -> UsageSnapshot:\n159\u2192         \"\"\"Return the in-progress snapshot for the current turn.\"\"\"\n160\u2192         if not self.turns:\n161\u2192             return UsageSnapshot()\n162\u2192         return self.turns[-1]\n163\u2192 \n164\u2192     # --- Aggregation ---------------------------------------------------------\n165\u2192 \n166\u2192     def total_tokens(self) -> int:\n167\u2192         return (\n168\u2192             self.total_input_tokens\n169\u2192             + self.total_output_tokens\n170\u2192             + self.total_cache_read_tokens\n171\u2192             + self.total_cache_creation_tokens\n172\u2192         )\n173\u2192 \n174\u2192     def total_cost_usd(self, model: str = \"\") -> float:\n175\u2192         pricing = _get_pricing(model)\n176\u2192         return (\n177\u2192             self.total_input_tokens * pricing[\"input\"]\n178\u2192             + self.total_output_tokens * pricing[\"output\"]\n179\u2192             + self.total_cache_read_tokens * pricing[\"cache_read\"]\n180\u2192             + self.total_cache_creation_tokens * pricing[\"cache_creation\"]\n181\u2192         ) / 1_000_000.0\n182\u2192 \n183\u2192     def to_dict(self) -> dict:\n184\u2192         \"\"\"Serialise full accumulator state.\"\"\"\n185\u2192         return {\n186\u2192             \"turn_count\": self.turn_count,\n187\u2192             \"total_input\": self.total_input_tokens,\n188\u2192             \"total_output\": self.total_output_tokens,\n189\u2192             \"total_cache_read\": self.total_cache_read_tokens,\n190\u2192             \"total_cache_creation\": self.total_cache_creation_tokens,\n191\u2192             \"total_tokens\": self.total_tokens(),\n192\u2192             \"turns\": [t.to_dict() for t in self.turns],\n193\u2192         }", "is_error": false}}
