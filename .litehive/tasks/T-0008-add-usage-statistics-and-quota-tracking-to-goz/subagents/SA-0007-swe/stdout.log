{"type": "tool_use", "part": {"id": "call_f6e68285fd5e438a984d57f7", "name": "view_file", "input": {"file_path": "goz/cli/usage.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/cli/usage.py (137 lines)\n============================================================\n\n  1\u2192 \"\"\"`goz usage` CLI command for displaying usage statistics and quota.\"\"\"\n  2\u2192 \n  3\u2192 from __future__ import annotations\n  4\u2192 \n  5\u2192 import sys\n  6\u2192 \n  7\u2192 from goz.config import load_config\n  8\u2192 \n  9\u2192 \n 10\u2192 def _fmt_tokens(n: int) -> str:\n 11\u2192     if n >= 1_000_000:\n 12\u2192         return f\"{n / 1_000_000:.2f}M\"\n 13\u2192     if n >= 1_000:\n 14\u2192         return f\"{n / 1_000:.1f}k\"\n 15\u2192     return str(n)\n 16\u2192 \n 17\u2192 \n 18\u2192 def _fmt_cost(cost: float) -> str:\n 19\u2192     if cost < 0.01:\n 20\u2192         return f\"${cost:.4f}\"\n 21\u2192     return f\"${cost:.2f}\"\n 22\u2192 \n 23\u2192 \n 24\u2192 async def cmd_usage(args: list[str]) -> None:\n 25\u2192     if args and args[0] in (\"--help\", \"-h\", \"help\"):\n 26\u2192         print(\"\"\"Usage command:\n 27\u2192 \n 28\u2192   goz usage            Show quota remaining and usage aggregates\n 29\u2192   goz usage --json     Raw JSON output\n 30\u2192   goz usage --days N   Model usage window (default: 7)\n 31\u2192 \n 32\u2192 Endpoints:\n 33\u2192   api.z.ai/api/monitor/usage/quota/limit   - 5-hour quota\n 34\u2192   api.z.ai/api/monitor/usage/model-usage   - Model aggregates\n 35\u2192 \"\"\")\n 36\u2192         return\n 37\u2192 \n 38\u2192     use_json = \"--json\" in args\n 39\u2192     days = 7\n 40\u2192     for i, a in enumerate(args):\n 41\u2192         if a == \"--days\" and i + 1 < len(args):\n 42\u2192             try:\n 43\u2192                 days = int(args[i + 1])\n 44\u2192             except ValueError:\n 45\u2192                 pass\n 46\u2192 \n 47\u2192     from goz.api.monitor import MonitorClient\n 48\u2192 \n 49\u2192     config = load_config()\n 50\u2192     client = MonitorClient(config=config)\n 51\u2192 \n 52\u2192     try:\n 53\u2192         quota = await client.fetch_quota_limit()\n 54\u2192     except Exception as exc:\n 55\u2192         print(f\"Failed to fetch quota: {exc}\", file=sys.stderr)\n 56\u2192         quota = None\n 57\u2192 \n 58\u2192     try:\n 59\u2192         usage_7 = await client.fetch_model_usage(days=days)\n 60\u2192     except Exception as exc:\n 61\u2192         print(f\"Failed to fetch {days}-day usage: {exc}\", file=sys.stderr)\n 62\u2192         usage_7 = None\n 63\u2192 \n 64\u2192     try:\n 65\u2192         usage_30 = await client.fetch_model_usage(days=30)\n 66\u2192     except Exception as exc:\n 67\u2192         print(f\"Failed to fetch 30-day usage: {exc}\", file=sys.stderr)\n 68\u2192         usage_30 = None\n 69\u2192 \n 70\u2192     if use_json:\n 71\u2192         import json\n 72\u2192 \n 73\u2192         out: dict = {}\n 74\u2192         if quota:\n 75\u2192             out[\"quota\"] = {\n 76\u2192                 \"limit\": quota.limit,\n 77\u2192                 \"remaining\": quota.remaining,\n 78\u2192                 \"used\": quota.used,\n 79\u2192                 \"window\": quota.window_label,\n 80\u2192             }\n 81\u2192         if usage_7:\n 82\u2192             out[f\"{usage_7.period_days}_day\"] = [\n 83\u2192                 {\n 84\u2192                     \"model\": e.model,\n 85\u2192                     \"input_tokens\": e.input_tokens,\n 86\u2192                     \"output_tokens\": e.output_tokens,\n 87\u2192                     \"total_tokens\": e.total_tokens,\n 88\u2192                     \"cost\": e.cost,\n 89\u2192                     \"requests\": e.requests,\n 90\u2192                 }\n 91\u2192                 for e in usage_7.entries\n 92\u2192             ]\n 93\u2192         if usage_30:\n 94\u2192             out[\"30_day\"] = [\n 95\u2192                 {\n 96\u2192                     \"model\": e.model,\n 97\u2192                     \"input_tokens\": e.input_tokens,\n 98\u2192                     \"output_tokens\": e.output_tokens,\n 99\u2192                     \"total_tokens\": e.total_tokens,\n100\u2192                     \"cost\": e.cost,\n101\u2192                     \"requests\": e.requests,\n102\u2192                 }\n103\u2192                 for e in usage_30.entries\n104\u2192             ]\n105\u2192         print(json.dumps(out, indent=2, ensure_ascii=True))\n106\u2192         return\n107\u2192 \n108\u2192     if quota:\n109\u2192         pct = (quota.used / quota.limit * 100) if quota.limit else 0\n110\u2192         print(f\"Quota ({quota.window_label}):\")\n111\u2192         print(f\"  Limit:     {_fmt_tokens(quota.limit)} tokens\")\n112\u2192         print(f\"  Used:      {_fmt_tokens(quota.used)} tokens ({pct:.1f}%)\")\n113\u2192         print(f\"  Remaining: {_fmt_tokens(quota.remaining)} tokens\")\n114\u2192         print()\n115\u2192 \n116\u2192     if usage_7:\n117\u2192         print(f\"Model usage ({usage_7.period_days}-day):\")\n118\u2192         if not usage_7.entries:\n119\u2192             print(\"  (no data)\")\n120\u2192         for e in usage_7.entries:\n121\u2192             print(f\"  {e.model}\")\n122\u2192             print(\n123\u2192                 f\"    Input:  {_fmt_tokens(e.input_tokens)}  Output: {_fmt_tokens(e.output_tokens)}  Total: {_fmt_tokens(e.total_tokens)}\"\n124\u2192             )\n125\u2192             print(f\"    Cost:   {_fmt_cost(e.cost)}  Requests: {e.requests}\")\n126\u2192         print()\n127\u2192 \n128\u2192     if usage_30:\n129\u2192         print(\"Model usage (30-day):\")\n130\u2192         if not usage_30.entries:\n131\u2192             print(\"  (no data)\")\n132\u2192         for e in usage_30.entries:\n133\u2192             print(f\"  {e.model}\")\n134\u2192             print(\n135\u2192                 f\"    Input:  {_fmt_tokens(e.input_tokens)}  Output: {_fmt_tokens(e.output_tokens)}  Total: {_fmt_tokens(e.total_tokens)}\"\n136\u2192             )\n137\u2192             print(f\"    Cost:   {_fmt_cost(e.cost)}  Requests: {e.requests}\")", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_643be3387ee84caa9ad03134", "name": "view_file", "input": {"file_path": "goz/api/monitor.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/monitor.py (130 lines)\n============================================================\n\n  1\u2192 \"\"\"Z.AI Monitor API client for usage statistics and quota tracking.\n  2\u2192 \n  3\u2192 Provides access to:\n  4\u2192 - /api/monitor/usage/quota/limit \u2014 5-hour quota remaining\n  5\u2192 - /api/monitor/usage/model-usage \u2014 7-day and 30-day aggregates\n  6\u2192 \"\"\"\n  7\u2192 \n  8\u2192 from __future__ import annotations\n  9\u2192 \n 10\u2192 import logging\n 11\u2192 from dataclasses import dataclass, field\n 12\u2192 from typing import Any\n 13\u2192 \n 14\u2192 import httpx\n 15\u2192 \n 16\u2192 from goz.config import Config\n 17\u2192 \n 18\u2192 logger = logging.getLogger(__name__)\n 19\u2192 \n 20\u2192 \n 21\u2192 @dataclass\n 22\u2192 class QuotaInfo:\n 23\u2192     limit: int\n 24\u2192     remaining: int\n 25\u2192     used: int\n 26\u2192     window_label: str\n 27\u2192     raw: dict[str, Any] = field(default_factory=dict)\n 28\u2192 \n 29\u2192 \n 30\u2192 @dataclass\n 31\u2192 class ModelUsageEntry:\n 32\u2192     model: str\n 33\u2192     input_tokens: int\n 34\u2192     output_tokens: int\n 35\u2192     total_tokens: int\n 36\u2192     cost: float\n 37\u2192     requests: int\n 38\u2192     raw: dict[str, Any] = field(default_factory=dict)\n 39\u2192 \n 40\u2192 \n 41\u2192 @dataclass\n 42\u2192 class ModelUsageReport:\n 43\u2192     period_days: int\n 44\u2192     entries: list[ModelUsageEntry] = field(default_factory=list)\n 45\u2192     raw: dict[str, Any] = field(default_factory=dict)\n 46\u2192 \n 47\u2192 \n 48\u2192 class MonitorClient:\n 49\u2192     def __init__(self, config: Config | None = None) -> None:\n 50\u2192         if config is None:\n 51\u2192             from goz.config import load_config\n 52\u2192 \n 53\u2192             config = load_config()\n 54\u2192         self.config = config\n 55\u2192 \n 56\u2192     def _base(self) -> str:\n 57\u2192         url = self.config.zai_base_url\n 58\u2192         if \"/api/anthropic\" in url:\n 59\u2192             url = url.replace(\"/api/anthropic\", \"\")\n 60\u2192         return url.rstrip(\"/\")\n 61\u2192 \n 62\u2192     def _headers(self) -> dict[str, str]:\n 63\u2192         return {\n 64\u2192             \"Authorization\": f\"Bearer {self.config.zai_token}\",\n 65\u2192             \"Content-Type\": \"application/json\",\n 66\u2192         }\n 67\u2192 \n 68\u2192     async def fetch_quota_limit(self) -> QuotaInfo:\n 69\u2192         base = self._base()\n 70\u2192         url = f\"{base}/api/monitor/usage/quota/limit\"\n 71\u2192         async with httpx.AsyncClient(timeout=self.config.timeout) as client:\n 72\u2192             resp = await client.get(url, headers=self._headers())\n 73\u2192             resp.raise_for_status()\n 74\u2192             data = resp.json()\n 75\u2192 \n 76\u2192         if isinstance(data, dict) and \"data\" in data:\n 77\u2192             inner = data[\"data\"]\n 78\u2192         elif isinstance(data, dict):\n 79\u2192             inner = data\n 80\u2192         else:\n 81\u2192             inner = {}\n 82\u2192 \n 83\u2192         limit = inner.get(\"limit\", inner.get(\"total\", 0))\n 84\u2192         used = inner.get(\"used\", inner.get(\"consumed\", 0))\n 85\u2192         remaining = inner.get(\"remaining\", max(0, limit - used))\n 86\u2192         window = inner.get(\"window\", inner.get(\"period\", \"5h\"))\n 87\u2192 \n 88\u2192         return QuotaInfo(\n 89\u2192             limit=limit,\n 90\u2192             remaining=remaining,\n 91\u2192             used=used,\n 92\u2192             window_label=str(window),\n 93\u2192             raw=data,\n 94\u2192         )\n 95\u2192 \n 96\u2192     async def fetch_model_usage(self, days: int = 7) -> ModelUsageReport:\n 97\u2192         base = self._base()\n 98\u2192         url = f\"{base}/api/monitor/usage/model-usage\"\n 99\u2192         params: dict[str, Any] = {\"days\": days}\n100\u2192 \n101\u2192         async with httpx.AsyncClient(timeout=self.config.timeout) as client:\n102\u2192             resp = await client.get(url, headers=self._headers(), params=params)\n103\u2192             resp.raise_for_status()\n104\u2192             data = resp.json()\n105\u2192 \n106\u2192         entries: list[ModelUsageEntry] = []\n107\u2192         items: list[dict[str, Any]] = []\n108\u2192         if isinstance(data, dict) and \"data\" in data:\n109\u2192             items = data[\"data\"] if isinstance(data[\"data\"], list) else []\n110\u2192         elif isinstance(data, list):\n111\u2192             items = data\n112\u2192 \n113\u2192         for item in items:\n114\u2192             entries.append(\n115\u2192                 ModelUsageEntry(\n116\u2192                     model=item.get(\"model\", \"unknown\"),\n117\u2192                     input_tokens=item.get(\"input_tokens\", 0),\n118\u2192                     output_tokens=item.get(\"output_tokens\", 0),\n119\u2192                     total_tokens=item.get(\n120\u2192                         \"total_tokens\", item.get(\"input_tokens\", 0) + item.get(\"output_tokens\", 0)\n121\u2192                     ),\n122\u2192                     cost=item.get(\"cost\", 0.0),\n123\u2192                     requests=item.get(\"requests\", item.get(\"request_count\", 0)),\n124\u2192                     raw=item,\n125\u2192                 )\n126\u2192             )\n127\u2192 \n128\u2192         return ModelUsageReport(\n129\u2192             period_days=days, entries=entries, raw=data if isinstance(data, dict) else {}\n130\u2192         )", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_75ece846bcf54278a48afa97", "name": "view_file", "input": {"file_path": "goz/agent/quota.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/quota.py (158 lines)\n============================================================\n\n  1\u2192 \"\"\"Z.AI quota and usage monitor API client.\n  2\u2192 \n  3\u2192 Calls the Z.AI monitor endpoints to retrieve quota limits and historical\n  4\u2192 usage aggregates for display in the ``goz usage`` CLI command.\n  5\u2192 \n  6\u2192 Endpoints:\n  7\u2192 - ``api.z.ai/api/monitor/usage/quota/limit`` \u2192 5-hour quota remaining\n  8\u2192 - ``api.z.ai/api/monitor/usage/model-usage`` \u2192 7-day and 30-day aggregates\n  9\u2192 \"\"\"\n 10\u2192 \n 11\u2192 from __future__ import annotations\n 12\u2192 \n 13\u2192 import logging\n 14\u2192 from dataclasses import dataclass\n 15\u2192 from typing import Any\n 16\u2192 \n 17\u2192 import httpx\n 18\u2192 \n 19\u2192 from goz.config import Config, DEFAULT_ZAI_BASE_URL\n 20\u2192 \n 21\u2192 logger = logging.getLogger(__name__)\n 22\u2192 \n 23\u2192 # The monitor API uses a different base than the Anthropic-compatible one.\n 24\u2192 _MONITOR_BASE = \"https://api.z.ai/api/monitor\"\n 25\u2192 \n 26\u2192 \n 27\u2192 @dataclass\n 28\u2192 class QuotaLimitInfo:\n 29\u2192     \"\"\"Parsed response from the quota/limit endpoint.\"\"\"\n 30\u2192 \n 31\u2192     quota_limit: int = 0\n 32\u2192     quota_remaining: int = 0\n 33\u2192     quota_used: int = 0\n 34\u2192     reset_at: str | None = None\n 35\u2192 \n 36\u2192     def usage_percent(self) -> float:\n 37\u2192         if self.quota_limit <= 0:\n 38\u2192             return 0.0\n 39\u2192         return (self.quota_used / self.quota_limit) * 100.0\n 40\u2192 \n 41\u2192 \n 42\u2192 @dataclass\n 43\u2192 class ModelUsageAggregate:\n 44\u2192     \"\"\"Parsed response from the model-usage endpoint.\"\"\"\n 45\u2192 \n 46\u2192     model: str = \"\"\n 47\u2192     input_tokens: int = 0\n 48\u2192     output_tokens: int = 0\n 49\u2192     total_tokens: int = 0\n 50\u2192     period: str = \"\"  # e.g. \"7d\", \"30d\"\n 51\u2192 \n 52\u2192 \n 53\u2192 @dataclass\n 54\u2192 class QuotaDashboard:\n 55\u2192     \"\"\"Combined quota and usage data for the ``goz usage`` display.\"\"\"\n 56\u2192 \n 57\u2192     quota: QuotaLimitInfo | None = None\n 58\u2192     aggregates_7d: list[ModelUsageAggregate] | None = None\n 59\u2192     aggregates_30d: list[ModelUsageAggregate] | None = None\n 60\u2192     error: str | None = None\n 61\u2192 \n 62\u2192 \n 63\u2192 class QuotaClient:\n 64\u2192     \"\"\"Client for the Z.AI monitor/usage API.\"\"\"\n 65\u2192 \n 66\u2192     def __init__(self, config: Config | None = None) -> None:\n 67\u2192         if config is None:\n 68\u2192             from goz.config import load_config\n 69\u2192             config = load_config()\n 70\u2192         self.config = config\n 71\u2192         self._headers = {\n 72\u2192             \"Authorization\": f\"Bearer {config.zai_token}\",\n 73\u2192             \"Accept\": \"application/json\",\n 74\u2192         }\n 75\u2192 \n 76\u2192     async def _get(self, path: str) -> dict[str, Any]:\n 77\u2192         \"\"\"Make an authenticated GET request to the monitor API.\"\"\"\n 78\u2192         url = f\"{_MONITOR_BASE}/{path.lstrip('/')}\"\n 79\u2192         async with httpx.AsyncClient(timeout=15.0) as client:\n 80\u2192             resp = await client.get(url, headers=self._headers)\n 81\u2192             resp.raise_for_status()\n 82\u2192             return resp.json()\n 83\u2192 \n 84\u2192     async def get_quota_limit(self) -> QuotaLimitInfo:\n 85\u2192         \"\"\"Fetch 5-hour quota limit and remaining tokens.\n 86\u2192 \n 87\u2192         Calls ``api.z.ai/api/monitor/usage/quota/limit``.\n 88\u2192         \"\"\"\n 89\u2192         try:\n 90\u2192             data = await self._get(\"usage/quota/limit\")\n 91\u2192             # The response shape may vary; handle common patterns.\n 92\u2192             if isinstance(data, dict):\n 93\u2192                 return QuotaLimitInfo(\n 94\u2192                     quota_limit=data.get(\"quota_limit\", data.get(\"limit\", 0)),\n 95\u2192                     quota_remaining=data.get(\"quota_remaining\", data.get(\"remaining\", 0)),\n 96\u2192                     quota_used=data.get(\"quota_used\", data.get(\"used\", 0)),\n 97\u2192                     reset_at=data.get(\"reset_at\", data.get(\"resets_at\")),\n 98\u2192                 )\n 99\u2192         except httpx.HTTPStatusError as exc:\n100\u2192             logger.warning(\"Quota limit request failed: %s\", exc)\n101\u2192         except Exception as exc:\n102\u2192             logger.warning(\"Quota limit request error: %s\", exc)\n103\u2192         return QuotaLimitInfo()\n104\u2192 \n105\u2192     async def get_model_usage(self) -> dict[str, list[ModelUsageAggregate]]:\n106\u2192         \"\"\"Fetch model usage aggregates.\n107\u2192 \n108\u2192         Calls ``api.z.ai/api/monitor/usage/model-usage``.\n109\u2192 \n110\u2192         Returns:\n111\u2192             A dict with ``\"7d\"`` and ``\"30d\"`` keys mapping to lists of\n112\u2192             :class:`ModelUsageAggregate`.\n113\u2192         \"\"\"\n114\u2192         result: dict[str, list[ModelUsageAggregate]] = {\"7d\": [], \"30d\": []}\n115\u2192         try:\n116\u2192             data = await self._get(\"usage/model-usage\")\n117\u2192             if isinstance(data, list):\n118\u2192                 for entry in data:\n119\u2192                     agg = ModelUsageAggregate(\n120\u2192                         model=entry.get(\"model\", entry.get(\"model_id\", \"\")),\n121\u2192                         input_tokens=entry.get(\"input_tokens\", 0),\n122\u2192                         output_tokens=entry.get(\"output_tokens\", 0),\n123\u2192                         total_tokens=entry.get(\"total_tokens\", entry.get(\"input_tokens\", 0) + entry.get(\"output_tokens\", 0)),\n124\u2192                         period=entry.get(\"period\", \"\"),\n125\u2192                     )\n126\u2192                     period = agg.period.lower() if agg.period else \"\"\n127\u2192                     if \"30\" in period:\n128\u2192                         result[\"30d\"].append(agg)\n129\u2192                     else:\n130\u2192                         result[\"7d\"].append(agg)\n131\u2192             elif isinstance(data, dict):\n132\u2192                 for period_key, entries in data.items():\n133\u2192                     key = \"30d\" if \"30\" in str(period_key).lower() else \"7d\"\n134\u2192                     if isinstance(entries, list):\n135\u2192                         for entry in entries:\n136\u2192                             agg = ModelUsageAggregate(\n137\u2192                                 model=entry.get(\"model\", entry.get(\"model_id\", \"\")),\n138\u2192                                 input_tokens=entry.get(\"input_tokens\", 0),\n139\u2192                                 output_tokens=entry.get(\"output_tokens\", 0),\n140\u2192                                 total_tokens=entry.get(\"total_tokens\", entry.get(\"input_tokens\", 0) + entry.get(\"output_tokens\", 0)),\n141\u2192                                 period=str(period_key),\n142\u2192                             )\n143\u2192                             result[key].append(agg)\n144\u2192         except httpx.HTTPStatusError as exc:\n145\u2192             logger.warning(\"Model usage request failed: %s\", exc)\n146\u2192         except Exception as exc:\n147\u2192             logger.warning(\"Model usage request error: %s\", exc)\n148\u2192         return result\n149\u2192 \n150\u2192     async def get_dashboard(self) -> QuotaDashboard:\n151\u2192         \"\"\"Fetch all quota/usage data for the usage command display.\"\"\"\n152\u2192         quota = await self.get_quota_limit()\n153\u2192         usage = await self.get_model_usage()\n154\u2192         return QuotaDashboard(\n155\u2192             quota=quota,\n156\u2192             aggregates_7d=usage.get(\"7d\"),\n157\u2192             aggregates_30d=usage.get(\"30d\"),\n158\u2192         )", "is_error": false}}
