to parameter \"stdout\" of type \"TextIO\" in function \"emit_error_event\"\n  Type \"TextIO | None\" is not assignable to type \"TextIO\"\n    \"None\" is not assignable to \"TextIO\"","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}}],"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/__main__.py":[{"range":{"start":{"line":849,"character":19},"end":{"line":849,"character":24}},"message":"Import \"httpx\" could not be resolved","severity":1,"code":"reportMissingImports","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportMissingImports"}},{"range":{"start":{"line":261,"character":47},"end":{"line":261,"character":54}},"message":"Argument of type \"Unknown | None\" cannot be assigned to parameter \"source\" of type \"str\" in function \"analyze\"\n  Type \"Unknown | None\" is not assignable to type \"str\"\n    \"None\" is not assignable to \"str\"","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}},{"range":{"start":{"line":270,"character":57},"end":{"line":270,"character":64}},"message":"Argument of type \"Unknown | None\" cannot be assigned to parameter \"source\" of type \"str\" in function \"analyze_stream\"\n  Type \"Unknown | None\" is not assignable to type \"str\"\n    \"None\" is not assignable to \"str\"","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}},{"range":{"start":{"line":854,"character":16},"end":{"line":854,"character":21}},"message":"\"httpx\" is possibly unbound","severity":1,"code":"reportPossiblyUnboundVariable","source":"Pyright","codeDescription":