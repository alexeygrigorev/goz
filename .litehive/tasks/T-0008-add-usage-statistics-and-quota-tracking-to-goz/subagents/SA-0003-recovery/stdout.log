{"type":"tool_use","timestamp":1775338509495,"sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","part":{"id":"prt_d5a6bd4a7001rIsRrfIcgnOnI4","sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","messageID":"msg_d5a6baa650016R3meKV8LsIvM9","type":"tool","callID":"call_8f6c474c2605433b823d659f","tool":"read","state":{"status":"completed","input":{"filePath":"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/usage.py"},"output":"<path>/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/usage.py</path>\n<type>file</type>\n<content>1: \"\"\"Usage tracking for Z.AI token consumption and cost.\n2: \n3: This module provides data structures and utilities for tracking token usage\n4: across streaming API responses, computing costs, and accumulating per-session\n5: statistics.\n6: \n7: Acceptance Criteria (T-0008):\n8: - Per-turn token counts extracted from message_start/message_delta events\n9: - Accumulated in session state\n10: - step_finish JSONL event includes tokens and cost\n11: \"\"\"\n12: \n13: from __future__ import annotations\n14: \n15: import math\n16: from dataclasses import dataclass, field\n17: \n18: \n19: # Approximate per-Mtoken pricing (USD) for common models.\n20: # These are best-effort estimates; actual billing comes from the API.\n21: _MODEL_PRICING: dict[str, dict[str, float]] = {\n22:     \"glm-5-turbo\": {\"input\": 2.0, \"output\": 8.0, \"cache_read\": 0.5, \"cache_creation\": 2.5},\n23:     \"glm-4.6v\": {\"input\": 2.0, \"output\": 8.0, \"cache_read\": 0.5, \"cache_creation\": 2.5},\n24:     \"claude-sonnet-4-20250514\": {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75},\n25:     \"claude-3-5-sonnet-20241022\": {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75},\n26: }\n27: \n28: _DEFAULT_PRICING = {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75}\n29: \n30: \n31: def _get_pricing(model: str) -> dict[str, float]:\n32:     \"\"\"Return pricing dict for *model*, falling back to defaults.\"\"\"\n33:     for key, pricing in _MODEL_PRICING.items():\n34:         if key in model:\n35:             return pricing\n36:     return _DEFAULT_PRICING\n37: \n38: \n39: @dataclass\n40: class UsageSnapshot:\n41:     \"\"\"Token counts from a single API response (one streaming turn).\n42: \n43:     Attributes:\n44:         input_tokens: Total input tokens for the request.\n45:         output_tokens: Total output tokens generated.\n46:         cache_read_input_tokens: Tokens served from prompt cache (read).\n47:         cache_creation_input_tokens: Tokens stored into prompt cache (write).\n48:     \"\"\"\n49: \n50:     input_tokens: int = 0\n51:     output_tokens: int = 0\n52:     cache_read_input_tokens: int = 0\n53:     cache_creation_input_tokens: int = 0\n54: \n55:     def cost_usd(self, model: str = \"\") -> float:\n56:         \"\"\"Compute approximate USD cost for this snapshot.\"\"\"\n57:         pricing = _get_pricing(model)\n58:         return (\n59:             self.input_tokens * pricing[\"input\"]\n60:             + self.output_tokens * pricing[\"output\"]\n61:             + self.cache_read_input_tokens * pricing[\"cache_read\"]\n62:             + self.cache_creation_input_tokens * pricing[\"cache_creation\"]\n63:         ) / 1_000_000.0\n64: \n65:     def total_tokens(self) -> int:\n66:         \"\"\"Return the sum of all token counts.\"\"\"\n67:         return (\n68:             self.input_tokens\n69:             + self.output_tokens\n70:             + self.cache_read_input_tokens\n71:             + self.cache_creation_input_tokens\n72:         )\n73: \n74:     def to_dict(self) -> dict:\n75:         \"\"\"Serialise to a plain dict (for JSONL emission).\"\"\"\n76:         return {\n77:             \"input\": self.input_tokens,\n78:             \"output\": self.output_tokens,\n79:             \"cache_read\": self.cache_read_input_tokens,\n80:             \"cache_creation\": self.cache_creation_input_tokens,\n81:         }\n82: \n83: \n84: @dataclass\n85: class UsageAccumulator:\n86:     \"\"\"Accumulates usage across multiple turns in a session.\n87: \n88:     Usage is captured in two phases per streaming response:\n89:     1. ``message_start`` carries initial input / cache tokens.\n90:     2. ``message_delta`` carries the final output token count.\n91: \n92:     The accumulator merges these into a :class:`UsageSnapshot` per turn\n93:     and maintains running totals.\n94:     \"\"\"\n95: \n96:     # Running totals across all turns\n97:     total_input_tokens: int = 0\n98:     total_output_tokens: int = 0\n99:     total_cache_read_tokens: int = 0\n100:     total_cache_creation_tokens: int = 0\n101:     turn_count: int = 0\n102: \n103:     # Per-turn snapshots (append-only)\n104:     turns: list[UsageSnapshot] = field(default_factory=list)\n105: \n106:     # --- Streaming helpers ---------------------------------------------------\n107: \n108:     def begin_turn(self) -> None:\n109:         \"\"\"Prepare for a new streaming turn.\"\"\"\n110:         self.turns.append(UsageSnapshot())\n111: \n112:     def apply_message_start(self, usage: object) -> None:\n113:         \"\"\"Merge ``message_start`` usage data into the current turn.\n114: \n115:         Args:\n116:             usage: An object with ``input_tokens``, optionally\n117:                 ``cache_read_input_tokens`` and ``cache_creation_input_tokens``.\n118:         \"\"\"\n119:         if not self.turns:\n120:             self.begin_turn()\n121:         snap = self.turns[-1]\n122:         snap.input_tokens = getattr(usage, \"input_tokens\", 0) or 0\n123:         snap.cache_read_input_tokens = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n124:         snap.cache_creation_input_tokens = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n125: \n126:     def apply_message_delta(self, usage: object) -> None:\n127:         \"\"\"Merge ``message_delta`` usage data into the current turn.\n128: \n129:         Args:\n130:             usage: An object with ``output_tokens``, optionally cumulative\n131:                 ``input_tokens``, ``cache_read_input_tokens``, etc.\n132:         \"\"\"\n133:         if not self.turns:\n134:             self.begin_turn()\n135:         snap = self.turns[-1]\n136:         # message_delta carries cumulative output_tokens\n137:         snap.output_tokens = getattr(usage, \"output_tokens\", 0) or 0\n138:         # Update input/cache if provided (some APIs send cumulative totals here)\n139:         if hasattr(usage, \"input_tokens\") and usage.input_tokens is not None:\n140:             snap.input_tokens = usage.input_tokens\n141:         if hasattr(usage, \"cache_read_input_tokens\") and usage.cache_read_input_tokens is not None:\n142:             snap.cache_read_input_tokens = usage.cache_read_input_tokens\n143:         if hasattr(usage, \"cache_creation_input_tokens\") and usage.cache_creation_input_tokens is not None:\n144:             snap.cache_creation_input_tokens = usage.cache_creation_input_tokens\n145: \n146:     def finalise_turn(self) -> UsageSnapshot:\n147:         \"\"\"Close the current turn, roll into running totals, and return it.\"\"\"\n148:         if not self.turns:\n149:             return UsageSnapshot()\n150:         snap = self.turns[-1]\n151:         self.total_input_tokens += snap.input_tokens\n152:         self.total_output_tokens += snap.output_tokens\n153:         self.total_cache_read_tokens += snap.cache_read_input_tokens\n154:         self.total_cache_creation_tokens += snap.cache_creation_input_tokens\n155:         self.turn_count += 1\n156:         return snap\n157: \n158:     def current_turn_snapshot(self) -> UsageSnapshot:\n159:         \"\"\"Return the in-progress snapshot for the current turn.\"\"\"\n160:         if not self.turns:\n161:             return UsageSnapshot()\n162:         return self.turns[-1]\n163: \n164:     # --- Aggregation ---------------------------------------------------------\n165: \n166:     def total_tokens(self) -> int:\n167:         return (\n168:             self.total_input_tokens\n169:             + self.total_output_tokens\n170:             + self.total_cache_read_tokens\n171:             + self.total_cache_creation_tokens\n172:         )\n173: \n174:     def total_cost_usd(self, model: str = \"\") -> float:\n175:         pricing = _get_pricing(model)\n176:         return (\n177:             self.total_input_tokens * pricing[\"input\"]\n178:             + self.total_output_tokens * pricing[\"output\"]\n179:             + self.total_cache_read_tokens * pricing[\"cache_read\"]\n180:             + self.total_cache_creation_tokens * pricing[\"cache_creation\"]\n181:         ) / 1_000_000.0\n182: \n183:     def to_dict(self) -> dict:\n184:         \"\"\"Serialise full accumulator state.\"\"\"\n185:         return {\n186:             \"turn_count\": self.turn_count,\n187:             \"total_input\": self.total_input_tokens,\n188:             \"total_output\": self.total_output_tokens,\n189:             \"total_cache_read\": self.total_cache_read_tokens,\n190:             \"total_cache_creation\": self.total_cache_creation_tokens,\n191:             \"total_tokens\": self.total_tokens(),\n192:             \"turns\": [t.to_dict() for t in self.turns],\n193:         }\n\n(End of file - total 193 lines)\n</content>","title":"goz/agent/usage.py","metadata":{"preview":"\"\"\"Usage tracking for Z.AI token consumption and cost.\n\nThis module provides data structures and utilities for tracking token usage\nacross streaming API responses, computing costs, and accumulating per-session\nstatistics.\n\nAcceptance Criteria (T-0008):\n- Per-turn token counts extracted from message_start/message_delta events\n- Accumulated in session state\n- step_finish JSONL event includes tokens and cost\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nfrom dataclasses import dataclass, field\n\n\n# Approximate per-Mtoken pricing (USD) for common models.\n# These are best-effort estimates; actual billing comes from the API.","truncated":false,"loaded":[]},"time":{"start":1775338509480,"end":1775338509492}}}}
{"type":"tool_use","timestamp":1775338509496,"sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","part":{"id":"prt_d5a6bd4a8001spq40ds5WlhRud","sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","messageID":"msg_d5a6baa650016R3meKV8LsIvM9","type":"tool","callID":"call_448f977263bb43228aec66db","tool":"read","state":{"status":"completed","input":{"filePath":"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/chat_client.py"},"output":"<path>/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/chat_client.py</path>\n<type>file</type>\n<content>1: \"\"\"Chat API Client for Z.AI (Issue 17).\n2: \n3: This module provides the ChatClient class for interacting with the Z.AI\n4: chat API using the Anthropic SDK with tool calling support.\n5: \n6: Acceptance Criteria:\n7: 1. ChatClient class exists in goz/agent/chat_client.py\n8: 2. Uses existing Anthropic SDK (same as Vision API)\n9: 3. Uses config.zai_token and config.zai_base_url\n10: 4. chat_completion() method sends messages and returns async iterator\n11: 5. Supports tools parameter for function calling\n12: 6. Supports tool_choice parameter (\"auto\", \"any\")\n13: 7. Supports stream parameter (True/False)\n14: 8. Response chunks yield text deltas\n15: 9. Tool calls are properly formatted in stream\n16: 10. Errors raised as appropriate exceptions (AuthError, ApiError, etc.)\n17: 11. Timeout configurable via config\n18: \"\"\"\n19: import asyncio\n20: import json\n21: from dataclasses import dataclass\n22: from typing import Any, AsyncIterator, Literal\n23: \n24: import anthropic\n25: from anthropic import AsyncAnthropic\n26: \n27: from goz.api.errors import AuthError, ApiError, NetworkError, TimeoutError, ZaiError\n28: from goz.config import Config\n29: \n30: \n31: # Chunk types for streaming responses (from spec)\n32: @dataclass\n33: class ContentBlockStart:\n34:     \"\"\"Start of a content block in the stream.\n35: \n36:     Attributes:\n37:         type: The type of content block (\"text\" or \"tool_use\")\n38:         index: The index of this content block\n39:         id: Tool call ID (only for tool_use type)\n40:         name: Tool name (only for tool_use type)\n41:     \"\"\"\n42:     type: Literal[\"text\", \"tool_use\"]\n43:     index: int\n44:     id: str | None = None\n45:     name: str | None = None\n46: \n47: \n48: @dataclass\n49: class ContentBlockDelta:\n50:     \"\"\"Delta for a content block in the stream.\n51: \n52:     Attributes:\n53:         type: The type of delta (\"text_delta\" or \"input_json_delta\")\n54:         index: The index of this content block\n55:         text: Text content (only for text_delta type)\n56:         partial_json: Partial JSON string (only for input_json_delta type)\n57:     \"\"\"\n58:     type: Literal[\"text_delta\", \"input_json_delta\"]\n59:     index: int\n60:     text: str | None = None\n61:     partial_json: str | None = None\n62: \n63: \n64: @dataclass\n65: class ContentBlockStop:\n66:     \"\"\"End of a content block in the stream.\n67: \n68:     Attributes:\n69:         index: The index of this content block\n70:     \"\"\"\n71:     index: int\n72: \n73: \n74: @dataclass\n75: class MessageStart:\n76:     \"\"\"Start of the message.\n77: \n78:     Attributes:\n79:         id: Message ID\n80:         model: Model name\n81:     \"\"\"\n82:     id: str\n83:     model: str\n84: \n85: \n86: @dataclass\n87: class MessageStop:\n88:     \"\"\"End of the message.\n89: \n90:     Attributes:\n91:         stop_reason: Reason for stopping (\"end_turn\", \"max_tokens\", \"tool_use\")\n92:     \"\"\"\n93:     stop_reason: Literal[\"end_turn\", \"max_tokens\", \"tool_use\"]\n94: \n95: \n96: # Union type for all chunk types\n97: Chunk = ContentBlockStart | ContentBlockDelta | ContentBlockStop | MessageStart | MessageStop\n98: \n99: \n100: class ChatClient:\n101:     \"\"\"Client for Z.AI Chat API with tool calling support.\n102: \n103:     This client uses the Anthropic SDK to interact with the Z.AI chat API,\n104:     supporting streaming responses, tool calling, and various generation\n105:     parameters.\n106: \n107:     Attributes:\n108:         config: Configuration object containing API credentials and settings\n109:         _client: Internal AsyncAnthropic client instance\n110:     \"\"\"\n111: \n112:     def __init__(self, config: Config | None = None) -> None:\n113:         \"\"\"Initialize ChatClient.\n114: \n115:         Args:\n116:             config: Optional config object. If not provided, loads from default location.\n117: \n118:         Acceptance Criteria:\n119:         - Uses config.zai_token and config.zai_base_url (AC 3)\n120:         - Uses AsyncAnthropic from existing SDK (AC 2)\n121:         - Timeout is configurable via config (AC 11)\n122:         \"\"\"\n123:         if config is None:\n124:             from goz.config import load_config\n125:             config = load_config()\n126: \n127:         self.config = config\n128: \n129:         # Initialize async Anthropic client (same pattern as VisionClient)\n130:         self._client = AsyncAnthropic(\n131:             api_key=self.config.zai_token,\n132:             base_url=self.config.zai_base_url,\n133:             timeout=self.config.timeout,\n134:         )\n135:         self.max_retries = 2\n136:         self.base_retry_delay = 1.0\n137: \n138:     async def chat_completion(\n139:         self,\n140:         messages: list[dict],\n141:         tools: list[dict] | None = None,\n142:         tool_choice: Literal[\"auto\", \"any\", \"none\"] | dict = \"auto\",\n143:         stream: bool = True,\n144:         temperature: float | None = None,\n145:         max_tokens: int | None = None,\n146:     ) -> AsyncIterator[Chunk]:\n147:         \"\"\"Stream chat completion with tool calling support.\n148: \n149:         Args:\n150:             messages: Chat history in Anthropic format\n151:             tools: Tool definitions in Anthropic format (optional)\n152:             tool_choice: How to select tools (\"auto\", \"any\", \"none\", or specific tool dict)\n153:             stream: Whether to stream response (True) or wait for complete response (False)\n154:             temperature: Generation temperature (uses config default if None)\n155:             max_tokens: Max tokens in response (uses config default if None)\n156: \n157:         Yields:\n158:             Chunk objects from the API response\n159: \n160:         Raises:\n161:             AuthError: For 401/403 authentication failures\n162:             ApiError: For other API errors (4xx, 5xx)\n163:             NetworkError: For connection failures\n164:             TimeoutError: For request timeouts\n165: \n166:         Acceptance Criteria:\n167:         - Returns async iterator (AC 4)\n168:         - Supports tools parameter (AC 5)\n169:         - Supports tool_choice parameter (AC 6)\n170:         - Supports stream parameter (AC 7)\n171:         - Response chunks yield text deltas (AC 8)\n172:         - Tool calls properly formatted in stream (AC 9)\n173:         - Errors raised as appropriate exceptions (AC 10)\n174:         \"\"\"\n175:         # Build request parameters\n176:         params: dict = {\n177:             \"model\": self.config.chat_model,\n178:             \"messages\": messages,\n179:         }\n180: \n181:         # Add optional parameters\n182:         if tools is not None:\n183:             params[\"tools\"] = tools\n184: \n185:         if tool_choice != \"auto\":\n186:             params[\"tool_choice\"] = tool_choice\n187: \n188:         if temperature is not None:\n189:             params[\"temperature\"] = temperature\n190:         else:\n191:             params[\"temperature\"] = self.config.temperature\n192: \n193:         if max_tokens is not None:\n194:             params[\"max_tokens\"] = max_tokens\n195:         else:\n196:             params[\"max_tokens\"] = self.config.max_tokens\n197: \n198:         timeout_ms = int(self.config.timeout * 1000)\n199: \n200:         for attempt in range(self.max_retries + 1):\n201:             try:\n202:                 if stream:\n203:                     async with self._client.messages.stream(**params) as response_stream:\n204:                         async for event in response_stream:\n205:                             chunk = self._convert_sse_event_to_chunk(event)\n206:                             if chunk is not None:\n207:                                 yield chunk\n208:                 else:\n209:                     response = await self._client.messages.create(**params)\n210:                     async for chunk in self._response_to_chunks(response):\n211:                         yield chunk\n212:                 return\n213:             except anthropic.AuthenticationError as e:\n214:                 status_code = getattr(getattr(e, \"response\", None), \"status_code\", 401)\n215:                 raise AuthError(\n216:                     \"Authentication failed. Check your API token and try again.\",\n217:                     statusCode=status_code,\n218:                 ) from e\n219:             except anthropic.APITimeoutError as e:\n220:                 timeout_error = TimeoutError(timeoutMs=timeout_ms)\n221:                 if attempt >= self.max_retries:\n222:                     raise timeout_error from e\n223:                 await self._sleep_before_retry(attempt)\n224:             except anthropic.APIConnectionError as e:\n225:                 network_error = NetworkError(\n226:                     \"Connection failed while contacting the API. Check your network and retry.\"\n227:                 )\n228:                 if attempt >= self.max_retries:\n229:                     raise network_error from e\n230:                 await self._sleep_before_retry(attempt)\n231:             except anthropic.APIStatusError as e:\n232:                 status_code = getattr(e, \"status_code\", None) or getattr(\n233:                     getattr(e, \"response\", None), \"status_code\", 500\n234:                 )\n235:                 if status_code in (401, 403):\n236:                     raise AuthError(\n237:                         \"Authentication failed. Check your API token and try again.\",\n238:                         statusCode=status_code,\n239:                     ) from e\n240: \n241:                 if status_code == 429:\n242:                     api_error = ApiError(\n243:                         \"Rate limit exceeded. Wait a moment and retry, or reduce request volume.\",\n244:                         statusCode=status_code,\n245:                     )\n246:                 elif status_code >= 500:\n247:                     api_error = ApiError(\n248:                         \"Server error from the API. Retry shortly; the service may be degraded.\",\n249:                         statusCode=status_code,\n250:                     )\n251:                 else:\n252:                     api_error = ApiError(str(e), statusCode=status_code)\n253: \n254:                 if attempt >= self.max_retries or status_code < 500 and status_code != 429:\n255:                     raise api_error from e\n256:                 await self._sleep_before_retry(attempt)\n257:             except Exception as e:\n258:                 raise ZaiError(f\"Unexpected error: {e}\") from e\n259: \n260:     def _convert_sse_event_to_chunk(self, event: anthropic.types.RawMessageStreamEvent) -> Chunk | None:\n261:         \"\"\"Convert Anthropic SSE event to our Chunk type.\n262: \n263:         Args:\n264:             event: Raw SSE event from Anthropic SDK\n265: \n266:         Returns:\n267:             Chunk object or None if event type not handled\n268:         \"\"\"\n269:         event_type = event.type\n270: \n271:         if event_type == \"message_start\":\n272:             return MessageStart(\n273:                 id=event.message.id,\n274:                 model=event.message.model,\n275:             )\n276: \n277:         elif event_type == \"content_block_start\":\n278:             content_block = event.content_block\n279:             if content_block.type == \"text\":\n280:                 return ContentBlockStart(\n281:                     type=\"text\",\n282:                     index=event.index,\n283:                 )\n284:             elif content_block.type == \"tool_use\":\n285:                 return ContentBlockStart(\n286:                     type=\"tool_use\",\n287:                     index=event.index,\n288:                     id=content_block.id,\n289:                     name=content_block.name,\n290:                 )\n291: \n292:         elif event_type == \"content_block_delta\":\n293:             delta = event.delta\n294:             if delta.type == \"text_delta\":\n295:                 return ContentBlockDelta(\n296:                     type=\"text_delta\",\n297:                     index=event.index,\n298:                     text=delta.text,\n299:                 )\n300:             elif delta.type == \"input_json_delta\":\n301:                 return ContentBlockDelta(\n302:                     type=\"input_json_delta\",\n303:                     index=event.index,\n304:                     partial_json=delta.partial_json,\n305:                 )\n306: \n307:         elif event_type == \"content_block_stop\":\n308:             return ContentBlockStop(index=event.index)\n309: \n310:         elif event_type == \"message_stop\":\n311:             return MessageStop(stop_reason=event.message.stop_reason)\n312: \n313:         # Return None for unhandled event types\n314:         return None\n315: \n316:     async def _response_to_chunks(self, response: anthropic.types.Message) -> AsyncIterator[Chunk]:\n317:         \"\"\"Convert non-streaming response to chunk stream.\n318: \n319:         Args:\n320:             response: Complete response from messages.create()\n321: \n322:         Yields:\n323:             Chunk objects representing the response\n324:         \"\"\"\n325:         # Yield message start\n326:         yield MessageStart(id=response.id, model=response.model)\n327: \n328:         # Yield content blocks\n329:         for index, block in enumerate(response.content):\n330:             if block.type == \"text\":\n331:                 yield ContentBlockStart(type=\"text\", index=index)\n332:                 yield ContentBlockDelta(type=\"text_delta\", index=index, text=block.text)\n333:                 yield ContentBlockStop(index=index)\n334: \n335:             elif block.type == \"tool_use\":\n336:                 yield ContentBlockStart(\n337:                     type=\"tool_use\",\n338:                     index=index,\n339:                     id=block.id,\n340:                     name=block.name,\n341:                 )\n342:                 # Yield the input JSON as a single delta\n343:                 input_json = json.dumps(block.input)\n344:                 yield ContentBlockDelta(\n345:                     type=\"input_json_delta\",\n346:                     index=index,\n347:                     partial_json=input_json,\n348:                 )\n349:                 yield ContentBlockStop(index=index)\n350: \n351:         # Yield message stop\n352:         yield MessageStop(stop_reason=response.stop_reason)\n353: \n354:     async def _sleep_before_retry(self, attempt: int) -> None:\n355:         \"\"\"Sleep using exponential backoff before retrying.\"\"\"\n356:         await asyncio.sleep(self.base_retry_delay * (2 ** attempt))\n357: \n358:     async def extract_tool_calls(\n359:         self,\n360:         chunks: list[Chunk],\n361:     ) -> list[dict]:\n362:         \"\"\"Extract tool calls from accumulated stream chunks.\n363: \n364:         This method processes a list of chunks and extracts complete\n365:         tool_call objects by accumulating partial_json deltas.\n366: \n367:         Args:\n368:             chunks: List of chunks from a stream\n369: \n370:         Returns:\n371:             List of tool_call dicts with id, name, and input keys\n372: \n373:         Example:\n374:             >>> chunks = []\n375:             >>> async for chunk in client.chat_completion(messages, tools=tools):\n376:             ...     chunks.append(chunk)\n377:             >>> tool_calls = await client.extract_tool_calls(chunks)\n378:         \"\"\"\n379:         tool_calls: list[dict] = []\n380:         current_tool: dict[str, Any] | None = None\n381:         accumulated_json: list[str] = []\n382: \n383:         for chunk in chunks:\n384:             if isinstance(chunk, ContentBlockStart) and chunk.type == \"tool_use\":\n385:                 # Start of a new tool call\n386:                 current_tool = {\n387:                     \"id\": chunk.id,\n388:                     \"name\": chunk.name,\n389:                     \"input\": {},\n390:                 }\n391:                 accumulated_json = []\n392: \n393:             elif isinstance(chunk, ContentBlockDelta) and chunk.type == \"input_json_delta\":\n394:                 # Accumulate partial JSON\n395:                 if chunk.partial_json:\n396:                     accumulated_json.append(chunk.partial_json)\n397: \n398:             elif isinstance(chunk, ContentBlockStop) and current_tool is not None:\n399:                 # End of current tool call - parse accumulated JSON\n400:                 if accumulated_json:\n401:                     try:\n402:                         json_str = \"\".join(accumulated_json)\n403:                         current_tool[\"input\"] = json.loads(json_str)\n404:                     except json.JSONDecodeError:\n405:                         # If JSON is incomplete, keep as string\n406:                         current_tool[\"input\"] = {\"raw\": \"\".join(accumulated_json)}\n407: \n408:                 tool_calls.append(current_tool)\n409:                 current_tool = None\n410:                 accumulated_json = []\n411: \n412:         return tool_calls\n413: \n414:     async def simple_chat(\n415:         self,\n416:         message: str,\n417:         system_prompt: str | None = None,\n418:     ) -> str:\n419:         \"\"\"Simple chat without streaming or tool calling.\n420: \n421:         This is a convenience method for basic chat interactions.\n422: \n423:         Args:\n424:             message: User message\n425:             system_prompt: Optional system prompt\n426: \n427:         Returns:\n428:             Complete response text\n429:         \"\"\"\n430:         messages: list[dict] = [{\"role\": \"user\", \"content\": message}]\n431: \n432:         params: dict = {\n433:             \"model\": self.config.chat_model,\n434:             \"messages\": messages,\n435:             \"max_tokens\": self.config.max_tokens,\n436:         }\n437: \n438:         if system_prompt:\n439:             params[\"system\"] = system_prompt\n440: \n441:         try:\n442:             response = await self._client.messages.create(**params)\n443:             return response.content[0].text\n444:         except anthropic.AuthenticationError as e:\n445:             raise AuthError(str(e))\n446:         except anthropic.APITimeoutError as e:\n447:             raise TimeoutError(timeoutMs=int(self.config.timeout * 1000))\n448:         except anthropic.APIConnectionError as e:\n449:             raise NetworkError(str(e))\n450:         except anthropic.APIStatusError as e:\n451:             raise ApiError(str(e), statusCode=e.status_code)\n452:         except Exception as e:\n453:             raise ZaiError(f\"Unexpected error: {e}\")\n\n(End of file - total 453 lines)\n</content>","title":"goz/agent/chat_client.py","metadata":{"preview":"\"\"\"Chat API Client for Z.AI (Issue 17).\n\nThis module provides the ChatClient class for interacting with the Z.AI\nchat API using the Anthropic SDK with tool calling support.\n\nAcceptance Criteria:\n1. ChatClient class exists in goz/agent/chat_client.py\n2. Uses existing Anthropic SDK (same as Vision API)\n3. Uses config.zai_token and config.zai_base_url\n4. chat_completion() method sends messages and returns async iterator\n5. Supports tools parameter for function calling\n6. Supports tool_choice parameter (\"auto\", \"any\")\n7. Supports stream parameter (True/False)\n8. Response chunks yield text deltas\n9. Tool calls are properly formatted in stream\n10. Errors raised as appropriate exceptions (AuthError, ApiError, etc.)\n11. Timeout configurable via config\n\"\"\"\nimport asyncio\nimport json","truncated":false,"loaded":[]},"time":{"start":1775338509481,"end":1775338509493}}}}
{"type":"tool_use","timestamp":1775338509497,"sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","part":{"id":"prt_d5a6bd4b2001kjv6nxOe3ILnay","sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","messageID":"msg_d5a6baa650016R3meKV8LsIvM9","type":"tool","callID":"call_f13acb68d9e349f68fdb391d","tool":"read","state":{"status":"completed","input":{"filePath":"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/cli/run.py"},"output":"<path>/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/cli/run.py</path>\n<type>file</type>\n<content>1: \"\"\"JSONL CLI runner for litehive-compatible one-shot agent execution.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import argparse\n6: import asyncio\n7: import json\n8: import signal\n9: import sys\n10: import uuid\n11: from dataclasses import dataclass\n12: from datetime import datetime\n13: from pathlib import Path\n14: from typing import Any, TextIO\n15: \n16: from goz.agent.chat_client import ChatClient, Chunk, ContentBlockDelta, ContentBlockStart, ContentBlockStop\n17: from goz.agent.history import ChatHistory, ChatMessage, ToolCall\n18: from goz.agent.sessions import Session, SessionManager\n19: from goz.agent.tools import (\n20:     BashTool,\n21:     CreateFileTool,\n22:     GlobTool,\n23:     GrepTool,\n24:     ReadTool,\n25:     RepoReadTool,\n26:     RepoSearchTool,\n27:     RepoTreeTool,\n28:     SearchTool,\n29:     StrReplaceEditorTool,\n30:     ToolRegistry,\n31:     ViewFileTool,\n32: )\n33: from goz.config import Config, load_config\n34: \n35: \n36: MAX_ITERATIONS = 10\n37: DEFAULT_AGENT_TYPE = \"engine\"\n38: STEP_FINISH_TOKENS = {\n39:     \"input\": 0,\n40:     \"output\": 0,\n41:     \"cache_creation\": 0,\n42:     \"cache_read\": 0,\n43: }\n44: STAGE_RESULT_INSTRUCTION = \"\"\"\n45: \n46: End your final answer with:\n47: STAGE_RESULT:\n48: {\"verdict\":\"pass\",\"summary\":\"one-line summary\",\"files_changed\":[\"path/to/file\"],\"tests\":{\"added\":0,\"passing\":0},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\n49: \n50: Return valid JSON after STAGE_RESULT:. Include a verdict.\n51: \"\"\".strip()\n52: \n53: \n54: def _emit_event(event: dict[str, Any], stdout: TextIO) -> None:\n55:     stdout.write(json.dumps(event, ensure_ascii=True) + \"\\n\")\n56:     stdout.flush()\n57: \n58: \n59: def emit_text_event(text: str, stdout: TextIO) -> None:\n60:     _emit_event({\"type\": \"text\", \"part\": {\"text\": text}}, stdout)\n61: \n62: \n63: def emit_tool_use_event(\n64:     tool_call: dict[str, Any],\n65:     result: str,\n66:     stdout: TextIO,\n67:     *,\n68:     is_error: bool = False,\n69: ) -> None:\n70:     _emit_event(\n71:         {\n72:             \"type\": \"tool_use\",\n73:             \"part\": {\n74:                 \"id\": tool_call[\"id\"],\n75:                 \"name\": tool_call[\"name\"],\n76:                 \"input\": tool_call[\"input\"],\n77:                 \"output\": result,\n78:                 \"is_error\": is_error,\n79:             },\n80:         },\n81:         stdout,\n82:     )\n83: \n84: \n85: def emit_error_event(name: str, message: str, stdout: TextIO) -> None:\n86:     _emit_event(\n87:         {\n88:             \"type\": \"error\",\n89:             \"error\": {\n90:                 \"name\": name,\n91:                 \"data\": {\"message\": message},\n92:             },\n93:         },\n94:         stdout,\n95:     )\n96: \n97: \n98: def emit_step_finish_event(stdout: TextIO, session_id: str) -> None:\n99:     _emit_event(\n100:         {\n101:             \"type\": \"step_finish\",\n102:             \"part\": {\n103:                 \"tokens\": dict(STEP_FINISH_TOKENS),\n104:                 \"cost\": 0,\n105:                 \"session_id\": session_id,\n106:                 \"continuation\": {\"resume_session_id\": session_id},\n107:             },\n108:         },\n109:         stdout,\n110:     )\n111: \n112: \n113: @dataclass\n114: class RunSessionState:\n115:     session_id: str\n116:     created_at: datetime\n117:     history: ChatHistory\n118:     working_dir: str\n119:     agent_type: str\n120:     config: Config\n121:     session_manager: SessionManager\n122:     tool_registry: ToolRegistry\n123: \n124:     async def save(self) -> Path:\n125:         session = Session(\n126:             id=self.session_id,\n127:             created_at=self.created_at,\n128:             updated_at=datetime.now(),\n129:             working_directory=self.working_dir,\n130:             messages=list(self.history.messages),\n131:             model=self.config.chat_model,\n132:             agent_type=self.agent_type,\n133:             config_snapshot=self.config.model_dump() if hasattr(self.config, \"model_dump\") else {},\n134:             tool_state=_serialize_tool_state(self.tool_registry, self.working_dir),\n135:         )\n136:         return await self.session_manager.save(session)\n137: \n138: \n139: def _serialize_tool_state(tool_registry: ToolRegistry, working_dir: str) -> dict[str, Any]:\n140:     return {\n141:         \"working_directory\": working_dir,\n142:         \"tools\": {\n143:             tool.name: {\n144:                 \"working_dir\": getattr(tool, \"working_dir\", None),\n145:             }\n146:             for tool in tool_registry.list_all()\n147:         },\n148:     }\n149: \n150: \n151: def build_default_tool_registry(config: Config, working_dir: str) -> ToolRegistry:\n152:     \"\"\"Create the default tool set for one-shot CLI runs.\"\"\"\n153:     registry = ToolRegistry()\n154:     registry.register(BashTool(working_dir=working_dir))\n155:     registry.register(ViewFileTool(working_dir=working_dir))\n156:     registry.register(CreateFileTool(working_dir=working_dir))\n157:     registry.register(StrReplaceEditorTool(working_dir=working_dir))\n158:     registry.register(GlobTool(working_dir=working_dir))\n159:     registry.register(GrepTool(working_dir=working_dir))\n160:     registry.register(SearchTool(config))\n161:     registry.register(ReadTool(config))\n162:     registry.register(RepoSearchTool(config))\n163:     registry.register(RepoTreeTool(config))\n164:     registry.register(RepoReadTool(config))\n165:     return registry\n166: \n167: \n168: def _build_prompt(user_prompt: str) -> str:\n169:     return f\"{user_prompt.rstrip()}\\n\\n{STAGE_RESULT_INSTRUCTION}\"\n170: \n171: \n172: def _parse_tool_calls(chunks: list[Chunk]) -> list[dict[str, Any]]:\n173:     tool_calls: list[dict[str, Any]] = []\n174:     tool_calls_by_index: dict[int, dict[str, Any]] = {}\n175: \n176:     for chunk in chunks:\n177:         if isinstance(chunk, ContentBlockStart) and chunk.type == \"tool_use\":\n178:             tool_calls_by_index[chunk.index] = {\n179:                 \"id\": chunk.id or \"\",\n180:                 \"name\": chunk.name or \"\",\n181:                 \"input_json\": [],\n182:             }\n183:         elif isinstance(chunk, ContentBlockDelta) and chunk.type == \"input_json_delta\":\n184:             block = tool_calls_by_index.get(chunk.index)\n185:             if block is not None and chunk.partial_json:\n186:                 block[\"input_json\"].append(chunk.partial_json)\n187:         elif isinstance(chunk, ContentBlockStop):\n188:             block = tool_calls_by_index.get(chunk.index)\n189:             if block is None:\n190:                 continue\n191:             input_text = \"\".join(block.pop(\"input_json\"))\n192:             try:\n193:                 parsed_input = json.loads(input_text) if input_text else {}\n194:             except json.JSONDecodeError:\n195:                 parsed_input = {\"raw\": input_text}\n196:             tool_calls.append(\n197:                 {\n198:                     \"id\": block[\"id\"],\n199:                     \"name\": block[\"name\"],\n200:                     \"input\": parsed_input,\n201:                 }\n202:             )\n203: \n204:     return tool_calls\n205: \n206: \n207: async def _execute_tool_call(tool_registry: ToolRegistry, tool_call: dict[str, Any]) -> tuple[str, bool]:\n208:     tool = tool_registry.get(tool_call[\"name\"])\n209:     if tool is None:\n210:         return f\"Tool not found: {tool_call['name']}\", True\n211: \n212:     try:\n213:         result = await asyncio.wait_for(tool.execute(**tool_call[\"input\"]), timeout=300)\n214:     except asyncio.TimeoutError:\n215:         return f\"Tool {tool_call['name']} timed out after 300 seconds\", True\n216:     except Exception as exc:\n217:         return f\"Tool {tool_call['name']} failed: {exc}\", True\n218: \n219:     return str(result), False\n220: \n221: \n222: async def run_prompt_jsonl(\n223:     prompt: str,\n224:     *,\n225:     config: Config,\n226:     working_dir: str,\n227:     stdout: TextIO | None = None,\n228:     tool_registry: ToolRegistry | None = None,\n229:     chat_client: ChatClient | None = None,\n230:     resume_session_id: str | None = None,\n231:     session_dir: Path | None = None,\n232: ) -> int:\n233:     \"\"\"Execute one agent prompt and emit JSONL events.\"\"\"\n234:     stdout = stdout or sys.stdout\n235:     session_manager = SessionManager(session_dir=session_dir)\n236:     session: Session | None = None\n237:     if resume_session_id is not None:\n238:         session = await session_manager.load(resume_session_id)\n239:         working_dir = session.working_directory\n240: \n241:     history = ChatHistory(messages=list(session.messages) if session else None)\n242:     registry = tool_registry or build_default_tool_registry(config, working_dir)\n243:     client = chat_client or ChatClient(config=config)\n244:     state = RunSessionState(\n245:         session_id=resume_session_id or uuid.uuid4().hex,\n246:         created_at=session.created_at if session else datetime.now(),\n247:         history=history,\n248:         working_dir=working_dir,\n249:         agent_type=session.agent_type if session else DEFAULT_AGENT_TYPE,\n250:         config=config,\n251:         session_manager=session_manager,\n252:         tool_registry=registry,\n253:     )\n254: \n255:     if prompt:\n256:         history.add(ChatMessage(role=\"user\", content=_build_prompt(prompt)))\n257: \n258:     loop = asyncio.get_running_loop()\n259:     interrupted_by: dict[str, str | None] = {\"signal\": None}\n260:     current_task = asyncio.current_task()\n261: \n262:     async def _handle_interrupt(signame: str) -> None:\n263:         interrupted_by[\"signal\"] = signame\n264:         await state.save()\n265:         if current_task is not None:\n266:             current_task.cancel()\n267: \n268:     for signum in (signal.SIGTERM, signal.SIGINT):\n269:         try:\n270:             loop.add_signal_handler(\n271:                 signum,\n272:                 lambda current_signum=signum: asyncio.create_task(\n273:                     _handle_interrupt(signal.Signals(current_signum).name)\n274:                 ),\n275:             )\n276:         except (NotImplementedError, RuntimeError):\n277:             continue\n278: \n279:     try:\n280:         for _ in range(MAX_ITERATIONS):\n281:             chunks: list[Chunk] = []\n282:             assistant_chunks: list[str] = []\n283: \n284:             stream = client.chat_completion(\n285:                 messages=history.to_api_format(),\n286:                 tools=registry.to_openai_schema(),\n287:                 tool_choice=\"auto\",\n288:             )\n289: \n290:             async for chunk in stream:\n291:                 chunks.append(chunk)\n292:                 if isinstance(chunk, ContentBlockDelta) and chunk.type == \"text_delta\" and chunk.text:\n293:                     assistant_chunks.append(chunk.text)\n294:                     emit_text_event(chunk.text, stdout)\n295: \n296:             tool_calls = _parse_tool_calls(chunks)\n297:             if not tool_calls:\n298:                 history.add(ChatMessage(role=\"assistant\", content=\"\".join(assistant_chunks)))\n299:                 emit_step_finish_event(stdout, state.session_id)\n300:                 return 0\n301: \n302:             history.add(\n303:                 ChatMessage(\n304:                     role=\"assistant\",\n305:                     content=\"\".join(assistant_chunks),\n306:                     tool_calls=[\n307:                         ToolCall(\n308:                             id=tool_call[\"id\"],\n309:                             name=tool_call[\"name\"],\n310:                             input=tool_call[\"input\"],\n311:                         )\n312:                         for tool_call in tool_calls\n313:                     ],\n314:                 )\n315:             )\n316: \n317:             for tool_call in tool_calls:\n318:                 result, is_error = await _execute_tool_call(registry, tool_call)\n319:                 emit_tool_use_event(tool_call, result, stdout, is_error=is_error)\n320:                 history.add(\n321:                     ChatMessage(\n322:                         role=\"tool\",\n323:                         content=result,\n324:                         tool_result_id=tool_call[\"id\"],\n325:                     )\n326:                 )\n327:     except asyncio.CancelledError:\n328:         emit_error_event(\"Interrupted\", f\"Run interrupted by {interrupted_by['signal'] or 'signal'}\", stdout)\n329:         return 1\n330:     finally:\n331:         for signum in (signal.SIGTERM, signal.SIGINT):\n332:             try:\n333:                 loop.remove_signal_handler(signum)\n334:             except (NotImplementedError, RuntimeError):\n335:                 continue\n336:         await state.save()\n337: \n338:     emit_error_event(\"MaxIterationsExceeded\", f\"Exceeded {MAX_ITERATIONS} agent iterations\", stdout)\n339:     return 1\n340: \n341: \n342: async def cmd_run(args: list[str]) -> None:\n343:     \"\"\"Handle the `goz run` command.\"\"\"\n344:     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n345:         print(\"\"\"Run command usage:\n346: \n347:   goz run [options] <prompt>\n348: \n349: Options:\n350:   --format, -f json   Output ExternalCLIAdapter-compatible JSONL (default: json)\n351:   --dir DIR           Working directory for file and shell tools\n352:   --model MODEL       Override chat model for this invocation\n353:   --resume-session ID Resume a previously saved engine session\n354: \n355: Examples:\n356:   goz run --format json \"Summarize this repo and report STAGE_RESULT.\"\n357:   goz run --dir /tmp/project --model glm-5 \"Run pytest and explain failures.\"\n358:   goz run --resume-session abc123 \"Continue with the next step.\"\n359: \"\"\")\n360:         return\n361: \n362:     parser = argparse.ArgumentParser(prog=\"goz run\", add_help=False)\n363:     parser.add_argument(\"--format\", \"-f\", choices=[\"json\"], default=\"json\", help=\"Output format\")\n364:     parser.add_argument(\"--dir\", dest=\"working_dir\", help=\"Working directory for the run\")\n365:     parser.add_argument(\"--model\", help=\"Override chat model\")\n366:     parser.add_argument(\"--resume-session\", dest=\"resume_session_id\", help=\"Resume a saved session by ID\")\n367:     parser.add_argument(\"prompt\", nargs=\"*\", help=\"Prompt to execute\")\n368:     parsed = parser.parse_args(args)\n369: \n370:     if not parsed.prompt and not parsed.resume_session_id:\n371:         raise SystemExit(\"goz run requires a prompt unless --resume-session is provided\")\n372: \n373:     try:\n374:         config = load_config()\n375:         if parsed.model:\n376:             config = config.model_copy(update={\"chat_model\": parsed.model})\n377: \n378:         working_dir = str(Path(parsed.working_dir or \".\").resolve())\n379:         if parsed.working_dir and not Path(working_dir).exists():\n380:             raise FileNotFoundError(f\"Working directory does not exist: {working_dir}\")\n381:         if parsed.working_dir and not Path(working_dir).is_dir():\n382:             raise NotADirectoryError(f\"Working directory is not a directory: {working_dir}\")\n383: \n384:         exit_code = await run_prompt_jsonl(\n385:             \" \".join(parsed.prompt),\n386:             config=config,\n387:             working_dir=working_dir,\n388:             resume_session_id=parsed.resume_session_id,\n389:         )\n390:     except Exception as exc:\n391:         emit_error_event(type(exc).__name__, str(exc), sys.stdout)\n392:         sys.exit(1)\n393: \n394:     if exit_code != 0:\n395:         sys.exit(exit_code)\n\n(End of file - total 395 lines)\n</content>","title":"goz/cli/run.py","metadata":{"preview":"\"\"\"JSONL CLI runner for litehive-compatible one-shot agent execution.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport asyncio\nimport json\nimport signal\nimport sys\nimport uuid\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, TextIO\n\nfrom goz.agent.chat_client import ChatClient, Chunk, ContentBlockDelta, ContentBlockStart, ContentBlockStop\nfrom goz.agent.history import ChatHistory, ChatMessage, ToolCall\nfrom goz.agent.sessions import Session, SessionManager\nfrom goz.agent.tools import (\n    BashTool,","truncated":false,"loaded":[]},"time":{"start":1775338509491,"end":1775338509495}}}}
{"type":"tool_use","timestamp":1775338509497,"sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","part":{"id":"prt_d5a6bd4a90016dIa7ytH2VOYPG","sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","messageID":"msg_d5a6baa650016R3meKV8LsIvM9","type":"tool","callID":"call_46ebf3de848e4f85ba0b4d47","tool":"read","state":{"status":"completed","input":{"filePath":"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/stream_processor.py"},"output":"<path>/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/stream_processor.py</path>\n<type>file</type>\n<content>1: \"\"\"Stream Processor for handling Anthropic API streaming responses.\n2: \n3: This module provides the StreamProcessor class for processing streaming\n4: responses from the Anthropic-compatible Z.AI API, extracting text chunks\n5: for real-time UI updates and parsing tool calls.\n6: \n7: Acceptance Criteria (Issue 16):\n8: 1. StreamProcessor class exists\n9: 2. process_stream() method takes async iterator of chunks\n10: 3. Returns ProcessedStream with: full_text, tool_calls, raw_chunks\n11: 4. extract_tool_calls() parses tool calls from chunks\n12: 5. Handles partial_json accumulation\n13: 6. Handles multiple tool calls in one response\n14: 7. Yields text chunks for real-time UI updates\n15: \"\"\"\n16: import asyncio\n17: import json\n18: import logging\n19: from dataclasses import dataclass, field\n20: from typing import Any, AsyncIterator\n21: \n22: from goz.config import Config\n23: \n24: \n25: logger = logging.getLogger(__name__)\n26: \n27: \n28: @dataclass\n29: class ToolCall:\n30:     \"\"\"Represents a tool call extracted from a streaming response.\n31: \n32:     Attributes:\n33:         id: The unique identifier for this tool call\n34:         name: The name of the tool being called\n35:         arguments: The arguments passed to the tool (as a dict)\n36: \n37:     Acceptance Criteria 8: ToolCall dataclass: id, name, arguments\n38:     \"\"\"\n39:     id: str\n40:     name: str\n41:     arguments: dict[str, Any] = field(default_factory=dict)\n42: \n43: \n44: @dataclass\n45: class ProcessedStream:\n46:     \"\"\"Result of processing a complete API stream.\n47: \n48:     Attributes:\n49:         full_text: The complete accumulated text from the stream\n50:         tool_calls: List of tool calls extracted from the stream\n51:         raw_chunks: All raw chunks received (for debugging/replay)\n52: \n53:     Acceptance Criteria 9: ProcessedStream dataclass: full_text, tool_calls, raw_chunks\n54:     \"\"\"\n55:     full_text: str\n56:     tool_calls: list[ToolCall]\n57:     raw_chunks: list[Any] = field(default_factory=list)\n58: \n59: \n60: class StreamProcessor:\n61:     \"\"\"Processes streaming responses from Anthropic API.\n62: \n63:     This class handles streaming responses from the Z.AI Anthropic-compatible API.\n64:     It accumulates text chunks for real-time UI updates and extracts tool calls\n65:     from content blocks.\n66: \n67:     Acceptance Criteria 1: StreamProcessor class exists\n68:     Acceptance Criteria 2: process_stream() method takes async iterator of chunks\n69: \n70:     Chunk Types (from Anthropic SDK):\n71:     - content_block_start: {\"type\": \"text\" | \"tool_use\"}\n72:     - content_block_delta: {\"type\": \"text_delta\", \"text\": \"...\"}\n73:                          or {\"type\": \"input_json_delta\", \"partial_json\": \"...\"}\n74:     - content_block_stop\n75:     - message_stop\n76:     \"\"\"\n77: \n78:     def __init__(self, config: Config) -> None:\n79:         \"\"\"Initialize StreamProcessor.\n80: \n81:         Args:\n82:             config: Configuration object\n83: \n84:         Acceptance Criteria 1: StreamProcessor class exists\n85:         \"\"\"\n86:         self.config = config\n87:         self._full_text: str = \"\"\n88:         self._raw_chunks: list[Any] = []\n89:         self._text_chunks: list[str] = []\n90: \n91:         # Tool call tracking\n92:         self._tool_blocks: dict[int, dict[str, Any]] = {}  # index -> {id, name, partial_json}\n93:         self._current_block_index: int | None = None\n94: \n95:     async def process_stream(\n96:         self,\n97:         stream: AsyncIterator[Any],\n98:     ) -> AsyncIterator[str]:\n99:         \"\"\"Process stream and yield text chunks.\n100: \n101:         This method consumes the streaming response, yielding text chunks\n102:         for real-time UI updates. After the stream completes, use get_result()\n103:         to retrieve the full processed result including tool calls.\n104: \n105:         Args:\n106:             stream: Async iterator of chunks from Anthropic SDK\n107: \n108:         Yields:\n109:             Text chunks as they arrive from the API\n110: \n111:         Acceptance Criteria 2: process_stream() method takes async iterator of chunks\n112:         Acceptance Criteria 7: Yields text chunks for real-time UI updates\n113:         \"\"\"\n114:         # Reset state for new stream\n115:         self._full_text = \"\"\n116:         self._raw_chunks = []\n117:         self._text_chunks = []\n118:         self._tool_blocks = {}\n119:         self._current_block_index = None\n120: \n121:         async for chunk in stream:\n122:             # Store raw chunk\n123:             self._raw_chunks.append(chunk)\n124: \n125:             # Process chunk based on type\n126:             chunk_type = getattr(chunk, 'type', None)\n127: \n128:             if chunk_type == 'content_block_delta':\n129:                 await self._handle_content_block_delta(chunk)\n130:             elif chunk_type == 'content_block_start':\n131:                 await self._handle_content_block_start(chunk)\n132:             elif chunk_type == 'content_block_stop':\n133:                 await self._handle_content_block_stop(chunk)\n134:             elif chunk_type == 'message_stop':\n135:                 # Stream is complete\n136:                 pass\n137: \n138:         # Yield all accumulated text chunks\n139:         for text_chunk in self._text_chunks:\n140:             yield text_chunk\n141: \n142:     async def _handle_content_block_delta(self, chunk: Any) -> None:\n143:         \"\"\"Handle content_block_delta chunk.\n144: \n145:         Extracts text deltas for UI updates and partial_json for tool arguments.\n146:         \"\"\"\n147:         delta = getattr(chunk, 'delta', None)\n148:         if not delta:\n149:             return\n150: \n151:         delta_type = delta.get('type', '')\n152: \n153:         if delta_type == 'text_delta':\n154:             # Text content - yield for UI and accumulate\n155:             text = delta.get('text', '')\n156:             if text:\n157:                 self._full_text += text\n158:                 self._text_chunks.append(text)\n159: \n160:         elif delta_type == 'input_json_delta':\n161:             # Partial JSON for tool arguments\n162:             if self._current_block_index is not None:\n163:                 partial_json = delta.get('partial_json', '')\n164:                 if self._current_block_index not in self._tool_blocks:\n165:                     self._tool_blocks[self._current_block_index] = {\n166:                         'partial_json': ''\n167:                     }\n168:                 self._tool_blocks[self._current_block_index]['partial_json'] += partial_json\n169: \n170:     async def _handle_content_block_start(self, chunk: Any) -> None:\n171:         \"\"\"Handle content_block_start chunk.\n172: \n173:         Identifies new tool_use blocks.\n174:         \"\"\"\n175:         index = getattr(chunk, 'index', None)\n176:         content_block = getattr(chunk, 'content_block', None)\n177: \n178:         if index is not None and content_block:\n179:             self._current_block_index = index\n180: \n181:             if content_block.get('type') == 'tool_use':\n182:                 self._tool_blocks[index] = {\n183:                     'id': content_block.get('id', ''),\n184:                     'name': content_block.get('name', ''),\n185:                     'partial_json': ''\n186:                 }\n187:             else:\n188:                 # Text block - just track the index\n189:                 if index not in self._tool_blocks:\n190:                     self._tool_blocks[index] = {}\n191: \n192:     async def _handle_content_block_stop(self, chunk: Any) -> None:\n193:         \"\"\"Handle content_block_stop chunk.\n194: \n195:         Finalizes tool argument accumulation.\n196:         \"\"\"\n197:         index = getattr(chunk, 'index', None)\n198:         if index is not None and index in self._tool_blocks:\n199:             # Parse accumulated JSON for tool arguments\n200:             partial_json = self._tool_blocks[index].get('partial_json', '')\n201:             if partial_json:\n202:                 try:\n203:                     self._tool_blocks[index]['arguments'] = json.loads(partial_json)\n204:                 except json.JSONDecodeError:\n205:                     logger.warning(f\"Failed to parse tool arguments: {partial_json}\")\n206:                     self._tool_blocks[index]['arguments'] = {}\n207: \n208:     def get_result(self) -> ProcessedStream:\n209:         \"\"\"Get the final processed result.\n210: \n211:         Returns a ProcessedStream containing the full text, extracted tool calls,\n212:         and all raw chunks received.\n213: \n214:         Returns:\n215:             ProcessedStream with full_text, tool_calls, and raw_chunks\n216: \n217:         Acceptance Criteria 3: Returns ProcessedStream with: full_text, tool_calls, raw_chunks\n218:         \"\"\"\n219:         tool_calls = self.extract_tool_calls(self._raw_chunks)\n220: \n221:         return ProcessedStream(\n222:             full_text=self._full_text,\n223:             tool_calls=tool_calls,\n224:             raw_chunks=self._raw_chunks\n225:         )\n226: \n227:     def extract_tool_calls(self, chunks: list[Any]) -> list[ToolCall]:\n228:         \"\"\"Parse tool calls from accumulated chunks.\n229: \n230:         This method processes the raw chunks to extract any tool calls that\n231:         were present in the response. It handles partial_json accumulation\n232:         and multiple tool calls in a single response.\n233: \n234:         Args:\n235:             chunks: List of raw chunks from the API stream\n236: \n237:         Returns:\n238:             List of ToolCall objects extracted from the stream\n239: \n240:         Acceptance Criteria 4: extract_tool_calls() parses tool calls from chunks\n241:         Acceptance Criteria 5: Handles partial_json accumulation\n242:         Acceptance Criteria 6: Handles multiple tool calls in one response\n243:         \"\"\"\n244:         # Re-process chunks to extract tool calls\n245:         tool_blocks: dict[int, dict[str, Any]] = {}\n246: \n247:         for chunk in chunks:\n248:             chunk_type = getattr(chunk, 'type', None)\n249: \n250:             if chunk_type == 'content_block_start':\n251:                 index = getattr(chunk, 'index', None)\n252:                 content_block = getattr(chunk, 'content_block', None)\n253: \n254:                 if index is not None and content_block:\n255:                     if content_block.get('type') == 'tool_use':\n256:                         tool_blocks[index] = {\n257:                             'id': content_block.get('id', ''),\n258:                             'name': content_block.get('name', ''),\n259:                             'partial_json': ''\n260:                         }\n261: \n262:             elif chunk_type == 'content_block_delta':\n263:                 index = getattr(chunk, 'index', None)\n264:                 delta = getattr(chunk, 'delta', None)\n265: \n266:                 if index is not None and delta and index in tool_blocks:\n267:                     delta_type = delta.get('type', '')\n268:                     if delta_type == 'input_json_delta':\n269:                         partial_json = delta.get('partial_json', '')\n270:                         tool_blocks[index]['partial_json'] += partial_json\n271: \n272:             elif chunk_type == 'content_block_stop':\n273:                 index = getattr(chunk, 'index', None)\n274:                 if index is not None and index in tool_blocks:\n275:                     partial_json = tool_blocks[index].get('partial_json', '')\n276:                     # Always try to parse - even if partial_json was accumulated\n277:                     try:\n278:                         tool_blocks[index]['arguments'] = json.loads(partial_json) if partial_json else {}\n279:                     except json.JSONDecodeError:\n280:                         tool_blocks[index]['arguments'] = {}\n281: \n282:         # Convert tool blocks to ToolCall objects\n283:         tool_calls = []\n284:         for block in tool_blocks.values():\n285:             if block.get('name'):  # Only include blocks with a tool name\n286:                 tool_calls.append(ToolCall(\n287:                     id=block.get('id', ''),\n288:                     name=block.get('name', ''),\n289:                     arguments=block.get('arguments', {})\n290:                 ))\n291: \n292:         return tool_calls\n\n(End of file - total 292 lines)\n</content>","title":"goz/agent/stream_processor.py","metadata":{"preview":"\"\"\"Stream Processor for handling Anthropic API streaming responses.\n\nThis module provides the StreamProcessor class for processing streaming\nresponses from the Anthropic-compatible Z.AI API, extracting text chunks\nfor real-time UI updates and parsing tool calls.\n\nAcceptance Criteria (Issue 16):\n1. StreamProcessor class exists\n2. process_stream() method takes async iterator of chunks\n3. Returns ProcessedStream with: full_text, tool_calls, raw_chunks\n4. extract_tool_calls() parses tool calls from chunks\n5. Handles partial_json accumulation\n6. Handles multiple tool calls in one response\n7. Yields text chunks for real-time UI updates\n\"\"\"\nimport asyncio\nimport json\nimport logging\nfrom dataclasses import dataclass, field\nfrom typing import Any, AsyncIterator","truncated":false,"loaded":[]},"time":{"start":1775338509488,"end":1775338509496}}}}
