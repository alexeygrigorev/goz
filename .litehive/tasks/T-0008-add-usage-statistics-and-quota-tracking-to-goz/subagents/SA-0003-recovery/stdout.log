patible with protocol \"Tool\"\n    \"execute\" is an incompatible type\n      Type \"(repo: str, path: str | None = None, depth: int = 1) -> CoroutineType[Any, Any, str]\" is not assignable to type \"(**kwargs: Any) -> CoroutineType[Any, Any, str]\"\n        Parameter \"**kwargs\" has no corresponding parameter","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}},{"range":{"start":{"line":163,"character":22},"end":{"line":163,"character":42}},"message":"Argument of type \"RepoReadTool\" cannot be assigned to parameter \"tool\" of type \"Tool\" in function \"register\"\n  \"RepoReadTool\" is incompatible with protocol \"Tool\"\n    \"execute\" is an incompatible type\n      Type \"(repo: str, file_path: str) -> CoroutineType[Any, Any, str]\" is not assignable to type \"(**kwargs: Any) -> CoroutineType[Any, Any, str]\"\n        Parameter \"**kwargs\" has no corresponding parameter","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}},{"range":{"start":{"line":293,"character":48},"end":{"line":293,"character":54}},"message":"Argument of type \"TextIO | None\" cannot be assigned to parameter \"stdout\" of type \"TextIO\" in function \"emit_text_event\"\n  Type \"TextIO | None\" is not assignable to type \"TextIO\"\n    \"None\" is not assignable to \"TextIO\"","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}},{"range":{"start":{"line":298,"character":39},"end":{"line":298,"character":45}},"message":"Argument of type \"TextIO | None\" cannot be assigned to parameter \"stdout\" of type \"TextIO\" in function \"emit_step_finish_event\"\n  Type \"TextIO | None\" is not assignable to type \"TextIO\"\n    \"None\" is not assignable to \"TextIO\"","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}},{"range":{"start":{"line":318,"character":55},"end":{"line":318,"character":61}},"message":"Argument of type \"TextIO | None\" cannot be assigned to parameter \"stdout\" of type \"TextIO\" in function \"emit_tool_use_event\"\n  Type \"TextIO | None\" is not assignable to type \"TextIO\"\n    \"None\" is not assignable to \"TextIO\"","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}},{"range":{"start":{"line":327,"character":102},"end":{"line":327,"character":108}},"message":"Argument of type \"TextIO | None\" cannot be assigned to parameter \"stdout\" of type \"TextIO\" in function \"emit_error_event\"\n  Type \"TextIO | None\" is not assignable to type \"TextIO\"\n    \"None\" is not assignable to \"TextIO\"","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}},{"range":{"start":{"line":337,"character":93},"end":{"line":337,"character":99}},"message":"Argument of type \"TextIO | None\" cannot be assigned to parameter \"stdout\" of type \"TextIO\" in function \"emit_error_event\"\n  Type \"TextIO | None\" is not assignable to type \"TextIO\"\n    \"None\" is not assignable to \"TextIO\"","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}}],"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/__main__.py":[{"range":{"start":{"line":849,"character":19},"end":{"line":849,"character":24}},"message":"Import \"httpx\" could not be resolved","severity":1,"code":"reportMissingImports","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportMissingImports"}},{"range":{"start":{"line":261,"character":47},"end":{"line":261,"character":54}},"message":"Argument of type \"Unknown | None\" cannot be assigned to parameter \"source\" of type \"str\" in function \"analyze\"\n  Type \"Unknown | None\" is not assignable to type \"str\"\n    \"None\" is not assignable to \"str\"","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}},{"range":{"start":{"line":270,"character":57},"end":{"line":270,"character":64}},"message":"Argument of type \"Unknown | None\" cannot be assigned to parameter \"source\" of type \"str\" in function \"analyze_stream\"\n  Type \"Unknown | None\" is not assignable to type \"str\"\n    \"None\" is not assignable to \"str\"","severity":1,"code":"reportArgumentType","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportArgumentType"}},{"range":{"start":{"line":854,"character":16},"end":{"line":854,"character":21}},"message":"\"httpx\" is possibly unbound","severity":1,"code":"reportPossiblyUnboundVariable","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportPossiblyUnboundVariable"}},{"range":{"start":{"line":854,"character":36},"end":{"line":854,"character":41}},"message":"\"httpx\" is possibly unbound","severity":1,"code":"reportPossiblyUnboundVariable","source":"Pyright","codeDescription":{"href":"https://github.com/microsoft/pyright/blob/main/docs/configuration.md#reportPossiblyUnboundVariable"}}],"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/errors.py":[],"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-