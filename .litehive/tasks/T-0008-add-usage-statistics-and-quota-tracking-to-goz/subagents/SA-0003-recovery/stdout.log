{"type":"tool_use","timestamp":1775338532200,"sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","part":{"id":"prt_d5a6c2d63001Bj5Oj3HXCUO9G0","sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","messageID":"msg_d5a6c0fe2001fEnpNtFA2qjfDN","type":"tool","callID":"call_e3273512ef0c4ce48c2ea546","tool":"read","state":{"status":"completed","input":{"filePath":"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/tests/test_chat_client.py"},"output":"<path>/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/tests/test_chat_client.py</path>\n<type>file</type>\n<content>1: \"\"\"Tests for ChatClient (Issue 17).\n2: \n3: TDD approach:\n4: 1. Write tests FIRST\n5: 2. Verify tests FAIL\n6: 3. Implement code\n7: 4. Verify tests PASS\n8: \"\"\"\n9: import asyncio\n10: from datetime import datetime\n11: from typing import Literal\n12: from dataclasses import dataclass, field\n13: from unittest.mock import AsyncMock, MagicMock, patch\n14: \n15: import pytest\n16: from anthropic import AsyncAnthropic\n17: \n18: from goz.config import Config\n19: from goz.api.errors import AuthError, ApiError, NetworkError, TimeoutError\n20: \n21: \n22: # Import the actual classes from chat_client for testing\n23: from goz.agent.chat_client import (\n24:     ChatClient,\n25:     ContentBlockStart,\n26:     ContentBlockDelta,\n27:     ContentBlockStop,\n28:     MessageStart,\n29:     MessageStop,\n30:     Chunk,\n31: )\n32: \n33: \n34: class TestChatClientTDD:\n35:     \"\"\"TDD tests for ChatClient.\n36: \n37:     Test sequence:\n38:     1. Class initialization\n39:     2. Simple chat completion (no tools, no stream)\n40:     3. Chat completion with streaming\n41:     4. Chat completion with tools\n42:     5. Tool call extraction from stream\n43:     6. Error handling\n44:     \"\"\"\n45: \n46:     @pytest.fixture\n47:     def config(self) -> Config:\n48:         \"\"\"Create test config.\"\"\"\n49:         return Config(\n50:             zai_token=\"test-token\",\n51:             zai_base_url=\"https://api.test.com\",\n52:             chat_model=\"test-model\",\n53:             timeout=60,\n54:         )\n55: \n56:     @pytest.fixture\n57:     def mock_anthropic(self):\n58:         \"\"\"Mock AsyncAnthropic client.\"\"\"\n59:         mock_client = MagicMock(spec=AsyncAnthropic)\n60:         return mock_client\n61: \n62:     # TEST 1: ChatClient class exists and initializes correctly\n63:     def test_01_chat_client_class_exists(self, config):\n64:         \"\"\"Acceptance Criterion 1: ChatClient class exists.\"\"\"\n65:         # This test will fail until we create the class\n66:         from goz.agent.chat_client import ChatClient\n67: \n68:         client = ChatClient(config)\n69:         assert client is not None\n70:         assert client.config is config\n71: \n72:     # TEST 2: ChatClient uses AsyncAnthropic from SDK\n73:     def test_02_uses_anthropic_sdk(self, config):\n74:         \"\"\"Acceptance Criterion 2: Uses existing Anthropic SDK.\"\"\"\n75:         from goz.agent.chat_client import ChatClient\n76: \n77:         client = ChatClient(config)\n78: \n79:         # Verify the client has an _client attribute that's an AsyncAnthropic\n80:         assert hasattr(client, '_client')\n81:         assert isinstance(client._client, AsyncAnthropic)\n82: \n83:         # Verify it's configured with the right params\n84:         assert client._client.api_key == config.zai_token\n85:         assert client._client.base_url == config.zai_base_url\n86: \n87:     # TEST 3: chat_completion method exists and returns async iterator\n88:     @pytest.mark.asyncio\n89:     async def test_03_chat_completion_returns_iterator(self, config):\n90:         \"\"\"Acceptance Criteria 3, 4: Uses config, returns async iterator.\"\"\"\n91:         from goz.agent.chat_client import ChatClient\n92: \n93:         client = ChatClient(config)\n94:         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n95: \n96:         # Mock the API response\n97:         with patch.object(client._client, 'messages') as mock_messages:\n98:             mock_stream = AsyncMock()\n99:             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n100:             mock_stream.__aenter__ = AsyncMock(return_value=mock_stream)\n101:             mock_stream.__aexit__ = AsyncMock()\n102: \n103:             mock_messages.stream.return_value = mock_stream\n104: \n105:             # Call chat_completion\n106:             result = client.chat_completion(messages)\n107: \n108:             # Verify it's an async iterator\n109:             assert hasattr(result, '__aiter__')\n110:             assert hasattr(result, '__anext__')\n111: \n112:     # TEST 4: Simple text streaming works\n113:     @pytest.mark.asyncio\n114:     async def test_04_simple_text_streaming(self, config):\n115:         \"\"\"Acceptance Criterion 8: Response chunks yield text deltas.\"\"\"\n116:         from goz.agent.chat_client import ChatClient\n117: \n118:         client = ChatClient(config)\n119:         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n120: \n121:         # Create events that will be converted to chunks\n122:         events = []\n123: \n124:         # Text delta events\n125:         for text in [\"Hello\", \" there\", \"!\"]:\n126:             event = MagicMock()\n127:             event.type = \"content_block_delta\"\n128:             event.index = 0\n129:             delta = MagicMock()\n130:             delta.type = \"text_delta\"\n131:             delta.text = text\n132:             event.delta = delta\n133:             events.append(event)\n134: \n135:         # Message stop\n136:         stop = MagicMock()\n137:         stop.type = \"message_stop\"\n138:         msg = MagicMock()\n139:         msg.stop_reason = \"end_turn\"\n140:         stop.message = msg\n141:         events.append(stop)\n142: \n143:         # Convert events using the client's conversion method\n144:         chunks = []\n145:         for event in events:\n146:             chunk = client._convert_sse_event_to_chunk(event)\n147:             if chunk is not None:\n148:                 chunks.append(chunk)\n149: \n150:         # Verify we got text chunks\n151:         text_chunks = [c for c in chunks if isinstance(c, ContentBlockDelta) and c.text]\n152:         assert len(text_chunks) == 3\n153:         assert text_chunks[0].text == \"Hello\"\n154:         assert text_chunks[1].text == \" there\"\n155:         assert text_chunks[2].text == \"!\"\n156: \n157:         # Also verify streaming works end-to-end with a simple mock\n158:         with patch.object(client._client, 'messages') as mock_messages:\n159:             async def empty_stream():\n160:                 return\n161:                 yield  # Make it an async generator\n162: \n163:             mock_stream_context = MagicMock()\n164:             mock_stream_context.__aenter__ = AsyncMock(return_value=empty_stream())\n165:             mock_stream_context.__aexit__ = AsyncMock()\n166:             mock_messages.stream.return_value = mock_stream_context\n167: \n168:             # Should not raise\n169:             chunks = []\n170:             async for chunk in client.chat_completion(messages, stream=True):\n171:                 chunks.append(chunk)\n172:             # Empty stream returns no chunks\n173:             assert len(chunks) == 0\n174: \n175:     # TEST 5: Tools parameter is supported\n176:     @pytest.mark.asyncio\n177:     async def test_05_tools_parameter_supported(self, config):\n178:         \"\"\"Acceptance Criterion 5: Supports tools parameter.\"\"\"\n179:         from goz.agent.chat_client import ChatClient\n180: \n181:         client = ChatClient(config)\n182:         messages = [{\"role\": \"user\", \"content\": \"Read main.py\"}]\n183: \n184:         tools = [\n185:             {\n186:                 \"name\": \"view_file\",\n187:                 \"description\": \"View file contents\",\n188:                 \"input_schema\": {\n189:                     \"type\": \"object\",\n190:                     \"properties\": {\n191:                         \"file_path\": {\"type\": \"string\"}\n192:                     },\n193:                     \"required\": [\"file_path\"]\n194:                 }\n195:             }\n196:         ]\n197: \n198:         with patch.object(client._client, 'messages') as mock_messages:\n199:             mock_stream = AsyncMock()\n200:             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n201:             mock_stream_context = MagicMock()\n202:             mock_stream_context.__aenter__ = AsyncMock(return_value=mock_stream)\n203:             mock_stream_context.__aexit__ = AsyncMock()\n204:             mock_messages.stream.return_value = mock_stream_context\n205: \n206:             # Call with tools\n207:             async for _ in client.chat_completion(messages, tools=tools):\n208:                 pass\n209: \n210:             # Verify tools were passed to the API\n211:             call_args = mock_messages.stream.call_args\n212:             assert 'tools' in call_args.kwargs or len(call_args.args) > 1\n213: \n214:     # TEST 6: tool_choice parameter is supported\n215:     @pytest.mark.asyncio\n216:     async def test_06_tool_choice_supported(self, config):\n217:         \"\"\"Acceptance Criterion 6: Supports tool_choice parameter.\"\"\"\n218:         from goz.agent.chat_client import ChatClient\n219: \n220:         client = ChatClient(config)\n221:         messages = [{\"role\": \"user\", \"content\": \"Read main.py\"}]\n222: \n223:         with patch.object(client._client, 'messages') as mock_messages:\n224:             mock_stream = AsyncMock()\n225:             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n226:             mock_stream_context = MagicMock()\n227:             mock_stream_context.__aenter__ = AsyncMock(return_value=mock_stream)\n228:             mock_stream_context.__aexit__ = AsyncMock()\n229:             mock_messages.stream.return_value = mock_stream_context\n230: \n231:             # Call with tool_choice\n232:             async for _ in client.chat_completion(messages, tool_choice=\"any\"):\n233:                 pass\n234: \n235:             # Verify tool_choice was passed\n236:             call_args = mock_messages.stream.call_args\n237:             assert 'tool_choice' in call_args.kwargs or len(call_args.args) > 2\n238: \n239:     # TEST 7: stream parameter is supported\n240:     @pytest.mark.asyncio\n241:     async def test_07_stream_parameter_supported(self, config):\n242:         \"\"\"Acceptance Criterion 7: Supports stream parameter.\"\"\"\n243:         from goz.agent.chat_client import ChatClient\n244: \n245:         client = ChatClient(config)\n246:         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n247: \n248:         with patch.object(client._client, 'messages') as mock_messages:\n249:             # Test with stream=True\n250:             mock_stream = AsyncMock()\n251:             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n252:             mock_stream_context = MagicMock()\n253:             mock_stream_context.__aenter__ = AsyncMock(return_value=mock_stream)\n254:             mock_stream_context.__aexit__ = AsyncMock()\n255:             mock_messages.stream.return_value = mock_stream_context\n256: \n257:             async for _ in client.chat_completion(messages, stream=True):\n258:                 pass\n259: \n260:             # Test with stream=False (should use create instead of stream)\n261:             mock_create_response = MagicMock()\n262:             mock_create_response.id = \"msg_123\"\n263:             mock_create_response.model = \"test-model\"\n264:             mock_create_response.content = [MagicMock(text=\"Response\", type=\"text\")]\n265:             mock_create_response.stop_reason = \"end_turn\"\n266:             mock_messages.create = AsyncMock(return_value=mock_create_response)\n267: \n268:             async for _ in client.chat_completion(messages, stream=False):\n269:                 pass\n270: \n271:     # TEST 8: Tool calls are properly formatted in stream\n272:     @pytest.mark.asyncio\n273:     async def test_08_tool_calls_formatted_correctly(self, config):\n274:         \"\"\"Acceptance Criterion 9: Tool calls are properly formatted in stream.\"\"\"\n275:         from goz.agent.chat_client import ChatClient\n276: \n277:         client = ChatClient(config)\n278: \n279:         # Create events for tool call\n280:         events = []\n281: \n282:         # Start tool_use block\n283:         start = MagicMock()\n284:         start.type = \"content_block_start\"\n285:         start.index = 0\n286:         cb = MagicMock()\n287:         cb.type = \"tool_use\"\n288:         cb.id = \"call_123\"\n289:         cb.name = \"view_file\"\n290:         start.content_block = cb\n291:         events.append(start)\n292: \n293:         # Delta with partial JSON\n294:         delta1 = MagicMock()\n295:         delta1.type = \"content_block_delta\"\n296:         delta1.index = 0\n297:         d1 = MagicMock()\n298:         d1.type = \"input_json_delta\"\n299:         d1.partial_json = '{\"file_path\":\"main.py\"}'\n300:         delta1.delta = d1\n301:         events.append(delta1)\n302: \n303:         # Stop\n304:         stop = MagicMock()\n305:         stop.type = \"content_block_stop\"\n306:         stop.index = 0\n307:         events.append(stop)\n308: \n309:         # Convert events using the client's conversion method\n310:         chunks = []\n311:         for event in events:\n312:             chunk = client._convert_sse_event_to_chunk(event)\n313:             if chunk is not None:\n314:                 chunks.append(chunk)\n315: \n316:         # Verify we got the tool use start\n317:         tool_use_starts = [c for c in chunks if isinstance(c, ContentBlockStart) and c.type == \"tool_use\"]\n318:         assert len(tool_use_starts) == 1\n319:         assert tool_use_starts[0].name == \"view_file\"\n320:         assert tool_use_starts[0].id == \"call_123\"\n321: \n322:         # Verify we got the partial JSON delta\n323:         json_deltas = [c for c in chunks if isinstance(c, ContentBlockDelta) and c.type == \"input_json_delta\"]\n324:         assert len(json_deltas) == 1\n325: \n326:     # TEST 9: AuthError is raised for authentication failures\n327:     @pytest.mark.asyncio\n328:     async def test_09_auth_error_handling(self, config):\n329:         \"\"\"Acceptance Criterion 10: AuthError raised for 401/403.\"\"\"\n330:         from goz.agent.chat_client import ChatClient\n331:         import anthropic\n332: \n333:         client = ChatClient(config)\n334:         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n335: \n336:         # Create error-raising context manager\n337:         class ErrorContext:\n338:             async def __aenter__(self):\n339:                 mock_response = MagicMock()\n340:                 mock_response.status_code = 401\n341:                 raise anthropic.AuthenticationError(\n342:                     message=\"Invalid token\",\n343:                     response=mock_response,\n344:                     body=None,\n345:                 )\n346:             async def __aexit__(self, *args):\n347:                 pass\n348: \n349:         with patch.object(client._client, 'messages') as mock_messages:\n350:             def mock_stream_func(**kwargs):\n351:                 return ErrorContext()\n352:             mock_messages.stream.side_effect = mock_stream_func\n353: \n354:             # Should raise AuthError\n355:             with pytest.raises(AuthError):\n356:                 async for _ in client.chat_completion(messages):\n357:                     pass\n358: \n359:     # TEST 10: ApiError is raised for API errors\n360:     @pytest.mark.asyncio\n361:     async def test_10_api_error_handling(self, config):\n362:         \"\"\"Acceptance Criterion 10: ApiError raised for 4xx/5xx.\"\"\"\n363:         from goz.agent.chat_client import ChatClient\n364:         import anthropic\n365: \n366:         client = ChatClient(config)\n367:         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n368: \n369:         class ErrorContext:\n370:             async def __aenter__(self):\n371:                 mock_response = MagicMock()\n372:                 mock_response.status_code = 429\n373:                 raise anthropic.APIStatusError(\n374:                     message=\"Rate limit exceeded\",\n375:                     response=mock_response,\n376:                     body=None,\n377:                 )\n378:             async def __aexit__(self, *args):\n379:                 pass\n380: \n381:         with patch.object(client._client, 'messages') as mock_messages:\n382:             def mock_stream_func(**kwargs):\n383:                 return ErrorContext()\n384:             mock_messages.stream.side_effect = mock_stream_func\n385: \n386:             # Should raise ApiError\n387:             with pytest.raises(ApiError) as exc_info:\n388:                 async for _ in client.chat_completion(messages):\n389:                     pass\n390: \n391:             assert exc_info.value.statusCode == 429\n392: \n393:     @pytest.mark.asyncio\n394:     async def test_10b_rate_limit_retried_before_success(self, config):\n395:         \"\"\"429 errors should retry with exponential backoff and preserve success.\"\"\"\n396:         from goz.agent.chat_client import ChatClient\n397:         import anthropic\n398: \n399:         client = ChatClient(config)\n400:         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n401: \n402:         response = MagicMock()\n403:         response.id = \"msg_123\"\n404:         response.model = \"test-model\"\n405:         response.content = []\n406:         response.stop_reason = \"end_turn\"\n407: \n408:         mock_response = MagicMock()\n409:         mock_response.status_code = 429\n410: \n411:         class ErrorContext:\n412:             async def __aenter__(self):\n413:                 raise anthropic.APIStatusError(\n414:                     message=\"Rate limit exceeded\",\n415:                     response=mock_response,\n416:                     body=None,\n417:                 )\n418: \n419:             async def __aexit__(self, *args):\n420:                 pass\n421: \n422:         with patch.object(client._client, \"messages\") as mock_messages, \\\n423:              patch(\"goz.agent.chat_client.asyncio.sleep\", new=AsyncMock()) as mock_sleep:\n424:             mock_messages.create = AsyncMock(side_effect=[\n425:                 anthropic.APIStatusError(\n426:                     message=\"Rate limit exceeded\",\n427:                     response=mock_response,\n428:                     body=None,\n429:                 ),\n430:                 anthropic.APIStatusError(\n431:                     message=\"Rate limit exceeded\",\n432:                     response=mock_response,\n433:                     body=None,\n434:                 ),\n435:                 response,\n436:             ])\n437: \n438:             chunks = []\n439:             async for chunk in client.chat_completion(messages, stream=False):\n440:                 chunks.append(chunk)\n441: \n442:             assert chunks\n443:             assert mock_messages.create.await_count == 3\n444:             assert mock_sleep.await_count == 2\n445: \n446:     @pytest.mark.asyncio\n447:     async def test_10c_server_error_retries_then_raises(self, config):\n448:         \"\"\"5xx errors should retry up to the configured maximum.\"\"\"\n449:         from goz.agent.chat_client import ChatClient\n450:         import anthropic\n451: \n452:         client = ChatClient(config)\n453:         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n454: \n455:         mock_response = MagicMock()\n456:         mock_response.status_code = 500\n457: \n458:         class ErrorContext:\n459:             async def __aenter__(self):\n460:                 raise anthropic.APIStatusError(\n461:                     message=\"Server unavailable\",\n462:                     response=mock_response,\n463:                     body=None,\n464:                 )\n465: \n466:             async def __aexit__(self, *args):\n467:                 pass\n468: \n469:         with patch.object(client._client, \"messages\") as mock_messages, \\\n470:              patch(\"goz.agent.chat_client.asyncio.sleep\", new=AsyncMock()) as mock_sleep:\n471:             mock_messages.stream.side_effect = [ErrorContext(), ErrorContext(), ErrorContext()]\n472: \n473:             with pytest.raises(ApiError) as exc_info:\n474:                 async for _ in client.chat_completion(messages):\n475:                     pass\n476: \n477:             assert exc_info.value.statusCode == 500\n478:             assert mock_messages.stream.call_count == 3\n479:             assert mock_sleep.await_count == 2\n480: \n481:     # TEST 11: NetworkError is raised for connection failures\n482:     @pytest.mark.asyncio\n483:     async def test_11_network_error_handling(self, config):\n484:         \"\"\"Acceptance Criterion 10: NetworkError for connection failures.\"\"\"\n485:         from goz.agent.chat_client import ChatClient\n486:         import anthropic\n487: \n488:         client = ChatClient(config)\n489: \n490:         # Test the error handling - APIConnectionError requires message and request\n491:         mock_request = MagicMock()\n492:         try:\n493:             raise anthropic.APIConnectionError(message=\"Connection failed\", request=mock_request)\n494:         except anthropic.APIConnectionError:\n495:             # Should be converted to NetworkError by the client\n496:             from goz.api.errors import NetworkError\n497:             raised = False\n498:             try:\n499:                 raise NetworkError(\"Connection failed\")\n500:             except NetworkError:\n501:                 raised = True\n502:             assert raised, \"NetworkError should be raised for APIConnectionError\"\n503: \n504:     # TEST 12: TimeoutError is raised for timeouts\n505:     @pytest.mark.asyncio\n506:     async def test_12_timeout_error_handling(self, config):\n507:         \"\"\"Acceptance Criterion 10: TimeoutError for request timeouts.\"\"\"\n508:         from goz.agent.chat_client import ChatClient\n509:         from anthropic import APITimeoutError\n510: \n511:         client = ChatClient(config)\n512:         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n513: \n514:         # Mock timeout error\n515:         class ErrorContext:\n516:             async def __aenter__(self):\n517:                 raise APITimeoutError(\"Request timed out\")\n518:             async def __aexit__(self, *args):\n519:                 pass\n520: \n521:         with patch.object(client._client, 'messages') as mock_messages:\n522:             def mock_stream_func(**kwargs):\n523:                 return ErrorContext()\n524:             mock_messages.stream.side_effect = mock_stream_func\n525: \n526:             # Should raise TimeoutError\n527:             with pytest.raises(TimeoutError):\n528:                 async for _ in client.chat_completion(messages):\n529:                     pass\n530: \n531:     @pytest.mark.asyncio\n532:     async def test_12b_timeout_error_includes_retry_guidance_after_exhaustion(self, config):\n533:         \"\"\"Timeouts should be retried, then surface a useful final message.\"\"\"\n534:         from goz.agent.chat_client import ChatClient\n535:         from anthropic import APITimeoutError\n536: \n537:         client = ChatClient(config)\n538:         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n539: \n540:         class ErrorContext:\n541:             async def __aenter__(self):\n542:                 raise APITimeoutError(\"Request timed out\")\n543: \n544:             async def __aexit__(self, *args):\n545:                 pass\n546: \n547:         with patch.object(client._client, \"messages\") as mock_messages, \\\n548:              patch(\"goz.agent.chat_client.asyncio.sleep\", new=AsyncMock()) as mock_sleep:\n549:             mock_messages.stream.side_effect = [ErrorContext(), ErrorContext(), ErrorContext()]\n550: \n551:             with pytest.raises(TimeoutError) as exc_info:\n552:                 async for _ in client.chat_completion(messages):\n553:                     pass\n554: \n555:             assert \"timed out\" in exc_info.value.message.lower()\n556:             assert mock_messages.stream.call_count == 3\n557:             assert mock_sleep.await_count == 2\n558: \n559:     # TEST 13: Timeout is configurable via config\n560:     def test_13_timeout_configurable(self, config):\n561:         \"\"\"Acceptance Criterion 11: Timeout is configurable via config.\"\"\"\n562:         from goz.agent.chat_client import ChatClient\n563: \n564:         # Set custom timeout\n565:         config.timeout = 120\n566: \n567:         client = ChatClient(config)\n568: \n569:         # Verify the client has the timeout configured\n570:         # The Anthropic SDK uses timeout parameter\n571:         assert client._client.timeout is not None\n572: \n573:     # TEST 14: temperature and max_tokens parameters are supported\n574:     @pytest.mark.asyncio\n575:     async def test_14_temperature_and_max_tokens(self, config):\n576:         \"\"\"Verify temperature and max_tokens parameters work.\"\"\"\n577:         from goz.agent.chat_client import ChatClient\n578: \n579:         client = ChatClient(config)\n580:         messages = [{\"role\": \"user\", \"content\": \"Hello\"}]\n581: \n582:         with patch.object(client._client, 'messages') as mock_messages:\n583:             mock_stream = AsyncMock()\n584:             mock_stream.__aiter__ = AsyncMock(return_value=iter([]))\n585:             mock_stream_context = MagicMock()\n586:             mock_stream_context.__aenter__ = AsyncMock(return_value=mock_stream)\n587:             mock_stream_context.__aexit__ = AsyncMock()\n588:             mock_messages.stream.return_value = mock_stream_context\n589: \n590:             # Call with temperature and max_tokens\n591:             async for _ in client.chat_completion(\n592:                 messages,\n593:                 temperature=0.5,\n594:                 max_tokens=1000\n595:             ):\n596:                 pass\n597: \n598:             # Verify parameters were passed\n599:             call_args = mock_messages.stream.call_args\n600: \n601:             # Check that temperature and max_tokens were in the call\n602:             kwargs = call_args.kwargs\n603:             assert 'temperature' in kwargs or len(call_args.args) > 3\n604:             assert 'max_tokens' in kwargs or len(call_args.args) > 4\n605: \n606:     # TEST 15: Non-streaming mode works\n607:     @pytest.mark.asyncio\n608:     async def test_15_non_streaming_mode(self, config):\n609:         \"\"\"Verify non-streaming mode returns chunks from response.\"\"\"\n610:         from goz.agent.chat_client import ChatClient\n611: \n612:         client = ChatClient(config)\n613: \n614:         # Test the _response_to_chunks method directly\n615:         mock_response = MagicMock()\n616:         mock_response.id = \"msg_123\"\n617:         mock_response.model = \"test-model\"\n618: \n619:         # Create proper content block\n620:         content_block = MagicMock()\n621:         content_block.type = \"text\"\n622:         content_block.text = \"Hello there!\"\n623:         mock_response.content = [content_block]\n624: \n625:         mock_response.stop_reason = \"end_turn\"\n626: \n627:         # Collect chunks from the response\n628:         chunks = []\n629:         async for chunk in client._response_to_chunks(mock_response):\n630:             chunks.append(chunk)\n631: \n632:         # Should yield chunks for the response\n633:         assert len(chunks) > 0\n634: \n635:         # Should have text content\n636:         text_chunks = [c for c in chunks if isinstance(c, ContentBlockDelta) and c.text]\n637:         assert len(text_chunks) > 0\n638:         assert \"Hello there!\" in text_chunks[0].text\n639: \n640: \n641: class TestChatClientIntegration:\n642:     \"\"\"Integration-style tests with more realistic mock scenarios.\"\"\"\n643: \n644:     @pytest.fixture\n645:     def config(self) -> Config:\n646:         \"\"\"Create test config.\"\"\"\n647:         return Config(\n648:             zai_token=\"test-token\",\n649:             zai_base_url=\"https://api.test.com\",\n650:             chat_model=\"test-model\",\n651:             timeout=60,\n652:         )\n653: \n654:     @pytest.mark.asyncio\n655:     async def test_full_conversation_flow(self, config):\n656:         \"\"\"Test a realistic conversation flow - tests event conversion.\"\"\"\n657:         from goz.agent.chat_client import ChatClient\n658: \n659:         client = ChatClient(config)\n660: \n661:         # Simulate a response with text then a tool call\n662:         events = []\n663: \n664:         # Message start\n665:         msg_start = MagicMock()\n666:         msg_start.type = \"message_start\"\n667:         msg = MagicMock()\n668:         msg.id = \"msg_123\"\n669:         msg.model = \"test-model\"\n670:         msg_start.message = msg\n671:         events.append(msg_start)\n672: \n673:         # Content block start (text)\n674:         cb_start = MagicMock()\n675:         cb_start.type = \"content_block_start\"\n676:         cb_start.index = 0\n677:         cb = MagicMock()\n678:         cb.type = \"text\"\n679:         cb_start.content_block = cb\n680:         events.append(cb_start)\n681: \n682:         # Text deltas\n683:         for text in [\"I'll\", \" read\", \" main.py\", \" for you.\"]:\n684:             delta = MagicMock()\n685:             delta.type = \"content_block_delta\"\n686:             delta.index = 0\n687:             d = MagicMock()\n688:             d.type = \"text_delta\"\n689:             d.text = text\n690:             delta.delta = d\n691:             events.append(delta)\n692: \n693:         # Content block stop\n694:         cb_stop = MagicMock()\n695:         cb_stop.type = \"content_block_stop\"\n696:         cb_stop.index = 0\n697:         events.append(cb_stop)\n698: \n699:         # Content block start (tool_use)\n700:         tool_start = MagicMock()\n701:         tool_start.type = \"content_block_start\"\n702:         tool_start.index = 1\n703:         tb = MagicMock()\n704:         tb.type = \"tool_use\"\n705:         tb.id = \"call_456\"\n706:         tb.name = \"view_file\"\n707:         tool_start.content_block = tb\n708:         events.append(tool_start)\n709: \n710:         # Tool input delta\n711:         tool_delta = MagicMock()\n712:         tool_delta.type = \"content_block_delta\"\n713:         tool_delta.index = 1\n714:         td = MagicMock()\n715:         td.type = \"input_json_delta\"\n716:         td.partial_json = '{\"file_path\":\"main.py\"}'\n717:         tool_delta.delta = td\n718:         events.append(tool_delta)\n719: \n720:         # Tool block stop\n721:         tool_stop = MagicMock()\n722:         tool_stop.type = \"content_block_stop\"\n723:         tool_stop.index = 1\n724:         events.append(tool_stop)\n725: \n726:         # Message stop\n727:         msg_stop = MagicMock()\n728:         msg_stop.type = \"message_stop\"\n729:         ms = MagicMock()\n730:         ms.stop_reason = \"tool_use\"\n731:         msg_stop.message = ms\n732:         events.append(msg_stop)\n733: \n734:         # Convert events using the client's conversion method\n735:         chunks = []\n736:         for event in events:\n737:             chunk = client._convert_sse_event_to_chunk(event)\n738:             if chunk is not None:\n739:                 chunks.append(chunk)\n740: \n741:         # Verify we got message start\n742:         msg_starts = [c for c in chunks if isinstance(c, MessageStart)]\n743:         assert len(msg_starts) == 1\n744: \n745:         # Verify we got text chunks\n746:         text_chunks = [c for c in chunks if isinstance(c, ContentBlockDelta) and c.text]\n747:         assert len(text_chunks) == 4\n748: \n749:         # Verify we got tool use start\n750:         tool_starts = [c for c in chunks if isinstance(c, ContentBlockStart) and c.type == \"tool_use\"]\n751:         assert len(tool_starts) == 1\n752:         assert tool_starts[0].name == \"view_file\"\n\n(End of file - total 752 lines)\n</content>","title":"tests/test_chat_client.py","metadata":{"preview":"\"\"\"Tests for ChatClient (Issue 17).\n\nTDD approach:\n1. Write tests FIRST\n2. Verify tests FAIL\n3. Implement code\n4. Verify tests PASS\n\"\"\"\nimport asyncio\nfrom datetime import datetime\nfrom typing import Literal\nfrom dataclasses import dataclass, field\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nimport pytest\nfrom anthropic import AsyncAnthropic\n\nfrom goz.config import Config\nfrom goz.api.errors import AuthError, ApiError, NetworkError, TimeoutError\n","truncated":false,"loaded":[]},"time":{"start":1775338532195,"end":1775338532198}}}}
{"type":"tool_use","timestamp":1775338532200,"sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","part":{"id":"prt_d5a6c2d64001WXSAAB1WRQZpNG","sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","messageID":"msg_d5a6c0fe2001fEnpNtFA2qjfDN","type":"tool","callID":"call_f20287c79c9a4d76b7b58393","tool":"read","state":{"status":"completed","input":{"filePath":"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/tests/test_run_cli.py"},"output":"<path>/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/tests/test_run_cli.py</path>\n<type>file</type>\n<content>1: \"\"\"Tests for `goz run` JSONL CLI mode.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import asyncio\n6: import io\n7: import json\n8: import signal\n9: import sys\n10: from pathlib import Path\n11: from unittest.mock import patch\n12: \n13: import pytest\n14: \n15: from goz.agent.chat_client import (\n16:     ContentBlockDelta,\n17:     ContentBlockStart,\n18:     ContentBlockStop,\n19:     MessageStart,\n20:     MessageStop,\n21: )\n22: from goz.cli.run import build_default_tool_registry, run_prompt_jsonl\n23: from goz.config import Config\n24: \n25: \n26: @pytest.fixture\n27: def config() -> Config:\n28:     return Config(\n29:         zai_token=\"test-token\",\n30:         zai_base_url=\"https://api.test.com\",\n31:         chat_model=\"test-model\",\n32:         timeout=60,\n33:     )\n34: \n35: \n36: class FakeChatClient:\n37:     def __init__(self, streams, *, config):\n38:         self.streams = list(streams)\n39:         self.config = config\n40:         self.calls: list[dict] = []\n41: \n42:     def chat_completion(self, **kwargs):\n43:         self.calls.append(kwargs)\n44:         stream = self.streams.pop(0)\n45: \n46:         async def iterator():\n47:             for chunk in stream:\n48:                 yield chunk\n49: \n50:         return iterator()\n51: \n52: \n53: class TestRunPromptJsonl:\n54:     @pytest.mark.asyncio\n55:     async def test_emits_jsonl_events_and_step_finish(self, config, tmp_path):\n56:         first_stream = [\n57:             MessageStart(id=\"msg_1\", model=\"test-model\"),\n58:             ContentBlockStart(type=\"tool_use\", index=0, id=\"call_1\", name=\"bash\"),\n59:             ContentBlockDelta(type=\"input_json_delta\", index=0, partial_json='{\"command\":\"pwd\"}'),\n60:             ContentBlockStop(index=0),\n61:             MessageStop(stop_reason=\"tool_use\"),\n62:         ]\n63:         second_stream = [\n64:             MessageStart(id=\"msg_2\", model=\"test-model\"),\n65:             ContentBlockStart(type=\"text\", index=0),\n66:             ContentBlockDelta(type=\"text_delta\", index=0, text=\"Answer\\n\"),\n67:             ContentBlockDelta(\n68:                 type=\"text_delta\",\n69:                 index=0,\n70:                 text='STAGE_RESULT:\\n{\"verdict\":\"pass\",\"summary\":\"ok\",\"files_changed\":[],\"tests\":{\"added\":0,\"passing\":1},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\\n',\n71:             ),\n72:             ContentBlockStop(index=0),\n73:             MessageStop(stop_reason=\"end_turn\"),\n74:         ]\n75:         stdout = io.StringIO()\n76:         chat_client = FakeChatClient([first_stream, second_stream], config=config)\n77: \n78:         exit_code = await run_prompt_jsonl(\n79:             \"Run pwd and report\",\n80:             config=config,\n81:             working_dir=str(tmp_path),\n82:             stdout=stdout,\n83:             chat_client=chat_client,\n84:         )\n85: \n86:         assert exit_code == 0\n87:         events = [json.loads(line) for line in stdout.getvalue().splitlines()]\n88:         assert [event[\"type\"] for event in events] == [\"tool_use\", \"text\", \"text\", \"step_finish\"]\n89:         assert events[0][\"part\"][\"name\"] == \"bash\"\n90:         assert events[0][\"part\"][\"input\"] == {\"command\": \"pwd\"}\n91:         assert events[-1][\"part\"] == {\n92:             \"tokens\": {\"input\": 0, \"output\": 0, \"cache_creation\": 0, \"cache_read\": 0},\n93:             \"cost\": 0,\n94:             \"session_id\": events[-1][\"part\"][\"session_id\"],\n95:             \"continuation\": {\"resume_session_id\": events[-1][\"part\"][\"session_id\"]},\n96:         }\n97:         combined_text = \"\".join(event[\"part\"][\"text\"] for event in events if event[\"type\"] == \"text\")\n98:         assert \"STAGE_RESULT:\" in combined_text\n99:         assert '\"verdict\":\"pass\"' in combined_text\n100:         assert \"STAGE_RESULT:\" in chat_client.calls[0][\"messages\"][0][\"content\"]\n101:         assert chat_client.calls[0][\"tools\"]\n102: \n103:     @pytest.mark.asyncio\n104:     async def test_saves_session_state_to_disk(self, config, tmp_path):\n105:         stream = [\n106:             MessageStart(id=\"msg_1\", model=\"test-model\"),\n107:             ContentBlockStart(type=\"text\", index=0),\n108:             ContentBlockDelta(\n109:                 type=\"text_delta\",\n110:                 index=0,\n111:                 text='STAGE_RESULT:\\n{\"verdict\":\"pass\",\"summary\":\"ok\",\"files_changed\":[],\"tests\":{\"added\":0,\"passing\":1},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\\n',\n112:             ),\n113:             ContentBlockStop(index=0),\n114:             MessageStop(stop_reason=\"end_turn\"),\n115:         ]\n116:         stdout = io.StringIO()\n117:         chat_client = FakeChatClient([stream], config=config)\n118: \n119:         await run_prompt_jsonl(\n120:             \"Persist this run\",\n121:             config=config,\n122:             working_dir=str(tmp_path),\n123:             stdout=stdout,\n124:             chat_client=chat_client,\n125:             session_dir=tmp_path / \"sessions\",\n126:         )\n127: \n128:         events = [json.loads(line) for line in stdout.getvalue().splitlines()]\n129:         session_id = events[-1][\"part\"][\"session_id\"]\n130:         session_path = tmp_path / \"sessions\" / f\"{session_id}.json\"\n131: \n132:         assert session_path.exists()\n133:         data = json.loads(session_path.read_text())\n134:         assert data[\"id\"] == session_id\n135:         assert data[\"working_directory\"] == str(tmp_path)\n136:         assert data[\"agent_type\"] == \"engine\"\n137:         assert data[\"messages\"][0][\"role\"] == \"user\"\n138:         assert data[\"messages\"][1][\"role\"] == \"assistant\"\n139:         assert data[\"tool_state\"][\"working_directory\"] == str(tmp_path)\n140:         assert data[\"tool_state\"][\"tools\"][\"bash\"][\"working_dir\"] == str(tmp_path)\n141: \n142:     @pytest.mark.asyncio\n143:     async def test_resume_session_reuses_saved_history(self, config, tmp_path):\n144:         first_stream = [\n145:             MessageStart(id=\"msg_1\", model=\"test-model\"),\n146:             ContentBlockStart(type=\"text\", index=0),\n147:             ContentBlockDelta(\n148:                 type=\"text_delta\",\n149:                 index=0,\n150:                 text='STAGE_RESULT:\\n{\"verdict\":\"pass\",\"summary\":\"first\",\"files_changed\":[],\"tests\":{\"added\":0,\"passing\":1},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\\n',\n151:             ),\n152:             ContentBlockStop(index=0),\n153:             MessageStop(stop_reason=\"end_turn\"),\n154:         ]\n155:         second_stream = [\n156:             MessageStart(id=\"msg_2\", model=\"test-model\"),\n157:             ContentBlockStart(type=\"text\", index=0),\n158:             ContentBlockDelta(\n159:                 type=\"text_delta\",\n160:                 index=0,\n161:                 text='STAGE_RESULT:\\n{\"verdict\":\"pass\",\"summary\":\"second\",\"files_changed\":[],\"tests\":{\"added\":0,\"passing\":2},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\\n',\n162:             ),\n163:             ContentBlockStop(index=0),\n164:             MessageStop(stop_reason=\"end_turn\"),\n165:         ]\n166:         first_stdout = io.StringIO()\n167:         second_stdout = io.StringIO()\n168:         session_dir = tmp_path / \"sessions\"\n169: \n170:         first_client = FakeChatClient([first_stream], config=config)\n171:         await run_prompt_jsonl(\n172:             \"First turn\",\n173:             config=config,\n174:             working_dir=str(tmp_path),\n175:             stdout=first_stdout,\n176:             chat_client=first_client,\n177:             session_dir=session_dir,\n178:         )\n179:         first_events = [json.loads(line) for line in first_stdout.getvalue().splitlines()]\n180:         session_id = first_events[-1][\"part\"][\"session_id\"]\n181: \n182:         second_client = FakeChatClient([second_stream], config=config)\n183:         await run_prompt_jsonl(\n184:             \"Second turn\",\n185:             config=config,\n186:             working_dir=\"/unused\",\n187:             stdout=second_stdout,\n188:             chat_client=second_client,\n189:             resume_session_id=session_id,\n190:             session_dir=session_dir,\n191:         )\n192: \n193:         second_call_messages = second_client.calls[0][\"messages\"]\n194:         assert second_call_messages[0][\"content\"].startswith(\"First turn\")\n195:         assert \"second\" not in second_call_messages[0][\"content\"].lower()\n196:         assert second_call_messages[1][\"role\"] == \"assistant\"\n197:         assert second_call_messages[2][\"content\"].startswith(\"Second turn\")\n198: \n199:     @pytest.mark.asyncio\n200:     async def test_saves_session_on_interrupt(self, config, tmp_path, monkeypatch):\n201:         wait_for_interrupt = asyncio.Event()\n202:         registered_handlers: dict[int, object] = {}\n203: \n204:         class HangingChatClient:\n205:             def __init__(self, *, config):\n206:                 self.config = config\n207: \n208:             def chat_completion(self, **kwargs):\n209:                 async def iterator():\n210:                     await wait_for_interrupt.wait()\n211:                     yield ContentBlockDelta(type=\"text_delta\", index=0, text=\"unreachable\")\n212: \n213:                 return iterator()\n214: \n215:         loop = asyncio.get_running_loop()\n216: \n217:         def fake_add_signal_handler(signum, callback):\n218:             registered_handlers[signum] = callback\n219: \n220:         def fake_remove_signal_handler(signum):\n221:             registered_handlers.pop(signum, None)\n222: \n223:         monkeypatch.setattr(loop, \"add_signal_handler\", fake_add_signal_handler)\n224:         monkeypatch.setattr(loop, \"remove_signal_handler\", fake_remove_signal_handler)\n225: \n226:         task = asyncio.create_task(\n227:             run_prompt_jsonl(\n228:                 \"Interrupt me\",\n229:                 config=config,\n230:                 working_dir=str(tmp_path),\n231:                 stdout=io.StringIO(),\n232:                 chat_client=HangingChatClient(config=config),\n233:                 session_dir=tmp_path / \"sessions\",\n234:             )\n235:         )\n236: \n237:         await asyncio.sleep(0)\n238:         registered_handlers[signal.SIGTERM]()\n239:         wait_for_interrupt.set()\n240:         exit_code = await task\n241: \n242:         session_files = list((tmp_path / \"sessions\").glob(\"*.json\"))\n243:         assert exit_code == 1\n244:         assert len(session_files) == 1\n245:         data = json.loads(session_files[0].read_text())\n246:         assert data[\"messages\"][0][\"content\"].startswith(\"Interrupt me\")\n247: \n248:     @pytest.mark.asyncio\n249:     async def test_raises_when_chat_fails(self, config, tmp_path):\n250:         class FailingChatClient:\n251:             def chat_completion(self, **kwargs):\n252:                 async def iterator():\n253:                     raise RuntimeError(\"boom\")\n254:                     yield\n255: \n256:                 return iterator()\n257: \n258:         stdout = io.StringIO()\n259:         with pytest.raises(RuntimeError):\n260:             await run_prompt_jsonl(\n261:                 \"fail\",\n262:                 config=config,\n263:                 working_dir=str(tmp_path),\n264:                 stdout=stdout,\n265:                 chat_client=FailingChatClient(),\n266:             )\n267: \n268:     def test_build_default_tool_registry_uses_working_directory(self, config, tmp_path):\n269:         registry = build_default_tool_registry(config, str(tmp_path))\n270: \n271:         assert registry.get(\"bash\").working_dir == str(tmp_path)\n272:         assert registry.get(\"view_file\").working_dir == str(tmp_path)\n273:         assert registry.get(\"create_file\").working_dir == str(tmp_path)\n274:         assert registry.get(\"str_replace_editor\").working_dir == str(tmp_path)\n275: \n276: \n277: class TestRunCli:\n278:     def test_goz_run_cli_supports_model_override_and_json_output(self, config, capsys):\n279:         observed = {}\n280: \n281:         async def fake_run(\n282:             prompt,\n283:             *,\n284:             config,\n285:             working_dir,\n286:             stdout=None,\n287:             tool_registry=None,\n288:             chat_client=None,\n289:             resume_session_id=None,\n290:             session_dir=None,\n291:         ):\n292:             observed[\"prompt\"] = prompt\n293:             observed[\"model\"] = config.chat_model\n294:             observed[\"working_dir\"] = working_dir\n295:             observed[\"resume_session_id\"] = resume_session_id\n296:             print(json.dumps({\"type\": \"text\", \"part\": {\"text\": \"ok\"}}))\n297:             print(json.dumps({\"type\": \"step_finish\", \"part\": {\"tokens\": {\"input\": 0, \"output\": 0, \"cache_creation\": 0, \"cache_read\": 0}, \"cost\": 0, \"session_id\": \"session-1\", \"continuation\": {\"resume_session_id\": \"session-1\"}}}))\n298:             return 0\n299: \n300:         with patch(\"goz.cli.run.load_config\", return_value=config), patch(\"goz.cli.run.run_prompt_jsonl\", side_effect=fake_run):\n301:             from goz.__main__ import main\n302: \n303:             sys.argv = [\"goz\", \"run\", \"--format\", \"json\", \"--dir\", \".\", \"--model\", \"override-model\", \"hello\", \"world\"]\n304:             main()\n305: \n306:         captured = capsys.readouterr()\n307:         events = [json.loads(line) for line in captured.out.splitlines()]\n308:         assert events[0][\"type\"] == \"text\"\n309:         assert events[1][\"type\"] == \"step_finish\"\n310:         assert observed == {\n311:             \"prompt\": \"hello world\",\n312:             \"model\": \"override-model\",\n313:             \"working_dir\": str(Path(\".\").resolve()),\n314:             \"resume_session_id\": None,\n315:         }\n316: \n317:     def test_goz_run_cli_supports_resume_session_without_prompt(self, config, capsys):\n318:         observed = {}\n319: \n320:         async def fake_run(\n321:             prompt,\n322:             *,\n323:             config,\n324:             working_dir,\n325:             stdout=None,\n326:             tool_registry=None,\n327:             chat_client=None,\n328:             resume_session_id=None,\n329:             session_dir=None,\n330:         ):\n331:             observed[\"prompt\"] = prompt\n332:             observed[\"resume_session_id\"] = resume_session_id\n333:             print(json.dumps({\"type\": \"step_finish\", \"part\": {\"tokens\": {\"input\": 0, \"output\": 0, \"cache_creation\": 0, \"cache_read\": 0}, \"cost\": 0, \"session_id\": resume_session_id, \"continuation\": {\"resume_session_id\": resume_session_id}}}))\n334:             return 0\n335: \n336:         with patch(\"goz.cli.run.load_config\", return_value=config), patch(\"goz.cli.run.run_prompt_jsonl\", side_effect=fake_run):\n337:             from goz.__main__ import main\n338: \n339:             sys.argv = [\"goz\", \"run\", \"--format\", \"json\", \"--resume-session\", \"resume-123\"]\n340:             main()\n341: \n342:         captured = capsys.readouterr()\n343:         events = [json.loads(line) for line in captured.out.splitlines()]\n344:         assert events[0][\"part\"][\"session_id\"] == \"resume-123\"\n345:         assert observed == {\n346:             \"prompt\": \"\",\n347:             \"resume_session_id\": \"resume-123\",\n348:         }\n349: \n350:     def test_goz_run_cli_emits_error_and_nonzero_exit(self, config, capsys):\n351:         with patch(\"goz.cli.run.load_config\", return_value=config), patch(\n352:             \"goz.cli.run.run_prompt_jsonl\",\n353:             side_effect=RuntimeError(\"bad run\"),\n354:         ):\n355:             from goz.__main__ import main\n356: \n357:             sys.argv = [\"goz\", \"run\", \"--format\", \"json\", \"hello\"]\n358:             with pytest.raises(SystemExit) as excinfo:\n359:                 main()\n360: \n361:         captured = capsys.readouterr()\n362:         event = json.loads(captured.out.strip())\n363:         assert excinfo.value.code == 1\n364:         assert event == {\n365:             \"type\": \"error\",\n366:             \"error\": {\n367:                 \"name\": \"RuntimeError\",\n368:                 \"data\": {\"message\": \"bad run\"},\n369:             },\n370:         }\n\n(End of file - total 370 lines)\n</content>","title":"tests/test_run_cli.py","metadata":{"preview":"\"\"\"Tests for `goz run` JSONL CLI mode.\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport io\nimport json\nimport signal\nimport sys\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nimport pytest\n\nfrom goz.agent.chat_client import (\n    ContentBlockDelta,\n    ContentBlockStart,\n    ContentBlockStop,\n    MessageStart,\n    MessageStop,","truncated":false,"loaded":[]},"time":{"start":1775338532196,"end":1775338532199}}}}
{"type":"tool_use","timestamp":1775338532201,"sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","part":{"id":"prt_d5a6c2d5b0027WHq3nGnaRynKt","sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","messageID":"msg_d5a6c0fe2001fEnpNtFA2qjfDN","type":"tool","callID":"call_d72e3c9f3f1f4625b9ff4b1a","tool":"read","state":{"status":"completed","input":{"filePath":"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/config/__init__.py"},"output":"<path>/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/config/__init__.py</path>\n<type>file</type>\n<content>1: \"\"\"Configuration management for goz.\n2: \n3: Config file location: ~/.config/goz/config.json\n4: \"\"\"\n5: import json\n6: from pathlib import Path\n7: \n8: from pydantic import BaseModel, Field, field_validator\n9: \n10: \n11: # Default config paths (Acceptance Criteria 1)\n12: DEFAULT_CONFIG_DIR = Path.home() / \".config\" / \"goz\"\n13: DEFAULT_CONFIG_FILE = DEFAULT_CONFIG_DIR / \"config.json\"\n14: \n15: # Default values (Acceptance Criteria 2)\n16: DEFAULT_ZAI_BASE_URL = \"https://api.z.ai/api/anthropic\"\n17: DEFAULT_CODING_BASE_URL = \"https://api.z.ai/api/coding/paas/v4\"\n18: DEFAULT_TIMEOUT = 300000  # 5 minutes in milliseconds\n19: DEFAULT_TIMEOUT_SECONDS = 120  # For Python clients (seconds)\n20: \n21: # Default model names\n22: DEFAULT_VISION_MODEL = \"glm-4.6v\"\n23: DEFAULT_CHAT_MODEL = \"glm-5-turbo\"\n24: \n25: # Generation parameters\n26: DEFAULT_TEMPERATURE = 0.8\n27: DEFAULT_TOP_P = 0.6\n28: DEFAULT_MAX_TOKENS = 32768\n29: \n30: \n31: class Config(BaseModel):\n32:     \"\"\"Configuration model for goz.\n33: \n34:     Fields:\n35:         zai_token: Z.AI auth token for API access (like apiKey in zai-cli)\n36:         zai_base_url: Base URL for Anthropic API (vision/chat)\n37:         coding_base_url: Base URL for Coding API (search/read/repo)\n38:         timeout: Request timeout in seconds\n39:         vision_model: Model for image/video analysis\n40:         chat_model: Model for chat/text requests\n41:         temperature: Generation temperature\n42:         top_p: Generation top_p\n43:         max_tokens: Maximum tokens in response\n44:     \"\"\"\n45: \n46:     zai_token: str\n47:     zai_base_url: str = DEFAULT_ZAI_BASE_URL\n48:     coding_base_url: str = DEFAULT_CODING_BASE_URL\n49:     timeout: int = Field(default=DEFAULT_TIMEOUT_SECONDS, gt=0)\n50:     vision_model: str = DEFAULT_VISION_MODEL\n51:     chat_model: str = DEFAULT_CHAT_MODEL\n52:     temperature: float = DEFAULT_TEMPERATURE\n53:     top_p: float = DEFAULT_TOP_P\n54:     max_tokens: int = DEFAULT_MAX_TOKENS\n55: \n56:     @field_validator(\"zai_token\")\n57:     @classmethod\n58:     def token_not_empty(cls, v: str) -> str:\n59:         \"\"\"Validate token is not empty.\"\"\"\n60:         if not v or not v.strip():\n61:             raise ValueError(\"zai_token cannot be empty\")\n62:         return v\n63: \n64: \n65: class ConfigManager:\n66:     \"\"\"Manager for loading and saving configuration.\"\"\"\n67: \n68:     def __init__(self, config_file: Path | None = None):\n69:         \"\"\"Initialize ConfigManager.\n70: \n71:         Args:\n72:             config_file: Path to config file. Defaults to DEFAULT_CONFIG_FILE.\n73:         \"\"\"\n74:         self.config_file = config_file or DEFAULT_CONFIG_FILE\n75:         self._ensure_config_dir()\n76: \n77:     def _ensure_config_dir(self) -> None:\n78:         \"\"\"Create config directory if it doesn't exist (Acceptance Criteria 3, 6).\"\"\"\n79:         self.config_file.parent.mkdir(parents=True, exist_ok=True)\n80: \n81:     def load(self) -> Config:\n82:         \"\"\"Load configuration from file.\n83: \n84:         Returns:\n85:             Config object\n86: \n87:         Raises:\n88:             json.JSONDecodeError: If config file contains invalid JSON\n89:             ValidationError: If config data is invalid\n90:         \"\"\"\n91:         if not self.config_file.exists():\n92:             return self._prompt_and_create()\n93: \n94:         # Check if file is empty\n95:         if self.config_file.stat().st_size == 0:\n96:             return self._prompt_and_create()\n97: \n98:         try:\n99:             with open(self.config_file) as f:\n100:                 data = json.load(f)\n101:         except json.JSONDecodeError:\n102:             # Invalid JSON - show error and re-raise\n103:             print(f\"Error: Invalid JSON in config file at {self.config_file}\")\n104:             raise\n105: \n106:         return Config.model_validate(data)\n107: \n108:     def save(self, config: Config) -> None:\n109:         \"\"\"Save configuration to file.\n110: \n111:         Args:\n112:             config: Config object to save\n113:         \"\"\"\n114:         self._ensure_config_dir()\n115:         with open(self.config_file, \"w\") as f:\n116:             f.write(config.model_dump_json(indent=2))\n117: \n118:     def _prompt_and_create(self) -> Config:\n119:         \"\"\"Prompt user for token and create config file (Acceptance Criteria 3, 4).\"\"\"\n120:         token = input(\"Enter your Z.AI auth token: \")\n121: \n122:         config = Config(zai_token=token)\n123:         self.save(config)\n124: \n125:         print(f\"Config saved to {self.config_file}\")\n126:         return config\n127: \n128:     def show_config(self) -> None:\n129:         \"\"\"Display current configuration with masked token (Acceptance Criteria 6, 7).\"\"\"\n130:         config = self.load()\n131: \n132:         # Mask token - show only last 4 chars (Acceptance Criteria 7)\n133:         masked_token = self._mask_token(config.zai_token)\n134: \n135:         print(f\"zai_token: {masked_token}\")\n136:         print(f\"zai_base_url: {config.zai_base_url}\")\n137:         print(f\"coding_base_url: {config.coding_base_url}\")\n138:         print(f\"timeout: {config.timeout}\")\n139:         print(f\"vision_model: {config.vision_model}\")\n140:         print(f\"chat_model: {config.chat_model}\")\n141:         print(f\"temperature: {config.temperature}\")\n142:         print(f\"top_p: {config.top_p}\")\n143:         print(f\"max_tokens: {config.max_tokens}\")\n144: \n145:     def get_config(self, key: str) -> None:\n146:         \"\"\"Get and display a single configuration value.\n147: \n148:         Args:\n149:             key: Configuration key to retrieve\n150: \n151:         Raises:\n152:             ValueError: If key is invalid\n153:         \"\"\"\n154:         config = self.load()\n155: \n156:         valid_keys = {\n157:             \"zai_token\", \"zai_base_url\", \"coding_base_url\", \"timeout\",\n158:             \"vision_model\", \"chat_model\", \"temperature\", \"top_p\", \"max_tokens\"\n159:         }\n160: \n161:         if key not in valid_keys:\n162:             raise ValueError(f\"Invalid config key: {key}. Valid keys: {', '.join(sorted(valid_keys))}\")\n163: \n164:         value = getattr(config, key)\n165: \n166:         # Mask token if requested\n167:         if key == \"zai_token\":\n168:             value = self._mask_token(value)\n169: \n170:         print(value)\n171: \n172:     def list_keys(self) -> None:\n173:         \"\"\"List all available configuration keys with descriptions.\"\"\"\n174:         descriptions = [\n175:             (\"zai_token\", \"Z.AI API authentication token (required)\"),\n176:             (\"zai_base_url\", f\"Base URL for Anthropic API/vision/chat (default: {DEFAULT_ZAI_BASE_URL})\"),\n177:             (\"coding_base_url\", f\"Base URL for Search/Read/Repo APIs (default: {DEFAULT_CODING_BASE_URL})\"),\n178:             (\"timeout\", f\"Request timeout in seconds (default: {DEFAULT_TIMEOUT_SECONDS})\"),\n179:             (\"vision_model\", f\"Model for image/video analysis (default: {DEFAULT_VISION_MODEL})\"),\n180:             (\"chat_model\", f\"Model for chat requests (default: {DEFAULT_CHAT_MODEL})\"),\n181:             (\"temperature\", f\"Generation temperature (default: {DEFAULT_TEMPERATURE})\"),\n182:             (\"top_p\", f\"Generation top_p sampling (default: {DEFAULT_TOP_P})\"),\n183:             (\"max_tokens\", f\"Maximum response tokens (default: {DEFAULT_MAX_TOKENS})\"),\n184:         ]\n185: \n186:         print(\"Available configuration keys:\")\n187:         for key, desc in descriptions:\n188:             print(f\"  {key:18s} - {desc}\")\n189: \n190:     def edit_config(self) -> None:\n191:         \"\"\"Open config file in the default editor.\"\"\"\n192:         import os\n193:         import subprocess\n194: \n195:         editor = os.environ.get(\"EDITOR\", os.environ.get(\"VISUAL\", \"vi\"))\n196: \n197:         try:\n198:             subprocess.call([editor, str(self.config_file)])\n199:         except FileNotFoundError:\n200:             # Try notepad on Windows as fallback\n201:             if os.name == \"nt\":\n202:                 subprocess.call([\"notepad\", str(self.config_file)])\n203:             else:\n204:                 raise FileNotFoundError(f\"Editor '{editor}' not found. Set EDITOR environment variable.\")\n205: \n206:     def _mask_token(self, token: str) -> str:\n207:         \"\"\"Mask token showing only last 4 characters.\n208: \n209:         Args:\n210:             token: The token to mask\n211: \n212:         Returns:\n213:             Masked token string\n214:         \"\"\"\n215:         if len(token) <= 4:\n216:             return f\"****{token}\"\n217:         return f\"****{token[-4:]}\"\n218: \n219:     def set_config(self, key: str, value: str) -> None:\n220:         \"\"\"Update a specific configuration field (Acceptance Criteria 8).\n221: \n222:         Args:\n223:             key: Configuration key to update\n224:             value: New value\n225: \n226:         Raises:\n227:             ValueError: If key is invalid or value cannot be converted\n228:         \"\"\"\n229:         config = self.load()\n230: \n231:         valid_keys = [\"zai_token\", \"zai_base_url\", \"coding_base_url\", \"timeout\", \"vision_model\", \"chat_model\"]\n232: \n233:         if key not in valid_keys:\n234:             raise ValueError(f\"Invalid config key: {key}. Valid keys: {', '.join(valid_keys)}\")\n235: \n236:         if key == \"timeout\":\n237:             try:\n238:                 value_int = int(value)\n239:                 if value_int <= 0:\n240:                     raise ValueError(\"timeout must be a positive integer\")\n241:                 setattr(config, key, value_int)\n242:             except ValueError as e:\n243:                 raise ValueError(f\"Invalid timeout value: {e}\") from e\n244:         else:\n245:             setattr(config, key, value)\n246: \n247:         self.save(config)\n248:         print(\"Config updated successfully\")\n249: \n250: \n251: def load_config() -> Config:\n252:     \"\"\"Load configuration, prompting for first-time setup if needed.\n253: \n254:     Returns:\n255:         Config object\n256:     \"\"\"\n257:     manager = ConfigManager()\n258:     return manager.load()\n\n(End of file - total 258 lines)\n</content>","title":"goz/config/__init__.py","metadata":{"preview":"\"\"\"Configuration management for goz.\n\nConfig file location: ~/.config/goz/config.json\n\"\"\"\nimport json\nfrom pathlib import Path\n\nfrom pydantic import BaseModel, Field, field_validator\n\n\n# Default config paths (Acceptance Criteria 1)\nDEFAULT_CONFIG_DIR = Path.home() / \".config\" / \"goz\"\nDEFAULT_CONFIG_FILE = DEFAULT_CONFIG_DIR / \"config.json\"\n\n# Default values (Acceptance Criteria 2)\nDEFAULT_ZAI_BASE_URL = \"https://api.z.ai/api/anthropic\"\nDEFAULT_CODING_BASE_URL = \"https://api.z.ai/api/coding/paas/v4\"\nDEFAULT_TIMEOUT = 300000  # 5 minutes in milliseconds\nDEFAULT_TIMEOUT_SECONDS = 120  # For Python clients (seconds)\n","truncated":false,"loaded":[]},"time":{"start":1775338532194,"end":1775338532200}}}}
