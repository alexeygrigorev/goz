{"type":"tool_use","timestamp":1775338524561,"sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","part":{"id":"prt_d5a6c0f8e001Z8z7ay6i3yNJhH","sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","messageID":"msg_d5a6bd4ed001xVRouoEdtM8Mpc","type":"tool","callID":"call_c104738edebe4caaa697596c","tool":"read","state":{"status":"completed","input":{"filePath":"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/config"},"output":"<path>/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/config</path>\n<type>directory</type>\n<entries>\n__init__.py\n\n(1 entries)\n</entries>","title":"goz/config","metadata":{"preview":"__init__.py","truncated":false,"loaded":[]},"time":{"start":1775338524559,"end":1775338524561}}}}
{"type":"tool_use","timestamp":1775338524575,"sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","part":{"id":"prt_d5a6c0f86001Ssiieh3fSqLQLf","sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","messageID":"msg_d5a6bd4ed001xVRouoEdtM8Mpc","type":"tool","callID":"call_94feba0276ce4bada4bf1727","tool":"read","state":{"status":"completed","input":{"filePath":"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/__main__.py"},"output":"<path>/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/__main__.py</path>\n<type>file</type>\n<content>1: \"\"\"Main entry point for the goz CLI.\"\"\"\n2: \n3: import asyncio\n4: import json\n5: import itertools\n6: import sys\n7: import threading\n8: import time\n9: from pathlib import Path\n10: \n11: from goz import __version__\n12: \n13: \n14: def _show_thinking_animation(stop_event: threading.Event) -> None:\n15:     \"\"\"Show a \"thinking\" animation in a separate thread.\n16: \n17:     Args:\n18:         stop_event: Threading event to stop the animation\n19:     \"\"\"\n20:     animation = [\"|\", \"/\", \"-\", \"\\\\\"]\n21:     try:\n22:         for frame in itertools.cycle(animation):\n23:             if stop_event.is_set():\n24:                 break\n25:             # Print the animation frame with carriage return to overwrite\n26:             print(f\"\\r{frame} Thinking...\", end=\"\", flush=True)\n27:             time.sleep(0.1)\n28:     finally:\n29:         # Clear the animation line when done\n30:         print(\"\\r\" + \" \" * 20 + \"\\r\", end=\"\", flush=True)\n31: \n32: \n33: def _print_json(data: object) -> None:\n34:     \"\"\"Print JSON with stable formatting.\"\"\"\n35:     print(json.dumps(data, indent=2, ensure_ascii=True))\n36: \n37: \n38: def _load_json_value(raw_value: str) -> object:\n39:     \"\"\"Load JSON from an inline value or @file reference.\"\"\"\n40:     source = raw_value\n41:     if raw_value.startswith(\"@\"):\n42:         source = Path(raw_value[1:]).read_text()\n43: \n44:     try:\n45:         return json.loads(source)\n46:     except json.JSONDecodeError as e:\n47:         raise ValueError(f\"Invalid JSON: {e}\") from e\n48: \n49: \n50: def _load_call_arguments(json_arg: str | None, use_stdin: bool) -> dict:\n51:     \"\"\"Resolve call arguments from --json or --stdin.\"\"\"\n52:     if json_arg is not None and use_stdin:\n53:         raise ValueError(\"Use either --json or --stdin, not both\")\n54: \n55:     if json_arg is None and not use_stdin:\n56:         return {}\n57: \n58:     payload = _load_json_value(sys.stdin.read() if use_stdin else json_arg or \"{}\")\n59:     if not isinstance(payload, dict):\n60:         raise ValueError(\"Tool arguments must be a JSON object\")\n61:     return payload\n62: \n63: \n64: async def cmd_vision(args: list[str]) -> None:\n65:     \"\"\"Handle the `goz vision` command.\n66: \n67:     Usage:\n68:         goz vision <image> [prompt]           - Analyze image (default)\n69:         goz vision analyze <image> [prompt]   - General analysis\n70:         goz vision ui-to-code <image>         - Convert UI to code\n71:         goz vision extract-text <image>       - OCR text extraction\n72:         goz vision diagnose-error <image>     - Diagnose error screenshot\n73:         goz vision diagram <image>            - Explain diagram\n74:         goz vision chart <image>              - Analyze chart\n75:         goz vision diff <expected> <actual>   - Compare images\n76:         goz vision video <video> [prompt]     - Analyze video\n77: \n78:     Options:\n79:         --no-stream     - Disable streaming (wait for full response)\n80:         --output <type> - Output type for ui-to-code (code, prompt, spec, description)\n81:         --language <lang> - Programming language for extract-text\n82:         --context <ctx> - Error context for diagnose-error\n83:         --type <type>   - Diagram type\n84:         --focus <focus> - Chart focus (trends, anomalies, comparisons, insights)\n85: \n86:     Args:\n87:         args: Command arguments\n88:     \"\"\"\n89: \n90:     # Check for help flag\n91:     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n92:         print(\"\"\"Vision command usage:\n93: \n94:   goz vision <image> [prompt]           - Analyze image (default)\n95:   goz vision analyze <image> [prompt]   - General image analysis\n96:   goz vision ui-to-code <image>         - Convert UI to code\n97:   goz vision extract-text <image>       - Extract text (OCR)\n98:   goz vision diagnose-error <image>     - Diagnose error screenshot\n99:   goz vision diagram <image>            - Explain technical diagram\n100:   goz vision chart <image>              - Analyze data visualization\n101:   goz vision diff <expected> <actual>   - Compare two screenshots\n102:   goz vision video <video> [prompt]     - Analyze video content\n103: \n104: Options:\n105:   --no-stream           - Disable streaming output\n106:   --output <type>       - ui-to-code output (code, prompt, spec, description)\n107:   --language <lang>     - Programming language for extract-text\n108:   --context <ctx>       - Error context for diagnose-error\n109:   --type <type>         - Diagram type (flowchart, sequence, architecture, etc.)\n110:   --focus <focus>       - Chart focus (trends, anomalies, comparisons, insights)\n111: \n112: File constraints:\n113:   Images: 5MB max (JPG, PNG, JPEG)\n114:   Videos: 8MB max (MP4, MOV, M4V)\n115: \"\"\")\n116:         return\n117: \n118:     from goz.api.vision import VisionClient\n119:     from goz.config import load_config\n120: \n121:     config = load_config()\n122:     client = VisionClient(config=config)\n123: \n124:     # Parse flags and positional args\n125:     flags = {}\n126:     positional = []\n127: \n128:     i = 0\n129:     while i < len(args):\n130:         arg = args[i]\n131:         if arg.startswith(\"--\"):\n132:             key = arg[2:]\n133:             # Check if next arg is a value (not a flag)\n134:             if i + 1 < len(args) and not args[i + 1].startswith(\"-\"):\n135:                 flags[key] = args[i + 1]\n136:                 i += 2\n137:             else:\n138:                 flags[key] = True\n139:                 i += 1\n140:         elif arg.startswith(\"-\") and len(arg) == 2:\n141:             key = arg[1:]\n142:             if i + 1 < len(args) and not args[i + 1].startswith(\"-\"):\n143:                 flags[key] = args[i + 1]\n144:                 i += 2\n145:             else:\n146:                 flags[key] = True\n147:                 i += 1\n148:         else:\n149:             positional.append(arg)\n150:             i += 1\n151: \n152:     # Determine mode and source\n153:     mode = \"analyze\"  # Default mode\n154:     source1 = None\n155:     source2 = None\n156:     prompt = None\n157: \n158:     # Check if first positional arg is a known subcommand\n159:     known_modes = {\n160:         \"analyze\", \"ui-to-code\", \"extract-text\",\n161:         \"diagnose-error\", \"diagram\", \"chart\", \"diff\", \"video\"\n162:     }\n163: \n164:     if positional[0] in known_modes:\n165:         mode = positional[0]\n166:         source1 = positional[1] if len(positional) > 1 else None\n167: \n168:         if mode == \"diff\":\n169:             source2 = positional[2] if len(positional) > 2 else None\n170:             prompt = positional[3] if len(positional) > 3 else None\n171:         else:\n172:             prompt = positional[2] if len(positional) > 2 else None\n173:     else:\n174:         # Old behavior: first arg is source\n175:         source1 = positional[0]\n176:         prompt = positional[1] if len(positional) > 1 else None\n177: \n178:     # Validate we have a source\n179:     if not source1:\n180:         print(\"Error: Missing image/video source\", file=sys.stderr)\n181:         print(\"Run 'goz vision --help' for usage\", file=sys.stderr)\n182:         sys.exit(1)\n183: \n184:     if mode == \"diff\" and not source2:\n185:         print(\"Error: diff mode requires two sources: <expected> <actual>\", file=sys.stderr)\n186:         sys.exit(1)\n187: \n188:     # Build prompt based on mode\n189:     default_prompts = {\n190:         \"analyze\": \"Describe this image in detail.\",\n191:         \"ui-to-code\": \"Convert this UI to production-ready code.\",\n192:         \"extract-text\": \"Extract all text from this image.\",\n193:         \"diagnose-error\": \"Diagnose this error and suggest fixes.\",\n194:         \"diagram\": \"Explain this technical diagram.\",\n195:         \"chart\": \"Analyze this data visualization.\",\n196:         \"video\": \"Analyze this video content.\",\n197:     }\n198: \n199:     effective_prompt = prompt or default_prompts.get(mode, \"Describe this image.\")\n200: \n201:     # Enhance prompt with mode-specific options\n202:     output_type = flags.get(\"output\", \"code\")\n203: \n204:     if mode == \"ui-to-code\" and output_type != \"code\":\n205:         if output_type == \"prompt\":\n206:             effective_prompt = (\n207:                 f\"{effective_prompt}\\n\\n\"\n208:                 f\"Provide a detailed prompt that would generate this UI, \"\n209:                 f\"including layout, components, styling, and functionality.\"\n210:             )\n211:         elif output_type == \"spec\":\n212:             effective_prompt = (\n213:                 f\"{effective_prompt}\\n\\n\"\n214:                 f\"Provide a technical specification including components, \"\n215:                 f\"props, state management, and styling approach.\"\n216:             )\n217:         elif output_type == \"description\":\n218:             effective_prompt = (\n219:                 f\"{effective_prompt}\\n\\n\"\n220:                 f\"Provide a detailed description of the UI layout, \"\n221:                 f\"components, colors, and interactions without generating code.\"\n222:             )\n223: \n224:     if mode == \"extract-text\" and flags.get(\"language\"):\n225:         effective_prompt = (\n226:             f\"{effective_prompt}\\n\\n\"\n227:             f\"The content is in {flags['language']}. Preserve code syntax and formatting.\"\n228:         )\n229: \n230:     if mode == \"diagnose-error\" and flags.get(\"context\"):\n231:         effective_prompt = (\n232:             f\"{effective_prompt}\\n\\n\"\n233:             f\"Context: {flags['context']}\\n\\n\"\n234:             f\"Consider this context when diagnosing the error.\"\n235:         )\n236: \n237:     if mode == \"diagram\" and flags.get(\"type\"):\n238:         effective_prompt = (\n239:             f\"{effective_prompt}\\n\\n\"\n240:             f\"This is a {flags['type']} diagram. Use appropriate terminology.\"\n241:         )\n242: \n243:     if mode == \"chart\" and flags.get(\"focus\"):\n244:         focus_prompts = {\n245:             \"trends\": \"Focus on identifying trends and patterns over time.\",\n246:             \"anomalies\": \"Focus on identifying anomalies, outliers, and unusual data points.\",\n247:             \"comparisons\": \"Focus on comparing different data series and values.\",\n248:             \"insights\": \"Focus on extracting key insights and actionable conclusions.\",\n249:         }\n250:         focus_prompt = focus_prompts.get(flags['focus'], '')\n251:         if focus_prompt:\n252:             effective_prompt = f\"{effective_prompt}\\n\\n{focus_prompt}\"\n253: \n254:     # Determine if streaming\n255:     no_stream = flags.get(\"no-stream\", False)\n256: \n257:     try:\n258:         if mode == \"diff\":\n259:             # For diff, analyze both images and compare\n260:             if no_stream:\n261:                 result1 = await client.analyze(source1, \"Describe this image in detail.\")\n262:                 result2 = await client.analyze(source2, \"Describe this image in detail.\")\n263:                 print(f\"Expected Image:\\n{result1}\\n\\n\")\n264:                 print(f\"Actual Image:\\n{result2}\\n\\n\")\n265:                 print(\"Note: Use the vision diff command for precise visual comparison.\")\n266:             else:\n267:                 print(\"Analyzing expected image...\", file=sys.stderr)\n268:                 async for chunk in client.analyze_stream(source1, \"Describe this image in detail.\"):\n269:                     print(chunk, end=\"\", flush=True)\n270:                 print(\"\\n\\nAnalyzing actual image...\", file=sys.stderr)\n271:                 async for chunk in client.analyze_stream(source2, \"Describe this image in detail.\"):\n272:                     print(chunk, end=\"\", flush=True)\n273:                 print(\"\\n\\nNote: Use the vision diff command for precise visual comparison.\")\n274:         else:\n275:             if no_stream:\n276:                 result = await client.analyze(source1, effective_prompt)\n277:                 print(result)\n278:             else:\n279:                 # Show \"thinking\" animation while waiting for first chunk\n280:                 import threading\n281:                 stop_animation = threading.Event()\n282:                 animation_thread = threading.Thread(\n283:                     target=_show_thinking_animation,\n284:                     args=(stop_animation,),\n285:                     daemon=True\n286:                 )\n287:                 animation_thread.start()\n288: \n289:                 # Stream response\n290:                 first_chunk = True\n291:                 async for chunk in client.analyze_stream(source1, effective_prompt):\n292:                     if first_chunk:\n293:                         # Stop animation on first chunk\n294:                         stop_animation.set()\n295:                         animation_thread.join(timeout=0.2)\n296:                         first_chunk = False\n297:                     print(chunk, end=\"\", flush=True)\n298:                 print()  # New line after streaming completes\n299:                 if first_chunk:\n300:                     # In case no chunks were received\n301:                     stop_animation.set()\n302:                     animation_thread.join(timeout=0.2)\n303:     except Exception as e:\n304:         print(f\"Error: {e}\", file=sys.stderr)\n305:         sys.exit(1)\n306: \n307: \n308: async def cmd_search(args: list[str]) -> None:\n309:     \"\"\"Handle the `goz search` command.\n310: \n311:     Usage:\n312:         goz search <query> [options]\n313: \n314:     Options:\n315:         --count, -c N       - Number of results (default: 10)\n316:         --domain, -d DOMAIN - Filter to domain\n317:         --recency, -r R     - Time filter (oneDay, oneWeek, oneMonth, oneYear, noLimit)\n318: \n319:     Args:\n320:         args: Command arguments\n321:     \"\"\"\n322:     import argparse\n323: \n324:     # Check for help\n325:     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n326:         print(\"\"\"Search command usage:\n327: \n328:   goz search <query> [options]\n329: \n330: Options:\n331:   --count, -c N         Number of results to return (default: 10)\n332:   --domain, -d DOMAIN   Filter results to specific domain\n333:   --recency, -r R       Time filter:\n334:                         - oneDay: Results from last 24 hours\n335:                         - oneWeek: Results from last week\n336:                         - oneMonth: Results from last month\n337:                         - oneYear: Results from last year\n338:                         - noLimit: No time restriction\n339: \n340: Examples:\n341:   goz search \"python async await\"\n342:   goz search \"climate change\" --count 5\n343:   goz search \"AI news\" --domain news.ycombinator.com --recency oneWeek\n344: \"\"\")\n345:         return\n346: \n347:     parser = argparse.ArgumentParser(prog=\"goz search\", add_help=False)\n348:     parser.add_argument(\"query\", help=\"Search query\")\n349:     parser.add_argument(\"--count\", \"-c\", type=int, help=\"Number of results\")\n350:     parser.add_argument(\"--domain\", \"-d\", help=\"Filter to domain\")\n351:     parser.add_argument(\"--recency\", \"-r\",\n352:                         choices=[\"oneDay\", \"oneWeek\", \"oneMonth\", \"oneYear\", \"noLimit\"],\n353:                         help=\"Time filter\")\n354: \n355:     parsed = parser.parse_args(args)\n356: \n357:     from goz.api.search import SearchClient\n358:     from goz.config import load_config\n359: \n360:     config = load_config()\n361:     client = SearchClient(config=config)\n362: \n363:     try:\n364:         results = await client.search(\n365:             query=parsed.query,\n366:             count=parsed.count,\n367:             domain_filter=parsed.domain,\n368:             recency_filter=parsed.recency,\n369:         )\n370:         for r in results:\n371:             print(f\"{r.rank}. {r.title}\")\n372:             print(f\"   {r.url}\")\n373:             if r.summary:\n374:                 print(f\"   {r.summary[:100]}...\")\n375:             print()\n376:     except Exception as e:\n377:         print(f\"Error: {e}\", file=sys.stderr)\n378:         sys.exit(1)\n379: \n380: \n381: async def cmd_read(args: list[str]) -> None:\n382:     \"\"\"Handle the `goz read` command.\n383: \n384:     Usage:\n385:         goz read <url> [options]\n386: \n387:     Options:\n388:         --format, -f FMT  - Output format (markdown, text)\n389:         --timeout, -t N   - Timeout in seconds (default: 20)\n390: \n391:     Args:\n392:         args: Command arguments\n393:     \"\"\"\n394:     import argparse\n395: \n396:     # Check for help\n397:     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n398:         print(\"\"\"Read command usage:\n399: \n400:   goz read <url> [options]\n401: \n402: Options:\n403:   --format, -f FMT    Output format:\n404:                       - markdown: GitHub Flavored Markdown (default)\n405:                       - text: Plain text\n406:   --timeout, -t N     Request timeout in seconds (default: 20)\n407: \n408: Examples:\n409:   goz read https://example.com\n410:   goz read https://example.com --format text\n411:   goz read https://example.com --timeout 30\n412: \"\"\")\n413:         return\n414: \n415:     parser = argparse.ArgumentParser(prog=\"goz read\", add_help=False)\n416:     parser.add_argument(\"url\", help=\"URL to read\")\n417:     parser.add_argument(\"--format\", \"-f\", choices=[\"markdown\", \"text\"],\n418:                         default=\"markdown\", help=\"Output format\")\n419:     parser.add_argument(\"--timeout\", \"-t\", type=int, help=\"Timeout in seconds\")\n420: \n421:     parsed = parser.parse_args(args)\n422: \n423:     from goz.api.reader import ReaderClient\n424:     from goz.config import load_config\n425: \n426:     config = load_config()\n427:     client = ReaderClient(config=config)\n428: \n429:     try:\n430:         result = await client.read(\n431:             url=parsed.url,\n432:             format=parsed.format,\n433:             timeout=parsed.timeout,\n434:         )\n435:         print(result.content)\n436:     except Exception as e:\n437:         print(f\"Error: {e}\", file=sys.stderr)\n438:         sys.exit(1)\n439: \n440: \n441: async def cmd_repo(args: list[str]) -> None:\n442:     \"\"\"Handle the `goz repo` command.\n443: \n444:     Usage:\n445:         goz repo search <owner/repo> <query>\n446:         goz repo tree <owner/repo>\n447:         goz repo read <owner/repo> <file_path>\n448: \n449:     Args:\n450:         args: Command arguments\n451:     \"\"\"\n452:     # Check for help or no args\n453:     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n454:         print(\"\"\"Repo command usage:\n455: \n456:   goz repo search <owner/repo> <query>   Search docs and code in repository\n457:   goz repo tree <owner/repo>             Get repository directory structure\n458:   goz repo read <owner/repo> <path>      Read a file from repository\n459: \n460: Search Options:\n461:   --language <lang>   Result language: en (default) or zh\n462: \n463: Tree Options:\n464:   --path <path>       Directory path to inspect (default: repo root)\n465:   --depth <n>         Expand subdirectory trees (default: 1)\n466: \n467: Examples:\n468:   goz repo search facebook/react \"server components\"\n469:   goz repo search vercel/next.js \"app router\" --language en\n470:   goz repo tree vercel/next.js\n471:   goz repo tree vercel/next.js --path packages --depth 2\n472:   goz repo read anthropics/anthropic-sdk-python README.md\n473: \n474: Notes:\n475:   - Repository must be public\n476:   - Use \"owner/repo\" format (e.g., \"facebook/react\")\n477:   - Paths are relative to repository root\n478: \"\"\")\n479:         return\n480: \n481:     subcommand = args[0]\n482: \n483:     if subcommand == \"search\":\n484:         # goz repo search <owner/repo> <query> [--language <lang>]\n485:         if len(args) < 3:\n486:             print(\"Error: repo search requires <owner/repo> and <query>\", file=sys.stderr)\n487:             print(\"Usage: goz repo search <owner/repo> <query> [--language <lang>]\", file=sys.stderr)\n488:             sys.exit(1)\n489: \n490:         repo = args[1]\n491:         query = args[2]\n492:         language = None\n493: \n494:         # Parse optional args\n495:         i = 3\n496:         while i < len(args):\n497:             if args[i] == \"--language\" and i + 1 < len(args):\n498:                 language = args[i + 1]\n499:                 i += 2\n500:             else:\n501:                 i += 1\n502: \n503:         from goz.api.repo import RepoClient\n504:         from goz.config import load_config\n505: \n506:         config = load_config()\n507:         client = RepoClient(config=config)\n508: \n509:         try:\n510:             results = await client.search(repo, query, language)\n511:             for r in results:\n512:                 if r.title:\n513:                     print(f\"# {r.title}\")\n514:                 print(r.content)\n515:                 if r.url:\n516:                     print(f\"URL: {r.url}\")\n517:                 print()\n518:         except Exception as e:\n519:             print(f\"Error: {e}\", file=sys.stderr)\n520:             sys.exit(1)\n521: \n522:     elif subcommand == \"tree\":\n523:         # goz repo tree <owner/repo> [--path <path>] [--depth <n>]\n524:         if len(args) < 2:\n525:             print(\"Error: repo tree requires <owner/repo>\", file=sys.stderr)\n526:             print(\"Usage: goz repo tree <owner/repo> [--path <path>] [--depth <n>]\", file=sys.stderr)\n527:             sys.exit(1)\n528: \n529:         repo = args[1]\n530:         path = None\n531:         depth = 1\n532: \n533:         # Parse optional args\n534:         i = 2\n535:         while i < len(args):\n536:             if args[i] == \"--path\" and i + 1 < len(args):\n537:                 path = args[i + 1]\n538:                 i += 2\n539:             elif args[i] == \"--depth\" and i + 1 < len(args):\n540:                 try:\n541:                     depth = int(args[i + 1])\n542:                 except ValueError:\n543:                     print(f\"Error: depth must be an integer, got '{args[i + 1]}'\", file=sys.stderr)\n544:                     sys.exit(1)\n545:                 i += 2\n546:             else:\n547:                 i += 1\n548: \n549:         from goz.api.repo import RepoClient\n550:         from goz.config import load_config\n551: \n552:         config = load_config()\n553:         client = RepoClient(config=config)\n554: \n555:         try:\n556:             result = await client.tree(repo, path, depth)\n557:             print(result)\n558:         except Exception as e:\n559:             print(f\"Error: {e}\", file=sys.stderr)\n560:             sys.exit(1)\n561: \n562:     elif subcommand == \"read\":\n563:         # goz repo read <owner/repo> <file_path>\n564:         if len(args) < 3:\n565:             print(\"Error: repo read requires <owner/repo> and <file_path>\", file=sys.stderr)\n566:             print(\"Usage: goz repo read <owner/repo> <file_path>\", file=sys.stderr)\n567:             sys.exit(1)\n568: \n569:         repo = args[1]\n570:         file_path = args[2]\n571: \n572:         from goz.api.repo import RepoClient\n573:         from goz.config import load_config\n574: \n575:         config = load_config()\n576:         client = RepoClient(config=config)\n577: \n578:         try:\n579:             result = await client.read(repo, file_path)\n580:             print(result)\n581:         except Exception as e:\n582:             print(f\"Error: {e}\", file=sys.stderr)\n583:             sys.exit(1)\n584: \n585:     else:\n586:         print(f\"Error: Unknown repo subcommand '{subcommand}'\", file=sys.stderr)\n587:         print(\"Run 'goz repo --help' for usage\", file=sys.stderr)\n588:         sys.exit(1)\n589: \n590: \n591: async def cmd_tools(args: list[str]) -> None:\n592:     \"\"\"Handle the `goz tools` command.\"\"\"\n593:     import argparse\n594: \n595:     if args and args[0] in (\"--help\", \"-h\", \"help\"):\n596:         print(\"\"\"Tools command usage:\n597: \n598:   goz tools [options]\n599: \n600: Options:\n601:   --filter TEXT   Filter tool names by substring\n602:   --full          Show full tool schemas as JSON\n603: \"\"\")\n604:         return\n605: \n606:     parser = argparse.ArgumentParser(prog=\"goz tools\", add_help=False)\n607:     parser.add_argument(\"--filter\", dest=\"name_filter\", help=\"Filter tool names by substring\")\n608:     parser.add_argument(\"--full\", action=\"store_true\", help=\"Show full tool schemas\")\n609:     parsed = parser.parse_args(args)\n610: \n611:     from goz.api.mcp import McpClient\n612: \n613:     client = McpClient()\n614:     try:\n615:         tools = await client.list_tools()\n616:     except Exception as e:\n617:         print(f\"Error: {e}\", file=sys.stderr)\n618:         sys.exit(1)\n619: \n620:     if parsed.name_filter:\n621:         query = parsed.name_filter.lower()\n622:         tools = [tool for tool in tools if query in str(tool.get(\"name\", \"\")).lower()]\n623: \n624:     if parsed.full:\n625:         _print_json(tools)\n626:         return\n627: \n628:     for tool in tools:\n629:         name = tool.get(\"name\")\n630:         if name:\n631:             print(name)\n632: \n633: \n634: async def cmd_tool(args: list[str]) -> None:\n635:     \"\"\"Handle the `goz tool <name>` command.\"\"\"\n636:     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n637:         print(\"\"\"Tool command usage:\n638: \n639:   goz tool <name>\n640: \"\"\")\n641:         return\n642: \n643:     from goz.api.mcp import McpClient\n644: \n645:     client = McpClient()\n646:     try:\n647:         tool = await client.get_tool(args[0])\n648:     except Exception as e:\n649:         print(f\"Error: {e}\", file=sys.stderr)\n650:         sys.exit(1)\n651: \n652:     if tool is None:\n653:         print(f\"Error: Unknown tool '{args[0]}'\", file=sys.stderr)\n654:         sys.exit(1)\n655: \n656:     _print_json(tool)\n657: \n658: \n659: async def cmd_call(args: list[str]) -> None:\n660:     \"\"\"Handle the `goz call <tool>` command.\"\"\"\n661:     import argparse\n662: \n663:     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n664:         print(\"\"\"Call command usage:\n665: \n666:   goz call <tool> [--json JSON|@file.json] [--stdin] [--dry-run]\n667: \n668: Options:\n669:   --json VALUE    Inline JSON object or @path/to/file.json\n670:   --stdin         Read JSON object from stdin\n671:   --dry-run       Print resolved request payload without calling the tool\n672: \"\"\")\n673:         return\n674: \n675:     parser = argparse.ArgumentParser(prog=\"goz call\", add_help=False)\n676:     parser.add_argument(\"tool\", help=\"Tool name to call\")\n677:     parser.add_argument(\"--json\", dest=\"json_payload\", help=\"Inline JSON or @file reference\")\n678:     parser.add_argument(\"--stdin\", action=\"store_true\", help=\"Read JSON from stdin\")\n679:     parser.add_argument(\"--dry-run\", action=\"store_true\", help=\"Preview the request without calling\")\n680:     parsed = parser.parse_args(args)\n681: \n682:     try:\n683:         arguments = _load_call_arguments(parsed.json_payload, parsed.stdin)\n684:     except (OSError, ValueError) as e:\n685:         print(f\"Error: {e}\", file=sys.stderr)\n686:         sys.exit(1)\n687: \n688:     request_payload = {\n689:         \"name\": parsed.tool,\n690:         \"arguments\": arguments,\n691:     }\n692:     if parsed.dry_run:\n693:         _print_json(request_payload)\n694:         return\n695: \n696:     from goz.api.mcp import McpClient\n697: \n698:     client = McpClient()\n699:     try:\n700:         result = await client.call_tool(parsed.tool, arguments)\n701:     except Exception as e:\n702:         print(f\"Error: {e}\", file=sys.stderr)\n703:         sys.exit(1)\n704: \n705:     _print_json(result)\n706: \n707: \n708: async def cmd_run(args: list[str]) -> None:\n709:     \"\"\"Handle the `goz run` command.\"\"\"\n710:     from goz.cli.run import cmd_run as run_cmd\n711: \n712:     await run_cmd(args)\n713: \n714: \n715: def cmd_config(args: list[str]) -> None:\n716:     \"\"\"Handle the `goz config` command.\n717: \n718:     Usage:\n719:         goz config                - Show current config\n720:         goz config get <key>      - Get a single value\n721:         goz config set <key> <val> - Set a value\n722:         goz config list           - List all keys\n723:         goz config edit           - Open in editor\n724: \n725:     Args:\n726:         args: Remaining arguments after 'config'\n727:     \"\"\"\n728:     from goz.config import ConfigManager\n729: \n730:     manager = ConfigManager()\n731: \n732:     # No subcommand = show current config\n733:     if not args:\n734:         manager.show_config()\n735:         return\n736: \n737:     subcommand = args[0]\n738: \n739:     if subcommand == \"get\" and len(args) >= 2:\n740:         key = args[1]\n741:         try:\n742:             manager.get_config(key)\n743:         except ValueError as e:\n744:             print(f\"Error: {e}\", file=sys.stderr)\n745:             sys.exit(1)\n746: \n747:     elif subcommand == \"set\" and len(args) >= 2:\n748:         key = args[1]\n749:         value = args[2] if len(args) > 2 else \"\"\n750:         try:\n751:             manager.set_config(key, value)\n752:         except ValueError as e:\n753:             print(f\"Error: {e}\", file=sys.stderr)\n754:             sys.exit(1)\n755: \n756:     elif subcommand == \"list\":\n757:         manager.list_keys()\n758: \n759:     elif subcommand == \"edit\":\n760:         try:\n761:             manager.edit_config()\n762:         except Exception as e:\n763:             print(f\"Error: {e}\", file=sys.stderr)\n764:             sys.exit(1)\n765: \n766:     elif subcommand in (\"--help\", \"-h\", \"help\"):\n767:         print(\"\"\"Config command usage:\n768: \n769:   goz config                Show current configuration\n770:   goz config get <key>      Get a single configuration value\n771:   goz config set <key> <val> Set a configuration value\n772:   goz config list           List all available keys with descriptions\n773:   goz config edit           Open config file in $EDITOR\n774: \n775: Keys:\n776:   zai_token     - Z.AI API authentication token (required)\n777:   zai_base_url  - Base URL for Z.AI API\n778:   timeout       - Request timeout in seconds\n779:   vision_model  - Model for image/video analysis\n780:   chat_model    - Model for chat requests\n781:   temperature   - Generation temperature\n782:   top_p         - Generation top_p sampling\n783:   max_tokens    - Maximum response tokens\n784: \"\"\")\n785: \n786:     else:\n787:         # Treat as show current config (for backwards compatibility)\n788:         manager.show_config()\n789: \n790: \n791: def cmd_doctor(args: list[str]) -> None:\n792:     \"\"\"Handle the `goz doctor` command.\n793: \n794:     Usage:\n795:         goz doctor\n796: \n797:     Runs environment and connectivity checks.\n798: \n799:     Args:\n800:         args: Remaining arguments\n801:     \"\"\"\n802:     import asyncio\n803: \n804:     # Check for help\n805:     if args and args[0] in (\"--help\", \"-h\", \"help\"):\n806:         print(\"\"\"Doctor command usage:\n807: \n808:   goz doctor\n809: \n810: Runs diagnostic checks:\n811:   - Config file exists\n812:   - API token is set\n813:   - API endpoint is reachable\n814: \"\"\")\n815:         return\n816: \n817:     async def run_doctor() -> None:\n818:         from goz.config import load_config, DEFAULT_CONFIG_FILE\n819: \n820:         checks_passed = 0\n821:         checks_failed = 0\n822: \n823:         # Check 1: Config file\n824:         print(\"Checking configuration...\")\n825:         if DEFAULT_CONFIG_FILE.exists():\n826:             print(f\"  [PASS] Config file found at {DEFAULT_CONFIG_FILE}\")\n827:             checks_passed += 1\n828:         else:\n829:             print(f\"  [FAIL] Config file not found at {DEFAULT_CONFIG_FILE}\")\n830:             print(\"         Run 'goz config' to set up.\")\n831:             checks_failed += 1\n832: \n833:         # Check 2: Load config and validate token\n834:         try:\n835:             config = load_config()\n836:             if config.zai_token:\n837:                 masked = f\"****{config.zai_token[-4:]}\" if len(config.zai_token) > 4 else \"****\"\n838:                 print(f\"  [PASS] API token present ({masked})\")\n839:                 checks_passed += 1\n840:             else:\n841:                 print(\"  [FAIL] API token not set\")\n842:                 checks_failed += 1\n843:         except Exception as e:\n844:             print(f\"  [FAIL] Error loading config: {e}\")\n845:             checks_failed += 1\n846:             return\n847: \n848:         # Check 3: API connectivity\n849:         try:\n850:             import httpx\n851:             async with httpx.AsyncClient(timeout=5.0) as client:\n852:                 await client.get(config.zai_base_url)\n853:                 print(f\"  [PASS] Base URL reachable ({config.zai_base_url})\")\n854:                 checks_passed += 1\n855:         except (httpx.ConnectError, httpx.NetworkError) as e:\n856:             print(f\"  [FAIL] Cannot connect to API: {e}\")\n857:             checks_failed += 1\n858:         except Exception as e:\n859:             print(f\"  [WARN] Could not test connectivity: {e}\")\n860: \n861:         # Summary\n862:         print()\n863:         if checks_failed == 0:\n864:             print(f\"All checks passed! ({checks_passed}/{checks_passed})\")\n865:         else:\n866:             print(f\"Some checks failed: {checks_failed} failed, {checks_passed} passed\")\n867: \n868:     asyncio.run(run_doctor())\n869: \n870: \n871: def cmd_tui(args: list[str]) -> None:\n872:     \"\"\"Launch the TUI.\n873: \n874:     Args:\n875:         args: Remaining arguments (ignored)\n876:     \"\"\"\n877:     from goz.tui import run_tui\n878:     run_tui()\n879: \n880: \n881: def main() -> None:\n882:     \"\"\"Run the goz CLI.\n883: \n884:     This is the entry point for the `goz` command.\n885:     \"\"\"\n886:     import argparse\n887: \n888:     # Check for --help before argparse to handle it properly\n889:     if \"--help\" in sys.argv or \"-h\" in sys.argv:\n890:         print(f\"\"\"goz v{__version__} - Z.AI Tools\n891: \n892: Usage: goz <command> [args] [options]\n893: \n894: Commands:\n895:   run       One-shot agent run with JSONL output\n896:   vision    Image and video analysis\n897:   search    Real-time web search\n898:   read      Fetch and parse web pages\n899:   repo      GitHub repository exploration\n900:   tools     List MCP tools\n901:   tool      Show one MCP tool schema\n902:   call      Call an MCP tool directly\n903:   config    Manage configuration\n904:   doctor    Environment + connectivity checks\n905:   tui       Launch interactive terminal UI\n906: \n907: Global Options:\n908:   --help, -h     Show this help message\n909:   --version, -v  Show version number\n910: \n911: For command-specific help:\n912:   goz vision --help\n913:   goz run --help\n914:   goz search --help\n915:   goz read --help\n916:   goz repo --help\n917:   goz tools --help\n918:   goz tool --help\n919:   goz call --help\n920:   goz config --help\n921:   goz doctor --help\n922: \n923: Examples:\n924:   goz vision analyze https://example.com/image.png\n925:   goz run --format json \"Inspect this repo and report STAGE_RESULT.\"\n926:   goz vision ui-to-code screenshot.png\n927:   goz search \"python async await\"\n928:   goz read https://example.com/article\n929:   goz repo tree vercel/next.js\n930:   goz repo search facebook/react \"hooks\"\n931:   goz tools --filter vision\n932:   goz tool zai.vision.analyze_image\n933:   goz call zai.search.webSearchPrime --json '{{\"search_query\":\"test\"}}'\n934:   goz config get zai_token\n935: \n936: With no command, launches the interactive TUI.\n937: \"\"\")\n938:         return\n939: \n940:     parser = argparse.ArgumentParser(\n941:         prog=\"goz\",\n942:         description=\"goz - Z.AI Tools: vision, search, web reader, and more\",\n943:         add_help=False,  # We handle help manually\n944:     )\n945:     parser.add_argument(\n946:         \"--version\",\n947:         action=\"version\",\n948:         version=f\"%(prog)s {__version__}\",\n949:     )\n950:     # Agent mode flags (for use with no command)\n951:     parser.add_argument(\n952:         \"--load\",\n953:         help=\"Load session on startup (for agent mode)\",\n954:     )\n955:     parser.add_argument(\n956:         \"--agent\",\n957:         help=\"Start with specific agent type (for agent mode)\",\n958:     )\n959:     parser.add_argument(\n960:         \"command\",\n961:         nargs=\"?\",\n962:         help=\"Command to run (run, config, vision, search, read, repo, tools, tool, call, doctor, tui)\",\n963:     )\n964:     parser.add_argument(\n965:         \"args\",\n966:         nargs=argparse.REMAINDER,\n967:         help=\"Arguments for the command\",\n968:     )\n969: \n970:     args = parser.parse_args()\n971: \n972:     if args.command is None:\n973:         # No command = launch AGENT MODE (interactive coding agent)\n974:         from goz.agent.tui import run_agent_app\n975:         run_agent_app(session_id=args.load, agent_type=args.agent)\n976:         return\n977: \n978:     # Dispatch to command handlers\n979:     if args.command == \"config\":\n980:         cmd_config(args.args)\n981:     elif args.command == \"vision\":\n982:         asyncio.run(cmd_vision(args.args))\n983:     elif args.command == \"run\":\n984:         asyncio.run(cmd_run(args.args))\n985:     elif args.command == \"search\":\n986:         asyncio.run(cmd_search(args.args))\n987:     elif args.command == \"read\":\n988:         asyncio.run(cmd_read(args.args))\n989:     elif args.command == \"repo\":\n990:         asyncio.run(cmd_repo(args.args))\n991:     elif args.command == \"tools\":\n992:         asyncio.run(cmd_tools(args.args))\n993:     elif args.command == \"tool\":\n994:         asyncio.run(cmd_tool(args.args))\n995:     elif args.command == \"call\":\n996:         asyncio.run(cmd_call(args.args))\n997:     elif args.command == \"doctor\":\n998:         cmd_doctor(args.args)\n999:     elif args.command in (\"tui\", \"ui\"):\n1000:         cmd_tui(args.args)\n1001:     else:\n1002:         print(f\"Error: Unknown command '{args.command}'\", file=sys.stderr)\n1003:         print(\"Run 'goz --help' for usage\", file=sys.stderr)\n1004:         sys.exit(1)\n1005: \n1006: \n1007: if __name__ == \"__main__\":\n1008:     main()\n\n(End of file - total 1008 lines)\n</content>","title":"goz/__main__.py","metadata":{"preview":"\"\"\"Main entry point for the goz CLI.\"\"\"\n\nimport asyncio\nimport json\nimport itertools\nimport sys\nimport threading\nimport time\nfrom pathlib import Path\n\nfrom goz import __version__\n\n\ndef _show_thinking_animation(stop_event: threading.Event) -> None:\n    \"\"\"Show a \"thinking\" animation in a separate thread.\n\n    Args:\n        stop_event: Threading event to stop the animation\n    \"\"\"\n    animation = [\"|\", \"/\", \"-\", \"\\\\\"]","truncated":false,"loaded":[]},"time":{"start":1775338524551,"end":1775338524567}}}}
{"type":"tool_use","timestamp":1775338524577,"sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","part":{"id":"prt_d5a6c0f8b001zEnaDmAuyWsGKG","sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","messageID":"msg_d5a6bd4ed001xVRouoEdtM8Mpc","type":"tool","callID":"call_ed4d918f2eee4097b8f9b2c0","tool":"read","state":{"status":"completed","input":{"filePath":"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/errors.py"},"output":"<path>/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/errors.py</path>\n<type>file</type>\n<content>1: \"\"\"Error types for Z.AI API client.\n2: \n3: These error types are used throughout the API client for consistent error handling.\n4: \"\"\"\n5: \n6: from __future__ import annotations\n7: \n8: \n9: \n10: class ZaiError(Exception):\n11:     \"\"\"Base error class for all Z.AI API errors.\n12: \n13:     Attributes:\n14:         message: Human-readable error message\n15:         code: Error code for programmatic handling\n16:         statusCode: HTTP status code (optional)\n17:         help: Helpful hint for resolving the error (optional)\n18:     \"\"\"\n19: \n20:     def __init__(\n21:         self,\n22:         message: str,\n23:         code: str = \"ZAI_ERROR\",\n24:         statusCode: int | None = None,\n25:         help: str | None = None,\n26:     ) -> None:\n27:         \"\"\"Initialize ZaiError.\n28: \n29:         Args:\n30:             message: Human-readable error message\n31:             code: Error code for programmatic handling\n32:             statusCode: HTTP status code (optional)\n33:             help: Helpful hint for resolving the error (optional)\n34:         \"\"\"\n35:         self.message = message\n36:         self.code = code\n37:         self.statusCode = statusCode\n38:         self.help = help\n39:         super().__init__(self.message)\n40: \n41:     def __str__(self) -> str:\n42:         \"\"\"Return string representation showing error code and message.\"\"\"\n43:         return f\"[{self.code}] {self.message}\"\n44: \n45:     def __repr__(self) -> str:\n46:         \"\"\"Return detailed string representation.\"\"\"\n47:         return (\n48:             f\"{self.__class__.__name__}(message={self.message!r}, code={self.code!r}, \"\n49:             f\"statusCode={self.statusCode!r}, help={self.help!r})\"\n50:         )\n51: \n52: \n53: class AuthError(ZaiError):\n54:     \"\"\"Authentication/authorization error (401, 403).\n55: \n56:     This error is raised when the API token is invalid, expired, or missing.\n57:     \"\"\"\n58: \n59:     def __init__(self, message: str, statusCode: int = 401) -> None:\n60:         \"\"\"Initialize AuthError.\n61: \n62:         Args:\n63:             message: Human-readable error message\n64:             statusCode: HTTP status code (default: 401)\n65:         \"\"\"\n66:         super().__init__(\n67:             message=message,\n68:             code=\"AUTH_ERROR\",\n69:             statusCode=statusCode,\n70:             help=\"Authentication failed. Check your API key in ~/.config/goz/config.json. \"\n71:             \"Run 'goz config set zai_token <your-token>' to update.\",\n72:         )\n73: \n74: \n75: class ApiError(ZaiError):\n76:     \"\"\"General API error (4xx, 5xx responses).\n77: \n78:     This error is raised for API errors that are not authentication-related.\n79:     \"\"\"\n80: \n81:     def __init__(self, message: str, statusCode: int = 500) -> None:\n82:         \"\"\"Initialize ApiError.\n83: \n84:         Args:\n85:             message: Human-readable error message\n86:             statusCode: HTTP status code (default: 500)\n87:         \"\"\"\n88:         super().__init__(\n89:             message=message,\n90:             code=\"API_ERROR\",\n91:             statusCode=statusCode,\n92:             help=self._default_help(statusCode),\n93:         )\n94: \n95:     @staticmethod\n96:     def _default_help(status_code: int) -> str:\n97:         \"\"\"Return actionable guidance based on HTTP status code.\"\"\"\n98:         if status_code == 429:\n99:             return \"Rate limit hit. Wait a moment before retrying, or reduce request volume.\"\n100:         if status_code >= 500:\n101:             return \"The service is having problems. Retry shortly; if it persists, try again later.\"\n102:         return \"Check the request input and try again.\"\n103: \n104: \n105: class NetworkError(ZaiError):\n106:     \"\"\"Network connection error.\n107: \n108:     This error is raised when the client cannot connect to the API server.\n109:     \"\"\"\n110: \n111:     def __init__(self, message: str) -> None:\n112:         \"\"\"Initialize NetworkError.\n113: \n114:         Args:\n115:             message: Human-readable error message\n116:         \"\"\"\n117:         super().__init__(\n118:             message=message,\n119:             code=\"NETWORK_ERROR\",\n120:             help=\"Network connection failed. Check your internet connection and try again.\",\n121:         )\n122: \n123: \n124: class TimeoutError(ZaiError):\n125:     \"\"\"Request timeout error.\n126: \n127:     This error is raised when the API request takes too long to complete.\n128:     \"\"\"\n129: \n130:     def __init__(self, timeoutMs: int) -> None:\n131:         \"\"\"Initialize TimeoutError.\n132: \n133:         Args:\n134:             timeoutMs: Timeout value in milliseconds\n135:         \"\"\"\n136:         super().__init__(\n137:             message=f\"Request timed out after {timeoutMs}ms\",\n138:             code=\"TIMEOUT_ERROR\",\n139:             help=\"Try again or increase timeout with Z_AI_TIMEOUT env var\",\n140:         )\n141: \n142: \n143: class ValidationError(ZaiError):\n144:     \"\"\"Validation error for invalid input parameters.\n145: \n146:     This error is raised when input validation fails, such as invalid URLs,\n147:     invalid format values, or other parameter validation issues.\n148:     \"\"\"\n149: \n150:     def __init__(self, message: str) -> None:\n151:         \"\"\"Initialize ValidationError.\n152: \n153:         Args:\n154:             message: Human-readable error message describing the validation failure\n155:         \"\"\"\n156:         super().__init__(\n157:             message=message,\n158:             code=\"VALIDATION_ERROR\",\n159:             help=\"Check your input parameters and try again.\",\n160:         )\n161: \n162: \n163: # Z.AI quota/rate-limit error codes\n164: QUOTA_ERROR_CODES = {\n165:     1302: \"QuotaExceededError\",\n166:     1305: \"RateLimitError\",\n167:     1308: \"TokenBudgetExceededError\",\n168:     1310: \"ConcurrentRequestLimitError\",\n169: }\n170: \n171: QUOTA_ERROR_DESCRIPTIONS = {\n172:     1302: \"API quota exceeded. Your usage has reached the plan limit.\",\n173:     1305: \"Rate limit hit. Too many requests in a short time window.\",\n174:     1308: \"Token budget exceeded for this billing period.\",\n175:     1310: \"Concurrent request limit reached. Wait for in-flight requests to finish.\",\n176: }\n177: \n178: QUOTA_ERROR_HELP = {\n179:     1302: \"Check your usage with 'goz usage' and consider upgrading your plan.\",\n180:     1305: \"Wait a moment before retrying, or reduce request volume.\",\n181:     1308: \"Reduce token usage or wait for the next billing period to reset.\",\n182:     1310: \"Wait for current requests to finish before sending new ones.\",\n183: }\n184: \n185: \n186: class QuotaError(ZaiError):\n187:     \"\"\"Quota or rate-limit error from Z.AI (error codes 1302/1305/1308/1310).\n188: \n189:     This error is raised when the Z.AI API returns a quota-related error code,\n190:     indicating that usage limits have been exceeded.\n191:     \"\"\"\n192: \n193:     def __init__(self, message: str, zai_code: int = 1302, statusCode: int = 429) -> None:\n194:         \"\"\"Initialize QuotaError.\n195: \n196:         Args:\n197:             message: Human-readable error message from the API\n198:             zai_code: Z.AI-specific error code (1302, 1305, 1308, or 1310)\n199:             statusCode: HTTP status code (typically 429)\n200:         \"\"\"\n201:         code_name = QUOTA_ERROR_CODES.get(zai_code, \"QUOTA_ERROR\")\n202:         help_text = QUOTA_ERROR_HELP.get(zai_code, \"Check your usage with 'goz usage'.\")\n203:         super().__init__(\n204:             message=message,\n205:             code=code_name,\n206:             statusCode=statusCode,\n207:             help=help_text,\n208:         )\n209:         self.zai_code = zai_code\n210: \n211: \n212: def is_quota_error(error: ZaiError) -> bool:\n213:     \"\"\"Check if an error is a quota-related error (codes 1302/1305/1308/1310).\"\"\"\n214:     if isinstance(error, QuotaError):\n215:         return True\n216:     # Also check if a generic error carries a quota code in its message\n217:     for code in QUOTA_ERROR_CODES:\n218:         if f\"[{code}]\" in str(error) or f\"code {code}\" in str(error).lower():\n219:             return True\n220:     return False\n\n(End of file - total 220 lines)\n</content>","title":"goz/api/errors.py","metadata":{"preview":"\"\"\"Error types for Z.AI API client.\n\nThese error types are used throughout the API client for consistent error handling.\n\"\"\"\n\nfrom __future__ import annotations\n\n\n\nclass ZaiError(Exception):\n    \"\"\"Base error class for all Z.AI API errors.\n\n    Attributes:\n        message: Human-readable error message\n        code: Error code for programmatic handling\n        statusCode: HTTP status code (optional)\n        help: Helpful hint for resolving the error (optional)\n    \"\"\"\n\n    def __init__(","truncated":false,"loaded":[]},"time":{"start":1775338524556,"end":1775338524576}}}}
{"type":"tool_use","timestamp":1775338524583,"sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","part":{"id":"prt_d5a6c0f8d001Vw5c81lGLAiJXk","sessionID":"ses_2a594d103ffeiA9Z2XMgVNr73E","messageID":"msg_d5a6bd4ed001xVRouoEdtM8Mpc","type":"tool","callID":"call_3a1e6de108424be19b2c7353","tool":"read","state":{"status":"completed","input":{"filePath":"/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/client.py"},"output":"<path>/home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/client.py</path>\n<type>file</type>\n<content>1: \"\"\"Z.AI API client for vision, search, and reader.\n2: \n3: Following TDD: tests are written first, then implementation follows.\n4: \"\"\"\n5: from __future__ import annotations\n6: \n7: import asyncio\n8: import json\n9: import logging\n10: import os\n11: from typing import Any\n12: \n13: import httpx\n14: \n15: from goz.api.errors import ApiError, AuthError, NetworkError, TimeoutError, ZaiError\n16: from goz.config import Config, load_config\n17: \n18: \n19: # Logger for API requests\n20: logger = logging.getLogger(__name__)\n21: \n22: \n23: def with_retry(max_retries: int = 2, base_delay: float = 1.0):\n24:     \"\"\"Decorator for retry logic with exponential backoff.\n25: \n26:     Args:\n27:         max_retries: Maximum number of retry attempts (default: 2)\n28:         base_delay: Base delay in seconds (default: 1.0)\n29: \n30:     Returns:\n31:         Decorator function\n32:     \"\"\"\n33:     def decorator(fn):\n34:         async def wrapper(*args, **kwargs):\n35:             last_error: Exception | None = None\n36: \n37:             for attempt in range(max_retries + 1):\n38:                 try:\n39:                     return await fn(*args, **kwargs)\n40:                 except AuthError:\n41:                     # Don't retry auth errors\n42:                     raise\n43:                 except Exception as e:\n44:                     last_error = e\n45: \n46:                     # Don't retry on last attempt\n47:                     if attempt == max_retries:\n48:                         break\n49: \n50:                     # Exponential backoff\n51:                     delay = base_delay * (2 ** attempt)\n52:                     await asyncio.sleep(delay)\n53: \n54:             raise last_error\n55:         return wrapper\n56:     return decorator\n57: \n58: \n59: class ZaiApiClient:\n60:     \"\"\"Z.AI API client.\n61: \n62:     This client handles HTTP requests to the Z.AI API with retry logic,\n63:     error handling, and optional logging.\n64:     \"\"\"\n65: \n66:     def __init__(\n67:         self,\n68:         config: Config | None = None,\n69:         enable_logging: bool | None = None,\n70:     ) -> None:\n71:         \"\"\"Initialize ZaiApiClient.\n72: \n73:         Args:\n74:             config: Optional Config object. If not provided, loads from default location.\n75:             enable_logging: Optional flag to enable logging. If not provided, checks\n76:                 GOZ_API_LOG environment variable.\n77:         \"\"\"\n78:         self.config = config or load_config()\n79: \n80:         # Enable logging if explicitly set or GOZ_API_LOG env var is set\n81:         if enable_logging is None:\n82:             enable_logging = os.getenv(\"GOZ_API_LOG\", \"\").lower() in (\"1\", \"true\", \"yes\")\n83:         self.enable_logging = enable_logging\n84: \n85:     @with_retry(max_retries=2, base_delay=1.0)\n86:     async def request(\n87:         self,\n88:         endpoint: str,\n89:         body: dict[str, Any],\n90:     ) -> dict[str, Any]:\n91:         \"\"\"Make an HTTP POST request to the API.\n92: \n93:         Args:\n94:             endpoint: API endpoint path (e.g., '/chat/completions')\n95:             body: Request body as dictionary\n96: \n97:         Returns:\n98:             Parsed JSON response as dictionary\n99: \n100:         Raises:\n101:             AuthError: For 401/403 responses\n102:             ApiError: For other 4xx/5xx responses\n103:             TimeoutError: For request timeouts\n104:             NetworkError: For network failures\n105:         \"\"\"\n106:         url = f\"{self.config.zai_base_url}{endpoint}\"\n107:         timeout_ms = self.config.timeout * 1000\n108: \n109:         if self.enable_logging:\n110:             logger.debug(\"-> POST %s (%d bytes)\", endpoint, len(json.dumps(body)))\n111: \n112:         try:\n113:             async with httpx.AsyncClient(timeout=self.config.timeout) as client:\n114:                 response = await client.post(\n115:                     url,\n116:                     json=body,\n117:                     headers={\n118:                         \"Authorization\": f\"Bearer {self.config.zai_token}\",\n119:                         \"Content-Type\": \"application/json\",\n120:                         \"Accept-Language\": \"en-US,en\",\n121:                     },\n122:                 )\n123: \n124:                 if self.enable_logging:\n125:                     logger.debug(\n126:                         \"<- %d %d bytes\",\n127:                         response.status_code,\n128:                         len(response.content),\n129:                     )\n130: \n131:                 # Handle error responses\n132:                 if not response.is_success:\n133:                     self._handle_error_response(response)\n134: \n135:                 # Return parsed JSON\n136:                 return response.json()\n137: \n138:         except asyncio.TimeoutError as e:\n139:             if self.enable_logging:\n140:                 logger.error(\"! TimeoutError: Request timed out after %dms\", timeout_ms)\n141:             raise TimeoutError(timeout_ms) from e\n142:         except httpx.TimeoutException as e:\n143:             if self.enable_logging:\n144:                 logger.error(\"! TimeoutException: Request timed out after %dms\", timeout_ms)\n145:             raise TimeoutError(timeout_ms) from e\n146:         except httpx.ConnectError as e:\n147:             if self.enable_logging:\n148:                 logger.error(\"! NetworkError: %s\", e)\n149:             raise NetworkError(str(e)) from e\n150:         except httpx.NetworkError as e:\n151:             if self.enable_logging:\n152:                 logger.error(\"! NetworkError: %s\", e)\n153:             raise NetworkError(str(e)) from e\n154:         except AuthError:\n155:             # Re-raise AuthError as-is\n156:             raise\n157:         except ZaiError:\n158:             # Re-raise other ZaiErrors as-is\n159:             raise\n160:         except Exception as e:\n161:             if self.enable_logging:\n162:                 logger.error(\"! %s: %s\", type(e).__name__, e)\n163:             raise\n164: \n165:     def _handle_error_response(self, response: httpx.Response) -> None:\n166:         \"\"\"Handle error response from API.\n167: \n168:         Args:\n169:             response: HTTP response object\n170: \n171:         Raises:\n172:             AuthError: For 401/403 responses\n173:             ApiError: For other error responses\n174:         \"\"\"\n175:         status_code = response.status_code\n176: \n177:         # Try to parse error message from JSON\n178:         error_message = self._parse_error_message(response)\n179: \n180:         if self.enable_logging:\n181:             logger.error(\"! %d: %s\", status_code, error_message)\n182: \n183:         # Raise appropriate error based on status code\n184:         if status_code in (401, 403):\n185:             raise AuthError(error_message, statusCode=status_code)\n186:         else:\n187:             raise ApiError(error_message, statusCode=status_code)\n188: \n189:     def _parse_error_message(self, response: httpx.Response) -> str:\n190:         \"\"\"Parse error message from response.\n191: \n192:         Handles nested error structures like:\n193:         - {\"error\": {\"message\": \"...\"}}\n194:         - {\"message\": \"...\"}\n195:         - {\"error\": \"...\"}\n196: \n197:         Args:\n198:             response: HTTP response object\n199: \n200:         Returns:\n201:             Extracted error message\n202:         \"\"\"\n203:         try:\n204:             data = response.json()\n205: \n206:             # Try nested error.message\n207:             if isinstance(data.get(\"error\"), dict):\n208:                 msg = data[\"error\"].get(\"message\")\n209:                 if msg:\n210:                     return msg if isinstance(msg, str) else json.dumps(msg)\n211: \n212:             # Try top-level message\n213:             if \"message\" in data:\n214:                 msg = data[\"message\"]\n215:                 return msg if isinstance(msg, str) else json.dumps(msg)\n216: \n217:             # Try error field\n218:             if \"error\" in data:\n219:                 msg = data[\"error\"]\n220:                 return msg if isinstance(msg, str) else json.dumps(msg)\n221: \n222:         except (json.JSONDecodeError, ValueError):\n223:             # Not JSON, use text as-is\n224:             pass\n225: \n226:         return response.text or f\"HTTP {response.status_code}\"\n\n(End of file - total 226 lines)\n</content>","title":"goz/api/client.py","metadata":{"preview":"\"\"\"Z.AI API client for vision, search, and reader.\n\nFollowing TDD: tests are written first, then implementation follows.\n\"\"\"\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport logging\nimport os\nfrom typing import Any\n\nimport httpx\n\nfrom goz.api.errors import ApiError, AuthError, NetworkError, TimeoutError, ZaiError\nfrom goz.config import Config, load_config\n\n\n# Logger for API requests\nlogger = logging.getLogger(__name__)","truncated":false,"loaded":[]},"time":{"start":1775338524558,"end":1775338524577}}}}
