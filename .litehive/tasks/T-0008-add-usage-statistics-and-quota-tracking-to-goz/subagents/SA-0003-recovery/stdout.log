z vision ui-to-code screenshot.png\n927:   goz search \"python async await\"\n928:   goz read https://example.com/article\n929:   goz repo tree vercel/next.js\n930:   goz repo search facebook/react \"hooks\"\n931:   goz tools --filter vision\n932:   goz tool zai.vision.analyze_image\n933:   goz call zai.search.webSearchPrime --json '{{\"search_query\":\"test\"}}'\n934:   goz config get zai_token\n935: \n936: With no command, launches the interactive TUI.\n937: \"\"\")\n938:         return\n939: \n940:     parser = argparse.ArgumentParser(\n941:         prog=\"goz\",\n942:         description=\"goz - Z.AI Tools: vision, search, web reader, and more\",\n943:         add_help=False,  # We handle help manually\n944:     )\n945:     parser.add_argument(\n946:         \"--version\",\n947:         action=\"version\",\n948:         version=f\"%(prog)s {__version__}\",\n949:     )\n950:     # Agent mode flags (for use with no command)\n951:     parser.add_argument(\n952:         \"--load\",\n953:         help=\"Load session on startup (for agent mode)\",\n954:     )\n955:     parser.add_argument(\n956:         \"--agent\",\n957:         help=\"Start with specific agent type (for agent mode)\",\n958:     )\n959:     parser.add_argument(\n960:         \"command\",\n961:         nargs=\"?\",\n962:         help=\"Command to run (run, config, vision, search, read, repo, tools, tool, call, doctor, tui)\",\n963:     )\n964:     parser.add_argument(\n965:         \"args\",\n966:         nargs=argparse.REMAINDER,\n967:         help=\"Arguments for the command\",\n968:     )\n969: \n970:     args = parser.parse_args()\n971: \n972:     if args.command is None:\n973:         # No command = launch AGENT MODE (interactive coding agent)\n974:         from goz.agent.tui import run_agent_app\n975:         run_agent_app(session_id=args.load, agent_type=args.agent)\n976:         return\n977: \n978:     # Dispatch to command handlers\n979:     if args.command == \"config\":\n980:         cmd_config(args.args)\n981:     elif args.command == \"vision\":\n982:         asyncio.run(cmd_vision(args.args))\n983:     elif args.command == \"run\":\n984:         asyncio.run(cmd_run(args.args))\n985:     elif args.command == \"search\":\n\n(Showing lines 886-985 of 1008. Use offset=986 to continue.)\n</content>","title":"goz/__main__.py","metadata":{"preview":"    import argparse\n\n    # Check for --help before argparse to handle it properly\n    if \"--help\" in sys.argv or \"-h\" in sys.argv:\n        print(f\"\"\"goz v{__version__} - Z.AI Tools\n\nUsage: goz <command> [args] [options]\n\nCommands:\n  run       One-shot agent run with JSONL output\n  vision    Image and video analysis\n  search    Real-time web search\n  read      Fetch and parse web pages\n  repo      GitHub repository exploration\n  tools     List MCP tools\n  tool      Show one MCP tool schema\n  call      Call an MCP tool directly\n  config    Manage configuration\n  doctor    Environment + connectivity checks\n  tui       Launch interactive terminal UI","truncated":true,"loaded":[]},"time":{"start":1775338877747,"end":1775338877748}}}}
