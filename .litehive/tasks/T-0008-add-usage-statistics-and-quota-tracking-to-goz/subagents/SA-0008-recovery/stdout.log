{"type": "tool_use", "part": {"id": "call_b9fbec6211f0462291a4244c", "name": "view_file", "input": {"file_path": "goz/agent/usage.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/usage.py (193 lines)\n============================================================\n\n  1\u2192 \"\"\"Usage tracking for Z.AI token consumption and cost.\n  2\u2192 \n  3\u2192 This module provides data structures and utilities for tracking token usage\n  4\u2192 across streaming API responses, computing costs, and accumulating per-session\n  5\u2192 statistics.\n  6\u2192 \n  7\u2192 Acceptance Criteria (T-0008):\n  8\u2192 - Per-turn token counts extracted from message_start/message_delta events\n  9\u2192 - Accumulated in session state\n 10\u2192 - step_finish JSONL event includes tokens and cost\n 11\u2192 \"\"\"\n 12\u2192 \n 13\u2192 from __future__ import annotations\n 14\u2192 \n 15\u2192 import math\n 16\u2192 from dataclasses import dataclass, field\n 17\u2192 \n 18\u2192 \n 19\u2192 # Approximate per-Mtoken pricing (USD) for common models.\n 20\u2192 # These are best-effort estimates; actual billing comes from the API.\n 21\u2192 _MODEL_PRICING: dict[str, dict[str, float]] = {\n 22\u2192     \"glm-5-turbo\": {\"input\": 2.0, \"output\": 8.0, \"cache_read\": 0.5, \"cache_creation\": 2.5},\n 23\u2192     \"glm-4.6v\": {\"input\": 2.0, \"output\": 8.0, \"cache_read\": 0.5, \"cache_creation\": 2.5},\n 24\u2192     \"claude-sonnet-4-20250514\": {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75},\n 25\u2192     \"claude-3-5-sonnet-20241022\": {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75},\n 26\u2192 }\n 27\u2192 \n 28\u2192 _DEFAULT_PRICING = {\"input\": 3.0, \"output\": 15.0, \"cache_read\": 0.3, \"cache_creation\": 3.75}\n 29\u2192 \n 30\u2192 \n 31\u2192 def _get_pricing(model: str) -> dict[str, float]:\n 32\u2192     \"\"\"Return pricing dict for *model*, falling back to defaults.\"\"\"\n 33\u2192     for key, pricing in _MODEL_PRICING.items():\n 34\u2192         if key in model:\n 35\u2192             return pricing\n 36\u2192     return _DEFAULT_PRICING\n 37\u2192 \n 38\u2192 \n 39\u2192 @dataclass\n 40\u2192 class UsageSnapshot:\n 41\u2192     \"\"\"Token counts from a single API response (one streaming turn).\n 42\u2192 \n 43\u2192     Attributes:\n 44\u2192         input_tokens: Total input tokens for the request.\n 45\u2192         output_tokens: Total output tokens generated.\n 46\u2192         cache_read_input_tokens: Tokens served from prompt cache (read).\n 47\u2192         cache_creation_input_tokens: Tokens stored into prompt cache (write).\n 48\u2192     \"\"\"\n 49\u2192 \n 50\u2192     input_tokens: int = 0\n 51\u2192     output_tokens: int = 0\n 52\u2192     cache_read_input_tokens: int = 0\n 53\u2192     cache_creation_input_tokens: int = 0\n 54\u2192 \n 55\u2192     def cost_usd(self, model: str = \"\") -> float:\n 56\u2192         \"\"\"Compute approximate USD cost for this snapshot.\"\"\"\n 57\u2192         pricing = _get_pricing(model)\n 58\u2192         return (\n 59\u2192             self.input_tokens * pricing[\"input\"]\n 60\u2192             + self.output_tokens * pricing[\"output\"]\n 61\u2192             + self.cache_read_input_tokens * pricing[\"cache_read\"]\n 62\u2192             + self.cache_creation_input_tokens * pricing[\"cache_creation\"]\n 63\u2192         ) / 1_000_000.0\n 64\u2192 \n 65\u2192     def total_tokens(self) -> int:\n 66\u2192         \"\"\"Return the sum of all token counts.\"\"\"\n 67\u2192         return (\n 68\u2192             self.input_tokens\n 69\u2192             + self.output_tokens\n 70\u2192             + self.cache_read_input_tokens\n 71\u2192             + self.cache_creation_input_tokens\n 72\u2192         )\n 73\u2192 \n 74\u2192     def to_dict(self) -> dict:\n 75\u2192         \"\"\"Serialise to a plain dict (for JSONL emission).\"\"\"\n 76\u2192         return {\n 77\u2192             \"input\": self.input_tokens,\n 78\u2192             \"output\": self.output_tokens,\n 79\u2192             \"cache_read\": self.cache_read_input_tokens,\n 80\u2192             \"cache_creation\": self.cache_creation_input_tokens,\n 81\u2192         }\n 82\u2192 \n 83\u2192 \n 84\u2192 @dataclass\n 85\u2192 class UsageAccumulator:\n 86\u2192     \"\"\"Accumulates usage across multiple turns in a session.\n 87\u2192 \n 88\u2192     Usage is captured in two phases per streaming response:\n 89\u2192     1. ``message_start`` carries initial input / cache tokens.\n 90\u2192     2. ``message_delta`` carries the final output token count.\n 91\u2192 \n 92\u2192     The accumulator merges these into a :class:`UsageSnapshot` per turn\n 93\u2192     and maintains running totals.\n 94\u2192     \"\"\"\n 95\u2192 \n 96\u2192     # Running totals across all turns\n 97\u2192     total_input_tokens: int = 0\n 98\u2192     total_output_tokens: int = 0\n 99\u2192     total_cache_read_tokens: int = 0\n100\u2192     total_cache_creation_tokens: int = 0\n101\u2192     turn_count: int = 0\n102\u2192 \n103\u2192     # Per-turn snapshots (append-only)\n104\u2192     turns: list[UsageSnapshot] = field(default_factory=list)\n105\u2192 \n106\u2192     # --- Streaming helpers ---------------------------------------------------\n107\u2192 \n108\u2192     def begin_turn(self) -> None:\n109\u2192         \"\"\"Prepare for a new streaming turn.\"\"\"\n110\u2192         self.turns.append(UsageSnapshot())\n111\u2192 \n112\u2192     def apply_message_start(self, usage: object) -> None:\n113\u2192         \"\"\"Merge ``message_start`` usage data into the current turn.\n114\u2192 \n115\u2192         Args:\n116\u2192             usage: An object with ``input_tokens``, optionally\n117\u2192                 ``cache_read_input_tokens`` and ``cache_creation_input_tokens``.\n118\u2192         \"\"\"\n119\u2192         if not self.turns:\n120\u2192             self.begin_turn()\n121\u2192         snap = self.turns[-1]\n122\u2192         snap.input_tokens = getattr(usage, \"input_tokens\", 0) or 0\n123\u2192         snap.cache_read_input_tokens = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n124\u2192         snap.cache_creation_input_tokens = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n125\u2192 \n126\u2192     def apply_message_delta(self, usage: object) -> None:\n127\u2192         \"\"\"Merge ``message_delta`` usage data into the current turn.\n128\u2192 \n129\u2192         Args:\n130\u2192             usage: An object with ``output_tokens``, optionally cumulative\n131\u2192                 ``input_tokens``, ``cache_read_input_tokens``, etc.\n132\u2192         \"\"\"\n133\u2192         if not self.turns:\n134\u2192             self.begin_turn()\n135\u2192         snap = self.turns[-1]\n136\u2192         # message_delta carries cumulative output_tokens\n137\u2192         snap.output_tokens = getattr(usage, \"output_tokens\", 0) or 0\n138\u2192         # Update input/cache if provided (some APIs send cumulative totals here)\n139\u2192         if hasattr(usage, \"input_tokens\") and usage.input_tokens is not None:\n140\u2192             snap.input_tokens = usage.input_tokens\n141\u2192         if hasattr(usage, \"cache_read_input_tokens\") and usage.cache_read_input_tokens is not None:\n142\u2192             snap.cache_read_input_tokens = usage.cache_read_input_tokens\n143\u2192         if hasattr(usage, \"cache_creation_input_tokens\") and usage.cache_creation_input_tokens is not None:\n144\u2192             snap.cache_creation_input_tokens = usage.cache_creation_input_tokens\n145\u2192 \n146\u2192     def finalise_turn(self) -> UsageSnapshot:\n147\u2192         \"\"\"Close the current turn, roll into running totals, and return it.\"\"\"\n148\u2192         if not self.turns:\n149\u2192             return UsageSnapshot()\n150\u2192         snap = self.turns[-1]\n151\u2192         self.total_input_tokens += snap.input_tokens\n152\u2192         self.total_output_tokens += snap.output_tokens\n153\u2192         self.total_cache_read_tokens += snap.cache_read_input_tokens\n154\u2192         self.total_cache_creation_tokens += snap.cache_creation_input_tokens\n155\u2192         self.turn_count += 1\n156\u2192         return snap\n157\u2192 \n158\u2192     def current_turn_snapshot(self) -> UsageSnapshot:\n159\u2192         \"\"\"Return the in-progress snapshot for the current turn.\"\"\"\n160\u2192         if not self.turns:\n161\u2192             return UsageSnapshot()\n162\u2192         return self.turns[-1]\n163\u2192 \n164\u2192     # --- Aggregation ---------------------------------------------------------\n165\u2192 \n166\u2192     def total_tokens(self) -> int:\n167\u2192         return (\n168\u2192             self.total_input_tokens\n169\u2192             + self.total_output_tokens\n170\u2192             + self.total_cache_read_tokens\n171\u2192             + self.total_cache_creation_tokens\n172\u2192         )\n173\u2192 \n174\u2192     def total_cost_usd(self, model: str = \"\") -> float:\n175\u2192         pricing = _get_pricing(model)\n176\u2192         return (\n177\u2192             self.total_input_tokens * pricing[\"input\"]\n178\u2192             + self.total_output_tokens * pricing[\"output\"]\n179\u2192             + self.total_cache_read_tokens * pricing[\"cache_read\"]\n180\u2192             + self.total_cache_creation_tokens * pricing[\"cache_creation\"]\n181\u2192         ) / 1_000_000.0\n182\u2192 \n183\u2192     def to_dict(self) -> dict:\n184\u2192         \"\"\"Serialise full accumulator state.\"\"\"\n185\u2192         return {\n186\u2192             \"turn_count\": self.turn_count,\n187\u2192             \"total_input\": self.total_input_tokens,\n188\u2192             \"total_output\": self.total_output_tokens,\n189\u2192             \"total_cache_read\": self.total_cache_read_tokens,\n190\u2192             \"total_cache_creation\": self.total_cache_creation_tokens,\n191\u2192             \"total_tokens\": self.total_tokens(),\n192\u2192             \"turns\": [t.to_dict() for t in self.turns],\n193\u2192         }", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_99aa28d6801e4dd48782ad40", "name": "view_file", "input": {"file_path": "goz/agent/chat_client.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/chat_client.py (530 lines)\n============================================================\n\n  1\u2192 \"\"\"Chat API Client for Z.AI (Issue 17).\n  2\u2192 \n  3\u2192 This module provides the ChatClient class for interacting with the Z.AI\n  4\u2192 chat API using the Anthropic SDK with tool calling support.\n  5\u2192 \n  6\u2192 Acceptance Criteria:\n  7\u2192 1. ChatClient class exists in goz/agent/chat_client.py\n  8\u2192 2. Uses existing Anthropic SDK (same as Vision API)\n  9\u2192 3. Uses config.zai_token and config.zai_base_url\n 10\u2192 4. chat_completion() method sends messages and returns async iterator\n 11\u2192 5. Supports tools parameter for function calling\n 12\u2192 6. Supports tool_choice parameter (\"auto\", \"any\")\n 13\u2192 7. Supports stream parameter (True/False)\n 14\u2192 8. Response chunks yield text deltas\n 15\u2192 9. Tool calls are properly formatted in stream\n 16\u2192 10. Errors raised as appropriate exceptions (AuthError, ApiError, etc.)\n 17\u2192 11. Timeout configurable via config\n 18\u2192 \n 19\u2192 T-0008 additions:\n 20\u2192 - MessageStart carries usage from message_start event\n 21\u2192 - UsageDelta chunk type carries usage from message_delta event\n 22\u2192 - QuotaError detection for Z.AI codes 1302/1305/1308/1310\n 23\u2192 \"\"\"\n 24\u2192 \n 25\u2192 import asyncio\n 26\u2192 import json\n 27\u2192 from dataclasses import dataclass\n 28\u2192 from typing import Any, AsyncIterator, Literal\n 29\u2192 \n 30\u2192 import anthropic\n 31\u2192 from anthropic import AsyncAnthropic\n 32\u2192 \n 33\u2192 from goz.api.errors import AuthError, ApiError, NetworkError, TimeoutError, ZaiError, QuotaError\n 34\u2192 from goz.config import Config\n 35\u2192 \n 36\u2192 \n 37\u2192 # Chunk types for streaming responses (from spec)\n 38\u2192 @dataclass\n 39\u2192 class ContentBlockStart:\n 40\u2192     \"\"\"Start of a content block in the stream.\n 41\u2192 \n 42\u2192     Attributes:\n 43\u2192         type: The type of content block (\"text\" or \"tool_use\")\n 44\u2192         index: The index of this content block\n 45\u2192         id: Tool call ID (only for tool_use type)\n 46\u2192         name: Tool name (only for tool_use type)\n 47\u2192     \"\"\"\n 48\u2192 \n 49\u2192     type: Literal[\"text\", \"tool_use\"]\n 50\u2192     index: int\n 51\u2192     id: str | None = None\n 52\u2192     name: str | None = None\n 53\u2192 \n 54\u2192 \n 55\u2192 @dataclass\n 56\u2192 class ContentBlockDelta:\n 57\u2192     \"\"\"Delta for a content block in the stream.\n 58\u2192 \n 59\u2192     Attributes:\n 60\u2192         type: The type of delta (\"text_delta\" or \"input_json_delta\")\n 61\u2192         index: The index of this content block\n 62\u2192         text: Text content (only for text_delta type)\n 63\u2192         partial_json: Partial JSON string (only for input_json_delta type)\n 64\u2192     \"\"\"\n 65\u2192 \n 66\u2192     type: Literal[\"text_delta\", \"input_json_delta\"]\n 67\u2192     index: int\n 68\u2192     text: str | None = None\n 69\u2192     partial_json: str | None = None\n 70\u2192 \n 71\u2192 \n 72\u2192 @dataclass\n 73\u2192 class ContentBlockStop:\n 74\u2192     \"\"\"End of a content block in the stream.\n 75\u2192 \n 76\u2192     Attributes:\n 77\u2192         index: The index of this content block\n 78\u2192     \"\"\"\n 79\u2192 \n 80\u2192     index: int\n 81\u2192 \n 82\u2192 \n 83\u2192 @dataclass\n 84\u2192 class MessageStart:\n 85\u2192     \"\"\"Start of the message.\n 86\u2192 \n 87\u2192     Attributes:\n 88\u2192         id: Message ID\n 89\u2192         model: Model name\n 90\u2192         usage_input_tokens: Input tokens from message_start.usage\n 91\u2192         usage_cache_read: Cache read tokens from message_start.usage\n 92\u2192         usage_cache_creation: Cache creation tokens from message_start.usage\n 93\u2192     \"\"\"\n 94\u2192 \n 95\u2192     id: str\n 96\u2192     model: str\n 97\u2192     usage_input_tokens: int = 0\n 98\u2192     usage_cache_read: int = 0\n 99\u2192     usage_cache_creation: int = 0\n100\u2192 \n101\u2192 \n102\u2192 @dataclass\n103\u2192 class MessageStop:\n104\u2192     \"\"\"End of the message.\n105\u2192 \n106\u2192     Attributes:\n107\u2192         stop_reason: Reason for stopping (\"end_turn\", \"max_tokens\", \"tool_use\")\n108\u2192         usage_output_tokens: Output tokens from message_delta.usage\n109\u2192     \"\"\"\n110\u2192 \n111\u2192     stop_reason: Literal[\"end_turn\", \"max_tokens\", \"tool_use\"]\n112\u2192     usage_output_tokens: int = 0\n113\u2192 \n114\u2192 \n115\u2192 @dataclass\n116\u2192 class UsageDelta:\n117\u2192     \"\"\"Usage data from message_delta event.\n118\u2192 \n119\u2192     Attributes:\n120\u2192         output_tokens: Output tokens generated so far\n121\u2192     \"\"\"\n122\u2192 \n123\u2192     output_tokens: int = 0\n124\u2192 \n125\u2192 \n126\u2192 # Union type for all chunk types\n127\u2192 Chunk = (\n128\u2192     ContentBlockStart\n129\u2192     | ContentBlockDelta\n130\u2192     | ContentBlockStop\n131\u2192     | MessageStart\n132\u2192     | MessageStop\n133\u2192     | UsageDelta\n134\u2192 )\n135\u2192 \n136\u2192 \n137\u2192 class ChatClient:\n138\u2192     \"\"\"Client for Z.AI Chat API with tool calling support.\n139\u2192 \n140\u2192     This client uses the Anthropic SDK to interact with the Z.AI chat API,\n141\u2192     supporting streaming responses, tool calling, and various generation\n142\u2192     parameters.\n143\u2192 \n144\u2192     Attributes:\n145\u2192         config: Configuration object containing API credentials and settings\n146\u2192         _client: Internal AsyncAnthropic client instance\n147\u2192     \"\"\"\n148\u2192 \n149\u2192     def __init__(self, config: Config | None = None) -> None:\n150\u2192         \"\"\"Initialize ChatClient.\n151\u2192 \n152\u2192         Args:\n153\u2192             config: Optional config object. If not provided, loads from default location.\n154\u2192 \n155\u2192         Acceptance Criteria:\n156\u2192         - Uses config.zai_token and config.zai_base_url (AC 3)\n157\u2192         - Uses AsyncAnthropic from existing SDK (AC 2)\n158\u2192         - Timeout is configurable via config (AC 11)\n159\u2192         \"\"\"\n160\u2192         if config is None:\n161\u2192             from goz.config import load_config\n162\u2192 \n163\u2192             config = load_config()\n164\u2192 \n165\u2192         self.config = config\n166\u2192 \n167\u2192         # Initialize async Anthropic client (same pattern as VisionClient)\n168\u2192         self._client = AsyncAnthropic(\n169\u2192             api_key=self.config.zai_token,\n170\u2192             base_url=self.config.zai_base_url,\n171\u2192             timeout=self.config.timeout,\n172\u2192         )\n173\u2192         self.max_retries = 2\n174\u2192         self.base_retry_delay = 1.0\n175\u2192 \n176\u2192     async def chat_completion(\n177\u2192         self,\n178\u2192         messages: list[dict],\n179\u2192         tools: list[dict] | None = None,\n180\u2192         tool_choice: Literal[\"auto\", \"any\", \"none\"] | dict = \"auto\",\n181\u2192         stream: bool = True,\n182\u2192         temperature: float | None = None,\n183\u2192         max_tokens: int | None = None,\n184\u2192     ) -> AsyncIterator[Chunk]:\n185\u2192         \"\"\"Stream chat completion with tool calling support.\n186\u2192 \n187\u2192         Args:\n188\u2192             messages: Chat history in Anthropic format\n189\u2192             tools: Tool definitions in Anthropic format (optional)\n190\u2192             tool_choice: How to select tools (\"auto\", \"any\", \"none\", or specific tool dict)\n191\u2192             stream: Whether to stream response (True) or wait for complete response (False)\n192\u2192             temperature: Generation temperature (uses config default if None)\n193\u2192             max_tokens: Max tokens in response (uses config default if None)\n194\u2192 \n195\u2192         Yields:\n196\u2192             Chunk objects from the API response\n197\u2192 \n198\u2192         Raises:\n199\u2192             AuthError: For 401/403 authentication failures\n200\u2192             ApiError: For other API errors (4xx, 5xx)\n201\u2192             NetworkError: For connection failures\n202\u2192             TimeoutError: For request timeouts\n203\u2192 \n204\u2192         Acceptance Criteria:\n205\u2192         - Returns async iterator (AC 4)\n206\u2192         - Supports tools parameter (AC 5)\n207\u2192         - Supports tool_choice parameter (AC 6)\n208\u2192         - Supports stream parameter (AC 7)\n209\u2192         - Response chunks yield text deltas (AC 8)\n210\u2192         - Tool calls properly formatted in stream (AC 9)\n211\u2192         - Errors raised as appropriate exceptions (AC 10)\n212\u2192         \"\"\"\n213\u2192         # Build request parameters\n214\u2192         params: dict = {\n215\u2192             \"model\": self.config.chat_model,\n216\u2192             \"messages\": messages,\n217\u2192         }\n218\u2192 \n219\u2192         # Add optional parameters\n220\u2192         if tools is not None:\n221\u2192             params[\"tools\"] = tools\n222\u2192 \n223\u2192         if tool_choice != \"auto\":\n224\u2192             params[\"tool_choice\"] = tool_choice\n225\u2192 \n226\u2192         if temperature is not None:\n227\u2192             params[\"temperature\"] = temperature\n228\u2192         else:\n229\u2192             params[\"temperature\"] = self.config.temperature\n230\u2192 \n231\u2192         if max_tokens is not None:\n232\u2192             params[\"max_tokens\"] = max_tokens\n233\u2192         else:\n234\u2192             params[\"max_tokens\"] = self.config.max_tokens\n235\u2192 \n236\u2192         timeout_ms = int(self.config.timeout * 1000)\n237\u2192 \n238\u2192         for attempt in range(self.max_retries + 1):\n239\u2192             try:\n240\u2192                 if stream:\n241\u2192                     async with self._client.messages.stream(**params) as response_stream:\n242\u2192                         async for event in response_stream:\n243\u2192                             chunk = self._convert_sse_event_to_chunk(event)\n244\u2192                             if chunk is not None:\n245\u2192                                 yield chunk\n246\u2192                 else:\n247\u2192                     response = await self._client.messages.create(**params)\n248\u2192                     async for chunk in self._response_to_chunks(response):\n249\u2192                         yield chunk\n250\u2192                 return\n251\u2192             except anthropic.AuthenticationError as e:\n252\u2192                 status_code = getattr(getattr(e, \"response\", None), \"status_code\", 401)\n253\u2192                 raise AuthError(\n254\u2192                     \"Authentication failed. Check your API token and try again.\",\n255\u2192                     statusCode=status_code,\n256\u2192                 ) from e\n257\u2192             except anthropic.APITimeoutError as e:\n258\u2192                 timeout_error = TimeoutError(timeoutMs=timeout_ms)\n259\u2192                 if attempt >= self.max_retries:\n260\u2192                     raise timeout_error from e\n261\u2192                 await self._sleep_before_retry(attempt)\n262\u2192             except anthropic.APIConnectionError as e:\n263\u2192                 network_error = NetworkError(\n264\u2192                     \"Connection failed while contacting the API. Check your network and retry.\"\n265\u2192                 )\n266\u2192                 if attempt >= self.max_retries:\n267\u2192                     raise network_error from e\n268\u2192                 await self._sleep_before_retry(attempt)\n269\u2192             except anthropic.APIStatusError as e:\n270\u2192                 status_code = getattr(e, \"status_code\", None) or getattr(\n271\u2192                     getattr(e, \"response\", None), \"status_code\", 500\n272\u2192                 )\n273\u2192                 if status_code in (401, 403):\n274\u2192                     raise AuthError(\n275\u2192                         \"Authentication failed. Check your API token and try again.\",\n276\u2192                         statusCode=status_code,\n277\u2192                     ) from e\n278\u2192 \n279\u2192                 zai_code = self._extract_zai_error_code(e)\n280\u2192                 if zai_code in (1302, 1305, 1308, 1310):\n281\u2192                     raise QuotaError(str(e), zai_code=zai_code, statusCode=status_code) from e\n282\u2192 \n283\u2192                 if status_code == 429:\n284\u2192                     api_error = ApiError(\n285\u2192                         \"Rate limit exceeded. Wait a moment and retry, or reduce request volume.\",\n286\u2192                         statusCode=status_code,\n287\u2192                     )\n288\u2192                 elif status_code >= 500:\n289\u2192                     api_error = ApiError(\n290\u2192                         \"Server error from the API. Retry shortly; the service may be degraded.\",\n291\u2192                         statusCode=status_code,\n292\u2192                     )\n293\u2192                 else:\n294\u2192                     api_error = ApiError(str(e), statusCode=status_code)\n295\u2192 \n296\u2192                 if attempt >= self.max_retries or status_code < 500 and status_code != 429:\n297\u2192                     raise api_error from e\n298\u2192                 await self._sleep_before_retry(attempt)\n299\u2192             except Exception as e:\n300\u2192                 raise ZaiError(f\"Unexpected error: {e}\") from e\n301\u2192 \n302\u2192     def _convert_sse_event_to_chunk(\n303\u2192         self, event: anthropic.types.RawMessageStreamEvent\n304\u2192     ) -> Chunk | None:\n305\u2192         \"\"\"Convert Anthropic SSE event to our Chunk type.\n306\u2192 \n307\u2192         Args:\n308\u2192             event: Raw SSE event from Anthropic SDK\n309\u2192 \n310\u2192         Returns:\n311\u2192             Chunk object or None if event type not handled\n312\u2192         \"\"\"\n313\u2192         event_type = event.type\n314\u2192 \n315\u2192         if event_type == \"message_start\":\n316\u2192             usage = getattr(event.message, \"usage\", None)\n317\u2192             input_tokens = getattr(usage, \"input_tokens\", 0) or 0\n318\u2192             cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n319\u2192             cache_creation = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n320\u2192             return MessageStart(\n321\u2192                 id=event.message.id,\n322\u2192                 model=event.message.model,\n323\u2192                 usage_input_tokens=input_tokens,\n324\u2192                 usage_cache_read=cache_read,\n325\u2192                 usage_cache_creation=cache_creation,\n326\u2192             )\n327\u2192 \n328\u2192         elif event_type == \"content_block_start\":\n329\u2192             content_block = event.content_block\n330\u2192             if content_block.type == \"text\":\n331\u2192                 return ContentBlockStart(\n332\u2192                     type=\"text\",\n333\u2192                     index=event.index,\n334\u2192                 )\n335\u2192             elif content_block.type == \"tool_use\":\n336\u2192                 return ContentBlockStart(\n337\u2192                     type=\"tool_use\",\n338\u2192                     index=event.index,\n339\u2192                     id=content_block.id,\n340\u2192                     name=content_block.name,\n341\u2192                 )\n342\u2192 \n343\u2192         elif event_type == \"content_block_delta\":\n344\u2192             delta = event.delta\n345\u2192             if delta.type == \"text_delta\":\n346\u2192                 return ContentBlockDelta(\n347\u2192                     type=\"text_delta\",\n348\u2192                     index=event.index,\n349\u2192                     text=delta.text,\n350\u2192                 )\n351\u2192             elif delta.type == \"input_json_delta\":\n352\u2192                 return ContentBlockDelta(\n353\u2192                     type=\"input_json_delta\",\n354\u2192                     index=event.index,\n355\u2192                     partial_json=delta.partial_json,\n356\u2192                 )\n357\u2192 \n358\u2192         elif event_type == \"content_block_stop\":\n359\u2192             return ContentBlockStop(index=event.index)\n360\u2192 \n361\u2192         elif event_type == \"message_delta\":\n362\u2192             usage = getattr(event, \"usage\", None)\n363\u2192             output_tokens = getattr(usage, \"output_tokens\", 0) or 0\n364\u2192             return UsageDelta(output_tokens=output_tokens)\n365\u2192 \n366\u2192         elif event_type == \"message_stop\":\n367\u2192             return MessageStop(stop_reason=event.message.stop_reason)\n368\u2192 \n369\u2192         # Return None for unhandled event types\n370\u2192         return None\n371\u2192 \n372\u2192     async def _response_to_chunks(self, response: anthropic.types.Message) -> AsyncIterator[Chunk]:\n373\u2192         \"\"\"Convert non-streaming response to chunk stream.\n374\u2192 \n375\u2192         Args:\n376\u2192             response: Complete response from messages.create()\n377\u2192 \n378\u2192         Yields:\n379\u2192             Chunk objects representing the response\n380\u2192         \"\"\"\n381\u2192         # Yield message start\n382\u2192         yield MessageStart(id=response.id, model=response.model)\n383\u2192 \n384\u2192         # Yield content blocks\n385\u2192         for index, block in enumerate(response.content):\n386\u2192             if block.type == \"text\":\n387\u2192                 yield ContentBlockStart(type=\"text\", index=index)\n388\u2192                 yield ContentBlockDelta(type=\"text_delta\", index=index, text=block.text)\n389\u2192                 yield ContentBlockStop(index=index)\n390\u2192 \n391\u2192             elif block.type == \"tool_use\":\n392\u2192                 yield ContentBlockStart(\n393\u2192                     type=\"tool_use\",\n394\u2192                     index=index,\n395\u2192                     id=block.id,\n396\u2192                     name=block.name,\n397\u2192                 )\n398\u2192                 # Yield the input JSON as a single delta\n399\u2192                 input_json = json.dumps(block.input)\n400\u2192                 yield ContentBlockDelta(\n401\u2192                     type=\"input_json_delta\",\n402\u2192                     index=index,\n403\u2192                     partial_json=input_json,\n404\u2192                 )\n405\u2192                 yield ContentBlockStop(index=index)\n406\u2192 \n407\u2192         # Yield message stop\n408\u2192         yield MessageStop(stop_reason=response.stop_reason)\n409\u2192 \n410\u2192     async def _sleep_before_retry(self, attempt: int) -> None:\n411\u2192         \"\"\"Sleep using exponential backoff before retrying.\"\"\"\n412\u2192         await asyncio.sleep(self.base_retry_delay * (2**attempt))\n413\u2192 \n414\u2192     @staticmethod\n415\u2192     def _extract_zai_error_code(exc: anthropic.APIStatusError) -> int | None:\n416\u2192         \"\"\"Try to extract a Z.AI numeric error code from an APIStatusError.\"\"\"\n417\u2192         try:\n418\u2192             body = getattr(exc, \"body\", None)\n419\u2192             if isinstance(body, dict):\n420\u2192                 code = body.get(\"error\", body).get(\"code\")\n421\u2192                 if isinstance(code, int):\n422\u2192                     return code\n423\u2192             resp = getattr(exc, \"response\", None)\n424\u2192             if resp is not None:\n425\u2192                 raw = getattr(resp, \"text\", \"\")\n426\u2192                 if raw:\n427\u2192                     data = json.loads(raw)\n428\u2192                     code = data.get(\"error\", data).get(\"code\")\n429\u2192                     if isinstance(code, int):\n430\u2192                         return code\n431\u2192         except (json.JSONDecodeError, AttributeError, TypeError):\n432\u2192             pass\n433\u2192         return None\n434\u2192 \n435\u2192     async def extract_tool_calls(\n436\u2192         self,\n437\u2192         chunks: list[Chunk],\n438\u2192     ) -> list[dict]:\n439\u2192         \"\"\"Extract tool calls from accumulated stream chunks.\n440\u2192 \n441\u2192         This method processes a list of chunks and extracts complete\n442\u2192         tool_call objects by accumulating partial_json deltas.\n443\u2192 \n444\u2192         Args:\n445\u2192             chunks: List of chunks from a stream\n446\u2192 \n447\u2192         Returns:\n448\u2192             List of tool_call dicts with id, name, and input keys\n449\u2192 \n450\u2192         Example:\n451\u2192             >>> chunks = []\n452\u2192             >>> async for chunk in client.chat_completion(messages, tools=tools):\n453\u2192             ...     chunks.append(chunk)\n454\u2192             >>> tool_calls = await client.extract_tool_calls(chunks)\n455\u2192         \"\"\"\n456\u2192         tool_calls: list[dict] = []\n457\u2192         current_tool: dict[str, Any] | None = None\n458\u2192         accumulated_json: list[str] = []\n459\u2192 \n460\u2192         for chunk in chunks:\n461\u2192             if isinstance(chunk, ContentBlockStart) and chunk.type == \"tool_use\":\n462\u2192                 # Start of a new tool call\n463\u2192                 current_tool = {\n464\u2192                     \"id\": chunk.id,\n465\u2192                     \"name\": chunk.name,\n466\u2192                     \"input\": {},\n467\u2192                 }\n468\u2192                 accumulated_json = []\n469\u2192 \n470\u2192             elif isinstance(chunk, ContentBlockDelta) and chunk.type == \"input_json_delta\":\n471\u2192                 # Accumulate partial JSON\n472\u2192                 if chunk.partial_json:\n473\u2192                     accumulated_json.append(chunk.partial_json)\n474\u2192 \n475\u2192             elif isinstance(chunk, ContentBlockStop) and current_tool is not None:\n476\u2192                 # End of current tool call - parse accumulated JSON\n477\u2192                 if accumulated_json:\n478\u2192                     try:\n479\u2192                         json_str = \"\".join(accumulated_json)\n480\u2192                         current_tool[\"input\"] = json.loads(json_str)\n481\u2192                     except json.JSONDecodeError:\n482\u2192                         # If JSON is incomplete, keep as string\n483\u2192                         current_tool[\"input\"] = {\"raw\": \"\".join(accumulated_json)}\n484\u2192 \n485\u2192                 tool_calls.append(current_tool)\n486\u2192                 current_tool = None\n487\u2192                 accumulated_json = []\n488\u2192 \n489\u2192         return tool_calls\n490\u2192 \n491\u2192     async def simple_chat(\n492\u2192         self,\n493\u2192         message: str,\n494\u2192         system_prompt: str | None = None,\n495\u2192     ) -> str:\n496\u2192         \"\"\"Simple chat without streaming or tool calling.\n497\u2192 \n498\u2192         This is a convenience method for basic chat interactions.\n499\u2192 \n500\u2192         Args:\n501\u2192             message: User message\n502\u2192             system_prompt: Optional system prompt\n503\u2192 \n504\u2192         Returns:\n505\u2192             Complete response text\n506\u2192         \"\"\"\n507\u2192         messages: list[dict] = [{\"role\": \"user\", \"content\": message}]\n508\u2192 \n509\u2192         params: dict = {\n510\u2192             \"model\": self.config.chat_model,\n511\u2192             \"messages\": messages,\n512\u2192             \"max_tokens\": self.config.max_tokens,\n513\u2192         }\n514\u2192 \n515\u2192         if system_prompt:\n516\u2192             params[\"system\"] = system_prompt\n517\u2192 \n518\u2192         try:\n519\u2192             response = await self._client.messages.create(**params)\n520\u2192             return response.content[0].text\n521\u2192         except anthropic.AuthenticationError as e:\n522\u2192             raise AuthError(str(e))\n523\u2192         except anthropic.APITimeoutError as e:\n524\u2192             raise TimeoutError(timeoutMs=int(self.config.timeout * 1000))\n525\u2192         except anthropic.APIConnectionError as e:\n526\u2192             raise NetworkError(str(e))\n527\u2192         except anthropic.APIStatusError as e:\n528\u2192             raise ApiError(str(e), statusCode=e.status_code)\n529\u2192         except Exception as e:\n530\u2192             raise ZaiError(f\"Unexpected error: {e}\")", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_0306302ab8ed40aba3a06f9d", "name": "view_file", "input": {"file_path": "goz/api/monitor.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/monitor.py (130 lines)\n============================================================\n\n  1\u2192 \"\"\"Z.AI Monitor API client for usage statistics and quota tracking.\n  2\u2192 \n  3\u2192 Provides access to:\n  4\u2192 - /api/monitor/usage/quota/limit \u2014 5-hour quota remaining\n  5\u2192 - /api/monitor/usage/model-usage \u2014 7-day and 30-day aggregates\n  6\u2192 \"\"\"\n  7\u2192 \n  8\u2192 from __future__ import annotations\n  9\u2192 \n 10\u2192 import logging\n 11\u2192 from dataclasses import dataclass, field\n 12\u2192 from typing import Any\n 13\u2192 \n 14\u2192 import httpx\n 15\u2192 \n 16\u2192 from goz.config import Config\n 17\u2192 \n 18\u2192 logger = logging.getLogger(__name__)\n 19\u2192 \n 20\u2192 \n 21\u2192 @dataclass\n 22\u2192 class QuotaInfo:\n 23\u2192     limit: int\n 24\u2192     remaining: int\n 25\u2192     used: int\n 26\u2192     window_label: str\n 27\u2192     raw: dict[str, Any] = field(default_factory=dict)\n 28\u2192 \n 29\u2192 \n 30\u2192 @dataclass\n 31\u2192 class ModelUsageEntry:\n 32\u2192     model: str\n 33\u2192     input_tokens: int\n 34\u2192     output_tokens: int\n 35\u2192     total_tokens: int\n 36\u2192     cost: float\n 37\u2192     requests: int\n 38\u2192     raw: dict[str, Any] = field(default_factory=dict)\n 39\u2192 \n 40\u2192 \n 41\u2192 @dataclass\n 42\u2192 class ModelUsageReport:\n 43\u2192     period_days: int\n 44\u2192     entries: list[ModelUsageEntry] = field(default_factory=list)\n 45\u2192     raw: dict[str, Any] = field(default_factory=dict)\n 46\u2192 \n 47\u2192 \n 48\u2192 class MonitorClient:\n 49\u2192     def __init__(self, config: Config | None = None) -> None:\n 50\u2192         if config is None:\n 51\u2192             from goz.config import load_config\n 52\u2192 \n 53\u2192             config = load_config()\n 54\u2192         self.config = config\n 55\u2192 \n 56\u2192     def _base(self) -> str:\n 57\u2192         url = self.config.zai_base_url\n 58\u2192         if \"/api/anthropic\" in url:\n 59\u2192             url = url.replace(\"/api/anthropic\", \"\")\n 60\u2192         return url.rstrip(\"/\")\n 61\u2192 \n 62\u2192     def _headers(self) -> dict[str, str]:\n 63\u2192         return {\n 64\u2192             \"Authorization\": f\"Bearer {self.config.zai_token}\",\n 65\u2192             \"Content-Type\": \"application/json\",\n 66\u2192         }\n 67\u2192 \n 68\u2192     async def fetch_quota_limit(self) -> QuotaInfo:\n 69\u2192         base = self._base()\n 70\u2192         url = f\"{base}/api/monitor/usage/quota/limit\"\n 71\u2192         async with httpx.AsyncClient(timeout=self.config.timeout) as client:\n 72\u2192             resp = await client.get(url, headers=self._headers())\n 73\u2192             resp.raise_for_status()\n 74\u2192             data = resp.json()\n 75\u2192 \n 76\u2192         if isinstance(data, dict) and \"data\" in data:\n 77\u2192             inner = data[\"data\"]\n 78\u2192         elif isinstance(data, dict):\n 79\u2192             inner = data\n 80\u2192         else:\n 81\u2192             inner = {}\n 82\u2192 \n 83\u2192         limit = inner.get(\"limit\", inner.get(\"total\", 0))\n 84\u2192         used = inner.get(\"used\", inner.get(\"consumed\", 0))\n 85\u2192         remaining = inner.get(\"remaining\", max(0, limit - used))\n 86\u2192         window = inner.get(\"window\", inner.get(\"period\", \"5h\"))\n 87\u2192 \n 88\u2192         return QuotaInfo(\n 89\u2192             limit=limit,\n 90\u2192             remaining=remaining,\n 91\u2192             used=used,\n 92\u2192             window_label=str(window),\n 93\u2192             raw=data,\n 94\u2192         )\n 95\u2192 \n 96\u2192     async def fetch_model_usage(self, days: int = 7) -> ModelUsageReport:\n 97\u2192         base = self._base()\n 98\u2192         url = f\"{base}/api/monitor/usage/model-usage\"\n 99\u2192         params: dict[str, Any] = {\"days\": days}\n100\u2192 \n101\u2192         async with httpx.AsyncClient(timeout=self.config.timeout) as client:\n102\u2192             resp = await client.get(url, headers=self._headers(), params=params)\n103\u2192             resp.raise_for_status()\n104\u2192             data = resp.json()\n105\u2192 \n106\u2192         entries: list[ModelUsageEntry] = []\n107\u2192         items: list[dict[str, Any]] = []\n108\u2192         if isinstance(data, dict) and \"data\" in data:\n109\u2192             items = data[\"data\"] if isinstance(data[\"data\"], list) else []\n110\u2192         elif isinstance(data, list):\n111\u2192             items = data\n112\u2192 \n113\u2192         for item in items:\n114\u2192             entries.append(\n115\u2192                 ModelUsageEntry(\n116\u2192                     model=item.get(\"model\", \"unknown\"),\n117\u2192                     input_tokens=item.get(\"input_tokens\", 0),\n118\u2192                     output_tokens=item.get(\"output_tokens\", 0),\n119\u2192                     total_tokens=item.get(\n120\u2192                         \"total_tokens\", item.get(\"input_tokens\", 0) + item.get(\"output_tokens\", 0)\n121\u2192                     ),\n122\u2192                     cost=item.get(\"cost\", 0.0),\n123\u2192                     requests=item.get(\"requests\", item.get(\"request_count\", 0)),\n124\u2192                     raw=item,\n125\u2192                 )\n126\u2192             )\n127\u2192 \n128\u2192         return ModelUsageReport(\n129\u2192             period_days=days, entries=entries, raw=data if isinstance(data, dict) else {}\n130\u2192         )", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_455dadc3af0c4d67b3830f47", "name": "view_file", "input": {"file_path": "goz/cli/usage.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/cli/usage.py (137 lines)\n============================================================\n\n  1\u2192 \"\"\"`goz usage` CLI command for displaying usage statistics and quota.\"\"\"\n  2\u2192 \n  3\u2192 from __future__ import annotations\n  4\u2192 \n  5\u2192 import sys\n  6\u2192 \n  7\u2192 from goz.config import load_config\n  8\u2192 \n  9\u2192 \n 10\u2192 def _fmt_tokens(n: int) -> str:\n 11\u2192     if n >= 1_000_000:\n 12\u2192         return f\"{n / 1_000_000:.2f}M\"\n 13\u2192     if n >= 1_000:\n 14\u2192         return f\"{n / 1_000:.1f}k\"\n 15\u2192     return str(n)\n 16\u2192 \n 17\u2192 \n 18\u2192 def _fmt_cost(cost: float) -> str:\n 19\u2192     if cost < 0.01:\n 20\u2192         return f\"${cost:.4f}\"\n 21\u2192     return f\"${cost:.2f}\"\n 22\u2192 \n 23\u2192 \n 24\u2192 async def cmd_usage(args: list[str]) -> None:\n 25\u2192     if args and args[0] in (\"--help\", \"-h\", \"help\"):\n 26\u2192         print(\"\"\"Usage command:\n 27\u2192 \n 28\u2192   goz usage            Show quota remaining and usage aggregates\n 29\u2192   goz usage --json     Raw JSON output\n 30\u2192   goz usage --days N   Model usage window (default: 7)\n 31\u2192 \n 32\u2192 Endpoints:\n 33\u2192   api.z.ai/api/monitor/usage/quota/limit   - 5-hour quota\n 34\u2192   api.z.ai/api/monitor/usage/model-usage   - Model aggregates\n 35\u2192 \"\"\")\n 36\u2192         return\n 37\u2192 \n 38\u2192     use_json = \"--json\" in args\n 39\u2192     days = 7\n 40\u2192     for i, a in enumerate(args):\n 41\u2192         if a == \"--days\" and i + 1 < len(args):\n 42\u2192             try:\n 43\u2192                 days = int(args[i + 1])\n 44\u2192             except ValueError:\n 45\u2192                 pass\n 46\u2192 \n 47\u2192     from goz.api.monitor import MonitorClient\n 48\u2192 \n 49\u2192     config = load_config()\n 50\u2192     client = MonitorClient(config=config)\n 51\u2192 \n 52\u2192     try:\n 53\u2192         quota = await client.fetch_quota_limit()\n 54\u2192     except Exception as exc:\n 55\u2192         print(f\"Failed to fetch quota: {exc}\", file=sys.stderr)\n 56\u2192         quota = None\n 57\u2192 \n 58\u2192     try:\n 59\u2192         usage_7 = await client.fetch_model_usage(days=days)\n 60\u2192     except Exception as exc:\n 61\u2192         print(f\"Failed to fetch {days}-day usage: {exc}\", file=sys.stderr)\n 62\u2192         usage_7 = None\n 63\u2192 \n 64\u2192     try:\n 65\u2192         usage_30 = await client.fetch_model_usage(days=30)\n 66\u2192     except Exception as exc:\n 67\u2192         print(f\"Failed to fetch 30-day usage: {exc}\", file=sys.stderr)\n 68\u2192         usage_30 = None\n 69\u2192 \n 70\u2192     if use_json:\n 71\u2192         import json\n 72\u2192 \n 73\u2192         out: dict = {}\n 74\u2192         if quota:\n 75\u2192             out[\"quota\"] = {\n 76\u2192                 \"limit\": quota.limit,\n 77\u2192                 \"remaining\": quota.remaining,\n 78\u2192                 \"used\": quota.used,\n 79\u2192                 \"window\": quota.window_label,\n 80\u2192             }\n 81\u2192         if usage_7:\n 82\u2192             out[f\"{usage_7.period_days}_day\"] = [\n 83\u2192                 {\n 84\u2192                     \"model\": e.model,\n 85\u2192                     \"input_tokens\": e.input_tokens,\n 86\u2192                     \"output_tokens\": e.output_tokens,\n 87\u2192                     \"total_tokens\": e.total_tokens,\n 88\u2192                     \"cost\": e.cost,\n 89\u2192                     \"requests\": e.requests,\n 90\u2192                 }\n 91\u2192                 for e in usage_7.entries\n 92\u2192             ]\n 93\u2192         if usage_30:\n 94\u2192             out[\"30_day\"] = [\n 95\u2192                 {\n 96\u2192                     \"model\": e.model,\n 97\u2192                     \"input_tokens\": e.input_tokens,\n 98\u2192                     \"output_tokens\": e.output_tokens,\n 99\u2192                     \"total_tokens\": e.total_tokens,\n100\u2192                     \"cost\": e.cost,\n101\u2192                     \"requests\": e.requests,\n102\u2192                 }\n103\u2192                 for e in usage_30.entries\n104\u2192             ]\n105\u2192         print(json.dumps(out, indent=2, ensure_ascii=True))\n106\u2192         return\n107\u2192 \n108\u2192     if quota:\n109\u2192         pct = (quota.used / quota.limit * 100) if quota.limit else 0\n110\u2192         print(f\"Quota ({quota.window_label}):\")\n111\u2192         print(f\"  Limit:     {_fmt_tokens(quota.limit)} tokens\")\n112\u2192         print(f\"  Used:      {_fmt_tokens(quota.used)} tokens ({pct:.1f}%)\")\n113\u2192         print(f\"  Remaining: {_fmt_tokens(quota.remaining)} tokens\")\n114\u2192         print()\n115\u2192 \n116\u2192     if usage_7:\n117\u2192         print(f\"Model usage ({usage_7.period_days}-day):\")\n118\u2192         if not usage_7.entries:\n119\u2192             print(\"  (no data)\")\n120\u2192         for e in usage_7.entries:\n121\u2192             print(f\"  {e.model}\")\n122\u2192             print(\n123\u2192                 f\"    Input:  {_fmt_tokens(e.input_tokens)}  Output: {_fmt_tokens(e.output_tokens)}  Total: {_fmt_tokens(e.total_tokens)}\"\n124\u2192             )\n125\u2192             print(f\"    Cost:   {_fmt_cost(e.cost)}  Requests: {e.requests}\")\n126\u2192         print()\n127\u2192 \n128\u2192     if usage_30:\n129\u2192         print(\"Model usage (30-day):\")\n130\u2192         if not usage_30.entries:\n131\u2192             print(\"  (no data)\")\n132\u2192         for e in usage_30.entries:\n133\u2192             print(f\"  {e.model}\")\n134\u2192             print(\n135\u2192                 f\"    Input:  {_fmt_tokens(e.input_tokens)}  Output: {_fmt_tokens(e.output_tokens)}  Total: {_fmt_tokens(e.total_tokens)}\"\n136\u2192             )\n137\u2192             print(f\"    Cost:   {_fmt_cost(e.cost)}  Requests: {e.requests}\")", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_a8a738e3ba8944c4b550bfb7", "name": "view_file", "input": {"file_path": "goz/cli/run.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/cli/run.py (446 lines)\n============================================================\n\n  1\u2192 \"\"\"JSONL CLI runner for litehive-compatible one-shot agent execution.\"\"\"\n  2\u2192 \n  3\u2192 from __future__ import annotations\n  4\u2192 \n  5\u2192 import argparse\n  6\u2192 import asyncio\n  7\u2192 import json\n  8\u2192 import signal\n  9\u2192 import sys\n 10\u2192 import uuid\n 11\u2192 from dataclasses import dataclass\n 12\u2192 from datetime import datetime\n 13\u2192 from pathlib import Path\n 14\u2192 from typing import Any, TextIO\n 15\u2192 \n 16\u2192 from goz.agent.chat_client import (\n 17\u2192     ChatClient,\n 18\u2192     Chunk,\n 19\u2192     ContentBlockDelta,\n 20\u2192     ContentBlockStart,\n 21\u2192     ContentBlockStop,\n 22\u2192     MessageStart,\n 23\u2192     MessageStop,\n 24\u2192     UsageDelta,\n 25\u2192 )\n 26\u2192 from goz.agent.history import ChatHistory, ChatMessage, ToolCall\n 27\u2192 from goz.agent.sessions import Session, SessionManager\n 28\u2192 from goz.agent.usage import UsageAccumulator\n 29\u2192 from goz.agent.tools import (\n 30\u2192     BashTool,\n 31\u2192     CreateFileTool,\n 32\u2192     GlobTool,\n 33\u2192     GrepTool,\n 34\u2192     ReadTool,\n 35\u2192     RepoReadTool,\n 36\u2192     RepoSearchTool,\n 37\u2192     RepoTreeTool,\n 38\u2192     SearchTool,\n 39\u2192     StrReplaceEditorTool,\n 40\u2192     ToolRegistry,\n 41\u2192     ViewFileTool,\n 42\u2192 )\n 43\u2192 from goz.config import Config, load_config\n 44\u2192 \n 45\u2192 \n 46\u2192 MAX_ITERATIONS: int | None = None  # No limit by default\n 47\u2192 DEFAULT_AGENT_TYPE = \"engine\"\n 48\u2192 STAGE_RESULT_INSTRUCTION = \"\"\"\n 49\u2192 \n 50\u2192 End your final answer with:\n 51\u2192 STAGE_RESULT:\n 52\u2192 {\"verdict\":\"pass\",\"summary\":\"one-line summary\",\"files_changed\":[\"path/to/file\"],\"tests\":{\"added\":0,\"passing\":0},\"warnings\":[],\"follow_up_tasks\":[],\"acceptance_criteria\":[]}\n 53\u2192 \n 54\u2192 Return valid JSON after STAGE_RESULT:. Include a verdict.\n 55\u2192 \"\"\".strip()\n 56\u2192 \n 57\u2192 \n 58\u2192 def _emit_event(event: dict[str, Any], stdout: TextIO) -> None:\n 59\u2192     stdout.write(json.dumps(event, ensure_ascii=True) + \"\\n\")\n 60\u2192     stdout.flush()\n 61\u2192 \n 62\u2192 \n 63\u2192 def emit_text_event(text: str, stdout: TextIO) -> None:\n 64\u2192     _emit_event({\"type\": \"text\", \"part\": {\"text\": text}}, stdout)\n 65\u2192 \n 66\u2192 \n 67\u2192 def emit_tool_use_event(\n 68\u2192     tool_call: dict[str, Any],\n 69\u2192     result: str,\n 70\u2192     stdout: TextIO,\n 71\u2192     *,\n 72\u2192     is_error: bool = False,\n 73\u2192 ) -> None:\n 74\u2192     _emit_event(\n 75\u2192         {\n 76\u2192             \"type\": \"tool_use\",\n 77\u2192             \"part\": {\n 78\u2192                 \"id\": tool_call[\"id\"],\n 79\u2192                 \"name\": tool_call[\"name\"],\n 80\u2192                 \"input\": tool_call[\"input\"],\n 81\u2192                 \"output\": result,\n 82\u2192                 \"is_error\": is_error,\n 83\u2192             },\n 84\u2192         },\n 85\u2192         stdout,\n 86\u2192     )\n 87\u2192 \n 88\u2192 \n 89\u2192 def emit_error_event(name: str, message: str, stdout: TextIO) -> None:\n 90\u2192     _emit_event(\n 91\u2192         {\n 92\u2192             \"type\": \"error\",\n 93\u2192             \"error\": {\n 94\u2192                 \"name\": name,\n 95\u2192                 \"data\": {\"message\": message},\n 96\u2192             },\n 97\u2192         },\n 98\u2192         stdout,\n 99\u2192     )\n100\u2192 \n101\u2192 \n102\u2192 def emit_step_finish_event(\n103\u2192     stdout: TextIO,\n104\u2192     session_id: str,\n105\u2192     *,\n106\u2192     tokens: dict[str, int] | None = None,\n107\u2192     cost: float = 0.0,\n108\u2192 ) -> None:\n109\u2192     _emit_event(\n110\u2192         {\n111\u2192             \"type\": \"step_finish\",\n112\u2192             \"part\": {\n113\u2192                 \"tokens\": tokens or {\"input\": 0, \"output\": 0, \"cache_creation\": 0, \"cache_read\": 0},\n114\u2192                 \"cost\": cost,\n115\u2192                 \"session_id\": session_id,\n116\u2192                 \"continuation\": {\"resume_session_id\": session_id},\n117\u2192             },\n118\u2192         },\n119\u2192         stdout,\n120\u2192     )\n121\u2192 \n122\u2192 \n123\u2192 @dataclass\n124\u2192 class RunSessionState:\n125\u2192     session_id: str\n126\u2192     created_at: datetime\n127\u2192     history: ChatHistory\n128\u2192     working_dir: str\n129\u2192     agent_type: str\n130\u2192     config: Config\n131\u2192     session_manager: SessionManager\n132\u2192     tool_registry: ToolRegistry\n133\u2192 \n134\u2192     async def save(self) -> Path:\n135\u2192         session = Session(\n136\u2192             id=self.session_id,\n137\u2192             created_at=self.created_at,\n138\u2192             updated_at=datetime.now(),\n139\u2192             working_directory=self.working_dir,\n140\u2192             messages=list(self.history.messages),\n141\u2192             model=self.config.chat_model,\n142\u2192             agent_type=self.agent_type,\n143\u2192             config_snapshot=self.config.model_dump() if hasattr(self.config, \"model_dump\") else {},\n144\u2192             tool_state=_serialize_tool_state(self.tool_registry, self.working_dir),\n145\u2192         )\n146\u2192         return await self.session_manager.save(session)\n147\u2192 \n148\u2192 \n149\u2192 def _serialize_tool_state(tool_registry: ToolRegistry, working_dir: str) -> dict[str, Any]:\n150\u2192     return {\n151\u2192         \"working_directory\": working_dir,\n152\u2192         \"tools\": {\n153\u2192             tool.name: {\n154\u2192                 \"working_dir\": getattr(tool, \"working_dir\", None),\n155\u2192             }\n156\u2192             for tool in tool_registry.list_all()\n157\u2192         },\n158\u2192     }\n159\u2192 \n160\u2192 \n161\u2192 def build_default_tool_registry(config: Config, working_dir: str) -> ToolRegistry:\n162\u2192     \"\"\"Create the default tool set for one-shot CLI runs.\"\"\"\n163\u2192     registry = ToolRegistry()\n164\u2192     registry.register(BashTool(working_dir=working_dir))\n165\u2192     registry.register(ViewFileTool(working_dir=working_dir))\n166\u2192     registry.register(CreateFileTool(working_dir=working_dir))\n167\u2192     registry.register(StrReplaceEditorTool(working_dir=working_dir))\n168\u2192     registry.register(GlobTool(working_dir=working_dir))\n169\u2192     registry.register(GrepTool(working_dir=working_dir))\n170\u2192     registry.register(SearchTool(config))\n171\u2192     registry.register(ReadTool(config))\n172\u2192     registry.register(RepoSearchTool(config))\n173\u2192     registry.register(RepoTreeTool(config))\n174\u2192     registry.register(RepoReadTool(config))\n175\u2192     return registry\n176\u2192 \n177\u2192 \n178\u2192 def _build_prompt(user_prompt: str) -> str:\n179\u2192     return f\"{user_prompt.rstrip()}\\n\\n{STAGE_RESULT_INSTRUCTION}\"\n180\u2192 \n181\u2192 \n182\u2192 def _parse_tool_calls(chunks: list[Chunk]) -> list[dict[str, Any]]:\n183\u2192     tool_calls: list[dict[str, Any]] = []\n184\u2192     tool_calls_by_index: dict[int, dict[str, Any]] = {}\n185\u2192 \n186\u2192     for chunk in chunks:\n187\u2192         if isinstance(chunk, ContentBlockStart) and chunk.type == \"tool_use\":\n188\u2192             tool_calls_by_index[chunk.index] = {\n189\u2192                 \"id\": chunk.id or \"\",\n190\u2192                 \"name\": chunk.name or \"\",\n191\u2192                 \"input_json\": [],\n192\u2192             }\n193\u2192         elif isinstance(chunk, ContentBlockDelta) and chunk.type == \"input_json_delta\":\n194\u2192             block = tool_calls_by_index.get(chunk.index)\n195\u2192             if block is not None and chunk.partial_json:\n196\u2192                 block[\"input_json\"].append(chunk.partial_json)\n197\u2192         elif isinstance(chunk, ContentBlockStop):\n198\u2192             block = tool_calls_by_index.get(chunk.index)\n199\u2192             if block is None:\n200\u2192                 continue\n201\u2192             input_text = \"\".join(block.pop(\"input_json\"))\n202\u2192             try:\n203\u2192                 parsed_input = json.loads(input_text) if input_text else {}\n204\u2192             except json.JSONDecodeError:\n205\u2192                 parsed_input = {\"raw\": input_text}\n206\u2192             tool_calls.append(\n207\u2192                 {\n208\u2192                     \"id\": block[\"id\"],\n209\u2192                     \"name\": block[\"name\"],\n210\u2192                     \"input\": parsed_input,\n211\u2192                 }\n212\u2192             )\n213\u2192 \n214\u2192     return tool_calls\n215\u2192 \n216\u2192 \n217\u2192 async def _execute_tool_call(\n218\u2192     tool_registry: ToolRegistry, tool_call: dict[str, Any]\n219\u2192 ) -> tuple[str, bool]:\n220\u2192     tool = tool_registry.get(tool_call[\"name\"])\n221\u2192     if tool is None:\n222\u2192         return f\"Tool not found: {tool_call['name']}\", True\n223\u2192 \n224\u2192     try:\n225\u2192         result = await asyncio.wait_for(tool.execute(**tool_call[\"input\"]), timeout=300)\n226\u2192     except asyncio.TimeoutError:\n227\u2192         return f\"Tool {tool_call['name']} timed out after 300 seconds\", True\n228\u2192     except Exception as exc:\n229\u2192         return f\"Tool {tool_call['name']} failed: {exc}\", True\n230\u2192 \n231\u2192     return str(result), False\n232\u2192 \n233\u2192 \n234\u2192 async def run_prompt_jsonl(\n235\u2192     prompt: str,\n236\u2192     *,\n237\u2192     config: Config,\n238\u2192     working_dir: str,\n239\u2192     stdout: TextIO | None = None,\n240\u2192     tool_registry: ToolRegistry | None = None,\n241\u2192     chat_client: ChatClient | None = None,\n242\u2192     resume_session_id: str | None = None,\n243\u2192     session_dir: Path | None = None,\n244\u2192 ) -> int:\n245\u2192     \"\"\"Execute one agent prompt and emit JSONL events.\"\"\"\n246\u2192     stdout = stdout or sys.stdout\n247\u2192     session_manager = SessionManager(session_dir=session_dir)\n248\u2192     session: Session | None = None\n249\u2192     if resume_session_id is not None:\n250\u2192         session = await session_manager.load(resume_session_id)\n251\u2192         working_dir = session.working_directory\n252\u2192 \n253\u2192     history = ChatHistory(messages=list(session.messages) if session else None)\n254\u2192     registry = tool_registry or build_default_tool_registry(config, working_dir)\n255\u2192     client = chat_client or ChatClient(config=config)\n256\u2192     state = RunSessionState(\n257\u2192         session_id=resume_session_id or uuid.uuid4().hex,\n258\u2192         created_at=session.created_at if session else datetime.now(),\n259\u2192         history=history,\n260\u2192         working_dir=working_dir,\n261\u2192         agent_type=session.agent_type if session else DEFAULT_AGENT_TYPE,\n262\u2192         config=config,\n263\u2192         session_manager=session_manager,\n264\u2192         tool_registry=registry,\n265\u2192     )\n266\u2192 \n267\u2192     if prompt:\n268\u2192         history.add(ChatMessage(role=\"user\", content=_build_prompt(prompt)))\n269\u2192 \n270\u2192     loop = asyncio.get_running_loop()\n271\u2192     interrupted_by: dict[str, str | None] = {\"signal\": None}\n272\u2192     current_task = asyncio.current_task()\n273\u2192 \n274\u2192     async def _handle_interrupt(signame: str) -> None:\n275\u2192         interrupted_by[\"signal\"] = signame\n276\u2192         await state.save()\n277\u2192         if current_task is not None:\n278\u2192             current_task.cancel()\n279\u2192 \n280\u2192     for signum in (signal.SIGTERM, signal.SIGINT):\n281\u2192         try:\n282\u2192             loop.add_signal_handler(\n283\u2192                 signum,\n284\u2192                 lambda current_signum=signum: asyncio.create_task(\n285\u2192                     _handle_interrupt(signal.Signals(current_signum).name)\n286\u2192                 ),\n287\u2192             )\n288\u2192         except (NotImplementedError, RuntimeError):\n289\u2192             continue\n290\u2192 \n291\u2192     iteration = 0\n292\u2192     try:\n293\u2192 <<<<<<< Updated upstream\n294\u2192         while True:\n295\u2192             iteration += 1\n296\u2192             if MAX_ITERATIONS is not None and iteration > MAX_ITERATIONS:\n297\u2192                 break\n298\u2192 =======\n299\u2192         usage_acc = UsageAccumulator()\n300\u2192         for _ in range(MAX_ITERATIONS):\n301\u2192 >>>>>>> Stashed changes\n302\u2192             chunks: list[Chunk] = []\n303\u2192             assistant_chunks: list[str] = []\n304\u2192             usage_acc.begin_turn()\n305\u2192 \n306\u2192             stream = client.chat_completion(\n307\u2192                 messages=history.to_api_format(),\n308\u2192                 tools=registry.to_openai_schema(),\n309\u2192                 tool_choice=\"auto\",\n310\u2192             )\n311\u2192 \n312\u2192             async for chunk in stream:\n313\u2192                 chunks.append(chunk)\n314\u2192                 if (\n315\u2192                     isinstance(chunk, ContentBlockDelta)\n316\u2192                     and chunk.type == \"text_delta\"\n317\u2192                     and chunk.text\n318\u2192                 ):\n319\u2192                     assistant_chunks.append(chunk.text)\n320\u2192                     emit_text_event(chunk.text, stdout)\n321\u2192                 elif isinstance(chunk, MessageStart):\n322\u2192                     usage_obj = type(\n323\u2192                         \"U\",\n324\u2192                         (),\n325\u2192                         {\n326\u2192                             \"input_tokens\": chunk.usage_input_tokens,\n327\u2192                             \"cache_read_input_tokens\": chunk.usage_cache_read,\n328\u2192                             \"cache_creation_input_tokens\": chunk.usage_cache_creation,\n329\u2192                         },\n330\u2192                     )()\n331\u2192                     usage_acc.apply_message_start(usage_obj)\n332\u2192                 elif isinstance(chunk, UsageDelta):\n333\u2192                     usage_obj = type(\"U\", (), {\"output_tokens\": chunk.output_tokens})()\n334\u2192                     usage_acc.apply_message_delta(usage_obj)\n335\u2192 \n336\u2192             snap = usage_acc.finalise_turn()\n337\u2192 \n338\u2192             tool_calls = _parse_tool_calls(chunks)\n339\u2192             if not tool_calls:\n340\u2192                 history.add(ChatMessage(role=\"assistant\", content=\"\".join(assistant_chunks)))\n341\u2192                 emit_step_finish_event(\n342\u2192                     stdout,\n343\u2192                     state.session_id,\n344\u2192                     tokens=snap.to_dict(),\n345\u2192                     cost=snap.cost_usd(model=config.chat_model),\n346\u2192                 )\n347\u2192                 return 0\n348\u2192 \n349\u2192             history.add(\n350\u2192                 ChatMessage(\n351\u2192                     role=\"assistant\",\n352\u2192                     content=\"\".join(assistant_chunks),\n353\u2192                     tool_calls=[\n354\u2192                         ToolCall(\n355\u2192                             id=tool_call[\"id\"],\n356\u2192                             name=tool_call[\"name\"],\n357\u2192                             input=tool_call[\"input\"],\n358\u2192                         )\n359\u2192                         for tool_call in tool_calls\n360\u2192                     ],\n361\u2192                 )\n362\u2192             )\n363\u2192 \n364\u2192             for tool_call in tool_calls:\n365\u2192                 result, is_error = await _execute_tool_call(registry, tool_call)\n366\u2192                 emit_tool_use_event(tool_call, result, stdout, is_error=is_error)\n367\u2192                 history.add(\n368\u2192                     ChatMessage(\n369\u2192                         role=\"tool\",\n370\u2192                         content=result,\n371\u2192                         tool_result_id=tool_call[\"id\"],\n372\u2192                     )\n373\u2192                 )\n374\u2192     except asyncio.CancelledError:\n375\u2192         emit_error_event(\n376\u2192             \"Interrupted\", f\"Run interrupted by {interrupted_by['signal'] or 'signal'}\", stdout\n377\u2192         )\n378\u2192         return 1\n379\u2192     finally:\n380\u2192         for signum in (signal.SIGTERM, signal.SIGINT):\n381\u2192             try:\n382\u2192                 loop.remove_signal_handler(signum)\n383\u2192             except (NotImplementedError, RuntimeError):\n384\u2192                 continue\n385\u2192         await state.save()\n386\u2192 \n387\u2192     emit_error_event(\"MaxIterationsExceeded\", f\"Exceeded {MAX_ITERATIONS} agent iterations\", stdout)\n388\u2192     return 1\n389\u2192 \n390\u2192 \n391\u2192 async def cmd_run(args: list[str]) -> None:\n392\u2192     \"\"\"Handle the `goz run` command.\"\"\"\n393\u2192     if not args or args[0] in (\"--help\", \"-h\", \"help\"):\n394\u2192         print(\"\"\"Run command usage:\n395\u2192 \n396\u2192   goz run [options] <prompt>\n397\u2192 \n398\u2192 Options:\n399\u2192   --format, -f json   Output ExternalCLIAdapter-compatible JSONL (default: json)\n400\u2192   --dir DIR           Working directory for file and shell tools\n401\u2192   --model MODEL       Override chat model for this invocation\n402\u2192   --resume-session ID Resume a previously saved engine session\n403\u2192 \n404\u2192 Examples:\n405\u2192   goz run --format json \"Summarize this repo and report STAGE_RESULT.\"\n406\u2192   goz run --dir /tmp/project --model glm-5 \"Run pytest and explain failures.\"\n407\u2192   goz run --resume-session abc123 \"Continue with the next step.\"\n408\u2192 \"\"\")\n409\u2192         return\n410\u2192 \n411\u2192     parser = argparse.ArgumentParser(prog=\"goz run\", add_help=False)\n412\u2192     parser.add_argument(\"--format\", \"-f\", choices=[\"json\"], default=\"json\", help=\"Output format\")\n413\u2192     parser.add_argument(\"--dir\", dest=\"working_dir\", help=\"Working directory for the run\")\n414\u2192     parser.add_argument(\"--model\", help=\"Override chat model\")\n415\u2192     parser.add_argument(\n416\u2192         \"--resume-session\", dest=\"resume_session_id\", help=\"Resume a saved session by ID\"\n417\u2192     )\n418\u2192     parser.add_argument(\"prompt\", nargs=\"*\", help=\"Prompt to execute\")\n419\u2192     parsed = parser.parse_args(args)\n420\u2192 \n421\u2192     if not parsed.prompt and not parsed.resume_session_id:\n422\u2192         raise SystemExit(\"goz run requires a prompt unless --resume-session is provided\")\n423\u2192 \n424\u2192     try:\n425\u2192         config = load_config()\n426\u2192         if parsed.model:\n427\u2192             config = config.model_copy(update={\"chat_model\": parsed.model})\n428\u2192 \n429\u2192         working_dir = str(Path(parsed.working_dir or \".\").resolve())\n430\u2192         if parsed.working_dir and not Path(working_dir).exists():\n431\u2192             raise FileNotFoundError(f\"Working directory does not exist: {working_dir}\")\n432\u2192         if parsed.working_dir and not Path(working_dir).is_dir():\n433\u2192             raise NotADirectoryError(f\"Working directory is not a directory: {working_dir}\")\n434\u2192 \n435\u2192         exit_code = await run_prompt_jsonl(\n436\u2192             \" \".join(parsed.prompt),\n437\u2192             config=config,\n438\u2192             working_dir=working_dir,\n439\u2192             resume_session_id=parsed.resume_session_id,\n440\u2192         )\n441\u2192     except Exception as exc:\n442\u2192         emit_error_event(type(exc).__name__, str(exc), sys.stdout)\n443\u2192         sys.exit(1)\n444\u2192 \n445\u2192     if exit_code != 0:\n446\u2192         sys.exit(exit_code)", "is_error": false}}
