{"type": "tool_use", "part": {"id": "call_6184be3234a743bca6cf8348", "name": "view_file", "input": {"file_path": "goz/agent/stream_processor.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/agent/stream_processor.py (292 lines)\n============================================================\n\n  1\u2192 \"\"\"Stream Processor for handling Anthropic API streaming responses.\n  2\u2192 \n  3\u2192 This module provides the StreamProcessor class for processing streaming\n  4\u2192 responses from the Anthropic-compatible Z.AI API, extracting text chunks\n  5\u2192 for real-time UI updates and parsing tool calls.\n  6\u2192 \n  7\u2192 Acceptance Criteria (Issue 16):\n  8\u2192 1. StreamProcessor class exists\n  9\u2192 2. process_stream() method takes async iterator of chunks\n 10\u2192 3. Returns ProcessedStream with: full_text, tool_calls, raw_chunks\n 11\u2192 4. extract_tool_calls() parses tool calls from chunks\n 12\u2192 5. Handles partial_json accumulation\n 13\u2192 6. Handles multiple tool calls in one response\n 14\u2192 7. Yields text chunks for real-time UI updates\n 15\u2192 \"\"\"\n 16\u2192 import asyncio\n 17\u2192 import json\n 18\u2192 import logging\n 19\u2192 from dataclasses import dataclass, field\n 20\u2192 from typing import Any, AsyncIterator\n 21\u2192 \n 22\u2192 from goz.config import Config\n 23\u2192 \n 24\u2192 \n 25\u2192 logger = logging.getLogger(__name__)\n 26\u2192 \n 27\u2192 \n 28\u2192 @dataclass\n 29\u2192 class ToolCall:\n 30\u2192     \"\"\"Represents a tool call extracted from a streaming response.\n 31\u2192 \n 32\u2192     Attributes:\n 33\u2192         id: The unique identifier for this tool call\n 34\u2192         name: The name of the tool being called\n 35\u2192         arguments: The arguments passed to the tool (as a dict)\n 36\u2192 \n 37\u2192     Acceptance Criteria 8: ToolCall dataclass: id, name, arguments\n 38\u2192     \"\"\"\n 39\u2192     id: str\n 40\u2192     name: str\n 41\u2192     arguments: dict[str, Any] = field(default_factory=dict)\n 42\u2192 \n 43\u2192 \n 44\u2192 @dataclass\n 45\u2192 class ProcessedStream:\n 46\u2192     \"\"\"Result of processing a complete API stream.\n 47\u2192 \n 48\u2192     Attributes:\n 49\u2192         full_text: The complete accumulated text from the stream\n 50\u2192         tool_calls: List of tool calls extracted from the stream\n 51\u2192         raw_chunks: All raw chunks received (for debugging/replay)\n 52\u2192 \n 53\u2192     Acceptance Criteria 9: ProcessedStream dataclass: full_text, tool_calls, raw_chunks\n 54\u2192     \"\"\"\n 55\u2192     full_text: str\n 56\u2192     tool_calls: list[ToolCall]\n 57\u2192     raw_chunks: list[Any] = field(default_factory=list)\n 58\u2192 \n 59\u2192 \n 60\u2192 class StreamProcessor:\n 61\u2192     \"\"\"Processes streaming responses from Anthropic API.\n 62\u2192 \n 63\u2192     This class handles streaming responses from the Z.AI Anthropic-compatible API.\n 64\u2192     It accumulates text chunks for real-time UI updates and extracts tool calls\n 65\u2192     from content blocks.\n 66\u2192 \n 67\u2192     Acceptance Criteria 1: StreamProcessor class exists\n 68\u2192     Acceptance Criteria 2: process_stream() method takes async iterator of chunks\n 69\u2192 \n 70\u2192     Chunk Types (from Anthropic SDK):\n 71\u2192     - content_block_start: {\"type\": \"text\" | \"tool_use\"}\n 72\u2192     - content_block_delta: {\"type\": \"text_delta\", \"text\": \"...\"}\n 73\u2192                          or {\"type\": \"input_json_delta\", \"partial_json\": \"...\"}\n 74\u2192     - content_block_stop\n 75\u2192     - message_stop\n 76\u2192     \"\"\"\n 77\u2192 \n 78\u2192     def __init__(self, config: Config) -> None:\n 79\u2192         \"\"\"Initialize StreamProcessor.\n 80\u2192 \n 81\u2192         Args:\n 82\u2192             config: Configuration object\n 83\u2192 \n 84\u2192         Acceptance Criteria 1: StreamProcessor class exists\n 85\u2192         \"\"\"\n 86\u2192         self.config = config\n 87\u2192         self._full_text: str = \"\"\n 88\u2192         self._raw_chunks: list[Any] = []\n 89\u2192         self._text_chunks: list[str] = []\n 90\u2192 \n 91\u2192         # Tool call tracking\n 92\u2192         self._tool_blocks: dict[int, dict[str, Any]] = {}  # index -> {id, name, partial_json}\n 93\u2192         self._current_block_index: int | None = None\n 94\u2192 \n 95\u2192     async def process_stream(\n 96\u2192         self,\n 97\u2192         stream: AsyncIterator[Any],\n 98\u2192     ) -> AsyncIterator[str]:\n 99\u2192         \"\"\"Process stream and yield text chunks.\n100\u2192 \n101\u2192         This method consumes the streaming response, yielding text chunks\n102\u2192         for real-time UI updates. After the stream completes, use get_result()\n103\u2192         to retrieve the full processed result including tool calls.\n104\u2192 \n105\u2192         Args:\n106\u2192             stream: Async iterator of chunks from Anthropic SDK\n107\u2192 \n108\u2192         Yields:\n109\u2192             Text chunks as they arrive from the API\n110\u2192 \n111\u2192         Acceptance Criteria 2: process_stream() method takes async iterator of chunks\n112\u2192         Acceptance Criteria 7: Yields text chunks for real-time UI updates\n113\u2192         \"\"\"\n114\u2192         # Reset state for new stream\n115\u2192         self._full_text = \"\"\n116\u2192         self._raw_chunks = []\n117\u2192         self._text_chunks = []\n118\u2192         self._tool_blocks = {}\n119\u2192         self._current_block_index = None\n120\u2192 \n121\u2192         async for chunk in stream:\n122\u2192             # Store raw chunk\n123\u2192             self._raw_chunks.append(chunk)\n124\u2192 \n125\u2192             # Process chunk based on type\n126\u2192             chunk_type = getattr(chunk, 'type', None)\n127\u2192 \n128\u2192             if chunk_type == 'content_block_delta':\n129\u2192                 await self._handle_content_block_delta(chunk)\n130\u2192             elif chunk_type == 'content_block_start':\n131\u2192                 await self._handle_content_block_start(chunk)\n132\u2192             elif chunk_type == 'content_block_stop':\n133\u2192                 await self._handle_content_block_stop(chunk)\n134\u2192             elif chunk_type == 'message_stop':\n135\u2192                 # Stream is complete\n136\u2192                 pass\n137\u2192 \n138\u2192         # Yield all accumulated text chunks\n139\u2192         for text_chunk in self._text_chunks:\n140\u2192             yield text_chunk\n141\u2192 \n142\u2192     async def _handle_content_block_delta(self, chunk: Any) -> None:\n143\u2192         \"\"\"Handle content_block_delta chunk.\n144\u2192 \n145\u2192         Extracts text deltas for UI updates and partial_json for tool arguments.\n146\u2192         \"\"\"\n147\u2192         delta = getattr(chunk, 'delta', None)\n148\u2192         if not delta:\n149\u2192             return\n150\u2192 \n151\u2192         delta_type = delta.get('type', '')\n152\u2192 \n153\u2192         if delta_type == 'text_delta':\n154\u2192             # Text content - yield for UI and accumulate\n155\u2192             text = delta.get('text', '')\n156\u2192             if text:\n157\u2192                 self._full_text += text\n158\u2192                 self._text_chunks.append(text)\n159\u2192 \n160\u2192         elif delta_type == 'input_json_delta':\n161\u2192             # Partial JSON for tool arguments\n162\u2192             if self._current_block_index is not None:\n163\u2192                 partial_json = delta.get('partial_json', '')\n164\u2192                 if self._current_block_index not in self._tool_blocks:\n165\u2192                     self._tool_blocks[self._current_block_index] = {\n166\u2192                         'partial_json': ''\n167\u2192                     }\n168\u2192                 self._tool_blocks[self._current_block_index]['partial_json'] += partial_json\n169\u2192 \n170\u2192     async def _handle_content_block_start(self, chunk: Any) -> None:\n171\u2192         \"\"\"Handle content_block_start chunk.\n172\u2192 \n173\u2192         Identifies new tool_use blocks.\n174\u2192         \"\"\"\n175\u2192         index = getattr(chunk, 'index', None)\n176\u2192         content_block = getattr(chunk, 'content_block', None)\n177\u2192 \n178\u2192         if index is not None and content_block:\n179\u2192             self._current_block_index = index\n180\u2192 \n181\u2192             if content_block.get('type') == 'tool_use':\n182\u2192                 self._tool_blocks[index] = {\n183\u2192                     'id': content_block.get('id', ''),\n184\u2192                     'name': content_block.get('name', ''),\n185\u2192                     'partial_json': ''\n186\u2192                 }\n187\u2192             else:\n188\u2192                 # Text block - just track the index\n189\u2192                 if index not in self._tool_blocks:\n190\u2192                     self._tool_blocks[index] = {}\n191\u2192 \n192\u2192     async def _handle_content_block_stop(self, chunk: Any) -> None:\n193\u2192         \"\"\"Handle content_block_stop chunk.\n194\u2192 \n195\u2192         Finalizes tool argument accumulation.\n196\u2192         \"\"\"\n197\u2192         index = getattr(chunk, 'index', None)\n198\u2192         if index is not None and index in self._tool_blocks:\n199\u2192             # Parse accumulated JSON for tool arguments\n200\u2192             partial_json = self._tool_blocks[index].get('partial_json', '')\n201\u2192             if partial_json:\n202\u2192                 try:\n203\u2192                     self._tool_blocks[index]['arguments'] = json.loads(partial_json)\n204\u2192                 except json.JSONDecodeError:\n205\u2192                     logger.warning(f\"Failed to parse tool arguments: {partial_json}\")\n206\u2192                     self._tool_blocks[index]['arguments'] = {}\n207\u2192 \n208\u2192     def get_result(self) -> ProcessedStream:\n209\u2192         \"\"\"Get the final processed result.\n210\u2192 \n211\u2192         Returns a ProcessedStream containing the full text, extracted tool calls,\n212\u2192         and all raw chunks received.\n213\u2192 \n214\u2192         Returns:\n215\u2192             ProcessedStream with full_text, tool_calls, and raw_chunks\n216\u2192 \n217\u2192         Acceptance Criteria 3: Returns ProcessedStream with: full_text, tool_calls, raw_chunks\n218\u2192         \"\"\"\n219\u2192         tool_calls = self.extract_tool_calls(self._raw_chunks)\n220\u2192 \n221\u2192         return ProcessedStream(\n222\u2192             full_text=self._full_text,\n223\u2192             tool_calls=tool_calls,\n224\u2192             raw_chunks=self._raw_chunks\n225\u2192         )\n226\u2192 \n227\u2192     def extract_tool_calls(self, chunks: list[Any]) -> list[ToolCall]:\n228\u2192         \"\"\"Parse tool calls from accumulated chunks.\n229\u2192 \n230\u2192         This method processes the raw chunks to extract any tool calls that\n231\u2192         were present in the response. It handles partial_json accumulation\n232\u2192         and multiple tool calls in a single response.\n233\u2192 \n234\u2192         Args:\n235\u2192             chunks: List of raw chunks from the API stream\n236\u2192 \n237\u2192         Returns:\n238\u2192             List of ToolCall objects extracted from the stream\n239\u2192 \n240\u2192         Acceptance Criteria 4: extract_tool_calls() parses tool calls from chunks\n241\u2192         Acceptance Criteria 5: Handles partial_json accumulation\n242\u2192         Acceptance Criteria 6: Handles multiple tool calls in one response\n243\u2192         \"\"\"\n244\u2192         # Re-process chunks to extract tool calls\n245\u2192         tool_blocks: dict[int, dict[str, Any]] = {}\n246\u2192 \n247\u2192         for chunk in chunks:\n248\u2192             chunk_type = getattr(chunk, 'type', None)\n249\u2192 \n250\u2192             if chunk_type == 'content_block_start':\n251\u2192                 index = getattr(chunk, 'index', None)\n252\u2192                 content_block = getattr(chunk, 'content_block', None)\n253\u2192 \n254\u2192                 if index is not None and content_block:\n255\u2192                     if content_block.get('type') == 'tool_use':\n256\u2192                         tool_blocks[index] = {\n257\u2192                             'id': content_block.get('id', ''),\n258\u2192                             'name': content_block.get('name', ''),\n259\u2192                             'partial_json': ''\n260\u2192                         }\n261\u2192 \n262\u2192             elif chunk_type == 'content_block_delta':\n263\u2192                 index = getattr(chunk, 'index', None)\n264\u2192                 delta = getattr(chunk, 'delta', None)\n265\u2192 \n266\u2192                 if index is not None and delta and index in tool_blocks:\n267\u2192                     delta_type = delta.get('type', '')\n268\u2192                     if delta_type == 'input_json_delta':\n269\u2192                         partial_json = delta.get('partial_json', '')\n270\u2192                         tool_blocks[index]['partial_json'] += partial_json\n271\u2192 \n272\u2192             elif chunk_type == 'content_block_stop':\n273\u2192                 index = getattr(chunk, 'index', None)\n274\u2192                 if index is not None and index in tool_blocks:\n275\u2192                     partial_json = tool_blocks[index].get('partial_json', '')\n276\u2192                     # Always try to parse - even if partial_json was accumulated\n277\u2192                     try:\n278\u2192                         tool_blocks[index]['arguments'] = json.loads(partial_json) if partial_json else {}\n279\u2192                     except json.JSONDecodeError:\n280\u2192                         tool_blocks[index]['arguments'] = {}\n281\u2192 \n282\u2192         # Convert tool blocks to ToolCall objects\n283\u2192         tool_calls = []\n284\u2192         for block in tool_blocks.values():\n285\u2192             if block.get('name'):  # Only include blocks with a tool name\n286\u2192                 tool_calls.append(ToolCall(\n287\u2192                     id=block.get('id', ''),\n288\u2192                     name=block.get('name', ''),\n289\u2192                     arguments=block.get('arguments', {})\n290\u2192                 ))\n291\u2192 \n292\u2192         return tool_calls", "is_error": false}}
