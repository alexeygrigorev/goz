class AgentCore:\n 37\u2192     \"\"\"Core agent class for interactive coding.\n 38\u2192 \n 39\u2192     This class implements the full agent loop with tool integration:\n 40\u2192     - User input -> API stream -> tool calls -> tool execution -> results -> API -> response\n 41\u2192     - Handles multiple iterations (tool -> API -> tool -> API -> response)\n 42\u2192     - Yields text chunks for real-time UI updates\n 43\u2192     - Manages chat history with all messages\n 44\u2192 \n 45\u2192     Attributes:\n 46\u2192         config: Configuration for the agent\n 47\u2192         history: Chat history manager\n 48\u2192         tool_registry: Registry of available tools\n 49\u2192         chat_client: Client for Z.AI Chat API\n 50\u2192         max_iterations: Maximum tool-API iterations to prevent infinite loops\n 51\u2192     \"\"\"\n 52\u2192 \n 53\u2192     def __init__(\n 54\u2192         self,\n 55\u2192         config: Config,\n 56\u2192         history: ChatHistory | None = None,\n 57\u2192         tool_registry: ToolRegistry | None = None,\n 58\u2192         stream_processor: Any = None,\n 59\u2192         max_iterations: int = 10,\n 60\u2192     ) -> None:\n 61\u2192         \"\"\"Initialize AgentCore.\n 62\u2192 \n 63\u2192         Args:\n 64\u2192             config: Configuration object\n 65\u2192             history: Optional ChatHistory (creates new if None)\n 66\u2192             tool_registry: Optional ToolRegistry (creates new if None)\n 67\u2192             stream_processor: Optional stream processor (not used in current implementation)\n 68\u2192             max_iterations: Maximum tool-API iterations per turn (default: 10)\n 69\u2192         \"\"\"\n 70\u2192         self.config = config\n 71\u2192         self.history = history if history is not None else ChatHistory()\n 72\u2192         self.tool_registry = tool_registry if tool_registry is not None else ToolRegistry()\n 73\u2192         self.stream_processor = stream_processor\n 74\u2192         self.max_iterations = max_iterations\n 75\u2192 \n 76\u2192         # Initialize chat client\n 77\u2192         self.chat_client = ChatClient(config=config)\n 78\u2192 \n 79\u2192     async def process_turn(\n 80\u2192         self,\n 81\u2192         user_input: str,\n 82\u2192     ) -> AsyncIterator[str]:\n 83\u2192         \"\"\"Process a user turn and yield streaming response.\n 84\u2192 \n 85\u2192         This is the main agent loop. It:\n 86\u2192         1. Adds user message to history\n 87\u2192         2. Loops (up to max_iterations):\n 88\u2192            a. Calls API with current history\n 89\u2192            b. Streams response to UI (yields text chunks)\n 90\u2192            c. Checks for tool calls\n 91\u2192            d. If no tool calls, breaks\n 92\u2192            e. Executes tools sequentially\n 93\u2192            f. Adds tool calls and results to history\n 94\u2192         3. Adds assistant message to history\n 95\u2192         4. Yields completion marker\n 96\u2192 \n 97\u2192         Args:\n 98\u2192             user_input: User's input message\n 99\u2192 \n100\u2192         Yields:\n101\u2192             Text chunks for real-time UI display, followed by COMPLETION_MARKER\n102\u2192 \n103\u2192         Acceptance Criteria:\n104\u2192         - AC 1: Implements full turn processing\n105\u2192         - AC 2: user input -> API -> tools -> results -> API -> response\n106\u2192         - AC 3: Sequential tool execution\n107\u2192         - AC 4: Multiple tool calls in one response work\n108\u2192         - AC 5: Tool results formatted for API\n109\u2192         - AC 6: Tool errors caught and formatted\n110\u2192         - AC 7: Tool timeouts handled\n111\u2192         - AC 8: Yields text chunks for UI\n112\u2192         - AC 9: Completes when API stops\n113\u2192         - AC 10: History updated with all messages\n114\u2192         \"\"\"\n115\u2192         # Step 1: Add user message to history\n116\u2192         self.history.add(ChatMessage(role=\"user\", content=user_input))\n117\u2192 \n118\u2192         # Step 2: Main loop for tool-API iterations\n119\u2192         for iteration in range(self.max_iterations):\n120\u2192             # Step 2a: Call API with current history\n121\u2192             messages = self.history.to_api_format()\n122\u2192             tools_schema = self.tool_registry.to_openai_schema()\n123\u2192 \n124\u2192             # Step 2b: Process stream and yield text for UI\n125\u2192             accumulated_chunks: list[Chunk] = []\n126\u2192             accumulated_text: list[str] = []\n127\u2192 \n128\u2192             try:\n129\u2192                 stream = self.chat_client.chat_completion(\n130\u2192                     messages=messages,\n131\u2192                     tools=tools_schema if tools_schema else None,\n132\u2192                     tool_choice=\"auto\",\n133\u2192                 )\n134\u2192 \n135\u2192                 async for chunk in stream:\n136\u2192                     accumulated_chunks.append(chunk)\n137\u2192 \n138\u2192                     # Yield text for UI (AC 8)\n139\u2192                     # ContentBlockDelta has type=\"text_delta\" or type=\"input_json_delta\"\n140\u2192                     if hasattr(chunk, 'type') and chunk.type == \"text_delta\":\n141\u2192                         if hasattr(chunk, 'text') and chunk.text:\n142\u2192                             accumulated_text.append(chunk.text)\n143\u2192                             yield chunk.text\n144\u2192 \n145\u2192                 # Step 2c: Extract tool calls from stream\n146\u2192                 tool_calls = await self._extract_tool_calls_from_chunks(accumulated_chunks)\n147\u2192 \n148\u2192                 # Step 2d: Check for completion (no more tool calls)\n149\u2192                 if not tool_calls:\n150\u2192                     # No tools, turn is complete - add assistant message to history\n151\u2192                     assistant_text = \"\".join(accumulated_text)\n152\u2192                     self.history.add(ChatMessage(role=\"assistant\", content=assistant_text))\n153\u2192                     # Yield completion marker (AC 9)\n154\u2192                     yield COMPLETION_MARKER\n155\u2192                     break\n156\u2192 \n157\u2192                 # Step 2e: Execute tools sequentially (AC 3, AC 4)\n158\u2192                 for tool_call_dict in tool_calls:\n159\u2192                     # Create tool call message (AC 10)\n160\u2192                     tool_call_msg = ChatMessage(\n161\u2192                         role=\"tool_call\",\n162\u2192                         content=f\"Called {tool_call_dict['name']}\",\n163\u2192                         tool_calls=[ToolCall(\n164\u2192                             id=tool_call_dict['id'],\n165\u2192                             name=tool_call_dict['name'],\n166\u2192                             input=tool_call_dict['input'],\n167\u2192                         )],\n168\u2192                     )\n169\u2192                     self.history.add(tool_call_msg)\n170\u2192 \n171\u2192                     # Execute tool (AC 5, AC 6, AC 7)\n172\u2192                     tool_result = await self._execute_tool_call(tool_call_dict)\n173\u2192 \n174\u2192                     # Add tool result to history (AC 10)\n175\u2192                     result_msg = ChatMessage(\n176\u2192                         role=\"tool\",\n177\u2192                         content=tool_result,\n178\u2192                         tool_result_id=tool_call_dict['id'],\n179\u2192                     )\n180\u2192                     self.history.add(result_msg)\n181\u2192 \n182\u2192                 # Step 2f: Loop continues with tool results in history\n183\u2192 \n184\u2192             except Exception as e:\n185\u2192                 logger.error(f\"Error during turn processing: {e}\")\n186\u2192                 error_message = self._format_agent_error(e)\n187\u2192                 self.history.add(ChatMessage(role=\"assistant\", content=error_message))\n188\u2192                 yield error_message\n189\u2192                 yield COMPLETION_MARKER\n190\u2192                 break\n191\u2192 \n192\u2192     async def _extract_tool_calls_from_chunks(self, chunks: list[Chunk]) -> list[dict]:\n193\u2192         \"\"\"Extract tool calls from accumulated stream chunks.\n194\u2192 \n195\u2192         Args:\n196\u2192             chunks: List of chunks from the API stream\n197\u2192 \n198\u2192         Returns:\n199\u2192             List of tool_call dicts with id, name, and input keys\n200\u2192         \"\"\"\n201\u2192         # Use the chat_client's method if available\n202\u2192         if hasattr(self.chat_client, 'extract_tool_calls'):\n203\u2192             return await self.chat_client.extract_tool_calls(chunks)\n204\u2192 \n205\u2192         # Fallback: implement extraction here\n206\u2192         import json\n207\u2192 \n208\u2192         tool_calls: list[dict] = []\n209\u2192         current_tool: dict[str, Any] | None = None\n210\u2192         accumulated_json: list[str] = []\n211\u2192 \n212\u2192         for chunk in chunks:\n213\u2192             # Check for ContentBlockStart with tool_use\n214\u2192             if hasattr(chunk, 'type') and chunk.type == \"tool_use\":\n215\u2192                 current_tool = {\n216\u2192                     \"id\": getattr(chunk, 'id', ''),\n217\u2192                     \"name\": getattr(chunk, 'name', ''),\n218\u2192                     \"input\": {},\n219\u2192                 }\n220\u2192                 accumulated_json = []\n221\u2192 \n222\u2192             # Check for ContentBlockDelta with partial JSON\n223\u2192             elif hasattr(chunk, 'type') and chunk.type == \"input_json_delta\":\n224\u2192                 if hasattr(chunk, 'partial_json') and chunk.partial_json:\n225\u2192                     accumulated_json.append(chunk.partial_json)\n226\u2192 \n227\u2192             # Check for ContentBlockStop\n228\u2192             elif hasattr(chunk, 'type') and chunk.type == \"content_block_stop\":\n229\u2192                 if current_tool is not None and accumulated_json:\n230\u2192                     try:\n231\u2192                         json_str = \"\".join(accumulated_json)\n232\u2192                         current_tool[\"input\"] = json.loads(json_str)\n233\u2192                     except json.JSONDecodeError:\n234\u2192                         current_tool[\"input\"] = {\"raw\": \"\".join(accumulated_json)}\n235\u2192                     tool_calls.append(current_tool)\n236\u2192                     current_tool = None\n237\u2192                     accumulated_json = []\n238\u2192 \n239\u2192         # Alternative extraction path using ContentBlockStart type\n240\u2192         for chunk in chunks:\n241\u2192             if hasattr(chunk, 'type') and hasattr(chunk, 'index'):\n242\u2192                 if chunk.type == \"tool_use\" and not any(\n243\u2192                     tc.get('id') == getattr(chunk, 'id', '') for tc in tool_calls\n244\u2192                 ):\n245\u2192                     new_tool = {\n246\u2192                         \"id\": getattr(chunk, 'id', ''),\n247\u2192                         \"name\": getattr(chunk, 'name', ''),\n248\u2192                         \"input\": {},\n249\u2192                     }\n250\u2192                     # Find corresponding input_json_delta chunks\n251\u2192                     for c in chunks:\n252\u2192                         if (hasattr(c, 'index') and c.index == chunk.index and\n253\u2192                             hasattr(c, 'type') and c.type == \"input_json_delta\"):\n254\u2192                             if hasattr(c, 'partial_json') and c.partial_json:\n255\u2192                                 try:\n256\u2192                                     current = new_tool[\"input\"].get(\"_partial\", \"\")\n257\u2192                                     current += c.partial_json\n258\u2192                                     new_tool[\"input\"] = json.loads(current)\n259\u2192                                 except json.JSONDecodeError:\n260\u2192                                     new_tool[\"input\"] = {\"_partial\": current + c.partial_json}\n261\u2192                     if new_tool not in tool_calls:\n262\u2192                         tool_calls.append(new_tool)\n263\u2192 \n264\u2192         return tool_calls\n265\u2192 \n266\u2192     async def _execute_tool_call(self, tool_call: dict) -> str:\n267\u2192         \"\"\"Execute a single tool call and return result.\n268\u2192 \n269\u2192         This handles:\n270\u2192         - Finding the tool by name\n271\u2192         - Executing with timeout\n272\u2192         - Catching and formatting errors\n273\u2192 \n274\u2192         Args:\n275\u2192             tool_call: Tool call dict with id, name, and input\n276\u2192 \n277\u2192         Returns:\n278\u2192             String result to send back to API\n279\u2192 \n280\u2192         Acceptance Criteria:\n281\u2192         - AC 5: Tool results formatted for API\n282\u2192         - AC 6: Tool errors caught and formatted\n283\u2192         - AC 7: Tool timeouts handled\n284\u2192         \"\"\"\n285\u2192         tool_name = tool_call.get('name', '')\n286\u2192         tool = self.tool_registry.get(tool_name)\n287\u2192 \n288\u2192         if tool is None:\n289\u2192             available = \", \".join(sorted(self.tool_registry.tool_names)) or \"none\"\n290\u2192             return f\"Tool '{tool_name}' not found. Available tools: {available}.\"\n291\u2192 \n292\u2192         try:\n293\u2192             # Execute with timeout (AC 7)\n294\u2192             result = await asyncio.wait_for(\n295\u2192                 tool.execute(**tool_call.get('input', {})),\n296\u2192                 timeout=300,  # 5 minutes\n297\u2192             )\n298\u2192             return str(result)\n299\u2192 \n300\u2192         except asyncio.TimeoutError:\n301\u2192             return (\n302\u2192                 f\"Tool '{tool_name}' timed out after 300 seconds. \"\n303\u2192                 \"Try a smaller input or break the task into smaller steps.\"\n304\u2192             )\n305\u2192         except Exception as e:\n306\u2192             logger.error(f\"Tool {tool_name} failed: {e}\")\n307\u2192             return self._format_tool_error(tool_name, e)\n308\u2192 \n309\u2192     def __repr__(self) -> str:\n310\u2192         \"\"\"Return string representation of AgentCore.\"\"\"\n311\u2192         return f\"AgentCore(config={self.config!r}, messages={self.history.message_count})\"\n312\u2192 \n313\u2192     def _format_tool_error(self, tool_name: str, error: Exception) -> str:\n314\u2192         \"\"\"Return a user-facing tool error message.\"\"\"\n315\u2192         if isinstance(error, ToolInputError):\n316\u2192             return f\"Tool '{tool_name}' received invalid input: {error}. Check the required fields and try again.\"\n317\u2192         if isinstance(error, PermissionError):\n318\u2192             return f\"Tool '{tool_name}' failed due to permission denied: {error}. Check file permissions and retry.\"\n319\u2192         if isinstance(error, FileNotFoundError):\n320\u2192             return f\"Tool '{tool_name}' could not find the requested file: {error}. Verify the path and retry.\"\n321\u2192         if isinstance(error, ToolError):\n322\u2192             return f\"Tool '{tool_name}' failed: {error}\"\n323\u2192         return f\"Tool '{tool_name}' failed: {error}\"\n324\u2192 \n325\u2192     def _format_agent_error(self, error: Exception) -> str:\n326\u2192         \"\"\"Return a user-facing assistant error message.\"\"\"\n327\u2192         if isinstance(error, AuthError):\n328\u2192             return f\"Authentication error: {error.message} {error.help or ''}\".strip()\n329\u2192         if isinstance(error, TimeoutError):\n330\u2192             return f\"Request timed out. {error.help or 'Try again.'}\".strip()\n331\u2192         if isinstance(error, NetworkError):\n332\u2192             return f\"Network error: {error.message} {error.help or ''}\".strip()\n333\u2192         if isinstance(error, ApiError):\n334\u2192             help_text = f\" {error.help}\" if error.help else \"\"\n335\u2192             return f\"API error ({error.statusCode}): {error.message}.{help_text}\".strip()\n336\u2192         if isinstance(error, ZaiError):\n337\u2192             help_text = f\" {error.help}\" if error.help else \"\"\n338\u2192             return f\"{error.message}.{help_text}\".strip()\n339\u2192         return f\"Unexpected error: {error}\"", "is_error": false}}
{"type": "tool_use", "part": {"id": "call_1c52811975f7480fba0979c7", "name": "view_file", "input": {"file_path": "goz/api/errors.py"}, "output": "File: /home/alexey/git/goz/.litehive/worktrees/T-0008-add-usage-statistics-and-quota-tracking-to-goz/goz/api/errors.py (220 lines)\n============================================================\n\n  1\u2192 \"\"\"Error types for Z.AI API client.\n  2\u2192 \n  3\u2192 These error types are used throughout the API client for consistent error handling.\n  4\u2192 \"\"\"\n  5\u2192 \n  6\u2192 from __future__ import annotations\n  7\u2192 \n  8\u2192 \n  9\u2192 \n 10\u2192 class ZaiError(Exception):\n 11\u2192     \"\"\"Base error class for all Z.AI API errors.\n 12\u2192 \n 13\u2192     Attributes:\n 14\u2192         message: Human-readable error message\n 15\u2192         code: Error code for programmatic handling\n 16\u2192         statusCode: HTTP status code (optional)\n 17\u2192         help: Helpful hint for resolving the error (optional)\n 18\u2192     \"\"\"\n 19\u2192 \n 20\u2192     def __init__(\n 21\u2192         self,\n 22\u2192         message: str,\n 23\u2192         code: str = \"ZAI_ERROR\",\n 24\u2192         statusCode: int | None = None,\n 25\u2192         help: str | None = None,\n 26\u2192     ) -> None:\n 27\u2192         \"\"\"Initialize ZaiError.\n 28\u2192 \n 29\u2192         Args:\n 30\u2192             message: Human-readable error message\n 31\u2192             code: Error code for programmatic handling\n 32\u2192             statusCode: HTTP status code (optional)\n 33\u2192             help: Helpful hint for resolving the error (optional)\n 34\u2192         \"\"\"\n 35\u2192         self.message = message\n 36\u2192         self.code = code\n 37\u2192         self.statusCode = statusCode\n 38\u2192         self.help = help\n 39\u2192         super().__init__(self.message)\n 40\u2192 \n 41\u2192     def __str__(self) -> str:\n 42\u2192         \"\"\"Return string representation showing error code and message.\"\"\"\n 43\u2192         return f\"[{self.code}] {self.message}\"\n 44\u2192 \n 45\u2192     def __repr__(self) -> str:\n 46\u2192         \"\"\"Return detailed string representation.\"\"\"\n 47\u2192         return (\n 48\u2192             f\"{self.__class__.__name__}(message={self.message!r}, code={self.code!r}, \"\n 49\u2192             f\"statusCode={self.statusCode!r}, help={self.help!r})\"\n 50\u2192         )\n 51\u2192 \n 52\u2192 \n 53\u2192 class AuthError(ZaiError):\n 54\u2192     \"\"\"Authentication/authorization error (401, 403).\n 55\u2192 \n 56\u2192     This error is raised when the API token is invalid, expired, or missing.\n 57\u2192     \"\"\"\n 58\u2192 \n 59\u2192     def __init__(self, message: str, statusCode: int = 401) -> None:\n 60\u2192         \"\"\"Initialize AuthError.\n 61\u2192 \n 62\u2192         Args:\n 63\u2192             message: Human-readable error message\n 64\u2192             statusCode: HTTP status code (default: 401)\n 65\u2192         \"\"\"\n 66\u2192         super().__init__(\n 67\u2192             message=message,\n 68\u2192             code=\"AUTH_ERROR\",\n 69\u2192             statusCode=statusCode,\n 70\u2192             help=\"Authentication failed. Check your API key in ~/.config/goz/config.json. \"\n 71\u2192             \"Run 'goz config set zai_token <your-token>' to update.\",\n 72\u2192         )\n 73\u2192 \n 74\u2192 \n 75\u2192 class ApiError(ZaiError):\n 76\u2192     \"\"\"General API error (4xx, 5xx responses).\n 77\u2192 \n 78\u2192     This error is raised for API errors that are not authentication-related.\n 79\u2192     \"\"\"\n 80\u2192 \n 81\u2192     def __init__(self, message: str, statusCode: int = 500) -> None:\n 82\u2192         \"\"\"Initialize ApiError.\n 83\u2192 \n 84\u2192         Args:\n 85\u2192             message: Human-readable error message\n 86\u2192             statusCode: HTTP status code (default: 500)\n 87\u2192         \"\"\"\n 88\u2192         super().__init__(\n 89\u2192             message=message,\n 90\u2192             code=\"API_ERROR\",\n 91\u2192             statusCode=statusCode,\n 92\u2192             help=self._default_help(statusCode),\n 93\u2192         )\n 94\u2192 \n 95\u2192     @staticmethod\n 96\u2192     def _default_help(status_code: int) -> str:\n 97\u2192         \"\"\"Return actionable guidance based on HTTP status code.\"\"\"\n 98\u2192         if status_code == 429:\n 99\u2192             return \"Rate limit hit. Wait a moment before retrying, or reduce request volume.\"\n100\u2192         if status_code >= 500:\n101\u2192             return \"The service is having problems. Retry shortly; if it persists, try again later.\"\n102\u2192         return \"Check the request input and try again.\"\n103\u2192 \n104\u2192 \n105\u2192 class NetworkError(ZaiError):\n106\u2192     \"\"\"Network connection error.\n107\u2192 \n108\u2192     This error is raised when the client cannot connect to the API server.\n109\u2192     \"\"\"\n110\u2192 \n111\u2192     def __init__(self, message: str) -> None:\n112\u2192         \"\"\"Initialize NetworkError.\n113\u2192 \n114\u2192         Args:\n115\u2192             message: Human-readable error message\n116\u2192         \"\"\"\n117\u2192         super().__init__(\n118\u2192             message=message,\n119\u2192             code=\"NETWORK_ERROR\",\n120\u2192             help=\"Network connection failed. Check your internet connection and try again.\",\n121\u2192         )\n122\u2192 \n123\u2192 \n124\u2192 class TimeoutError(ZaiError):\n125\u2192     \"\"\"Request timeout error.\n126\u2192 \n127\u2192     This error is raised when the API request takes too long to complete.\n128\u2192     \"\"\"\n129\u2192 \n130\u2192     def __init__(self, timeoutMs: int) -> None:\n131\u2192         \"\"\"Initialize TimeoutError.\n132\u2192 \n133\u2192         Args:\n134\u2192             timeoutMs: Timeout value in milliseconds\n135\u2192         \"\"\"\n136\u2192         super().__init__(\n137\u2192             message=f\"Request timed out after {timeoutMs}ms\",\n138\u2192             code=\"TIMEOUT_ERROR\",\n139\u2192             help=\"Try again or increase timeout with Z_AI_TIMEOUT env var\",\n140\u2192         )\n141\u2192 \n142\u2192 \n143\u2192 class ValidationError(ZaiError):\n144\u2192     \"\"\"Validation error for invalid input parameters.\n145\u2192 \n146\u2192     This error is raised when input validation fails, such as invalid URLs,\n147\u2192     invalid format values, or other parameter validation issues.\n148\u2192     \"\"\"\n149\u2192 \n150\u2192     def __init__(self, message: str) -> None:\n151\u2192         \"\"\"Initialize ValidationError.\n152\u2192 \n153\u2192         Args:\n154\u2192             message: Human-readable error message describing the validation failure\n155\u2192         \"\"\"\n156\u2192         super().__init__(\n157\u2192             message=message,\n158\u2192             code=\"VALIDATION_ERROR\",\n159\u2192             help=\"Check your input parameters and try again.\",\n160\u2192         )\n161\u2192 \n162\u2192 \n163\u2192 # Z.AI quota/rate-limit error codes\n164\u2192 QUOTA_ERROR_CODES = {\n165\u2192     1302: \"QuotaExceededError\",\n166\u2192     1305: \"RateLimitError\",\n167\u2192     1308: \"TokenBudgetExceededError\",\n168\u2192     1310: \"ConcurrentRequestLimitError\",\n169\u2192 }\n170\u2192 \n171\u2192 QUOTA_ERROR_DESCRIPTIONS = {\n172\u2192     1302: \"API quota exceeded. Your usage has reached the plan limit.\",\n173\u2192     1305: \"Rate limit hit. Too many requests in a short time window.\",\n174\u2192     1308: \"Token budget exceeded for this billing period.\",\n175\u2192     1310: \"Concurrent request limit reached. Wait for in-flight requests to finish.\",\n176\u2192 }\n177\u2192 \n178\u2192 QUOTA_ERROR_HELP = {\n179\u2192     1302: \"Check your usage with 'goz usage' and consider upgrading your plan.\",\n180\u2192     1305: \"Wait a moment before retrying, or reduce request volume.\",\n181\u2192     1308: \"Reduce token usage or wait for the next billing period to reset.\",\n182\u2192     1310: \"Wait for current requests to finish before sending new ones.\",\n183\u2192 }\n184\u2192 \n185\u2192 \n186\u2192 class QuotaError(ZaiError):\n187\u2192     \"\"\"Quota or rate-limit error from Z.AI (error codes 1302/1305/1308/1310).\n188\u2192 \n189\u2192     This error is raised when the Z.AI API returns a quota-related error code,\n190\u2192     indicating that usage limits have been exceeded.\n191\u2192     \"\"\"\n192\u2192 \n193\u2192     def __init__(self, message: str, zai_code: int = 1302, statusCode: int = 429) -> None:\n194\u2192         \"\"\"Initialize QuotaError.\n195\u2192 \n196\u2192         Args:\n197\u2192             message: Human-readable error message from the API\n198\u2192             zai_code: Z.AI-specific error code (1302, 1305, 1308, or 1310)\n199\u2192             statusCode: HTTP status code (typically 429)\n200\u2192         \"\"\"\n201\u2192         code_name = QUOTA_ERROR_CODES.get(zai_code, \"QUOTA_ERROR\")\n202\u2192         help_text = QUOTA_ERROR_HELP.get(zai_code, \"Check your usage with 'goz usage'.\")\n203\u2192         super().__init__(\n204\u2192             message=message,\n205\u2192             code=code_name,\n206\u2192             statusCode=statusCode,\n207\u2192             help=help_text,\n208\u2192         )\n209\u2192         self.zai_code = zai_code\n210\u2192 \n211\u2192 \n212\u2192 def is_quota_error(error: ZaiError) -> bool:\n213\u2192     \"\"\"Check if an error is a quota-related error (codes 1302/1305/1308/1310).\"\"\"\n214\u2192     if isinstance(error, QuotaError):\n215\u2192         return True\n216\u2192     # Also check if a generic error carries a quota code in its message\n217\u2192     for code in QUOTA_ERROR_CODES:\n218\u2192         if f\"[{code}]\" in str(error) or f\"code {code}\" in str(error).lower():\n219\u2192             return True\n220\u2192     return False", "is_error": false}}
